// ============================================================================
//  بيئة التطوير المحلية — جهاز المطوّر فقط
// ----------------------------------------------------------------------------
//  مُستبعد من git ومن مخرجات publish.
//  في هذه البيئة فقط:
//    • Swagger مفعّل على /swagger
//    • DbSeeder ينشئ مستخدمي التطوير + بيانات تجريبية
//    • تفاصيل الاستثناءات تظهر في حقل detail بالردود
//  المستخدمون المزروعون: admin / cyber / supervisor / user / dev
//  كلمة المرور للجميع: Test@123
// ============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "NUH_PORTAL": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "AllowedHosts": "*",
  "AllowedOrigin": "*",

  "ConnectionStrings": {
    // قاعدة بيانات محلية — لا توجّهها أبدًا على قاعدة الإنتاج
    "DefaultConnection": "Server=localhost;Database=NUH_DB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },

  "HttpsRedirect": {
    "Enabled": false
  },

  "Jwt": {
    // مفتاح تطوير فقط — لا يُستخدم في أي بيئة أخرى
    "Key": "DEV-ONLY-NUH-PORTAL-LOCAL-KEY-NOT-FOR-PRODUCTION-2026",
    "Issuer": "NUH-PORTAL",
    "Audience": "NUH-PORTAL-USERS"
  },

  "ActiveDirectory": {
    // Enabled=false يتخطّى AD ويستخدم الدخول المحلي — للتطوير بدون دومين
    "Enabled": false,
    "Domain": "globalgroups.com",
    "DomainController": "DC-01.globalgroups.com",
    "Port": 636,
    "ValidateCertificate": false,
    "RoleMappings": [
      { "AdGroup": "Housing_Admin", "ApplicationRole": "admin" },
      { "AdGroup": "Housing_Cyber", "ApplicationRole": "cyber" },
      { "AdGroup": "Housing_Supervisor", "ApplicationRole": "supervisor" },
      { "AdGroup": "Housing_Users", "ApplicationRole": "user" }
    ]
  },

  "Otp": {
    // Static مقبول هنا فقط — تطوير بدون مزوّد SMS. الرمز دائمًا 123456
    "Mode": "Static",
    "StaticCode": "123456",
    "Salt": "DEV_OTP_SALT_LOCAL_ONLY"
  },

  "ADServiceAccount": {
    // فاضي — عمليات إدارة AD معطّلة في التطوير
    "Username": "",
    "Password": ""
  }
}
