// ============================================================================
//  بيئة التطوير — نسخة مطابقة تمامًا لـ appsettings.Production.json
// ----------------------------------------------------------------------------
//  الشغل كله بيتم مباشرة على سيرفر الإنتاج (10.100.100.21)، فمفيش داعي
//  لإعدادات منفصلة: نفس قاعدة البيانات، نفس الدومين، نفس المفاتيح.
//
//  ⚠️ أي تعديل هنا لازم يتعمل في appsettings.Production.json كمان —
//     الملفين المفروض يفضلوا متطابقين.
//
//  ملاحظة على السلوك: تشغيل المشروع من Visual Studio بيخلّي البيئة
//  Development، و Program.cs:327 بيزرع ساعتها حسابات محلية
//  (admin / cyber / supervisor / user - كلهم Test@123) وبيانات تجريبية.
//  ده بيديك دخول فوري بعد إعادة بناء القاعدة من غير ما تستنى AD،
//  بس امسحهم قبل ما البوابة تتفتح للمستخدمين.
// ============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "NUH_PORTAL": "Information",

      // يكتم سجلات TRACE المفصّلة (UPN، فلاتر LDAP، مجموعات المستخدم،
      // موضوع الشهادة، طول كلمة المرور) المسجَّلة بمستوى Information
      // داخل ActiveDirectoryService — بدون تعديل كود.
      // اجعلها Information مؤقتًا لو احتجت تشخيص مشكلة في AD.
      "NUH_PORTAL.Services.ActiveDirectoryService": "Warning",

      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // أسماء المضيف المسموح بها — تمنع هجمات Host header.
  // localhost و IP السيرفر مضافين عشان تقدر تفتح الموقع من على الجهاز نفسه
  // قبل ما الـ DNS والشهادة يخلصوا. شيلهم بعد ما التشغيل يستقر.
  "AllowedHosts": "housing.nuh.edu.sa;localhost;10.100.100.21",

  // نفس عنوان الموقع بالضبط: بالبروتوكول، وبدون / في الآخر
  "AllowedOrigin": "https://housing.nuh.edu.sa",

  "ConnectionStrings": {
    // حساب واحد بصلاحيات كاملة: svc.nuh (db_owner + dbcreator)
    // .\SQLEXPRESS = الجهاز المحلي، النسخة المسماة SQLEXPRESS.
    // لا نكتب منفذًا: النسخة المسماة تستخدم منفذًا ديناميكيًا،
    // والاتصال المحلي يمر عبر Shared Memory بدون خدمة SQL Browser.
    // ملاحظة: \\ مزدوجة إجبارية في JSON — \ حرف هروب.
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=NUH_DB;User Id=svc.nuh;Password=aPCWLk1_RpLiNy2+11pji9W_;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;Connect Timeout=30;Application Name=NUH-PORTAL"

    // ── الخيار الأفضل: هوية الـ Application Pool (بدون أي كلمة مرور) ──
    // SQL محلي على نفس الجهاز، فتقدر تدي حساب الـ App Pool صلاحية
    // مباشرة وتشيل كلمة المرور من الملف ده خالص:
    //
    //   CREATE LOGIN [IIS APPPOOL\NUH-PORTAL] FROM WINDOWS;
    //   USE NUH_DB;
    //   CREATE USER [IIS APPPOOL\NUH-PORTAL] FOR LOGIN [IIS APPPOOL\NUH-PORTAL];
    //   ALTER ROLE db_datareader ADD MEMBER [IIS APPPOOL\NUH-PORTAL];
    //   ALTER ROLE db_datawriter ADD MEMBER [IIS APPPOOL\NUH-PORTAL];
    //
    // وبعدها بدّل السطر فوق بده:
    // "DefaultConnection": "Server=.\\SQLEXPRESS;Database=NUH_DB;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;Application Name=NUH-PORTAL"
    //
    // ده بيشتغل سواء السيرفر منضم للدومين أو لأ — الهوية محلية.
  },

  // IIS ينهي الـ TLS داخل العملية (inprocess) فالمخطط https يصل صحيحًا
  "HttpsRedirect": {
    "Enabled": true
  },

  "Jwt": {
    // 🔑 مفتاح مولَّد عشوائيًا (48 بايت / 64 حرف Base64)
    //    تغييره يُبطل كل الجلسات النشطة فورًا.
    "Key": "UrRRODN4Uc04LiucG49WEuae1pi78iy4XQydrlkjZ16TtW+21ZZAfLnS858zGtS8",
    "Issuer": "NUH-PORTAL",
    "Audience": "NUH-PORTAL-USERS"
  },

  "ActiveDirectory": {
    "Enabled": true,

    // ⚠️ FQDN إجباري وليس NetBIOS — الكود بيستخدمه في حاجتين:
    //    ١) بناء الـ UPN:  {Username}@{Domain}
    //    ٢) بناء الـ Base DN: nuh.edu.sa → DC=nuh,DC=edu,DC=sa
    //       (ActiveDirectoryService.BuildBaseDn يقسّم على النقطة)
    "Domain": "nuh.edu.sa",

    // ممكن تحطها 10.100.100.15 لو الـ DNS مش مظبوط،
    // لكن الاسم أفضل لأن شهادة الـ LDAPS مُصدَرة عليه.
    "DomainController": "NUH-AD-SRV1.nuh.edu.sa",

    // 636 = LDAPS. الكود بيفرضها ويرفض 389.
    "Port": 636,

    // لا تجعلها false — الاتصال ده بتمر عليه كلمات مرور كل المستخدمين.
    // لو فشل التحقق: استورد شهادة Root CA بتاعة الدومين على السيرفر.
    "ValidateCertificate": true
  },

  "Otp": {
    // 🚨 وضع مؤقت — الرمز ثابت لأي رقم 🚨
    //
    //  "Static" → الرمز هو Otp:StaticCode لأي رقم جوال.
    //             ده تجاوز كامل لتحقق الجوال: أي حد يوصل للبوابة يقدر
    //             يكمّل تسجيل بأي رقم مش بتاعه.
    //  "Sms"    → رمز عشوائي آمن، لكن SmsService محاكي حاليًا
    //             (Provider = "Simulated") وبيسجّل الرسالة في جدول SMSLogs
    //             من غير ما يبعت حاجة فعليًا — فالطالب مش هيستلم رمز.
    //
    //  القرار الحالي: "Static" لحد ما تستلم API مزوّد الرسائل.
    //
    //  ⚠️ ارجع لـ "Sms" فورًا بعد ربط المزوّد داخل SmsService.SendOtpAsync،
    //     ولحد ساعتها ما تعرّضش /register للإنترنت العام.
    //
    //  المفاتيح دي بتتقرا في OtpFlowService.SendAsync (سطر 79-89):
    //      var otpMode    = _config["Otp:Mode"] ?? "Sms";
    //      var staticCode = _config["Otp:StaticCode"] ?? "123456";
    //  المقارنة حسّاسة لحالة الأحرف — لازم "Static" بالظبط.
    "Mode": "Static",
    "StaticCode": "123456",
    "Salt": "iZeWLryT3WoJ9E6x3hLJcy8WY5FTw7kl"
  },

  "ADServiceAccount": {
    // ⚠️ SAM مجرّد فقط — بدون NUH\ وبدون @nuh.edu.sa
    //    لأن ActiveDirectoryService.cs:594 بيبني الـ UPN بنفسه:
    //        $"{_serviceAccount.Username}@{_config.Domain}"
    //    فالناتج: nuh.portal@nuh.edu.sa
    //
    //    (ده بالظبط الباج اللي اتوثّق في AGENTS.md لما اتحطت
    //     القيمة بصيغة down-level وبقى الـ UPN غير صالح)
    "Username": "nuh.portal",

    "Password": "Nuh@Pa$$w0rd2026"
  }
}

// ============================================================================
//  ⚠️ الملف ده بقى مُتتبَّع في git بناءً على طلبك
// ----------------------------------------------------------------------------
//  أي قيمة تكتبها هنا هتترفع على GitHub. الأربعة دول أسرار حقيقية:
//      ConnectionStrings.DefaultConnection  (كلمة مرور SQL)
//      Jwt.Key                              (مفتاح توقيع التوكنات)
//      Otp.Salt                             (ملح تجزئة الـ OTP)
//      ADServiceAccount.Password            (حساب بيقدر ينشئ/يحذف مستخدمين
//                                            في دومين الجامعة)
//
//  لو عايز الملف يفضل مرفوع بهيكله من غير الأسرار: سيب القيم دي
//  placeholders هنا، واعمل على السيرفر ملف:
//
//      appsettings.Production.local.json
//
//  حاطط فيه الأربع قيم الحقيقية بس. .gitignore بيتجاهله، ولازم كمان
//  تضيف قراءته في Program.cs (سطر واحد بعد إنشاء الـ builder):
//
//      builder.Configuration.AddJsonFile(
//          $"appsettings.{builder.Environment.EnvironmentName}.local.json",
//          optional: true, reloadOnChange: true);
// ============================================================================
