@{
    ViewData["Title"] = SharedLocalizer["lk_tab_department"].Value;
}

<div class="page-header">
  <h2>@SharedLocalizer["lk_tab_department"]</h2>
  <p>@SharedLocalizer["lk_pageSubtitle"]</p>
</div>

<partial name="_LookupAdminShell" />

@section Scripts {
<script src="/i18n.js"></script>
<script src="/lookup-admin.js"></script>
<script>
  setLang(localStorage.getItem('uiLanguage') || 'ar');
  LookupAdmin.init({
    apiBase: '/api/admin/departments',
    fields: ['code', 'arName', 'enName', 'collegeId', 'displayOrder', 'isActive'],
    cols: ['code', 'arName', 'enName', 'college', 'order', 'active'],
    isTerm: false,
    needsColleges: true,
    titleKey: 'lk_tab_department'
  });
</script>
}
