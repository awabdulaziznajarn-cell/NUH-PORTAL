@{
    ViewData["Title"] = SharedLocalizer["rol_pageTitle"].Value;
    var canManage = User.HasClaim("permission", "roles.manage");
}

<div class="page-header">
  <h2>@SharedLocalizer["rol_pageTitle"]</h2>
  <p>@SharedLocalizer["rol_pageSubtitle"]</p>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">@SharedLocalizer["rol_pageTitle"]</div>
    <div class="card-tools">
      @if (canManage)
      {
        <button class="btn btn-primary" type="button" onclick="openCreate()">@SharedLocalizer["rol_addRole"]</button>
      }
    </div>
  </div>

  <div style="overflow-x:auto">
    <table id="rolTable">
      <thead>
        <tr>
          @* ⚠️ «#» ترقيم عرض، و«الوصف» جملة حرّة ترتيبها أبجديًّا مالوش
             معنى، و«إجراءات» مش بيانات — التلاتة بلا data-sort. *@
          <th>@SharedLocalizer["col_seq"]</th>
          <th data-sort="name">@SharedLocalizer["rol_col_name"]</th>
          <th>@SharedLocalizer["rol_col_desc"]</th>
          <th data-sort="userCount">@SharedLocalizer["rol_col_users"]</th>
          <th data-sort="permissionCount">@SharedLocalizer["rol_col_perms"]</th>
          <th>@SharedLocalizer["rol_col_actions"]</th>
        </tr>
      </thead>
      <tbody id="rolBody">
        <tr><td colspan="6" style="text-align:center;padding:40px"><div class="spinner"></div></td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="edit-overlay" id="rolOverlay" onclick="if(event.target===this)closeModal()">
  <div class="edit-modal" role="dialog" aria-modal="true" style="max-width:720px">
    <div class="edit-modal-header">
      <div>
        <div class="edit-modal-title" id="rolModalTitle">@SharedLocalizer["rol_addTitle"]</div>
        <div class="edit-modal-sub">@SharedLocalizer["rol_modalSub"]</div>
      </div>
      <button class="edit-close" type="button" onclick="closeModal()" aria-label='@(SharedLocalizer["rol_cancel"].Value)'>✕</button>
    </div>
    <div class="edit-modal-body">
      <input type="hidden" id="m_id">
      <div class="e-grid">
        <div class="e-field">
          <label for="m_name">@SharedLocalizer["rol_lbl_name"]<span class="req">*</span></label>
          <input type="text" id="m_name">
          <span class="field-error" id="m-err-name">@SharedLocalizer["rol_required"]</span>
        </div>
        <div class="e-field">
          <label for="m_description">@SharedLocalizer["rol_lbl_desc"]</label>
          <input type="text" id="m_description">
        </div>
      </div>

      <div style="margin-top:20px">
        <div style="font-size:13px;font-weight:700;color:var(--navy-dark);margin-bottom:6px">@SharedLocalizer["rol_lbl_perms"]</div>
        <div style="font-size:12px;color:var(--gray-500);margin-bottom:12px">@SharedLocalizer["rol_permsHint"]</div>
        <div id="permGroups"></div>
      </div>
    </div>
    <div class="edit-modal-actions">
      <button class="btn btn-primary" id="rolSaveBtn" type="button" onclick="saveRole()">
        <span class="btn-text">@SharedLocalizer["rol_save"]</span>
        <div class="spinner2"></div>
      </button>
      <button class="btn btn-cancel" type="button" onclick="closeModal()">@SharedLocalizer["rol_cancel"]</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"><span id="toast-msg"></span></div>

@section Scripts {
<style>
  /* ⚠️ أزرار إجراءات الصف (.row-actions / .action-*) اتشالت من هنا —
     كانت مكرّرة بالحرف في أربع شاشات. مكانها الآن components.css. */
  .rol-name{display:inline-block;padding:2px 10px;border-radius:6px;font-size:12px;font-weight:700;background:#eff4ff;color:#1849a9}
  .rol-count{display:inline-block;min-width:26px;text-align:center;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:600;background:var(--gray-100);color:var(--gray-700)}
  /* ⚠️ .edit-modal-header اتشالت من هنا — كانت مكرّرة في ثلاث شاشات.
     مكانها الآن site.css مرة واحدة. */
  .perm-group{border:1px solid var(--gray-200);border-radius:12px;margin-bottom:12px;overflow:hidden}
  .perm-group-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 14px;background:var(--gray-50);cursor:pointer}
  .perm-group-title{font-size:13px;font-weight:700;color:var(--navy-dark)}
  .perm-group-all{font-size:11px;color:var(--navy);cursor:pointer;font-weight:600}
  .perm-list{padding:8px 14px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .perm-item{display:flex;align-items:flex-start;gap:8px;padding:6px;border-radius:8px}
  .perm-item:hover{background:var(--row-hover)}
  .perm-item input{margin-top:3px;width:16px;height:16px;cursor:pointer}
  .perm-item label{cursor:pointer;font-size:13px;color:var(--navy-dark)}
  .perm-item .perm-desc{display:block;font-size:11px;color:var(--gray-500);margin-top:2px}
</style>
<script src="/i18n.js"></script>
<script>
  var PERM_MANAGE = @(canManage ? "true" : "false");
  var state = { roles: [], catalog: [] };

  // الجدول وحالاته من NuhTable، والترويسات من NUH.headers في التخطيط — مفيش نسخة محلية.
  var rolTable = NuhTable.bind('rolBody', 6);
  // تهريب HTML — التعريف الوحيد في /js/esc.js
  var esc = function (v) { return escHtml(v); };

  function showToast(msg, isError) {
    var el = document.getElementById('toast'); if (!el) return;
    document.getElementById('toast-msg').textContent = msg;
    el.style.background = isError ? '#b42318' : '#067647';
    el.classList.add('show');
    setTimeout(function () { el.classList.remove('show'); }, 3500);
  }

  var rolSort = NuhTable.sort('rolTable', function () { renderTable(); });

  function renderTable() {
    // ⚠️ setLang في التهيئة بتنادي onLanguageChange → renderTable قبل أول نداء،
    //    فكانت الشاشة تكتب «لا توجد أدوار» ثم تمتلئ. الحالتان مختلفتان.
    if (!rolTable.isDone()) return rolTable.loading();
    var body = '';
    // ⚠️ الترتيب في المتصفح: /api/Roles بيرجّع كل الأدوار في نداء واحد بلا
    //    ترقيم (٦-٩ صفوف)، فالمصفوفة هي كل البيانات. المقارنة من NuhTable.
    rolSort.sortRows(state.roles).forEach(function (r, idx) {
      var actions = '';
      if (PERM_MANAGE) {
        actions += '<button class="action-btn action-edit" onclick="openEdit(' + r.id + ')">' + t('rol_edit') + '</button>';
        actions += '<button class="action-btn action-delete" onclick="delRole(' + r.id + ',\'' + esc(r.name) + '\')">' + t('rol_delete') + '</button>';
      }
      body += '<tr>' +
        '<td>' + (idx + 1) + '</td>' +
        '<td><span class="rol-name">' + esc(r.name) + '</span></td>' +
        '<td>' + esc(r.description) + '</td>' +
        '<td><span class="rol-count">' + r.userCount + '</span></td>' +
        '<td><span class="rol-count">' + r.permissionCount + '</span></td>' +
        '<td><div class="row-actions">' + (actions || '-') + '</div></td></tr>';
    });
    rolTable.rows(body, t('rol_noItems'));
  }

  async function loadRoles() {
    try {
      var res = await fetch('/api/Roles', { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (!res.ok) { rolTable.error(t('rol_loadError')); showToast(t('rol_loadError'), true); return; }
      state.roles = await res.json();
      rolTable.done();
      renderTable();
    } catch (e) { rolTable.error(t('rol_loadError')); showToast(t('rol_loadError'), true); }
  }

  async function ensureCatalog() {
    if (state.catalog.length) return;
    try {
      var res = await fetch('/api/Roles/permissions', { headers: NUH.headers() });
      if (res.ok) state.catalog = await res.json();
    } catch (e) { /* صامت */ }
  }

  function renderPermGroups(selected) {
    var sel = {};
    (selected || []).forEach(function (v) { sel[v] = true; });
    var html = '';
    state.catalog.forEach(function (g, gi) {
      html += '<div class="perm-group">' +
        '<div class="perm-group-head">' +
          '<span class="perm-group-title">' + esc(g.groupName) + '</span>' +
          '<span class="perm-group-all" onclick="toggleGroup(' + gi + ')">' + t('rol_groupToggle') + '</span>' +
        '</div>' +
        '<div class="perm-list" data-group="' + gi + '">' +
          g.permissions.map(function (p) {
            var id = 'perm_' + p.value.replace(/[^a-zA-Z0-9]/g, '_');
            return '<div class="perm-item">' +
              '<input type="checkbox" id="' + id + '" value="' + esc(p.value) + '"' + (sel[p.value] ? ' checked' : '') + '>' +
              '<label for="' + id + '">' + esc(p.name) +
                '<span class="perm-desc">' + esc(p.description) + '</span>' +
              '</label></div>';
          }).join('') +
        '</div></div>';
    });
    document.getElementById('permGroups').innerHTML = html;
  }

  function toggleGroup(gi) {
    var boxes = document.querySelectorAll('.perm-list[data-group="' + gi + '"] input[type=checkbox]');
    var anyUnchecked = Array.prototype.some.call(boxes, function (b) { return !b.checked; });
    boxes.forEach(function (b) { b.checked = anyUnchecked; });
  }

  function collectPerms() {
    var boxes = document.querySelectorAll('#permGroups input[type=checkbox]:checked');
    return Array.prototype.map.call(boxes, function (b) { return b.value; });
  }

  function mGet(id) { return document.getElementById('m_' + id); }

  async function openCreate() {
    await ensureCatalog();
    document.getElementById('rolModalTitle').textContent = t('rol_addTitle');
    mGet('id').value = '';
    mGet('name').value = '';
    mGet('name').removeAttribute('readonly');
    mGet('description').value = '';
    document.getElementById('m-err-name').classList.remove('show');
    mGet('name').classList.remove('error');
    renderPermGroups([]);
    document.getElementById('rolOverlay').classList.add('show');
  }

  async function openEdit(id) {
    await ensureCatalog();
    document.getElementById('rolModalTitle').textContent = t('rol_editTitle');
    mGet('id').value = id;
    document.getElementById('m-err-name').classList.remove('show');
    mGet('name').classList.remove('error');
    try {
      var res = await fetch('/api/Roles/' + id, { headers: NUH.headers() });
      if (!res.ok) { showToast(t('rol_loadError'), true); return; }
      var d = await res.json();
      mGet('name').value = d.name || '';
      mGet('name').setAttribute('readonly', 'readonly');
      mGet('description').value = d.description || '';
      renderPermGroups(d.permissions || []);
      document.getElementById('rolOverlay').classList.add('show');
    } catch (e) { showToast(t('rol_loadError'), true); }
  }

  function closeModal() { document.getElementById('rolOverlay').classList.remove('show'); }

  async function saveRole() {
    var id = mGet('id').value;
    var isEdit = !!id;
    var name = mGet('name').value.trim();
    if (!isEdit && !name) {
      mGet('name').classList.add('error');
      document.getElementById('m-err-name').classList.add('show');
      return;
    }
    var btn = document.getElementById('rolSaveBtn');
    btn.classList.add('loading');
    var payload = { name: name, description: mGet('description').value.trim(), permissions: collectPerms() };
    try {
      var res = await fetch(isEdit ? '/api/Roles/' + id : '/api/Roles', {
        method: isEdit ? 'PUT' : 'POST',
        headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
        body: JSON.stringify(payload)
      });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.ok) { closeModal(); loadRoles(); showToast(t('rol_saved')); }
      else { var err = await res.json().catch(function () { return {}; }); showToast(err.message || t('rol_saveError'), true); }
    } catch (e) { showToast(t('rol_saveError'), true); }
    finally { btn.classList.remove('loading'); }
  }

  async function delRole(id, name) {
    // ⚠️ حوار النظام لا confirm() المتصفح - الشرح في js/dialog.js: خيار
    //    «امنع هذه الصفحة من إنشاء حوارات» بيعطّل كل تأكيد بعده بصمت.
    if (!await NuhDialog.confirm({
      message: t('rol_confirmDelete').replace('{0}', name),
      danger: true,
      confirmLabel: t('rol_delete')
    })) return;
    try {
      var res = await fetch('/api/Roles/' + id, { method: 'DELETE', headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.ok) { loadRoles(); showToast(t('rol_deleted')); }
      else { var err = await res.json().catch(function () { return {}; }); showToast(err.message || t('rol_saveError'), true); }
    } catch (e) { showToast(t('rol_saveError'), true); }
  }

  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
  window.onLanguageChange = function () { renderTable(); };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
  loadRoles();
</script>
}
