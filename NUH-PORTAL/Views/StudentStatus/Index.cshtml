          <div class="field full">
            <div style="background:var(--gray-50);border-radius:10px;padding:12px 16px">
              <div style="font-size:13px;font-weight:600;color:var(--gray-700);margin-bottom:8px" >@SharedLocalizer["ss_currentHousing"]</div>
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;font-size:13px">
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["ss_currentBuilding"]</span><br><strong id="transferOldBuilding">--</strong></div>
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["reg_lblFloor"]</span><br><strong id="transferOldFloor">--</strong></div>
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["ss_currentApartment"]</span><br><strong id="transferOldApartment">--</strong></div>
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["ss_currentRoom"]</span><br><strong id="transferOldRoom">--</strong></div>
              </div>
            </div>
          </div>

          <div class="field full">
            <div style="background:var(--green-light);border-radius:10px;padding:12px 16px">
              <div style="font-size:13px;font-weight:600;color:var(--green);margin-bottom:8px" >@SharedLocalizer["ss_newHousing"]</div>
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px">
                <div class="field" style="gap:4px">
                  <label for="transferNewBuilding"><span >@SharedLocalizer["ss_newBuilding"]</span> <span style="color:#d92d20">*</span></label>
                  <div class="input-wrap">
                    @* المباني بتتفلتر حسب جنس الطالب بعد ما يتحمّل — نفس قاعدة شاشات التسجيل *@
                    <select id="transferNewBuilding" disabled>
                      <option value="" >@SharedLocalizer["ss_studentNumber"]</option>
                    </select>
                  </div>
                </div>
                <div class="field" style="gap:4px">
                  <label for="transferNewFloor"><span >@SharedLocalizer["reg_lblFloor"]</span> <span style="color:#d92d20">*</span></label>
                  <div class="input-wrap">
                    <select id="transferNewFloor">
                      <option value="" >@SharedLocalizer["reg_optSelectFloor"]</option>
                      <option value="0" >@SharedLocalizer["reg_optFloorGround"]</option>
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4">4</option>
                    </select>
                  </div>
                </div>
                <div class="field" style="gap:4px">
                  <label for="transferNewApartment"><span >@SharedLocalizer["ss_newApartment"]</span> <span style="color:#d92d20">*</span></label>
                  <div class="input-wrap">
                    @* الشقة بتتولّد من الدور — نفس قاعدة شاشات التسجيل (js/housing-fields.js) *@
                    <select id="transferNewApartment" disabled>
                      <option value="" >@SharedLocalizer["reg_optSelectFloorFirst"]</option>
                    </select>
                  </div>
                </div>
                <div class="field" style="gap:4px">
                  <label for="transferNewRoom"><span >@SharedLocalizer["ss_newRoom"]</span> <span style="color:#d92d20">*</span></label>
                  <div class="input-wrap">
                    <select id="transferNewRoom">
                      <option value="" >@SharedLocalizer["reg_optSelectRoom"]</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="field full">
            <label for="transferReason"><span >@SharedLocalizer["ss_transferReason"]</span> <span style="color:#d92d20">*</span></label>
            <div class="input-wrap">
              <select id="transferReason">
                <option value="" >@SharedLocalizer["ss_selectDefault"]</option>
                <option value="student_request" >@SharedLocalizer["ss_reason_student_request"]</option>
                <option value="major_change" >@SharedLocalizer["ss_reason_major_change"]</option>
                <option value="housing_issue" >@SharedLocalizer["ss_reason_housing_issue"]</option>
                <option value="room_maintenance" >@SharedLocalizer["ss_reason_room_maintenance"]</option>
                <option value="admin_decision" >@SharedLocalizer["ss_reason_admin_decision"]</option>
                <option value="other" >@SharedLocalizer["ss_reason_other"]</option>
              </select>
            </div>
          </div>

          <div class="field full" id="customReasonField" style="display:none">
            <label for="transferCustomReason"><span >@SharedLocalizer["ss_customReason"]</span> <span style="color:#d92d20">*</span></label>
            <div class="input-wrap">
              <textarea id="transferCustomReason" style="width:100%;height:80px;background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:10px;padding:12px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;color:var(--navy-dark);direction:inherit;outline:none;resize:vertical;transition:all .2s" placeholder='@(SharedLocalizer["ss_customReasonPlaceholder"].Value)'></textarea>
            </div>
          </div>

          <div class="field full">
            <label for="transferAttachmentFile">@SharedLocalizer["ss_attachDocument"]</label>
            <div class="file-upload-wrap">
              <input type="file" id="transferAttachmentFile" accept=".pdf,.jpg,.jpeg,.png,.docx" onchange="onFilePicked(this, 'transferFileName')">
              <div class="file-upload-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span >@SharedLocalizer["ss_chooseFile"]</span>
              </div>
            </div>
            <div class="file-name" id="transferFileName"></div>
          </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:12px">
          <button class="form-actions-btn" id="transferBtn" onclick="handleTransfer()" disabled style="background:var(--gray-300);color:#fff">
            <span >@SharedLocalizer["ss_transferStudent"]</span>
          </button>
          <button class="form-actions-btn" style="background:var(--gray-100);color:var(--gray-700)" onclick="resetTransferForm()">
            <span >@SharedLocalizer["ss_clear"]</span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="col-history">
    <div class="card">
      <div class="card-header">
        <div class="card-title" >@SharedLocalizer["ss_transferHistory"]</div>
      </div>
      <div class="history-list" id="transferHistoryList">
        <div style="text-align:center;padding:30px;color:var(--gray-500)" >@SharedLocalizer["ss_noTransfers"]</div>
      </div>
      <button type="button" class="history-more" id="transferHistoryMore" style="display:none">@SharedLocalizer["ss_loadMore"]</button>
    </div>
  </div>
</div>
}

<div class="toast" id="toast"></div>

@* ⚠️ حوارا التأكيد اتشالوا من هنا: كانوا ماركب كامل (غلاف + صندوق +
   أيقونة + عنوان + أزرار) بيكرّر مكوّن NuhDialog الموجود في js/dialog.js -
   نفس المكوّن اللي شِلنا عشانه confirm() المتصفح من ستّ شاشات.

   وكان فيهم تكرار ظاهر للعين: الأيقونة بتقول «تحذير» والعنوان بيقول
   «تحذير» - نفس المعلومة مرتين والعنوان مش بيضيف حاجة. دلوقتي العنوان
   بيقول **إيه اللي هيحصل** والأيقونة بتقول إن ده إجراء خطير.

   وبييجي مع المكوّن: Esc بيقفل، والدوس برّه مابيقفلش في الخطير، والتركيز
   بيرجع مكانه، والأزرار بتترجم - كلها ماكانتش موجودة في المبني بالإيد. *@

@section Scripts {
<script src="/i18n.js"></script>
<script src="/js/housing-fields.js"></script>
<script>
  var _toastTimer = null;
  function showToast(msg, type) {
    var el = document.getElementById('toast');
    el.textContent = msg;
    el.className = 'toast show toast-' + (type || 'success');

    // رسائل الخطأ بتشرح سبب رفض إجراء — محتاجة وقت تتقرا. النجاح تأكيد سريع.
    if (_toastTimer) clearTimeout(_toastTimer);
    _toastTimer = setTimeout(function () { el.className = 'toast'; },
                             type === 'error' ? 12000 : 3500);

    el.onclick = function () {
      if (_toastTimer) clearTimeout(_toastTimer);
      el.className = 'toast';
    };
  }

  async function apiFetch(url) {
    try {
      var res = await fetch(url, { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return null; }
      if (!res.ok) return null;
      return await res.json();
    } catch (e) { return null; }
  }

  // نص الحالة من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function getStatusLabel(v) {
    var k = 'ss_status_' + v;
    var val = t(k);
    return val === k ? (v || '') : val;
  }

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach(function (el) { el.classList.remove('show'); });
    document.querySelectorAll('.input-wrap input.error, .input-wrap select.error, textarea.error').forEach(function (el) { el.classList.remove('error'); });
  }
  function showError(id) {
    document.getElementById(id).classList.add('show');
    var input = document.getElementById(id.replace('Error', ''));
    if (input) input.classList.add('error');
  }

  function selectStatus(el) {
    document.querySelectorAll('.status-option').forEach(function (s) { s.classList.remove('selected'); });
    el.classList.add('selected');
    el.querySelector('input[type=radio]').checked = true;
  }

  // ⚠️ التظليل بيتبع الاختيار الحقيقي لا الدوسة: اللي بيتنقّل بالكيبورد
  //    (سهم لتحت جوه المجموعة) كان بيغيّر الخيار المحدَّد فعلًا من غير ما
  //    أي كارت يتظلّل - فيبعت «منقطع» وهو شايف إنه ما اختارش حاجة.
  document.querySelectorAll('#statusOptions input[type=radio]').forEach(function (r) {
    r.addEventListener('change', function () {
      var card = r.closest('.status-option');
      if (card) selectStatus(card);
    });
  });

  // ====================================================================
  //  الملف المختار: اسمه ومعاينته ومسحه - دالة واحدة للمنتقيين.
  //  ⚠️ كان لكل منتقٍ دالة خاصة به تكتب الاسم نصًّا وخلاص: لا معاينة تتأكد
  //     أن الملف هو المقصود، ولا مسح إن كان غلطًا. والمسح الوحيد كان بإعادة
  //     تحميل الصفحة أو بإرسال النموذج.
  //     ونستعمل نفس صفّ المرفق (.att-row) المستعمل في سجل الإجراءات أدناه،
  //     فشكل الملف واحد قبل الحفظ وبعده.
  // ====================================================================
  var pickedObjectUrl = null;

  function releasePickedUrl() {
    if (pickedObjectUrl) { URL.revokeObjectURL(pickedObjectUrl); pickedObjectUrl = null; }
  }

  function onFilePicked(input, boxId) {
    var box = document.getElementById(boxId);
    if (!box) return;
    releasePickedUrl();

    var f = input.files && input.files[0];
    if (!f) { box.innerHTML = ''; return; }

    if (isImageName(f.name)) pickedObjectUrl = URL.createObjectURL(f);

    // نفس البانٍ - فالصفّ قبل الرفع وبعده مكوّن واحد لا نسختان
    box.innerHTML = attachmentRow({
      name: f.name,
      previewUrl: pickedObjectUrl,
      isLocal: true,
      removable: true
    });

    box.querySelector('.att-remove').onclick = function () {
      input.value = '';
      releasePickedUrl();
      box.innerHTML = '';
    };
  }

  var pendingSubmitData = null;

  function resetForm() {
    document.getElementById('studentNumber').value = '';
    document.querySelectorAll('.status-option').forEach(function (s) { s.classList.remove('selected'); });
    document.querySelectorAll('input[name=statusType]').forEach(function (r) { r.checked = false; });
    document.getElementById('notes').value = '';
    document.getElementById('attachmentFile').value = '';
    releasePickedUrl();
    document.getElementById('fileName').innerHTML = '';
    document.getElementById('studentInfo').style.display = 'none';
    document.getElementById('studentInfoId').textContent = '--';
    document.getElementById('studentInfoName').textContent = '--';
    document.getElementById('studentInfoStatus').textContent = '--';
    clearErrors();
    pendingSubmitData = null;
  }

  async function handleSubmit() {
    clearErrors();
    var studentNumber = document.getElementById('studentNumber').value.trim();
    var statusEl = document.querySelector('input[name=statusType]:checked');
    var notes = document.getElementById('notes').value.trim();
    var file = document.getElementById('attachmentFile').files[0];
    var valid = true;

    if (!studentNumber) { showError('studentNumberError'); valid = false; }
    if (!statusEl) { showError('statusTypeError'); valid = false; }
    if (!notes || notes.length < 5) { showError('notesError'); valid = false; }
    if (!valid) return;

    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').innerHTML = '<span>...</span>';

    try {
      var res = await fetch('/api/students', { headers: NUH.headers() });
      if (!res.ok) { showToast(t('ss_serverError'), 'error'); enableSubmitBtn(); return; }
      var students = await res.json();
      var student = Array.isArray(students) ? students.find(function (s) { return s.student_id === studentNumber; }) : null;
      if (!student) { showToast(t('ss_studentNotFound'), 'error'); enableSubmitBtn(); return; }

      // نفس قاعدة السيرفر (StudentStatusService): الحالات الأربع كلها تُنهي السكن،
      // فكلها تُعطِّل حساب شبكة السكن. كان هنا استثناء لـ «ترك السكن» بُني على
      // افتراض أن الحساب أكاديمي — وهو ليس كذلك. أي استثناء هنا يعني أن التحذير
      // يكذب على المستخدم في اتجاه أو آخر، وهو أخطر من عدم وجود تحذير أصلًا.
      var hasAdAccount = !!student.ad_username;

      pendingSubmitData = { studentNumber: studentNumber, statusType: statusEl.value, notes: notes, file: file };
      window._pendingStatus = pendingSubmitData;

      // ====================================================================
      //  ⚠️ النافذة كانت تعرض اسم المستخدم التقني بالأحمر ولا تعرض اسم الطالب
      //     إطلاقًا - وأشيع خطأ هنا هو رقم جامعي من تسعة أرقام يُكتب باليد،
      //     ولحظة التأكيد هي آخر فرصة لالتقاطه. فالاسم أولًا، ثم الرقم، ثم
      //     السبب، واسم المستخدم ينزل سطر تذييل رماديًّا صغيرًا.
      //
      //  ⚠️ ولم تعد danger: الحالات الأربع كلها إجراءات إدارية روتينية يسجّلها
      //     المشرف أسبوعيًّا وكلها تُغلق الحساب. لو كان كل روتيني أحمر، لم يعد
      //     الأحمر يعني «قف» في أي مكان آخر في النظام.
      //
      //  ⚠️ وحالة «بلا حساب» تُقال صراحةً لا تُخفى: كل طالب في هذه الشاشة
      //     يُفترض أن له حسابًا، فغيابه شذوذ - غالبًا فشل إنشاء - والمشرف
      //     والمسؤول يحتاجان معرفته لا تمريره بهدوء.
      // ====================================================================
      var ok = await NuhDialog.confirm({
        title: t('ss_confirmTitleFmt').replace('{0}', getStatusLabel(statusEl.value)),
        message: hasAdAccount ? t('ss_disableIntroCalm') : t('ss_noAccountNotice'),
        rows: [
          { label: t('ss_studentLabel'), value: student.full_name || '' },
          { label: t('ss_studentIdLabel'), value: student.student_id || '' },
          { label: t('ss_reasonLabel'), value: getStatusLabel(statusEl.value) }
        ],
        foot: hasAdAccount ? t('ss_networkAccountFoot').replace('{0}', student.ad_username) : '',
        confirmLabel: t('ss_confirmAction'),
        cancelLabel: t('ss_cancel')
      });
      if (ok) await executeSubmit();
      else { pendingSubmitData = null; window._pendingStatus = null; }
    } catch (e) {
      showToast(t('ss_serverError'), 'error');
    } finally {
      enableSubmitBtn();
    }
  }

  function enableSubmitBtn() {
    document.getElementById('submitBtn').disabled = false;
    document.getElementById('submitBtn').innerHTML = '<span>' + t('ss_confirmAction') + '</span>';
  }

  async function executeSubmit() {
    var data = window._pendingStatus;
    if (!data) return;
    window._pendingStatus = null;

    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').innerHTML = '<span>...</span>';

    try {
      var formData = new FormData();
      formData.append('studentNumber', data.studentNumber);
      formData.append('statusType', data.statusType);
      formData.append('notes', data.notes);
      if (data.file) formData.append('file', data.file);

      var res = await fetch('/api/student-status', {
        method: 'POST',
        headers: NUH.headers(),
        body: formData
      });

      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.status === 403) { showToast(t('ss_forbidden'), 'error'); return; }

      var result = await res.json();
      if (!res.ok) { showToast(result.message || t('ss_errorOccurred'), 'error'); return; }

      if (result.warning) showToast(result.message + '. ' + result.warning, 'error');
      else showToast(result.message || t('ss_statusSaved'), 'success');

      resetForm();
      loadHistory();
      // الأرقام فوق سيرفرية — نحدّثها بإعادة تحميل بعد ثانية علشان التوست يبان
      setTimeout(function () { location.reload(); }, 1200);
    } catch (e) {
      showToast(t('ss_serverError'), 'error');
    } finally {
      enableSubmitBtn();
    }
  }

  // ==========================================================================
  //  «عرض المزيد» - تعريف واحد للقائمتين.
  //
  //  ⚠️ كلتاهما كانت تجلب ٥٠ صفًّا وتقف بلا أي إشارة: القائمة تبدو منتهية وهي
  //     ليست كذلك، فيُغلق الموظف الشاشة وهو يظنّ أنه رأى كل شيء. الزرّ يجلب
  //     الخمسين التالية، ويختفي عند النهاية الحقيقية لا قبلها.
  //
  //  ⚠️ نقيس الاكتمال بعدد ما وصل مقابل حجم الصفحة، لا بعدّاد إجمالي منفصل:
  //     العدّاد المنفصل يعني استعلامًا ثانيًا ورقمًا قد يتأخّر عن القائمة.
  // ==========================================================================
  var HISTORY_PAGE = @NUH_PORTAL.Services.StudentStatusService.RecentPageSize;

  function bindMore(btnId, loader) {
    var b = document.getElementById(btnId);
    if (b) b.addEventListener('click', function () { loader(true); });
  }

  function updateMore(btnId, received) {
    var b = document.getElementById(btnId);
    if (!b) return;
    b.disabled = false;
    b.textContent = t('ss_loadMore');
    b.style.display = (received === HISTORY_PAGE) ? '' : 'none';
  }

  // نخزّن نسخة من البيانات علشان نقدر نعيد الرسم عند تغيير اللغة بدون إعادة تحميل
  var _statusHistoryData = null;
  async function loadHistory(more) {
    var btn = document.getElementById('historyMore');
    if (more && btn) { btn.disabled = true; btn.textContent = t('ss_loading'); }

    var skip = (more && _statusHistoryData) ? _statusHistoryData.length : 0;
    var page = await apiFetch('/api/student-status/recent?skip=' + skip) || [];
    _statusHistoryData = (more && _statusHistoryData) ? _statusHistoryData.concat(page) : page;

    renderHistory();
    updateMore('historyMore', page.length);
  }

  function renderHistory() {
    var data = _statusHistoryData;
    var list = document.getElementById('historyList');
    if (!list) return;
    if (!data || !data.length) {
      list.innerHTML = '<div style="text-align:center;padding:30px;color:var(--gray-500)">' + t('ss_noUpdates') + '</div>';
      return;
    }
    list.innerHTML = data.map(function (a) {
      var label = getStatusLabel(a.statusType) || a.statusType;
      var badgeClass = 'badge-status-' + a.statusType;
      var dateObj = new Date(a.createdDate);
      var dateStr = NuhFmt.dateLong(dateObj);
      var timeStr = NuhFmt.time(dateObj);
      var userName = a.createdByName || t('ss_unknown');
      return '<div class="history-item" data-type="' + escHtml(a.statusType || 'other') + '">' +
        '<div style="margin-bottom:8px"><span class="badge ' + badgeClass + '" style="font-size:13px;padding:4px 12px">' + escHtml(label) + '</span></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:13px;color:var(--navy-dark)">' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_studentNumber') + '</span><br><strong>' + escHtml(a.studentNumber) + '</strong></div>' +
          (a.studentName ? '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_infoStudentName') + '</span><br>' + escHtml(a.studentName) + '</div>' : '') +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_by') + '</span><br>' + escHtml(userName) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_date') + '</span><br>' + dateStr + ' ' + timeStr + '</div>' +
        '</div>' +
        (a.notes ? '<div style="margin-top:8px;padding:8px 12px;background:var(--gray-50);border-radius:8px;font-size:13px;color:var(--gray-700)"><span style="color:var(--gray-500);font-size:12px;font-weight:600">' + t('ss_notes') + '</span><br>' + escHtml(a.notes) + '</div>' : '') +
        // المستند المرفق — اتنقل من شاشة المغادرة قبل ما تتشال
        (a.attachmentFileName ? attachmentHtml('/api/student-status/' + a.id + '/attachment', a.attachmentFileName) : '') +
      '</div>';
    }).join('');
  }

  // ===== نقل السكن =====
  var transferStudentLoaded = false;
  var transferStudentData = null;

  var SS_PH = @Html.Raw(__ssHousingPh);
  // الشقة بتتولد من الدور، والغرفة 1-4 — نفس قاعدة شاشات التسجيل
  NuhHousing.attach({
    floor: 'transferNewFloor', apartment: 'transferNewApartment', room: 'transferNewRoom',
    labels: { floorFirst: SS_PH.floorFirst, selectApartment: SS_PH.selectApartment, selectRoom: SS_PH.selectRoom }
  });

  // الدور متخزّن كود ("0" = الأرضي) — بيتترجم عند العرض بس
  function floorLabel(v) {
    if (v === null || v === undefined || v === '') return '--';
    return String(v) === '0' ? SS_PH.ground : String(v);
  }

  // المباني بتتفلتر حسب جنس الطالب — من غير كده ممكن المشرف ينقل طالب لمبنى بنات.
  // احتياطي ثابت لو جدول القوائم مش متاح، بنفس التوزيع المعتمد.
  var TRANSFER_FALLBACK = { male: ['65','66','67','68','69','70'], female: ['40','41','42','43'] };

  async function loadTransferBuildings(gender) {
    var sel = document.getElementById('transferNewBuilding');
    sel.innerHTML = '';
    var ph = document.createElement('option');
    ph.value = '';
    sel.appendChild(ph);

    var g = (gender || '').toString().toLowerCase();
    if (g !== 'male' && g !== 'female') {
      ph.textContent = t('ss_studentNumber');
      sel.disabled = true;
      updateTransferBtnState();
      return;
    }

    ph.textContent = SS_PH.selectBuilding;
    sel.disabled = false;

    var items = [];
    try {
      var res = await fetch('/api/lookups/buildings?gender=' + encodeURIComponent(g), { headers: NUH.headers() });
      if (res.ok) items = await res.json();
    } catch (e) { items = []; }

    if (items && items.length) {
      items.forEach(function (b) {
        var o = document.createElement('option');
        o.value = b.code || b.Code || '';
        o.textContent = b.name || b.Name || o.value;
        sel.appendChild(o);
      });
    } else {
      (TRANSFER_FALLBACK[g] || []).forEach(function (code) {
        var o = document.createElement('option');
        o.value = code; o.textContent = code;
        sel.appendChild(o);
      });
    }
    updateTransferBtnState();
  }

  // وصف الموقع بصيغة مقروءة: «مبنى 69 · الدور 3 · شقة 15 · غرفة 3»
  // الأرقام لوحدها (69/3/15/3) مالهاش معنى لحد ما يحفظ الترتيب — الليبل بيشيل اللبس.
  var LOC_SEP = ' · ';
  function locText(b, f, a, r) {
    var parts = [];
    if (b) parts.push(t('loc_building') + ' ' + b);
    var fl = floorLabel(f);
    if (fl !== '--') parts.push(t('loc_floor') + ' ' + fl);
    if (a) parts.push(t('loc_apartment') + ' ' + a);
    if (r) parts.push(t('loc_room') + ' ' + r);
    return parts.length ? parts.join(LOC_SEP) : '--';
  }

  // ===== المرفقات =====
  // الرابط بيروح على endpoint بيتحقق من الصلاحية (مش ملف ثابت في wwwroot).
  // الصور بتتفتح في نافذة معاينة جوه الصفحة، و PDF/Word بيتفتحوا في تبويب جديد،
  // و«تحميل» بترجع الملف باسمه الأصلي.
  function isImageName(n) { return /\.(png|jpe?g|gif|webp)$/i.test(n || ''); }

  // ====================================================================
  //  صفّ المرفق - بانٍ واحد للحالتين: ملف محفوظ على الخادم، وملف اختاره
  //  المستخدم للتو ولم يُرفع بعد.
  //
  //  ⚠️ كان لكل حالة ماركب مكتوب بيده. النتيجة صفّان يُفترض أنهما نفس
  //     المكوّن ويظهران بشكلين: المحفوظ فيه زر أخضر يعطي الصفّ ثقله، والمختار
  //     زرّان رماديان يبدوان باهتين بجانبه. أي تعديل على أحدهما كان يترك
  //     الآخر خلفه - وهذا ما حدث فعلًا.
  //
  //  الألوان من لغة النظام لا من الذوق: أخضر للإجراء الأساسي (تحميل)،
  //  ورمادي للثانوي (معاينة)، وأحمر للهادم (مسح).
  // ====================================================================
  function attachmentRow(o) {
    var canPreview = isImageName(o.name);
    return '<div class="att-row">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>' +
        '<span class="att-name" title="' + escHtml(o.name) + '">' + escHtml(o.name) + '</span>' +
        (canPreview && o.previewUrl
          ? '<a class="btn btn-cancel att-btn" href="' + escHtml(o.previewUrl) + '"' +
            (o.isLocal ? '' : ' target="_blank" rel="noopener"') +
            ' data-preview="' + escHtml(o.previewUrl) + '"' +
            ' data-preview-name="' + escHtml(o.name) + '"' +
            (o.isLocal ? ' data-preview-local="1"' : '') + '>' +
            escHtml(SS_PH.preview) + '</a>'
          : '') +
        (o.downloadUrl
          ? '<a class="btn btn-primary att-btn" href="' + escHtml(o.downloadUrl) + '">' +
            escHtml(SS_PH.download) + '</a>'
          : '') +
        (o.removable
          ? '<button type="button" class="btn btn-danger att-btn att-remove">' +
            escHtml(t('ss_removeFile')) + '</button>'
          : '') +
      '</div>';
  }

  // المرفق المحفوظ على الخادم: معاينة وتحميل
  function attachmentHtml(url, name) {
    return attachmentRow({ name: name, previewUrl: url, downloadUrl: url + '?download=true' });
  }

  // معاينة الصور جوه الصفحة — من غير ما المستخدم يسيب الشاشة
  document.addEventListener('click', function (e) {
    var link = e.target.closest ? e.target.closest('[data-preview]') : null;
    if (!link) return;
    e.preventDefault();
    showAttachmentPreview(
      link.getAttribute('data-preview'),
      link.getAttribute('data-preview-name'),
      link.hasAttribute('data-preview-local'));
  });

  // isLocal = ملف على جهاز المستخدم لم يُرفع بعد: لا رابط تنزيل له، ورابط
  //           التنزيل بـ ?download=true لا معنى له على عنوان blob.
  function showAttachmentPreview(url, name, isLocal) {
    var overlay = document.getElementById('attPreviewOverlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'attPreviewOverlay';
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(22,27,38,.75);z-index:9999;' +
        'display:flex;align-items:center;justify-content:center;padding:24px';
      overlay.addEventListener('click', function (ev) { if (ev.target === overlay) closeAttachmentPreview(); });
      document.body.appendChild(overlay);
      document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') closeAttachmentPreview(); });
    }
    overlay.innerHTML =
      '<div class="att-prev-card">' +
        '<div class="att-prev-head">' +
          '<span class="att-prev-title" title="' + escHtml(name) + '">' + escHtml(name) + '</span>' +
          '<div class="att-prev-actions">' +
            (isLocal ? '' :
              '<a class="btn btn-primary att-btn" href="' + escHtml(url) + '?download=true">' + escHtml(SS_PH.download) + '</a>') +
            '<button type="button" id="attPreviewClose" class="btn btn-cancel att-btn">' + escHtml(SS_PH.close) + '</button>' +
          '</div>' +
        '</div>' +
        // ⚠️ onerror لازم: الصورة اللي مابتحمّلش كانت بتسيب النافذة فاضية
        //    إلا من اسم الملف (نصّ alt)، فالمستخدم بيفتكر إن دي هي المعاينة
        //    وإن الملف اترفع فاضي. السبب الحقيقي ممكن يكون سياسة محتوى أو
        //    ملف تالف، والاتنين بيحصلوا بصمت في وحدة تحكّم المتصفح.
        '<div class="att-prev-body">' +
          '<img src="' + escHtml(url) + '" alt="' + escHtml(name) + '">' +
          '<div class="att-prev-fail" style="display:none;padding:28px 20px;text-align:center;' +
            'color:var(--gray-500);font-size:13.5px">' +
            escHtml(t('ss_previewFailed')) + '</div>' +
        '</div>' +
      '</div>';
    overlay.style.display = 'flex';

    // ⚠️ الربط من الجافاسكربت لا onerror مكتوبة في الوسم: السياسة اللي
    //    النظام ماشي ناحيتها (Content-Security-Policy-Report-Only في
    //    Program.cs) بتمنع السكربت المكتوب جوّه الخصائص، فأي معالج inline
    //    جديد بيبقى دَين لازم يتشال بعدين.
    var img = overlay.querySelector('.att-prev-body img');
    var fail = overlay.querySelector('.att-prev-fail');
    if (img && fail) {
      img.onerror = function () { img.style.display = 'none'; fail.style.display = 'block'; };
    }

    var btn = document.getElementById('attPreviewClose');
    if (btn) btn.onclick = closeAttachmentPreview;
  }

  function closeAttachmentPreview() {
    var overlay = document.getElementById('attPreviewOverlay');
    if (overlay) overlay.style.display = 'none';
  }

  function updateTransferBtnState() {
    var nb = document.getElementById('transferNewBuilding').value.trim();
    var nf = document.getElementById('transferNewFloor').value;
    var na = document.getElementById('transferNewApartment').value.trim();
    var nr = document.getElementById('transferNewRoom').value.trim();
    var reason = document.getElementById('transferReason').value;
    var customReason = document.getElementById('transferCustomReason').value.trim();
    var btn = document.getElementById('transferBtn');
    var canTransfer = transferStudentLoaded && nb && nf && na && nr && reason && (reason !== 'other' || customReason.length >= 3);
    btn.disabled = !canTransfer;
    btn.style.background = canTransfer ? 'var(--navy)' : 'var(--gray-300)';
  }


  function resetTransferForm() {
    ['transferStudentNumber', 'transferNewBuilding', 'transferNewApartment', 'transferNewRoom', 'transferCustomReason'].forEach(function (id) {
      document.getElementById(id).value = '';
    });
    document.getElementById('transferReason').value = '';
    document.getElementById('transferAttachmentFile').value = '';
    releasePickedUrl();
    document.getElementById('transferFileName').innerHTML = '';
    document.getElementById('transferStudentInfo').style.display = 'none';
    document.getElementById('customReasonField').style.display = 'none';
    document.getElementById('transferOldBuilding').textContent = '--';
    document.getElementById('transferOldFloor').textContent = '--';
    document.getElementById('transferOldApartment').textContent = '--';
    document.getElementById('transferOldRoom').textContent = '--';
    transferStudentLoaded = false;
    transferStudentData = null;
    updateTransferBtnState();
  }

  // نص سبب النقل من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function getTransferReasonLabel(v) {
    var k = 'ss_reason_' + v;
    var val = t(k);
    return val === k ? (v || '') : val;
  }

  async function handleTransfer() {
    var sn = document.getElementById('transferStudentNumber').value.trim();
    var nb = document.getElementById('transferNewBuilding').value.trim();
    var nf = document.getElementById('transferNewFloor').value;
    var na = document.getElementById('transferNewApartment').value.trim();
    var nr = document.getElementById('transferNewRoom').value.trim();
    var reason = document.getElementById('transferReason').value;
    var customReason = document.getElementById('transferCustomReason').value.trim();

    if (!transferStudentData) { showToast(t('ss_studentNotFound'), 'error'); return; }
    if (!nb || !nf || !na || !nr) { showToast(t('ss_completeNewHousing'), 'error'); return; }
    if (!reason) { showToast(t('ss_selectTransferReason'), 'error'); return; }
    if (reason === 'other' && customReason.length < 3) { showToast(t('ss_customReasonPlaceholder'), 'error'); return; }

    var student = transferStudentData;
    var oldLoc = locText(student.housing_building, student.floor_number, student.apartment_number, student.room_number);
    var newLoc = locText(nb, nf, na, nr);
    var reasonLabel = reason === 'other' ? customReason : getTransferReasonLabel(reason);

    window._pendingTransfer = {
      studentNumber: sn, newBuilding: nb, newFloor: nf, newApartment: na, newRoom: nr,
      reason: reason, customReason: reason === 'other' ? customReason : null,
      file: document.getElementById('transferAttachmentFile').files[0]
    };

    // ⚠️ النقل مش إجراء خطير (مفيش حاجة بتتعطّل) - فالحوار بشكل السؤال العادي
    //    لا الأحمر. اللون بيفرّق بين «راجع وأكّد» و«ده ملهوش رجعة».
    var ok = await NuhDialog.confirm({
      title: t('ss_transferConfirmTitle'),
      message: t('ss_transferIntroFull'),
      rows: [
        { label: t('ss_studentLabel'), value: student.full_name },
        { label: t('ss_currentHousingLabel'), value: oldLoc },
        { label: t('ss_newHousingLabel'), value: newLoc },
        { label: t('ss_reasonShortLabel'), value: reasonLabel }
      ],
      confirmLabel: t('ss_transferConfirmYes'),
      cancelLabel: t('ss_cancel')
    });
    if (ok) await executeTransfer();
    else window._pendingTransfer = null;
  }

  async function executeTransfer() {
    var data = window._pendingTransfer;
    if (!data) return;
    window._pendingTransfer = null;

    var btn = document.getElementById('transferBtn');
    btn.disabled = true;
    btn.innerHTML = '<span>...</span>';

    try {
      var formData = new FormData();
      formData.append('studentNumber', data.studentNumber);
      formData.append('newBuilding', data.newBuilding);
      formData.append('newFloor', data.newFloor);
      formData.append('newApartment', data.newApartment);
      formData.append('newRoom', data.newRoom);
      formData.append('reason', data.reason);
      if (data.customReason) formData.append('customReason', data.customReason);
      if (data.file) formData.append('file', data.file);

      var res = await fetch('/api/supervisor/housing-transfer', {
        method: 'POST',
        headers: NUH.headers(),
        body: formData
      });

      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.status === 403) { showToast(t('ss_forbidden'), 'error'); return; }

      var result = await res.json();
      if (!res.ok) { showToast(result.message || t('ss_errorOccurred'), 'error'); return; }

      showToast(result.message || t('ss_transferSuccess'), 'success');
      resetTransferForm();
      loadTransferHistory();
    } catch (e) {
      showToast(t('ss_serverError'), 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span>' + t('ss_transferStudent') + '</span>';
      updateTransferBtnState();
    }
  }

  var _transferHistoryData = null;
  async function loadTransferHistory(more) {
    // القسم كله مخفي لو المستخدم مالوش صلاحية النقل — بلاش نداء بيرجّع 403
    if (!document.getElementById('transferHistoryList')) return;

    var btn = document.getElementById('transferHistoryMore');
    if (more && btn) { btn.disabled = true; btn.textContent = t('ss_loading'); }

    var skip = (more && _transferHistoryData) ? _transferHistoryData.length : 0;
    var page = await apiFetch('/api/supervisor/housing-transfer/recent?skip=' + skip) || [];
    _transferHistoryData = (more && _transferHistoryData) ? _transferHistoryData.concat(page) : page;

    renderTransferHistory();
    updateMore('transferHistoryMore', page.length);
  }

  function renderTransferHistory() {
    var data = _transferHistoryData;
    var list = document.getElementById('transferHistoryList');
    if (!list) return;
    if (!data || !data.length) {
      list.innerHTML = '<div style="text-align:center;padding:30px;color:var(--gray-500)">' + t('ss_noTransfers') + '</div>';
      return;
    }
    list.innerHTML = data.map(function (x) {
      var dateObj = new Date(x.createdAt);
      var dateStr = NuhFmt.dateLong(dateObj);
      var timeStr = NuhFmt.time(dateObj);
      var userName = x.createdByName || t('ss_unknown');
      var oldLoc = locText(x.oldBuilding, x.oldFloor, x.oldApartment, x.oldRoom);
      var newLoc = locText(x.newBuilding, x.newFloor, x.newApartment, x.newRoom);
      var reasonLabel = x.customReason || getTransferReasonLabel(x.reason);
      // الرابط القديم كان بيستخدم الاسم الأصلي للملف، والملف متخزّن على الديسك
      // باسم GUID — فكان بيطلع 404 دايمًا. بيعدّي دلوقتي من endpoint بيتحقق من
      // الصلاحية ويرجّع الملف بنوعه الصحيح.
      var attachHtml = x.originalFileName
        ? attachmentHtml('/api/supervisor/housing-transfer/' + x.id + '/attachment', x.originalFileName)
        : '';
      return '<div class="history-item" data-type="transferred">' +
        '<div style="margin-bottom:8px"><span class="badge badge-status-transferred" style="font-size:13px;padding:4px 12px">🏠 ' + t('ss_housingTransferBadge') + '</span></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:13px;color:var(--navy-dark)">' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_studentNumber') + '</span><br><strong>' + escHtml(x.studentNumber) + '</strong></div>' +
          (x.studentName ? '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_infoStudentName') + '</span><br>' + escHtml(x.studentName) + '</div>' : '') +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_currentHousingShort') + '</span><br>' + escHtml(oldLoc) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_newHousingShort') + '</span><br>' + escHtml(newLoc) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_by') + '</span><br>' + escHtml(userName) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_date') + '</span><br>' + dateStr + ' ' + timeStr + '</div>' +
        '</div>' +
        '<div style="margin-top:8px;padding:8px 12px;background:var(--gray-50);border-radius:8px;font-size:13px;color:var(--gray-700)"><span style="color:var(--gray-500);font-size:12px;font-weight:600">' + t('ss_transferReason') + '</span><br>' + escHtml(reasonLabel) + '</div>' +
        attachHtml +
      '</div>';
    }).join('');
  }

  // ===== ملء بيانات الطالب عند كتابة الرقم الجامعي =====
  document.getElementById('studentNumber').addEventListener('blur', async function () {
    var val = this.value.trim();
    if (!val) return;
    // ⚠️ كان بيسحب *كل* الطلاب من السيرفر ويدوّر فيهم هنا، على كل خروج من الخانة.
    //    مع آلاف طالب ده ميجابايتات على كل ضغطة. بقى صف واحد بالرقم الجامعي.
    var found = await apiFetch('/api/students/by-number/' + encodeURIComponent(val));
    var info = document.getElementById('studentInfo');
    if (found) {
      var st = (found.student_status || 'active');
      var badgeClass = 'badge-status-' + st;
      document.getElementById('studentInfoId').textContent = found.student_id;
      document.getElementById('studentInfoName').textContent = found.full_name;
      document.getElementById('studentInfoStatus').innerHTML = '<span class="badge ' + badgeClass + '">' + getStatusLabel(st) + '</span>';
      info.style.display = 'block';
      info.style.background = '';
    } else {
      document.getElementById('studentInfoId').textContent = '✗ ' + t('ss_studentNotFound');
      document.getElementById('studentInfoName').textContent = '';
      document.getElementById('studentInfoStatus').textContent = '';
      info.style.display = 'block';
      info.style.background = '#fef3f2';
    }
  });

  document.getElementById('transferStudentNumber').addEventListener('blur', async function () {
    var val = this.value.trim();
    transferStudentLoaded = false;
    transferStudentData = null;
    updateTransferBtnState();
    if (!val) return;
    // ⚠️ كان بيسحب *كل* الطلاب من السيرفر ويدوّر فيهم هنا، على كل خروج من الخانة.
    //    مع آلاف طالب ده ميجابايتات على كل ضغطة. بقى صف واحد بالرقم الجامعي.
    var found = await apiFetch('/api/students/by-number/' + encodeURIComponent(val));
    var info = document.getElementById('transferStudentInfo');
    var text = document.getElementById('transferStudentInfoText');
    if (found) {
      transferStudentLoaded = true;
      transferStudentData = found;
      text.textContent = '✓ ' + found.full_name + ' - ' + found.student_id;
      info.style.display = 'block';
      info.style.background = '';
      document.getElementById('transferOldBuilding').textContent = found.housing_building || '--';
      document.getElementById('transferOldFloor').textContent = floorLabel(found.floor_number);
      await loadTransferBuildings(found.gender);
      document.getElementById('transferOldApartment').textContent = found.apartment_number || '--';
      document.getElementById('transferOldRoom').textContent = found.room_number || '--';
    } else {
      text.textContent = '✗ ' + t('ss_studentNotFound');
      info.style.display = 'block';
      info.style.background = '#fef3f2';
      await loadTransferBuildings(null);
    }
    updateTransferBtnState();
  });

  ['transferCustomReason'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', updateTransferBtnState);
  });
  // المبنى والدور والشقة والغرفة كلهم قوائم — الحدث بتاعها change مش input
  ['transferNewBuilding', 'transferNewFloor', 'transferNewApartment', 'transferNewRoom'].forEach(function (id) {
    document.getElementById(id).addEventListener('change', updateTransferBtnState);
  });
  document.getElementById('transferReason').addEventListener('change', function () {
    document.getElementById('customReasonField').style.display = this.value === 'other' ? 'block' : 'none';
    updateTransferBtnState();
  });

  // السجلين بيتحمّلوا على طول وبالتوازي.
  // قبل كده كانت الصفحة بتنادي /api/users الأول عشان تجيب أسماء المستخدمين،
  // وده نداء مقفول على المشرف (users.view للأدمن بس) — يعني كانت بتستنى رد 403
  // قبل ما تبدأ تحمّل أي سجل. الأسماء بقت بترجع من السيرفر مع الصفوف نفسها
  // (createdByName)، فالنداء ده اتشال خالص.
  loadHistory();
  loadTransferHistory();
  bindMore('historyMore', loadHistory);
  bindMore('transferHistoryMore', loadTransferHistory);

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم عناصر الترجمة وبيستدعي onLanguageChange لإعادة رسم السجلات من الكاش
  window.onLanguageChange = function () {
    renderHistory();
    renderTransferHistory();
  };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
</script>
}
