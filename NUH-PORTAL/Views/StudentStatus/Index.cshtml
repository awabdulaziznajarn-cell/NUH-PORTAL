@model NUH_PORTAL.DTOs.StudentStatus.StudentStatusStatsDto
@{
    ViewData["Title"] = SharedLocalizer["Page_StudentStatus"].Value;

    // النصوص بتتسلسل JSON عشان Razor بيهرّب أي نص بيطبعه ترميز HTML حتى جوه script
    var __ssHousingPh = System.Text.Json.JsonSerializer.Serialize(new
    {
        floorFirst = SharedLocalizer["reg_optSelectFloorFirst"].Value,
        selectApartment = SharedLocalizer["reg_optSelectApartment"].Value,
        selectRoom = SharedLocalizer["reg_optSelectRoom"].Value,
        selectBuilding = SharedLocalizer["reg_optSelectBuilding"].Value,
        ground = SharedLocalizer["reg_optFloorGround"].Value,
        preview = SharedLocalizer["att_preview"].Value,
        download = SharedLocalizer["att_download"].Value,
        close = SharedLocalizer["att_close"].Value
    });
}

<style>
  /* خاص بصفحة حالة الطالب فقط — الباقي من site.css */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-bottom:24px}
  .stat-card{background:var(--white);border-radius:14px;padding:16px;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(27,42,94,.05);display:flex;flex-direction:column;gap:8px;transition:transform .2s,box-shadow .2s}
  .stat-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(27,42,94,.1)}
  .stat-top{display:flex;align-items:center;justify-content:space-between}
  .stat-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center}
  .stat-num{font-size:26px;font-weight:900;color:var(--navy-dark);line-height:1}
  .stat-label{font-size:12px;color:var(--gray-500);font-weight:500}
  .stat-badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;white-space:nowrap}
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
  .two-col .col-form{min-width:0}
  .two-col .col-history{min-width:0}
  .form-card{background:var(--white);border-radius:16px;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(27,42,94,.05);overflow:hidden;margin-bottom:20px}
  .form-card-header{padding:18px 24px;border-bottom:1px solid var(--gray-100);display:flex;align-items:center;gap:10px}
  .form-card-header-icon{width:36px;height:36px;border-radius:10px;background:var(--gray-100);display:flex;align-items:center;justify-content:center}
  .form-card-title{font-size:15px;font-weight:700;color:var(--navy-dark)}
  .form-card-body{padding:24px}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .field{display:flex;flex-direction:column;gap:7px}
  .field.full{grid-column:1/-1}
  .field label{font-size:13px;font-weight:600;color:var(--gray-700)}
  .input-wrap{position:relative}
  .input-wrap input,.input-wrap select{width:100%;height:46px;background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:10px;padding:0 14px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;color:var(--navy-dark);transition:all .2s;appearance:none;outline:none}
  .input-wrap input:focus,.input-wrap select:focus{border-color:var(--navy);background:var(--white);box-shadow:0 0 0 3px rgba(27,42,94,.08)}
  .input-wrap input.error,.input-wrap select.error,textarea.error{border-color:#EF4444}
  .field-error{font-size:11px;color:#EF4444;font-weight:500;display:none}
  .field-error.show{display:block}
  .form-actions-btn{padding:0 28px;height:46px;border-radius:10px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;font-weight:700;cursor:pointer;border:none;transition:all .2s;display:flex;align-items:center;gap:8px}
  .status-option{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1.5px solid var(--gray-200);border-radius:10px;cursor:pointer;transition:all .2s;margin-bottom:8px}
  .status-option:hover{border-color:var(--navy-light);background:var(--gray-50)}
  .status-option.selected{border-color:var(--navy);background:#E6F1FB}
  .status-option input[type=radio]{display:none}
  .status-option-text{font-size:14px;font-weight:600;color:var(--navy-dark)}
  .status-option-desc{font-size:12px;color:var(--gray-500)}
  .student-info-card{display:none;grid-column:1/-1;padding:16px;border-radius:12px;background:var(--gray-50);margin-bottom:12px}
  .student-field{display:flex;flex-direction:column;gap:4px;margin-bottom:8px;padding:10px 14px;background:var(--gray-50);border-radius:10px}
  .student-field .field-label{font-size:12px;color:var(--gray-500);font-weight:600}
  .student-field .field-value{font-size:14px;color:var(--navy-dark);font-weight:700}
  .file-upload-wrap{position:relative}
  .file-upload-wrap input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}
  .file-upload-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:var(--gray-100);border:1.5px dashed var(--gray-300);border-radius:10px;font-size:13px;color:var(--gray-700);font-weight:500;cursor:pointer;transition:all .2s}
  .file-upload-wrap:hover .file-upload-btn{border-color:var(--navy);color:var(--navy);background:var(--gray-50)}
  .file-name{font-size:12px;color:var(--gray-500);margin-top:4px}
  .history-list{max-height:400px;overflow-y:auto}
  .history-item{padding:12px;border-bottom:1px solid var(--gray-100);font-size:13px}
  .history-item:last-child{border-bottom:none}
  .badge-status-active{background:var(--green-light);color:var(--green)}
  .badge-status-graduated{background:#DBEAFE;color:#1E40AF}
  .badge-status-dismissed{background:var(--red-light);color:var(--red)}
  .badge-status-transferred{background:#FFF7ED;color:#92400E}
  .badge-status-left_housing{background:#F3E8FF;color:#6B21A8}
  .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10000;display:none;align-items:center;justify-content:center;backdrop-filter:blur(2px)}
  .modal-overlay.show{display:flex}
  .modal-box{background:var(--white);border-radius:16px;padding:28px;max-width:480px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.3)}
  .modal-icon{width:48px;height:48px;border-radius:12px;background:#FEF2F2;display:flex;align-items:center;justify-content:center;margin-bottom:16px;color:#991B1B}
  .modal-title{font-size:18px;font-weight:800;color:var(--navy-dark);margin-bottom:8px}
  .modal-body{font-size:14px;color:var(--gray-700);line-height:1.6;margin-bottom:16px}
  .modal-body strong{color:var(--navy-dark)}
  .modal-actions{display:flex;gap:10px;justify-content:flex-end}
  .modal-actions .form-actions-btn{min-width:120px;justify-content:center}
  .modal-divider{border:none;border-top:1px solid var(--gray-100);margin:12px 0}
  /* الرسالة فوق مش تحت: كانت بتظهر في آخر الشاشة والمستخدم شايف أول الصفحة
     فبتروح قبل ما يلاحظها. وبقت قابلة للضغط عشان يقفلها بنفسه. */
  .toast{position:fixed;top:24px;left:50%;transform:translateX(-50%);padding:14px 30px;border-radius:12px;font-size:14px;font-weight:600;z-index:10001;box-shadow:0 10px 30px rgba(0,0,0,.2);opacity:0;transition:opacity .3s;pointer-events:none;max-width:min(680px,92vw);text-align:center;line-height:1.7}
  .toast.show{pointer-events:auto;cursor:pointer}
  .toast.show{opacity:1}
  .toast-success{background:#0F6E56;color:#fff}
  .toast-error{background:#991B1B;color:#fff}
  @@media(max-width:768px){.form-grid{grid-template-columns:1fr}.two-col{grid-template-columns:1fr!important}.stats-grid{grid-template-columns:repeat(2,1fr)}}
</style>

<div class="page-header">
  <h2 >@SharedLocalizer["ss_pageTitle"]</h2>
  <p >@SharedLocalizer["ss_pageDesc"]</p>
</div>

@* ===== الإحصائيات — من السيرفر ===== *@
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#E6F1FB">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
    </div>
    <div class="stat-num">@Model.Total</div>
    <div class="stat-label" >@SharedLocalizer["ss_totalLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#E1F5EE">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <span class="stat-badge" style="background:#E1F5EE;color:#0F6E56" >@SharedLocalizer["ss_activeBadge"]</span>
    </div>
    <div class="stat-num">@Model.Active</div>
    <div class="stat-label" >@SharedLocalizer["ss_activeLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#DBEAFE">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E40AF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <span class="stat-badge" style="background:#DBEAFE;color:#1E40AF" >@SharedLocalizer["ss_graduatedBadge"]</span>
    </div>
    <div class="stat-num">@Model.Graduated</div>
    <div class="stat-label" >@SharedLocalizer["ss_graduatedLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#FEF2F2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#991B1B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
      </div>
      <span class="stat-badge" style="background:#FEF2F2;color:#991B1B" >@SharedLocalizer["ss_dismissedBadge"]</span>
    </div>
    <div class="stat-num">@Model.Dismissed</div>
    <div class="stat-label" >@SharedLocalizer["ss_dismissedLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#FFF7ED">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#92400E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      </div>
      <span class="stat-badge" style="background:#FFF7ED;color:#92400E" >@SharedLocalizer["ss_transferredBadge"]</span>
    </div>
    <div class="stat-num">@Model.Transferred</div>
    <div class="stat-label" >@SharedLocalizer["ss_transferredLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#F3E8FF">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B21A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </div>
      <span class="stat-badge" style="background:#F3E8FF;color:#6B21A8" >@SharedLocalizer["ss_leftHousingBadge"]</span>
    </div>
    <div class="stat-num">@Model.LeftHousing</div>
    <div class="stat-label" >@SharedLocalizer["ss_leftHousingLabel"]</div>
  </div>
</div>

@* ===== تحديث الحالة الأكاديمية + آخر التحديثات ===== *@
<div class="two-col">
  <div class="col-form">
    <div class="form-card">
      <div class="form-card-header">
        <div class="form-card-header-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="form-card-title" >@SharedLocalizer["ss_statusFormTitle"]</div>
      </div>
      <div class="form-card-body">
        <div class="form-grid">
          <div class="field full">
            <label><span >@SharedLocalizer["ss_studentNumber"]</span> <span style="color:#EF4444">*</span></label>
            <div class="input-wrap">
              <input type="text" id="studentNumber" placeholder='@(SharedLocalizer["ss_studentNumberPlaceholder"].Value)' autocomplete="off">
            </div>
            <div class="field-error" id="studentNumberError" >@SharedLocalizer["ss_studentNumberError"]</div>
          </div>

          <div class="student-info-card" id="studentInfo">
            <div class="student-field">
              <span class="field-label" >@SharedLocalizer["ss_infoStudentId"]</span>
              <span class="field-value" id="studentInfoId">--</span>
            </div>
            <div class="student-field">
              <span class="field-label" >@SharedLocalizer["ss_infoStudentName"]</span>
              <span class="field-value" id="studentInfoName">--</span>
            </div>
            <div class="student-field">
              <span class="field-label" >@SharedLocalizer["ss_infoCurrentStatus"]</span>
              <span class="field-value" id="studentInfoStatus">--</span>
            </div>
          </div>

          <div class="field full">
            <label><span >@SharedLocalizer["ss_statusType"]</span> <span style="color:#EF4444">*</span></label>
            <div id="statusOptions">
              <div class="status-option" data-value="graduated" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="graduated">
                <div>
                  <div class="status-option-text" >@SharedLocalizer["ss_status_graduated"]</div>
                  <div class="status-option-desc" >@SharedLocalizer["ss_graduatedDesc"]</div>
                </div>
              </div>
              <div class="status-option" data-value="dismissed" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="dismissed">
                <div>
                  <div class="status-option-text" >@SharedLocalizer["ss_status_dismissed"]</div>
                  <div class="status-option-desc" >@SharedLocalizer["ss_dismissedDesc"]</div>
                </div>
              </div>
              <div class="status-option" data-value="transferred" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="transferred">
                <div>
                  <div class="status-option-text" >@SharedLocalizer["ss_status_transferred"]</div>
                  <div class="status-option-desc" >@SharedLocalizer["ss_transferredDesc"]</div>
                </div>
              </div>
              <div class="status-option" data-value="left_housing" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="left_housing">
                <div>
                  <div class="status-option-text" >@SharedLocalizer["ss_status_left_housing"]</div>
                  <div class="status-option-desc" >@SharedLocalizer["ss_leftHousingDesc"]</div>
                </div>
              </div>
            </div>
            <div class="field-error" id="statusTypeError" >@SharedLocalizer["ss_statusTypeError"]</div>
          </div>

          <div class="field full">
            <label><span >@SharedLocalizer["ss_actionReason"]</span> <span style="color:#EF4444">*</span></label>
            <div class="input-wrap">
              <textarea id="notes" style="width:100%;height:100px;background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:10px;padding:12px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;color:var(--navy-dark);direction:inherit;outline:none;resize:vertical;transition:all .2s" placeholder='@(SharedLocalizer["ss_actionReasonPlaceholder"].Value)'></textarea>
            </div>
            <div class="field-error" id="notesError" >@SharedLocalizer["ss_notesError"]</div>
          </div>

          <div class="field full">
            <label >@SharedLocalizer["ss_attachDocument"]</label>
            <div class="file-upload-wrap">
              <input type="file" id="attachmentFile" accept=".pdf,.jpg,.jpeg,.png,.docx" onchange="updateFileName(this)">
              <div class="file-upload-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span >@SharedLocalizer["ss_chooseFile"]</span>
              </div>
            </div>
            <div class="file-name" id="fileName"></div>
          </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:12px">
          <button class="form-actions-btn" id="submitBtn" onclick="handleSubmit()" style="background:var(--navy);color:#fff">
            <span >@SharedLocalizer["ss_confirmAction"]</span>
          </button>
          <button class="form-actions-btn" style="background:var(--gray-100);color:var(--gray-700)" onclick="resetForm()">
            <span >@SharedLocalizer["ss_clear"]</span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="col-history">
    <div class="card">
      <div class="card-header">
        <div class="card-title" >@SharedLocalizer["ss_recentUpdates"]</div>
      </div>
      <div class="history-list" id="historyList">
        <div style="text-align:center;padding:30px;color:var(--gray-500)" >@SharedLocalizer["ss_noUpdates"]</div>
      </div>
    </div>
  </div>
</div>

@* ===== نقل السكن + سجل التنقلات ===== *@
@* قسم نقل السكن بيظهر بصلاحية housing.transfer بس — الـ API بيتحقق منها كمان *@
@if (User.HasClaim("permission", "housing.transfer"))
{
<div class="two-col">
  <div class="col-form">
    <div class="form-card">
      <div class="form-card-header">
        <div class="form-card-header-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div class="form-card-title" >@SharedLocalizer["ss_transferFormTitle"]</div>
      </div>
      <div class="form-card-body">
        <div class="form-grid">
          <div class="field full">
            <label><span >@SharedLocalizer["ss_studentNumber"]</span> <span style="color:#EF4444">*</span></label>
            <div class="input-wrap">
              <input type="text" id="transferStudentNumber" placeholder='@(SharedLocalizer["ss_studentNumberPlaceholder"].Value)' autocomplete="off">
            </div>
          </div>

          <div id="transferStudentInfo" style="display:none;grid-column:1/-1;padding:12px 16px;border-radius:10px;background:var(--gray-50)">
            <div style="font-size:13px;font-weight:600;color:var(--navy-dark)" id="transferStudentInfoText"></div>
          </div>

          <div class="field full">
            <div style="background:var(--gray-50);border-radius:10px;padding:12px 16px">
              <div style="font-size:13px;font-weight:600;color:var(--gray-700);margin-bottom:8px" >@SharedLocalizer["ss_currentHousing"]</div>
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;font-size:13px">
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["ss_currentBuilding"]</span><br><strong id="transferOldBuilding">--</strong></div>
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["reg_lblFloor"]</span><br><strong id="transferOldFloor">--</strong></div>
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["ss_currentApartment"]</span><br><strong id="transferOldApartment">--</strong></div>
                <div><span style="color:var(--gray-500);font-size:12px" >@SharedLocalizer["ss_currentRoom"]</span><br><strong id="transferOldRoom">--</strong></div>
              </div>
            </div>
          </div>

          <div class="field full">
            <div style="background:var(--green-light);border-radius:10px;padding:12px 16px">
              <div style="font-size:13px;font-weight:600;color:var(--green);margin-bottom:8px" >@SharedLocalizer["ss_newHousing"]</div>
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px">
                <div class="field" style="gap:4px">
                  <label><span >@SharedLocalizer["ss_newBuilding"]</span> <span style="color:#EF4444">*</span></label>
                  <div class="input-wrap">
                    @* المباني بتتفلتر حسب جنس الطالب بعد ما يتحمّل — نفس قاعدة شاشات التسجيل *@
                    <select id="transferNewBuilding" disabled>
                      <option value="" >@SharedLocalizer["ss_studentNumber"]</option>
                    </select>
                  </div>
                </div>
                <div class="field" style="gap:4px">
                  <label><span >@SharedLocalizer["reg_lblFloor"]</span> <span style="color:#EF4444">*</span></label>
                  <div class="input-wrap">
                    <select id="transferNewFloor">
                      <option value="" >@SharedLocalizer["reg_optSelectFloor"]</option>
                      <option value="0" >@SharedLocalizer["reg_optFloorGround"]</option>
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4">4</option>
                    </select>
                  </div>
                </div>
                <div class="field" style="gap:4px">
                  <label><span >@SharedLocalizer["ss_newApartment"]</span> <span style="color:#EF4444">*</span></label>
                  <div class="input-wrap">
                    @* الشقة بتتولّد من الدور — نفس قاعدة شاشات التسجيل (js/housing-fields.js) *@
                    <select id="transferNewApartment" disabled>
                      <option value="" >@SharedLocalizer["reg_optSelectFloorFirst"]</option>
                    </select>
                  </div>
                </div>
                <div class="field" style="gap:4px">
                  <label><span >@SharedLocalizer["ss_newRoom"]</span> <span style="color:#EF4444">*</span></label>
                  <div class="input-wrap">
                    <select id="transferNewRoom">
                      <option value="" >@SharedLocalizer["reg_optSelectRoom"]</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="field full">
            <label><span >@SharedLocalizer["ss_transferReason"]</span> <span style="color:#EF4444">*</span></label>
            <div class="input-wrap">
              <select id="transferReason">
                <option value="" >@SharedLocalizer["ss_selectDefault"]</option>
                <option value="student_request" >@SharedLocalizer["ss_reason_student_request"]</option>
                <option value="major_change" >@SharedLocalizer["ss_reason_major_change"]</option>
                <option value="housing_issue" >@SharedLocalizer["ss_reason_housing_issue"]</option>
                <option value="room_maintenance" >@SharedLocalizer["ss_reason_room_maintenance"]</option>
                <option value="admin_decision" >@SharedLocalizer["ss_reason_admin_decision"]</option>
                <option value="other" >@SharedLocalizer["ss_reason_other"]</option>
              </select>
            </div>
          </div>

          <div class="field full" id="customReasonField" style="display:none">
            <label><span >@SharedLocalizer["ss_customReason"]</span> <span style="color:#EF4444">*</span></label>
            <div class="input-wrap">
              <textarea id="transferCustomReason" style="width:100%;height:80px;background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:10px;padding:12px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;color:var(--navy-dark);direction:inherit;outline:none;resize:vertical;transition:all .2s" placeholder='@(SharedLocalizer["ss_customReasonPlaceholder"].Value)'></textarea>
            </div>
          </div>

          <div class="field full">
            <label >@SharedLocalizer["ss_attachDocument"]</label>
            <div class="file-upload-wrap">
              <input type="file" id="transferAttachmentFile" accept=".pdf,.jpg,.jpeg,.png,.docx" onchange="updateTransferFileName(this)">
              <div class="file-upload-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span >@SharedLocalizer["ss_chooseFile"]</span>
              </div>
            </div>
            <div class="file-name" id="transferFileName"></div>
          </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:12px">
          <button class="form-actions-btn" id="transferBtn" onclick="handleTransfer()" disabled style="background:var(--gray-300);color:#fff">
            <span >@SharedLocalizer["ss_transferStudent"]</span>
          </button>
          <button class="form-actions-btn" style="background:var(--gray-100);color:var(--gray-700)" onclick="resetTransferForm()">
            <span >@SharedLocalizer["ss_clear"]</span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="col-history">
    <div class="card">
      <div class="card-header">
        <div class="card-title" >@SharedLocalizer["ss_transferHistory"]</div>
      </div>
      <div class="history-list" id="transferHistoryList">
        <div style="text-align:center;padding:30px;color:var(--gray-500)" >@SharedLocalizer["ss_noTransfers"]</div>
      </div>
    </div>
  </div>
</div>
}

<div class="toast" id="toast"></div>

<div class="modal-overlay" id="confirmDialog">
  <div class="modal-box">
    <div class="modal-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div class="modal-title" >@SharedLocalizer["ss_warningTitle"]</div>
    <div class="modal-body" id="confirmBody">
      @* تحذير التعطيل بيظهر للحالات اللي بتنهي علاقة الطالب بالجامعة بس.
         «ترك الإسكان الجامعي» مابيعطّلش الحساب، فالتحذير كان بيكذب على المستخدم. *@
      <p id="confirmDisableIntro" >@SharedLocalizer["ss_disableIntro"]</p>
      <hr class="modal-divider" id="confirmDivider1">
      <p id="confirmUsernameRow"><strong >@SharedLocalizer["ss_usernameColonLabel"]</strong> <span id="confirmUsername">--</span></p>
      <p><strong >@SharedLocalizer["ss_reasonColonLabel"]</strong> <span id="confirmStatus">--</span></p>
      <hr class="modal-divider">
      <p >@SharedLocalizer["ss_proceedQuestion"]</p>
    </div>
    <div class="modal-actions">
      <button class="form-actions-btn" style="background:var(--gray-100);color:var(--gray-700)" onclick="closeConfirmDialog()" >@SharedLocalizer["ss_cancel"]</button>
      <button class="form-actions-btn" id="confirmYesBtn" onclick="executeSubmit()" style="background:#991B1B;color:#fff" >@SharedLocalizer["ss_confirmDisableYes"]</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="transferConfirmDialog">
  <div class="modal-box">
    <div class="modal-icon" style="background:#E1F5EE;color:#0F6E56">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    </div>
    <div class="modal-title" >@SharedLocalizer["ss_transferConfirmTitle"]</div>
    <div class="modal-body">
      <p >@SharedLocalizer["ss_transferConfirmIntro"]</p>
      <hr class="modal-divider">
      <p><strong >@SharedLocalizer["ss_studentColonLabel"]</strong> <span id="transferConfirmName">--</span></p>
      <p><strong >@SharedLocalizer["ss_currentHousingColonLabel"]</strong> <span id="transferConfirmOld">--</span></p>
      <p><strong >@SharedLocalizer["ss_newHousingColonLabel"]</strong> <span id="transferConfirmNew">--</span></p>
      <p><strong >@SharedLocalizer["ss_reasonShortColonLabel"]</strong> <span id="transferConfirmReason">--</span></p>
      <hr class="modal-divider">
      <p >@SharedLocalizer["ss_proceedQuestion"]</p>
    </div>
    <div class="modal-actions">
      <button class="form-actions-btn" style="background:var(--gray-100);color:var(--gray-700)" onclick="closeTransferConfirm()" >@SharedLocalizer["ss_cancel"]</button>
      <button class="form-actions-btn" id="transferConfirmYesBtn" onclick="executeTransfer()" style="background:var(--green);color:#fff" >@SharedLocalizer["ss_transferConfirmYes"]</button>
    </div>
  </div>
</div>

@section Scripts {
<script src="/i18n.js"></script>
<script src="/js/housing-fields.js"></script>
<script>
  var _toastTimer = null;
  function showToast(msg, type) {
    var el = document.getElementById('toast');
    el.textContent = msg;
    el.className = 'toast show toast-' + (type || 'success');

    // رسائل الخطأ بتشرح سبب رفض إجراء — محتاجة وقت تتقرا. النجاح تأكيد سريع.
    if (_toastTimer) clearTimeout(_toastTimer);
    _toastTimer = setTimeout(function () { el.className = 'toast'; },
                             type === 'error' ? 12000 : 3500);

    el.onclick = function () {
      if (_toastTimer) clearTimeout(_toastTimer);
      el.className = 'toast';
    };
  }

  async function apiFetch(url) {
    try {
      var res = await fetch(url, { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return null; }
      if (!res.ok) return null;
      return await res.json();
    } catch (e) { return null; }
  }

  // نص الحالة من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function getStatusLabel(v) {
    var k = 'ss_status_' + v;
    var val = t(k);
    return val === k ? (v || '') : val;
  }

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach(function (el) { el.classList.remove('show'); });
    document.querySelectorAll('.input-wrap input.error, .input-wrap select.error, textarea.error').forEach(function (el) { el.classList.remove('error'); });
  }
  function showError(id) {
    document.getElementById(id).classList.add('show');
    var input = document.getElementById(id.replace('Error', ''));
    if (input) input.classList.add('error');
  }

  function selectStatus(el) {
    document.querySelectorAll('.status-option').forEach(function (s) { s.classList.remove('selected'); });
    el.classList.add('selected');
    el.querySelector('input[type=radio]').checked = true;
  }

  function updateFileName(input) {
    document.getElementById('fileName').textContent = input.files.length > 0 ? input.files[0].name : '';
  }

  var pendingSubmitData = null;

  function closeConfirmDialog() {
    document.getElementById('confirmDialog').classList.remove('show');
    pendingSubmitData = null;
  }

  function resetForm() {
    document.getElementById('studentNumber').value = '';
    document.querySelectorAll('.status-option').forEach(function (s) { s.classList.remove('selected'); });
    document.querySelectorAll('input[name=statusType]').forEach(function (r) { r.checked = false; });
    document.getElementById('notes').value = '';
    document.getElementById('attachmentFile').value = '';
    document.getElementById('fileName').textContent = '';
    document.getElementById('studentInfo').style.display = 'none';
    document.getElementById('studentInfoId').textContent = '--';
    document.getElementById('studentInfoName').textContent = '--';
    document.getElementById('studentInfoStatus').textContent = '--';
    clearErrors();
    pendingSubmitData = null;
  }

  async function handleSubmit() {
    clearErrors();
    var studentNumber = document.getElementById('studentNumber').value.trim();
    var statusEl = document.querySelector('input[name=statusType]:checked');
    var notes = document.getElementById('notes').value.trim();
    var file = document.getElementById('attachmentFile').files[0];
    var valid = true;

    if (!studentNumber) { showError('studentNumberError'); valid = false; }
    if (!statusEl) { showError('statusTypeError'); valid = false; }
    if (!notes || notes.length < 5) { showError('notesError'); valid = false; }
    if (!valid) return;

    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').innerHTML = '<span>...</span>';

    try {
      var res = await fetch('/api/students', { headers: NUH.headers() });
      if (!res.ok) { showToast(t('ss_serverError'), 'error'); enableSubmitBtn(); return; }
      var students = await res.json();
      var student = Array.isArray(students) ? students.find(function (s) { return s.student_id === studentNumber; }) : null;
      if (!student) { showToast(t('ss_studentNotFound'), 'error'); enableSubmitBtn(); return; }

      // نفس قاعدة السيرفر (StudentStatusService): التعطيل للحالات اللي بتنهي
      // علاقة الطالب بالجامعة بس. «ترك السكن» بيسيب حساب الشبكة زي ما هو.
      var disablesAccount = ['graduated', 'dismissed', 'transferred'].indexOf(statusEl.value) > -1;

      document.getElementById('confirmUsername').textContent = student.ad_username || '--';
      document.getElementById('confirmStatus').textContent = getStatusLabel(statusEl.value);

      document.getElementById('confirmDisableIntro').style.display = disablesAccount ? '' : 'none';
      document.getElementById('confirmDivider1').style.display = disablesAccount ? '' : 'none';
      document.getElementById('confirmUsernameRow').style.display = disablesAccount ? '' : 'none';

      var yesBtn = document.getElementById('confirmYesBtn');
      yesBtn.textContent = disablesAccount ? t('ss_confirmDisableYes') : t('ss_confirmAction');
      yesBtn.style.background = disablesAccount ? '#991B1B' : 'var(--navy)';

      document.getElementById('confirmDialog').classList.add('show');

      pendingSubmitData = { studentNumber: studentNumber, statusType: statusEl.value, notes: notes, file: file };
      window._pendingStatus = pendingSubmitData;
    } catch (e) {
      showToast(t('ss_serverError'), 'error');
    } finally {
      enableSubmitBtn();
    }
  }

  function enableSubmitBtn() {
    document.getElementById('submitBtn').disabled = false;
    document.getElementById('submitBtn').innerHTML = '<span>' + t('ss_confirmAction') + '</span>';
  }

  async function executeSubmit() {
    closeConfirmDialog();
    // النسخة المحفوظة في window لأن closeConfirmDialog بيصفّر pendingSubmitData
    var data = window._pendingStatus;
    if (!data) return;
    window._pendingStatus = null;

    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').innerHTML = '<span>...</span>';

    try {
      var formData = new FormData();
      formData.append('studentNumber', data.studentNumber);
      formData.append('statusType', data.statusType);
      formData.append('notes', data.notes);
      if (data.file) formData.append('file', data.file);

      var res = await fetch('/api/student-status', {
        method: 'POST',
        headers: NUH.headers(),
        body: formData
      });

      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.status === 403) { showToast(t('ss_forbidden'), 'error'); return; }

      var result = await res.json();
      if (!res.ok) { showToast(result.message || t('ss_errorOccurred'), 'error'); return; }

      if (result.warning) showToast(result.message + '. ' + result.warning, 'error');
      else showToast(result.message || t('ss_statusSaved'), 'success');

      resetForm();
      loadHistory();
      // الأرقام فوق سيرفرية — نحدّثها بإعادة تحميل بعد ثانية علشان التوست يبان
      setTimeout(function () { location.reload(); }, 1200);
    } catch (e) {
      showToast(t('ss_serverError'), 'error');
    } finally {
      enableSubmitBtn();
    }
  }

  // نخزّن نسخة من البيانات علشان نقدر نعيد الرسم عند تغيير اللغة بدون إعادة تحميل
  var _statusHistoryData = null;
  async function loadHistory() {
    _statusHistoryData = await apiFetch('/api/student-status/recent');
    renderHistory();
  }

  function renderHistory() {
    var data = _statusHistoryData;
    var list = document.getElementById('historyList');
    if (!list) return;
    if (!data || !data.length) {
      list.innerHTML = '<div style="text-align:center;padding:30px;color:var(--gray-500)">' + t('ss_noUpdates') + '</div>';
      return;
    }
    list.innerHTML = data.map(function (a) {
      var label = getStatusLabel(a.statusType) || a.statusType;
      var badgeClass = 'badge-status-' + a.statusType;
      var dateObj = new Date(a.createdDate);
      var dateStr = dateObj.toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric' });
      var timeStr = dateObj.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
      var userName = a.createdByName || t('ss_unknown');
      return '<div class="history-item" style="display:block;padding:14px 16px;border-bottom:1px solid var(--gray-100)">' +
        '<div style="margin-bottom:8px"><span class="badge ' + badgeClass + '" style="font-size:13px;padding:4px 12px">' + escHtml(label) + '</span></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:13px;color:var(--navy-dark)">' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_studentNumber') + '</span><br><strong>' + escHtml(a.studentNumber) + '</strong></div>' +
          (a.studentName ? '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_infoStudentName') + '</span><br>' + escHtml(a.studentName) + '</div>' : '') +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_by') + '</span><br>' + escHtml(userName) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_date') + '</span><br>' + dateStr + ' ' + timeStr + '</div>' +
        '</div>' +
        (a.notes ? '<div style="margin-top:8px;padding:8px 12px;background:var(--gray-50);border-radius:8px;font-size:13px;color:var(--gray-700)"><span style="color:var(--gray-500);font-size:12px;font-weight:600">' + t('ss_notes') + '</span><br>' + escHtml(a.notes) + '</div>' : '') +
        // المستند المرفق — اتنقل من شاشة المغادرة قبل ما تتشال
        (a.attachmentFileName ? attachmentHtml('/api/student-status/' + a.id + '/attachment', a.attachmentFileName) : '') +
      '</div>';
    }).join('');
  }

  // ===== نقل السكن =====
  var transferStudentLoaded = false;
  var transferStudentData = null;

  var SS_PH = @Html.Raw(__ssHousingPh);
  // الشقة بتتولد من الدور، والغرفة 1-4 — نفس قاعدة شاشات التسجيل
  NuhHousing.attach({
    floor: 'transferNewFloor', apartment: 'transferNewApartment', room: 'transferNewRoom',
    labels: { floorFirst: SS_PH.floorFirst, selectApartment: SS_PH.selectApartment, selectRoom: SS_PH.selectRoom }
  });

  // الدور متخزّن كود ("0" = الأرضي) — بيتترجم عند العرض بس
  function floorLabel(v) {
    if (v === null || v === undefined || v === '') return '--';
    return String(v) === '0' ? SS_PH.ground : String(v);
  }

  // المباني بتتفلتر حسب جنس الطالب — من غير كده ممكن المشرف ينقل طالب لمبنى بنات.
  // احتياطي ثابت لو جدول القوائم مش متاح، بنفس التوزيع المعتمد.
  var TRANSFER_FALLBACK = { male: ['65','66','67','68','69','70'], female: ['40','41','42','43'] };

  async function loadTransferBuildings(gender) {
    var sel = document.getElementById('transferNewBuilding');
    sel.innerHTML = '';
    var ph = document.createElement('option');
    ph.value = '';
    sel.appendChild(ph);

    var g = (gender || '').toString().toLowerCase();
    if (g !== 'male' && g !== 'female') {
      ph.textContent = t('ss_studentNumber');
      sel.disabled = true;
      updateTransferBtnState();
      return;
    }

    ph.textContent = SS_PH.selectBuilding;
    sel.disabled = false;

    var items = [];
    try {
      var res = await fetch('/api/lookups/buildings?gender=' + encodeURIComponent(g), { headers: NUH.headers() });
      if (res.ok) items = await res.json();
    } catch (e) { items = []; }

    if (items && items.length) {
      items.forEach(function (b) {
        var o = document.createElement('option');
        o.value = b.code || b.Code || '';
        o.textContent = b.name || b.Name || o.value;
        sel.appendChild(o);
      });
    } else {
      (TRANSFER_FALLBACK[g] || []).forEach(function (code) {
        var o = document.createElement('option');
        o.value = code; o.textContent = code;
        sel.appendChild(o);
      });
    }
    updateTransferBtnState();
  }

  // وصف الموقع بصيغة مقروءة: «مبنى 69 · الدور 3 · شقة 15 · غرفة 3»
  // الأرقام لوحدها (69/3/15/3) مالهاش معنى لحد ما يحفظ الترتيب — الليبل بيشيل اللبس.
  var LOC_SEP = ' · ';
  function locText(b, f, a, r) {
    var parts = [];
    if (b) parts.push(t('loc_building') + ' ' + b);
    var fl = floorLabel(f);
    if (fl !== '--') parts.push(t('loc_floor') + ' ' + fl);
    if (a) parts.push(t('loc_apartment') + ' ' + a);
    if (r) parts.push(t('loc_room') + ' ' + r);
    return parts.length ? parts.join(LOC_SEP) : '--';
  }

  // ===== المرفقات =====
  // الرابط بيروح على endpoint بيتحقق من الصلاحية (مش ملف ثابت في wwwroot).
  // الصور بتتفتح في نافذة معاينة جوه الصفحة، و PDF/Word بيتفتحوا في تبويب جديد،
  // و«تحميل» بترجع الملف باسمه الأصلي.
  function isImageName(n) { return /\.(png|jpe?g|gif|webp)$/i.test(n || ''); }

  function attachmentHtml(url, name) {
    return '<div style="margin-top:8px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:12px">' +
        '<span style="color:var(--gray-500)">📎 ' + escHtml(name) + '</span>' +
        '<a href="' + escHtml(url) + '" target="_blank" rel="noopener"' +
          (isImageName(name) ? ' data-preview="' + escHtml(url) + '" data-preview-name="' + escHtml(name) + '"' : '') +
          ' style="color:var(--navy);text-decoration:underline">' + escHtml(SS_PH.preview) + '</a>' +
        '<a href="' + escHtml(url) + '?download=true" style="color:var(--navy);text-decoration:underline">' +
          escHtml(SS_PH.download) + '</a>' +
      '</div>';
  }

  // معاينة الصور جوه الصفحة — من غير ما المستخدم يسيب الشاشة
  document.addEventListener('click', function (e) {
    var link = e.target.closest ? e.target.closest('[data-preview]') : null;
    if (!link) return;
    e.preventDefault();
    showAttachmentPreview(link.getAttribute('data-preview'), link.getAttribute('data-preview-name'));
  });

  function showAttachmentPreview(url, name) {
    var overlay = document.getElementById('attPreviewOverlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'attPreviewOverlay';
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,.75);z-index:9999;' +
        'display:flex;align-items:center;justify-content:center;padding:24px';
      overlay.addEventListener('click', function (ev) { if (ev.target === overlay) closeAttachmentPreview(); });
      document.body.appendChild(overlay);
      document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') closeAttachmentPreview(); });
    }
    overlay.innerHTML =
      '<div style="background:var(--white);border-radius:14px;max-width:90vw;max-height:90vh;overflow:auto;padding:16px;display:flex;flex-direction:column;gap:12px">' +
        '<div style="display:flex;align-items:center;justify-content:space-between;gap:16px">' +
          '<strong style="font-size:14px;color:var(--navy-dark)">' + escHtml(name) + '</strong>' +
          '<div style="display:flex;gap:12px;font-size:13px">' +
            '<a href="' + escHtml(url) + '?download=true" style="color:var(--navy);text-decoration:underline">' + escHtml(SS_PH.download) + '</a>' +
            '<button type="button" id="attPreviewClose" style="border:none;background:none;cursor:pointer;color:var(--gray-500);font-size:13px">' + escHtml(SS_PH.close) + '</button>' +
          '</div>' +
        '</div>' +
        '<img src="' + escHtml(url) + '" alt="' + escHtml(name) + '" style="max-width:100%;max-height:75vh;border-radius:10px;display:block">' +
      '</div>';
    overlay.style.display = 'flex';
    var btn = document.getElementById('attPreviewClose');
    if (btn) btn.onclick = closeAttachmentPreview;
  }

  function closeAttachmentPreview() {
    var overlay = document.getElementById('attPreviewOverlay');
    if (overlay) overlay.style.display = 'none';
  }

  function updateTransferBtnState() {
    var nb = document.getElementById('transferNewBuilding').value.trim();
    var nf = document.getElementById('transferNewFloor').value;
    var na = document.getElementById('transferNewApartment').value.trim();
    var nr = document.getElementById('transferNewRoom').value.trim();
    var reason = document.getElementById('transferReason').value;
    var customReason = document.getElementById('transferCustomReason').value.trim();
    var btn = document.getElementById('transferBtn');
    var canTransfer = transferStudentLoaded && nb && nf && na && nr && reason && (reason !== 'other' || customReason.length >= 3);
    btn.disabled = !canTransfer;
    btn.style.background = canTransfer ? 'var(--navy)' : 'var(--gray-300)';
  }

  function updateTransferFileName(input) {
    document.getElementById('transferFileName').textContent = input.files.length > 0 ? input.files[0].name : '';
  }

  function resetTransferForm() {
    ['transferStudentNumber', 'transferNewBuilding', 'transferNewApartment', 'transferNewRoom', 'transferCustomReason'].forEach(function (id) {
      document.getElementById(id).value = '';
    });
    document.getElementById('transferReason').value = '';
    document.getElementById('transferAttachmentFile').value = '';
    document.getElementById('transferFileName').textContent = '';
    document.getElementById('transferStudentInfo').style.display = 'none';
    document.getElementById('customReasonField').style.display = 'none';
    document.getElementById('transferOldBuilding').textContent = '--';
    document.getElementById('transferOldFloor').textContent = '--';
    document.getElementById('transferOldApartment').textContent = '--';
    document.getElementById('transferOldRoom').textContent = '--';
    transferStudentLoaded = false;
    transferStudentData = null;
    updateTransferBtnState();
  }

  // نص سبب النقل من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function getTransferReasonLabel(v) {
    var k = 'ss_reason_' + v;
    var val = t(k);
    return val === k ? (v || '') : val;
  }

  async function handleTransfer() {
    var sn = document.getElementById('transferStudentNumber').value.trim();
    var nb = document.getElementById('transferNewBuilding').value.trim();
    var nf = document.getElementById('transferNewFloor').value;
    var na = document.getElementById('transferNewApartment').value.trim();
    var nr = document.getElementById('transferNewRoom').value.trim();
    var reason = document.getElementById('transferReason').value;
    var customReason = document.getElementById('transferCustomReason').value.trim();

    if (!transferStudentData) { showToast(t('ss_studentNotFound'), 'error'); return; }
    if (!nb || !nf || !na || !nr) { showToast(t('ss_completeNewHousing'), 'error'); return; }
    if (!reason) { showToast(t('ss_selectTransferReason'), 'error'); return; }
    if (reason === 'other' && customReason.length < 3) { showToast(t('ss_customReasonPlaceholder'), 'error'); return; }

    var student = transferStudentData;
    var oldLoc = locText(student.housing_building, student.floor_number, student.apartment_number, student.room_number);
    var newLoc = locText(nb, nf, na, nr);
    var reasonLabel = reason === 'other' ? customReason : getTransferReasonLabel(reason);

    document.getElementById('transferConfirmName').textContent = student.full_name;
    document.getElementById('transferConfirmOld').textContent = oldLoc;
    document.getElementById('transferConfirmNew').textContent = newLoc;
    document.getElementById('transferConfirmReason').textContent = reasonLabel;
    document.getElementById('transferConfirmDialog').classList.add('show');

    window._pendingTransfer = {
      studentNumber: sn, newBuilding: nb, newFloor: nf, newApartment: na, newRoom: nr,
      reason: reason, customReason: reason === 'other' ? customReason : null,
      file: document.getElementById('transferAttachmentFile').files[0]
    };
  }

  function closeTransferConfirm() {
    document.getElementById('transferConfirmDialog').classList.remove('show');
  }

  async function executeTransfer() {
    closeTransferConfirm();
    var data = window._pendingTransfer;
    if (!data) return;
    window._pendingTransfer = null;

    var btn = document.getElementById('transferBtn');
    btn.disabled = true;
    btn.innerHTML = '<span>...</span>';

    try {
      var formData = new FormData();
      formData.append('studentNumber', data.studentNumber);
      formData.append('newBuilding', data.newBuilding);
      formData.append('newFloor', data.newFloor);
      formData.append('newApartment', data.newApartment);
      formData.append('newRoom', data.newRoom);
      formData.append('reason', data.reason);
      if (data.customReason) formData.append('customReason', data.customReason);
      if (data.file) formData.append('file', data.file);

      var res = await fetch('/api/supervisor/housing-transfer', {
        method: 'POST',
        headers: NUH.headers(),
        body: formData
      });

      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.status === 403) { showToast(t('ss_forbidden'), 'error'); return; }

      var result = await res.json();
      if (!res.ok) { showToast(result.message || t('ss_errorOccurred'), 'error'); return; }

      showToast(result.message || t('ss_transferSuccess'), 'success');
      resetTransferForm();
      loadTransferHistory();
    } catch (e) {
      showToast(t('ss_serverError'), 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<span>' + t('ss_transferStudent') + '</span>';
      updateTransferBtnState();
    }
  }

  var _transferHistoryData = null;
  async function loadTransferHistory() {
    // القسم كله مخفي لو المستخدم مالوش صلاحية النقل — بلاش نداء بيرجّع 403
    if (!document.getElementById('transferHistoryList')) return;
    _transferHistoryData = await apiFetch('/api/supervisor/housing-transfer/recent');
    renderTransferHistory();
  }

  function renderTransferHistory() {
    var data = _transferHistoryData;
    var list = document.getElementById('transferHistoryList');
    if (!list) return;
    if (!data || !data.length) {
      list.innerHTML = '<div style="text-align:center;padding:30px;color:var(--gray-500)">' + t('ss_noTransfers') + '</div>';
      return;
    }
    list.innerHTML = data.map(function (x) {
      var dateObj = new Date(x.createdAt);
      var dateStr = dateObj.toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric' });
      var timeStr = dateObj.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
      var userName = x.createdByName || t('ss_unknown');
      var oldLoc = locText(x.oldBuilding, x.oldFloor, x.oldApartment, x.oldRoom);
      var newLoc = locText(x.newBuilding, x.newFloor, x.newApartment, x.newRoom);
      var reasonLabel = x.customReason || getTransferReasonLabel(x.reason);
      // الرابط القديم كان بيستخدم الاسم الأصلي للملف، والملف متخزّن على الديسك
      // باسم GUID — فكان بيطلع 404 دايمًا. بيعدّي دلوقتي من endpoint بيتحقق من
      // الصلاحية ويرجّع الملف بنوعه الصحيح.
      var attachHtml = x.originalFileName
        ? attachmentHtml('/api/supervisor/housing-transfer/' + x.id + '/attachment', x.originalFileName)
        : '';
      return '<div class="history-item" style="display:block;padding:14px 16px;border-bottom:1px solid var(--gray-100)">' +
        '<div style="margin-bottom:8px"><span class="badge badge-status-transferred" style="font-size:13px;padding:4px 12px">🏠 ' + t('ss_housingTransferBadge') + '</span></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:13px;color:var(--navy-dark)">' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_studentNumber') + '</span><br><strong>' + escHtml(x.studentNumber) + '</strong></div>' +
          (x.studentName ? '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_infoStudentName') + '</span><br>' + escHtml(x.studentName) + '</div>' : '') +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_currentHousingShort') + '</span><br>' + escHtml(oldLoc) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_newHousingShort') + '</span><br>' + escHtml(newLoc) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_by') + '</span><br>' + escHtml(userName) + '</div>' +
          '<div><span style="color:var(--gray-500);font-size:12px">' + t('ss_date') + '</span><br>' + dateStr + ' ' + timeStr + '</div>' +
        '</div>' +
        '<div style="margin-top:8px;padding:8px 12px;background:var(--gray-50);border-radius:8px;font-size:13px;color:var(--gray-700)"><span style="color:var(--gray-500);font-size:12px;font-weight:600">' + t('ss_transferReason') + '</span><br>' + escHtml(reasonLabel) + '</div>' +
        attachHtml +
      '</div>';
    }).join('');
  }

  // ===== ملء بيانات الطالب عند كتابة الرقم الجامعي =====
  document.getElementById('studentNumber').addEventListener('blur', async function () {
    var val = this.value.trim();
    if (!val) return;
    // ⚠️ كان بيسحب *كل* الطلاب من السيرفر ويدوّر فيهم هنا، على كل خروج من الخانة.
    //    مع آلاف طالب ده ميجابايتات على كل ضغطة. بقى صف واحد بالرقم الجامعي.
    var found = await apiFetch('/api/students/by-number/' + encodeURIComponent(val));
    var info = document.getElementById('studentInfo');
    if (found) {
      var st = (found.student_status || 'active');
      var badgeClass = 'badge-status-' + st;
      document.getElementById('studentInfoId').textContent = found.student_id;
      document.getElementById('studentInfoName').textContent = found.full_name;
      document.getElementById('studentInfoStatus').innerHTML = '<span class="badge ' + badgeClass + '">' + getStatusLabel(st) + '</span>';
      info.style.display = 'block';
      info.style.background = '';
    } else {
      document.getElementById('studentInfoId').textContent = '✗ ' + t('ss_studentNotFound');
      document.getElementById('studentInfoName').textContent = '';
      document.getElementById('studentInfoStatus').textContent = '';
      info.style.display = 'block';
      info.style.background = '#FEF2F2';
    }
  });

  document.getElementById('transferStudentNumber').addEventListener('blur', async function () {
    var val = this.value.trim();
    transferStudentLoaded = false;
    transferStudentData = null;
    updateTransferBtnState();
    if (!val) return;
    // ⚠️ كان بيسحب *كل* الطلاب من السيرفر ويدوّر فيهم هنا، على كل خروج من الخانة.
    //    مع آلاف طالب ده ميجابايتات على كل ضغطة. بقى صف واحد بالرقم الجامعي.
    var found = await apiFetch('/api/students/by-number/' + encodeURIComponent(val));
    var info = document.getElementById('transferStudentInfo');
    var text = document.getElementById('transferStudentInfoText');
    if (found) {
      transferStudentLoaded = true;
      transferStudentData = found;
      text.textContent = '✓ ' + found.full_name + ' — ' + found.student_id;
      info.style.display = 'block';
      info.style.background = '';
      document.getElementById('transferOldBuilding').textContent = found.housing_building || '--';
      document.getElementById('transferOldFloor').textContent = floorLabel(found.floor_number);
      await loadTransferBuildings(found.gender);
      document.getElementById('transferOldApartment').textContent = found.apartment_number || '--';
      document.getElementById('transferOldRoom').textContent = found.room_number || '--';
    } else {
      text.textContent = '✗ ' + t('ss_studentNotFound');
      info.style.display = 'block';
      info.style.background = '#FEF2F2';
      await loadTransferBuildings(null);
    }
    updateTransferBtnState();
  });

  ['transferCustomReason'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', updateTransferBtnState);
  });
  // المبنى والدور والشقة والغرفة كلهم قوائم — الحدث بتاعها change مش input
  ['transferNewBuilding', 'transferNewFloor', 'transferNewApartment', 'transferNewRoom'].forEach(function (id) {
    document.getElementById(id).addEventListener('change', updateTransferBtnState);
  });
  document.getElementById('transferReason').addEventListener('change', function () {
    document.getElementById('customReasonField').style.display = this.value === 'other' ? 'block' : 'none';
    updateTransferBtnState();
  });

  // السجلين بيتحمّلوا على طول وبالتوازي.
  // قبل كده كانت الصفحة بتنادي /api/users الأول عشان تجيب أسماء المستخدمين،
  // وده نداء مقفول على المشرف (users.view للأدمن بس) — يعني كانت بتستنى رد 403
  // قبل ما تبدأ تحمّل أي سجل. الأسماء بقت بترجع من السيرفر مع الصفوف نفسها
  // (createdByName)، فالنداء ده اتشال خالص.
  loadHistory();
  loadTransferHistory();

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم عناصر الترجمة وبيستدعي onLanguageChange لإعادة رسم السجلات من الكاش
  window.onLanguageChange = function () {
    renderHistory();
    renderTransferHistory();
  };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
</script>
}
