@model NUH_PORTAL.DTOs.StudentStatus.StudentStatusStatsDto
@{
    ViewData["Title"] = SharedLocalizer["Page_StudentStatus"].Value;

    // النصوص بتتسلسل JSON عشان Razor بيهرّب أي نص بيطبعه ترميز HTML حتى جوه script
    var __ssHousingPh = System.Text.Json.JsonSerializer.Serialize(new
    {
        floorFirst = SharedLocalizer["reg_optSelectFloorFirst"].Value,
        selectApartment = SharedLocalizer["reg_optSelectApartment"].Value,
        selectRoom = SharedLocalizer["reg_optSelectRoom"].Value,
        selectBuilding = SharedLocalizer["reg_optSelectBuilding"].Value,
        ground = SharedLocalizer["reg_optFloorGround"].Value,
        preview = SharedLocalizer["att_preview"].Value,
        download = SharedLocalizer["att_download"].Value,
        close = SharedLocalizer["att_close"].Value
    });
}

<style>
  /* خاص بصفحة حالة الطالب فقط — الباقي من site.css */
  /* ⚠️ بطاقة المؤشّر اتنقلت لـ css/components.css - كانت مكتوبة هنا وفي
     الصفحة الرئيسية بمقاسين مختلفين لنفس المكوّن. والشارة (.stat-badge)
     اتشالت خالص: كانت بتكرّر الليبل تحتها بالحرف («نشط» فوق «عدد النشطين»). */
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
  .two-col .col-form{min-width:0}
  .two-col .col-history{min-width:0}
  /* ⚠️ تعريفات .form-card* اتشالت من هنا — كانت مكرّرة حرفيًا في أربع شاشات.
     مكانها الآن wwwroot/css/site.css مرة واحدة، فأي تغيير في الشكل يوصلها كلها. */
  .form-actions-btn{padding:0 28px;height:46px;border-radius:10px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;font-weight:700;cursor:pointer;border:none;transition:all .2s;display:flex;align-items:center;gap:8px}
  .status-option{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1.5px solid var(--gray-200);border-radius:10px;cursor:pointer;transition:all .2s;margin-bottom:8px}
  .status-option:hover{border-color:var(--navy-light);background:var(--row-hover)}
  .status-option.selected{border-color:var(--navy);background:var(--green-light)}
  .status-option input[type=radio]{display:none}
  .status-option-text{font-size:14px;font-weight:600;color:var(--navy-dark)}
  .status-option-desc{font-size:12px;color:var(--gray-500)}
  .student-info-card{display:none;grid-column:1/-1;padding:16px;border-radius:12px;background:var(--gray-50);margin-bottom:12px}
  .student-field{display:flex;flex-direction:column;gap:4px;margin-bottom:8px;padding:10px 14px;background:var(--gray-50);border-radius:10px}
  .student-field .field-label{font-size:12px;color:var(--gray-500);font-weight:600}
  .student-field .field-value{font-size:14px;color:var(--navy-dark);font-weight:700}
  .file-upload-wrap{position:relative}
  .file-upload-wrap input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}
  .file-upload-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:var(--gray-100);border:1.5px dashed var(--gray-300);border-radius:10px;font-size:13px;color:var(--gray-700);font-weight:500;cursor:pointer;transition:all .2s}
  .file-upload-wrap:hover .file-upload-btn{border-color:var(--navy);color:var(--navy);background:var(--gray-50)}
  .file-name{font-size:12px;color:var(--gray-500);margin-top:4px}
  /* ⚠️ الارتفاع كان ثابتًا 400px بينما عمود النموذج يمتدّ مع محتواه لأكثر من
     الضعف: فيبقى تحت بطاقة السجل فراغ أبيض، ويُقصّ آخر صفّ في منتصفه.
     الآن العمودان يتمدّدان معًا (stretch) والبطاقة عمود مرن، فتنتهي حيث تنتهي
     جارتها بالضبط ويحدث التمرير داخل القائمة وحدها. */
  /* ⚠️ البطاقة موضوعة absolute داخل عمودها عمدًا - وهذا هو بيت القصيد:
     في الشبكة، ارتفاع الصف = ارتفاع أطول عمود. فلو ساهم السجل بمحتواه كاملًا
     (٥٠ صفًّا) لمطّ الصفحة كلها وترك تحت النموذج فراغًا هائلًا - وهو ما حدث
     في محاولتي الأولى. العنصر المطلق لا يساهم في ارتفاع الصف إطلاقًا، فيصير
     الارتفاع من النموذج وحده وتملأ البطاقة ما تُعطاه بالضبط.
     وقبله كان max-height:400px ثابتًا فيحدث العكس: فراغ تحت السجل وصفٌّ مقطوع. */
  .two-col{align-items:stretch}
  .two-col .col-history{position:relative;min-height:340px}
  .two-col .col-history > .card{position:absolute;inset:0;display:flex;flex-direction:column;min-height:0}
  .history-list{flex:1;overflow-y:auto;min-height:0}
  /* على الشاشات الصغيرة العمودان فوق بعض ولا يوجد جار يُحاذى، فيعود التدفّق
     الطبيعي بارتفاع مريح - المطلق هناك يقصّ المحتوى بلا سبب. */
  @@media(max-width:768px){
    .two-col .col-history{position:static;min-height:0}
    .two-col .col-history > .card{position:static;inset:auto}
    .history-list{flex:none;max-height:420px}
  }
  .history-more{padding:10px;text-align:center;border-top:1px solid var(--gray-100);
    background:#f3fcf6;color:var(--navy);font-size:13px;font-weight:700;cursor:pointer;
    font-family:'IBM Plex Sans Arabic',sans-serif;border-inline:none;border-bottom:none;width:100%}
  .history-more:hover{background:var(--green-light)}
  .history-more:disabled{color:var(--gray-500);background:var(--gray-50);cursor:default}
  /* حدث نظام لا قرار موظف - رمادي محايد، والأحمر يبقى لقرارات الفصل */
  .badge-status-ad_provisioning{background:var(--gray-100);color:var(--gray-700)}
  /* ⚠️ .form-card عليها margin-bottom:20px من components.css، فارتفاع عمود
     النموذج = البطاقة + ٢٠. وبطاقة السجل تملأ العمود كاملًا (inset:0)، فتظهر
     أطول من جارتها بعشرين بكسلًا بالضبط - وهو «الأطول بسنة» الذي رأيته.
     نُلغي الهامش داخل هذا التخطيط وحده؛ المسافة بين القسمين تأتي من .two-col. */
  .two-col .col-form > .form-card{margin-bottom:0}

  /* ⚠️ كل سجل كيان مستقل: حدّ وظلّ ومسافة. كان خطًّا رفيعًا واحدًا بلون قريب
     من الخلفية بين كتل نصّ متطابقة الشكل، فتسيح السجلات في بعضها.
     والحافة الملوّنة تقول نوع الإجراء قبل قراءة كلمة - وهي بألوان الشارة
     نفسها فوقها، فلا لغة ألوان ثانية تُحفظ. */
  .history-list{padding:10px}
  .history-item{position:relative;overflow:hidden;background:var(--white);
    border:1px solid var(--gray-200);border-radius:10px;padding:12px 14px;
    margin-bottom:8px;font-size:13px;box-shadow:0 1px 2px rgba(16,70,49,.04)}
  .history-item:last-child{margin-bottom:0;border-bottom:1px solid var(--gray-200)}
  .history-item::before{content:'';position:absolute;inset-inline-start:0;top:0;bottom:0;
    width:4px;background:var(--gray-300)}
  /* نفس تقسيم ألوان الشارات أدناه - مصدر لوني واحد للاثنين */
  .history-item[data-type="dismissed"]::before{background:var(--red)}
  .history-item[data-type="graduated"]::before{background:#175cd3}
  .history-item[data-type="transferred"]::before{background:var(--gold)}
  .history-item[data-type="left_housing"]::before{background:var(--purple)}
  .history-item[data-type="active"]::before{background:var(--green)}
  .history-item[data-type="ad_provisioning"]::before{background:var(--gray-300)}
  .badge-status-active{background:var(--green-light);color:var(--green)}
  .badge-status-graduated{background:var(--blue-pale);color:#175cd3}
  .badge-status-dismissed{background:var(--red-light);color:var(--red)}
  .badge-status-transferred{background:#fffaeb;color:#93370d}
  .badge-status-left_housing{background:var(--purple-light);color:var(--purple)}
  .badge-status-other{background:var(--gray-100);color:var(--gray-700)}
  /* ⚠️ ستايل الحوار المبني بالإيد اتشال: شكل الحوار كله بقى من js/dialog.js
     (NuhDialog). كان هنا غلاف بـ z-index 10000 - أعلى من أي حوار تاني في
     النظام - وصندوق وأيقونة وعنوان وأزرار، كلها نسخة موازية للمكوّن. */
  /* الرسالة فوق مش تحت: كانت بتظهر في آخر الشاشة والمستخدم شايف أول الصفحة
     فبتروح قبل ما يلاحظها. وبقت قابلة للضغط عشان يقفلها بنفسه. */
  .toast{position:fixed;top:24px;left:50%;transform:translateX(-50%);padding:14px 30px;border-radius:12px;font-size:14px;font-weight:600;z-index:10001;box-shadow:0 10px 30px rgba(0,0,0,.2);opacity:0;transition:opacity .3s;pointer-events:none;max-width:min(680px,92vw);text-align:center;line-height:1.7}
  .toast.show{pointer-events:auto;cursor:pointer}
  .toast.show{opacity:1}
  .toast-success{background:#067647;color:#fff}
  .toast-error{background:#b42318;color:#fff}
  @@media(max-width:768px){.two-col{grid-template-columns:1fr!important}.stats-grid{grid-template-columns:repeat(2,1fr)}}
</style>

<div class="page-header">
  <h2 >@SharedLocalizer["ss_pageTitle"]</h2>
  <p >@SharedLocalizer["ss_pageDesc"]</p>
</div>

@* ===== الإحصائيات — من السيرفر ===== *@
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
    <div class="stat-num">@Model.Total</div>
    <div class="stat-label" >@SharedLocalizer["ss_totalLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
    <div class="stat-num">@Model.Active</div>
    <div class="stat-label" >@SharedLocalizer["ss_activeLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
    <div class="stat-num">@Model.Graduated</div>
    <div class="stat-label" >@SharedLocalizer["ss_graduatedLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
    <div class="stat-num">@Model.Dismissed</div>
    <div class="stat-label" >@SharedLocalizer["ss_dismissedLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></div>
    <div class="stat-num">@Model.Transferred</div>
    <div class="stat-label" >@SharedLocalizer["ss_transferredLabel"]</div>
  </div>
  <div class="stat-card">
    <div class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
    <div class="stat-num">@Model.LeftHousing</div>
    <div class="stat-label" >@SharedLocalizer["ss_leftHousingLabel"]</div>
  </div>
</div>

@* ===== تحديث الحالة الأكاديمية + آخر التحديثات ===== *@
<div class="two-col">
  <div class="col-form">
    <div class="form-card">
      <div class="form-card-header">
        <div class="form-card-header-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="form-card-title" >@SharedLocalizer["ss_statusFormTitle"]</div>
      </div>
      <div class="form-card-body">
        <div class="form-grid">
          <div class="field full">
            <label for="studentNumber"><span >@SharedLocalizer["ss_studentNumber"]</span> <span style="color:#d92d20">*</span></label>
            <div class="input-wrap">
              <input type="text" id="studentNumber" autocomplete="off">
            </div>
            <div class="field-error" id="studentNumberError" >@SharedLocalizer["ss_studentNumberError"]</div>
          </div>

          <div class="student-info-card" id="studentInfo">
            <div class="student-field">
              <span class="field-label" >@SharedLocalizer["ss_infoStudentId"]</span>
              <span class="field-value" id="studentInfoId">--</span>
            </div>
            <div class="student-field">
              <span class="field-label" >@SharedLocalizer["ss_infoStudentName"]</span>
              <span class="field-value" id="studentInfoName">--</span>
            </div>
            <div class="student-field">
              <span class="field-label" >@SharedLocalizer["ss_infoCurrentStatus"]</span>
              <span class="field-value" id="studentInfoStatus">--</span>
            </div>
          </div>

          <div class="field full">
            @* ⚠️ عنوان مجموعة اختيارات لا تسمية حقل واحد: خمس خيارات لا حقل
               واحد يتربط بيه، فـ role="radiogroup" + aria-labelledby عشان
               قارئ الشاشة يقول «نوع الحالة - ١ من ٥» بدل ما يقرا الخيارات
               مفكوكة بلا عنوان. *@
            <label id="ssStatusTypeLbl"><span >@SharedLocalizer["ss_statusType"]</span> <span style="color:#d92d20">*</span></label>
            <div id="statusOptions" role="radiogroup" aria-labelledby="ssStatusTypeLbl">
              <div class="status-option" data-value="graduated" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="graduated" id="st_graduated" aria-labelledby="stt_graduated std_graduated">
                <div>
                  <div class="status-option-text" id="stt_graduated">@SharedLocalizer["ss_status_graduated"]</div>
                  <div class="status-option-desc" id="std_graduated">@SharedLocalizer["ss_graduatedDesc"]</div>
                </div>
              </div>
              <div class="status-option" data-value="dismissed" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="dismissed" id="st_dismissed" aria-labelledby="stt_dismissed std_dismissed">
                <div>
                  <div class="status-option-text" id="stt_dismissed">@SharedLocalizer["ss_status_dismissed"]</div>
                  <div class="status-option-desc" id="std_dismissed">@SharedLocalizer["ss_dismissedDesc"]</div>
                </div>
              </div>
              <div class="status-option" data-value="transferred" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="transferred" id="st_transferred" aria-labelledby="stt_transferred std_transferred">
                <div>
                  <div class="status-option-text" id="stt_transferred">@SharedLocalizer["ss_status_transferred"]</div>
                  <div class="status-option-desc" id="std_transferred">@SharedLocalizer["ss_transferredDesc"]</div>
                </div>
              </div>
              <div class="status-option" data-value="left_housing" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="left_housing" id="st_left_housing" aria-labelledby="stt_left_housing std_left_housing">
                <div>
                  <div class="status-option-text" id="stt_left_housing">@SharedLocalizer["ss_status_left_housing"]</div>
                  <div class="status-option-desc" id="std_left_housing">@SharedLocalizer["ss_leftHousingDesc"]</div>
                </div>
              </div>
              @* ⚠️ «أخرى» مقصود إنها آخر بند: الاختيار الافتراضي لازم يكون البند
                 المحدّد مش العام، وإلا المشرف ياخد الأسهل ويبقى عندنا نص السجل
                 «أخرى». وسبب الإجراء إجباري أصلًا فالتفاصيل بتتكتب فيه. *@
              <div class="status-option" data-value="other" onclick="selectStatus(this)">
                <input type="radio" name="statusType" value="other" id="st_other" aria-labelledby="stt_other std_other">
                <div>
                  <div class="status-option-text" id="stt_other">@SharedLocalizer["ss_status_other"]</div>
                  <div class="status-option-desc" id="std_other">@SharedLocalizer["ss_otherDesc"]</div>
                </div>
              </div>
            </div>
            <div class="field-error" id="statusTypeError" >@SharedLocalizer["ss_statusTypeError"]</div>
          </div>

          <div class="field full">
            <label for="notes"><span >@SharedLocalizer["ss_actionReason"]</span> <span style="color:#d92d20">*</span></label>
            <div class="input-wrap">
              <textarea id="notes" style="width:100%;height:100px;background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:10px;padding:12px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;color:var(--navy-dark);direction:inherit;outline:none;resize:vertical;transition:all .2s" placeholder='@(SharedLocalizer["ss_actionReasonPlaceholder"].Value)'></textarea>
            </div>
            <div class="field-error" id="notesError" >@SharedLocalizer["ss_notesError"]</div>
          </div>

          <div class="field full">
            <label for="attachmentFile">@SharedLocalizer["ss_attachDocument"]</label>
            <div class="file-upload-wrap">
              <input type="file" id="attachmentFile" accept=".pdf,.jpg,.jpeg,.png,.docx" onchange="onFilePicked(this, 'fileName')">
              <div class="file-upload-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span >@SharedLocalizer["ss_chooseFile"]</span>
              </div>
            </div>
            <div class="file-name" id="fileName"></div>
          </div>
        </div>

        <div style="margin-top:24px;display:flex;gap:12px">
          <button class="form-actions-btn" id="submitBtn" onclick="handleSubmit()" style="background:var(--navy);color:#fff">
            <span >@SharedLocalizer["ss_confirmAction"]</span>
          </button>
          <button class="form-actions-btn" style="background:var(--gray-100);color:var(--gray-700)" onclick="resetForm()">
            <span >@SharedLocalizer["ss_clear"]</span>
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="col-history">
    <div class="card">
      <div class="card-header">
        <div class="card-title" >@SharedLocalizer["ss_recentUpdates"]</div>
      </div>
      <div class="history-list" id="historyList">
        <div style="text-align:center;padding:30px;color:var(--gray-500)" >@SharedLocalizer["ss_noUpdates"]</div>
      </div>
      @* ⚠️ القائمة كانت تجلب ٥٠ صفًّا وتقف بلا أي إشارة - تبدو كاملة وهي ليست
         كذلك. الزرّ يجلب الخمسين التالية ويختفي عند النهاية الحقيقية. *@
      <button type="button" class="history-more" id="historyMore" style="display:none">@SharedLocalizer["ss_loadMore"]</button>
    </div>
  </div>
</div>

@* ===== نقل السكن + سجل التنقلات ===== *@
@* قسم نقل السكن بيظهر بصلاحية housing.transfer بس — الـ API بيتحقق منها كمان *@
@if (User.HasClaim("permission", "housing.transfer"))
{
<div class="two-col">
  <div class="col-form">
    <div class="form-card">
      <div class="form-card-header">
        <div class="form-card-header-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div class="form-card-title" >@SharedLocalizer["ss_transferFormTitle"]</div>
      </div>
      <div class="form-card-body">
        <div class="form-grid">
          <div class="field full">
            <label for="transferStudentNumber"><span >@SharedLocalizer["ss_studentNumber"]</span> <span style="color:#d92d20">*</span></label>
            <div class="input-wrap">
              <input type="text" id="transferStudentNumber" autocomplete="off">
            </div>
