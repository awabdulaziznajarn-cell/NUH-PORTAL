</div>

<div class="modal-overlay" id="adSearchModal">
  <div class="modal" style="max-width:800px">
    <div class="modal-header">
      <h3 >@SharedLocalizer["hs_adSearchTitle"]</h3>
      <button class="modal-close" onclick="closeModal('adSearchModal')" aria-label="@SharedLocalizer["close"]"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="modal-body">
      <div style="display:flex;gap:8px;margin-bottom:16px">
        <input type="text" id="adSearchInput" style="flex:1;padding:8px 12px;border:1px solid var(--gray-300);border-radius:8px;font-family:inherit;font-size:13px" placeholder='@(SharedLocalizer["hs_searchPlaceholder"].Value)'>
        <button class="hbtn" style="background:var(--navy);color:#fff" onclick="performADSearch()" >@SharedLocalizer["hs_search"]</button>
      </div>
      <div id="adSearchResults"></div>
    </div>
    <div class="modal-footer">
      <button class="hbtn btn-outline" onclick="closeModal('adSearchModal')" >@SharedLocalizer["hs_close"]</button>
    </div>
  </div>
</div>

@section Scripts {
<script>
  // ==========================================================================
  //  طيّ لوحة الدليل النشط.
  //
  //  ⚠️ مطوية افتراضيًا: تحديث الحالات وربط الحسابات إجراءات بتتعمل مرة كل
  //     فترة، مش شغل يومي — وكانت واخدة تلت الشاشة الأولى فوق الجدول اللي
  //     الموظف بيفتح الصفحة عشانه.
  //
  //  ⚠️ واختيار الموظف بيتحفظ: اللي بيشتغل على المزامنة بيفتحها كل يوم،
  //     ومش منطقي يطويها له النظام في كل مرة.
  // ==========================================================================
  (function () {
    var panel = document.getElementById('adPanel');
    if (!panel) return;                       // مفيش صلاحية housing.syncAd
    var head = document.getElementById('adPanelToggle');
    var KEY = 'nuhAdPanelOpen';

    function set(open) {
      panel.classList.toggle('is-open', open);
      head.setAttribute('aria-expanded', open ? 'true' : 'false');
      try { localStorage.setItem(KEY, open ? '1' : '0'); } catch (e) { }
    }

    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) { }
    set(saved === '1');

    head.addEventListener('click', function () {
      set(!panel.classList.contains('is-open'));
    });
  })();

  // نصوص لوحة المزامنة (من SharedResource) — L.key
  var L = @Html.Raw(__hmL);

  // housing-management.js القديم بيعتمد على i18n و token من التخزين — بنوفرهم بنفس الأسماء
  // اللغة من نفس مصدر ثقافة السيرفر (اللياوت بيزامن localStorage مع الكوكي)
  var currentLang = localStorage.getItem('uiLanguage') || 'ar';

  // ===== المزامنة مع الأكتف دايركتوري =====
  // كل العمليات هنا *قراءة* من الدومين وكتابة في قاعدة بيانات النظام بس.
  // مفيش إنشاء ولا تعطيل ولا تعديل على أي حساب في الأكتف دايركتوري.

  async function adPost(url) {
    var res = await fetch(url, { method: 'POST', credentials: 'same-origin' });
    if (!res.ok) {
      var err = {};
      try { err = await res.json(); } catch (e) { }
      throw new Error(err.message || L.actionFailed);
    }
    return await res.json();
  }

  // بنغيّر نص الزر بس ونسيب الأيقونة مكانها (بتلف أثناء الانتظار)،
  // بدل ما نستبدل محتوى الزر كله فتختفي.
  function adBusy(btn, text) {
    var label = btn.querySelector('span');
    if (label) {
      btn.dataset.original = label.textContent;
      label.textContent = text;
    }
    btn.classList.add('is-busy');
    btn.disabled = true;
  }

  function adDone(btn) {
    var label = btn.querySelector('span');
    if (label && btn.dataset.original) label.textContent = btn.dataset.original;
    btn.classList.remove('is-busy');
    btn.disabled = false;
  }

  // ---- عرض نتيجة المزامنة في نافذة الصفحة بدل alert() ----
  function adStat(value, label, warn) {
    return '<div class="sync-stat' + (warn && value > 0 ? ' warn' : '') + '">' +
             '<div class="v">' + value + '</div><div class="l">' + label + '</div>' +
           '</div>';
  }

  // قائمة مختصرة: أول 15 صف والباقي بيتلخّص في سطر واحد
  function adRows(items, render, limit) {
    limit = limit || 15;
    var html = '<div class="sync-list">';
    items.slice(0, limit).forEach(function (x) { html += '<div class="row">' + render(x) + '</div>'; });
    if (items.length > limit)
      html += '<div class="more">… ' + (items.length - limit) + ' ' + L.andOthers + '</div>';
    return html + '</div>';
  }

  function showSyncModal(title, bodyHtml, footerHtml) {
    document.getElementById('adSyncTitle').textContent = title;
    document.getElementById('adSyncBody').innerHTML = bodyHtml;
    document.getElementById('adSyncFooter').innerHTML = footerHtml ||
      '<button class="hbtn btn-outline" onclick="closeModal(\'adSyncModal\')">' + L.close + '</button>';
    openModal('adSyncModal');
  }

  function syncErrorBlock(r) {
    return r.error ? '<div class="sync-note danger"><strong>' + L.adError + '</strong> ' + escHtml(r.error) + '</div>' : '';
  }

  // ---- تحديث الحالات: بيقرا حالة المربوطين بالفعل بس ----
  async function refreshAdStatuses() {
    var btn = document.getElementById('adRefreshBtn');
    adBusy(btn, L.busyRefresh);
    try {
      var r = await adPost('/api/HousingAccountManagement/refresh-status');

      var html = syncErrorBlock(r) +
        '<div class="sync-stats">' +
          adStat(r.scanned, L.statScanned) +
          adStat(r.statusChanged, L.statChanged) +
          adStat(r.notFound, L.statNotFound, true) +
          adStat(r.failed, L.statFailed, true) +
        '</div>';

      if (r.statusChanged > 0) {
        html += '<div class="sync-section"><h4>' + L.secChanged + '</h4>' +
          '<div class="sync-note info">' + escHtml(L.noteChanged) + '</div>' +
          adRows(r.statusChanges || [], function (c) {
            return '<span class="id">' + escHtml(c.studentId) + '</span>' +
                   '<span>' + escHtml(c.fullName || '') + '</span>' +
                   '<span class="muted">' + escHtml(c.from) + ' ← <strong>' + escHtml(c.to) + '</strong></span>';
          }) + '</div>';
      }

      if (r.notFound > 0) {
        html += '<div class="sync-section"><h4>' + L.secOrphan + '</h4>' +
          '<div class="sync-note danger">' + escHtml(L.noteOrphan) + '</div>' +
          adRows(r.notFoundStudents || [], function (x) {
            return '<span class="id">' + escHtml(x.studentId) + '</span>' +
                   '<span>' + escHtml(x.fullName || '') + '</span>' +
                   '<span class="muted" style="direction:ltr">' + escHtml(x.expectedAccount || '') + '</span>';
          }) + '</div>';
      }

      showSyncModal(L.refreshResult, html);
      loadAccounts();
    } catch (e) {
      showSyncModal(L.refreshFailed, '<div class="sync-note danger">' + escHtml(e.message || L.serverError) + '</div>');
    } finally {
      adDone(btn);
    }
  }

  // ---- ربط الحسابات الجديدة: معاينة الأول، والحفظ بموافقة صريحة ----
  // ⚠️ الربط الغلط مش بيبان فورًا: بيظهر بعد شهور لما «تخرّج» يعطّل حساب شخص
  //    تاني. عشان كده المعاينة إجبارية، وأي اسم في الدومين مالوش أي كلمة مشتركة
  //    مع اسم الطالب عندنا بيتعرض كتحذير قبل ما المسؤول يوافق.
  async function linkExistingAdAccounts() {
    var btn = document.getElementById('adLinkBtn');
    adBusy(btn, L.busyPreview);
    try {
      var p = await adPost('/api/HousingAccountManagement/link-existing?dryRun=true');

      var html = '<div class="sync-note info"><strong>' + L.previewOnly + '</strong> ' + escHtml(L.nothingSaved) + '</div>' +
        syncErrorBlock(p) +
        '<div class="sync-stats">' +
          adStat(p.scanned, L.statUnlinked) +
          adStat(p.linked, L.statWillLink) +
          adStat(p.notFound, L.statNoAccount) +
          adStat(p.failed, L.statFailed, true) +
        '</div>';

      if (p.nameMismatches && p.nameMismatches.length) {
        html += '<div class="sync-section"><h4>⚠️ ' + L.secMismatch + ' (' + p.nameMismatches.length + ')</h4>' +
          '<div class="sync-note danger">' + escHtml(L.noteMismatch) + '</div>' +
          adRows(p.nameMismatches, function (m) {
            return '<span class="id">' + escHtml(m.studentId) + '</span>' +
                   '<span>' + L.colSystem + ' ' + escHtml(m.systemName || '-') + '</span>' +
                   '<span class="muted">' + L.colDirectory + ' ' + escHtml(m.directoryName || '-') + '</span>';
          }) + '</div>';
      }

      if (p.notFoundStudents && p.notFoundStudents.length) {
        html += '<div class="sync-section"><h4>' + L.secNoAccount + '</h4>' +
          adRows(p.notFoundStudents, function (x) {
            return '<span class="id">' + escHtml(x.studentId) + '</span>' +
                   '<span>' + escHtml(x.fullName || '') + '</span>' +
                   '<span class="muted" style="direction:ltr">' + escHtml(x.expectedAccount || '') + '</span>';
          }) + '</div>';
      }

      var footer = p.linked > 0
        ? '<button class="hbtn btn-outline" onclick="closeModal(\'adSyncModal\')">' + L.cancel + '</button>' +
          '<button class="hbtn" style="background:var(--navy);color:#fff" onclick="confirmAdLink()">' + L.runLink + ' (' + p.linked + ')</button>'
        : null;

      showSyncModal(L.previewTitle, html, footer);
    } catch (e) {
      showSyncModal(L.previewFailed, '<div class="sync-note danger">' + escHtml(e.message || L.serverError) + '</div>');
    } finally {
      adDone(btn);
    }
  }

  // التنفيذ الفعلي بعد موافقة المسؤول على المعاينة
  async function confirmAdLink() {
    var footer = document.getElementById('adSyncFooter');
    footer.innerHTML = '<span style="color:var(--gray-500);font-size:13px">' + L.busyLink + '</span>';
    try {
      var r = await adPost('/api/HousingAccountManagement/link-existing?dryRun=false');
      var html = syncErrorBlock(r) +
        '<div class="sync-stats">' +
          adStat(r.linked, L.statLinked) +
          adStat(r.notFound, L.statNoAcc) +
          adStat(r.failed, L.statFailed, true) +
        '</div>';
      showSyncModal(L.linkDone, html);
      loadAccounts();
    } catch (e) {
      showSyncModal(L.linkFailed, '<div class="sync-note danger">' + escHtml(e.message || L.serverError) + '</div>');
    }
  }
</script>
<script src="/i18n.js"></script>
@* صلاحيات المستخدم للواجهة — الفحص الحقيقي على السيرفر في كل نداء *@
<script>window.NUH_PERMS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    User.FindAll("permission").Select(c => c.Value).ToArray()));</script>
<script src="/housing-management.js"></script>
}
