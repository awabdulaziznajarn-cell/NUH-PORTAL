@{
    ViewData["Title"] = SharedLocalizer["Page_Housing"].Value;

    // نصوص لوحة المزامنة — بتتسلسل JSON لأن Razor بيهرّب أي نص بيطبعه ترميز HTML
    // حتى جوه <script>. نفس أسلوب باقي الشاشات (StudentStatus مثلًا).
    var __hmL = System.Text.Json.JsonSerializer.Serialize(new
    {
        close        = SharedLocalizer["hm_close"].Value,
        cancel       = SharedLocalizer["hm_cancel"].Value,
        andOthers    = SharedLocalizer["hm_andOthers"].Value,
        adError      = SharedLocalizer["hm_adError"].Value,
        serverError  = SharedLocalizer["hm_serverError"].Value,
        actionFailed = SharedLocalizer["hm_actionFailed"].Value,
        busyRefresh  = SharedLocalizer["hm_busyRefresh"].Value,
        busyPreview  = SharedLocalizer["hm_busyPreview"].Value,
        busyLink     = SharedLocalizer["hm_busyLink"].Value,
        statScanned  = SharedLocalizer["hm_statScanned"].Value,
        statChanged  = SharedLocalizer["hm_statChanged"].Value,
        statNotFound = SharedLocalizer["hm_statNotFound"].Value,
        statFailed   = SharedLocalizer["hm_statFailed"].Value,
        secChanged   = SharedLocalizer["hm_secChanged"].Value,
        noteChanged  = SharedLocalizer["hm_noteChanged"].Value,
        secOrphan    = SharedLocalizer["hm_secOrphan"].Value,
        noteOrphan   = SharedLocalizer["hm_noteOrphan"].Value,
        refreshResult= SharedLocalizer["hm_refreshResult"].Value,
        refreshFailed= SharedLocalizer["hm_refreshFailed"].Value,
        previewOnly  = SharedLocalizer["hm_previewOnly"].Value,
        nothingSaved = SharedLocalizer["hm_previewNothingSaved"].Value,
        statUnlinked = SharedLocalizer["hm_statUnlinked"].Value,
        statWillLink = SharedLocalizer["hm_statWillLink"].Value,
        statNoAccount= SharedLocalizer["hm_statNoAccount"].Value,
        secMismatch  = SharedLocalizer["hm_secMismatch"].Value,
        noteMismatch = SharedLocalizer["hm_noteMismatch"].Value,
        colSystem    = SharedLocalizer["hm_colSystem"].Value,
        colDirectory = SharedLocalizer["hm_colDirectory"].Value,
        secNoAccount = SharedLocalizer["hm_secNoAccount"].Value,
        previewTitle = SharedLocalizer["hm_previewTitle"].Value,
        previewFailed= SharedLocalizer["hm_previewFailed"].Value,
        runLink      = SharedLocalizer["hm_runLink"].Value,
        statLinked   = SharedLocalizer["hm_statLinked"].Value,
        statNoAcc    = SharedLocalizer["hm_statNoAcc"].Value,
        linkDone     = SharedLocalizer["hm_linkDone"].Value,
        linkFailed   = SharedLocalizer["hm_linkFailed"].Value
    });
}

<style>
  /* خاص بصفحة إدارة حسابات السكن — نفس ستايلات الصفحة القديمة عشان housing-management.js يشتغل زي ما هو */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:24px}
  .stat-card{background:var(--white);border-radius:12px;padding:16px 20px;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(0,0,0,.04)}
  .stat-card .stat-label{font-size:13px;color:var(--gray-500);margin-bottom:4px}
  .stat-card .stat-value{font-size:28px;font-weight:700;color:var(--navy)}

  /* شريط أدوات المزامنة — قبل كده كانت الأزرار نص عريان جنب بعضه من غير أي
     تمييز، فمكانش باين إن دي إجراءات ولا إن التنين مختلفين عن بعض. */
  .tool-sep{width:1px;align-self:stretch;background:var(--gray-200);margin:0 2px}
  .tbtn{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;border-radius:9px;
        border:1px solid var(--gray-200);background:var(--white);color:var(--navy);
        font-family:inherit;font-size:12.5px;font-weight:600;cursor:pointer;
        transition:background .15s,border-color .15s,box-shadow .15s;white-space:nowrap}
  .tbtn svg{width:15px;height:15px;flex-shrink:0;opacity:.85}
  .tbtn:hover{background:var(--gray-50,#f5f5f6);border-color:var(--gray-300);box-shadow:0 1px 3px rgba(16,70,49,.07)}
  .tbtn:active{transform:translateY(1px)}
  .tbtn:disabled{opacity:.55;cursor:default;box-shadow:none;transform:none}
  /* الزر الأساسي: الإجراء اللي بيغيّر بيانات فعلاً */
  .tbtn.primary{background:var(--navy);border-color:var(--navy);color:#fff}
  .tbtn.primary:hover{background:var(--navy-dark,#104631);border-color:var(--navy-dark,#104631)}
  .tbtn.icon-only{padding:8px 10px}
  .tbtn.is-busy svg{animation:spin 1s linear infinite}
  .hbtn{padding:8px 16px;border:none;border-radius:8px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:6px}
  .btn-outline{background:transparent;border:1px solid var(--gray-300);color:var(--gray-700)}
  .btn-outline:hover{background:var(--gray-50)}
  .btn-sm{padding:4px 10px;font-size:12px}
  .btn-success{background:var(--green);color:var(--white)}
  .btn-danger{background:var(--red);color:var(--white)}
  .btn-warning{background:var(--gold);color:var(--navy-dark)}
  .badge-enabled{background:var(--green-light);color:var(--green)}
  .badge-disabled{background:var(--red-light);color:var(--red)}
  .badge-unknown{background:var(--gray-200);color:var(--gray-700)}
  .table-wrap{overflow-x:auto}
/* ⚠️ .card-body اتنقلت لـ css/components.css - كانت مكتوبة في شاشتين. */
  .loading{text-align:center;padding:40px;color:var(--gray-500)}
  .loading::after{content:'';display:inline-block;width:24px;height:24px;border:3px solid var(--gray-200);border-top-color:var(--navy);border-radius:50%;animation:spin 1s linear infinite;margin-right:8px;vertical-align:middle}
  .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 24px}
  .detail-item label{font-size:11px;color:var(--gray-500);display:block;margin-bottom:2px}
  .detail-item span{font-size:14px;font-weight:600}
  .modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:1000;display:none;align-items:center;justify-content:center}
  .modal-overlay.show{display:flex}
  .modal{background:var(--white);border-radius:16px;width:90%;max-width:700px;max-height:90vh;overflow-y:auto;box-shadow:0 24px 48px rgba(0,0,0,.2)}
  .modal-header{padding:16px 20px;background:var(--tint);border-bottom:1px solid #c6ecd6;display:flex;align-items:center;justify-content:space-between}
  .modal-header h3{font-size:16px;font-weight:700}
  .modal-body{padding:20px}
  .modal-footer{padding:12px 20px;border-top:1px solid var(--gray-100);display:flex;justify-content:flex-end;gap:8px}

  /* ⚠️ كلاسات سجل دورة الحياة (.log-entry / .log-icon / .log-details ...) كانت
     مستخدمة في housing-management.js من غير أي CSS في المشروع كله، فالسطور كانت
     بتطلع ملزوقة في بعضها: الإجراء والتاريخ والمنفّذ و IP في سطر واحد متصل. */
  .log-list{display:flex;flex-direction:column;max-height:430px;overflow-y:auto;padding-inline-end:6px}
  .log-entry{display:flex;gap:12px;padding:14px 2px;border-bottom:1px solid var(--gray-100)}
  .log-entry:last-child{border-bottom:none}
  .log-icon{flex-shrink:0;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;background:var(--gray-100);color:var(--gray-500)}
  .log-icon.created,.log-icon.enabled,.log-icon.reprovisioned{background:var(--green-light);color:var(--green)}
  .log-icon.disabled{background:var(--red-light);color:var(--red)}
  .log-icon.password_reset{background:#fffaeb;color:var(--gold-dark)}
  .log-details{flex:1;min-width:0}
  .log-action{font-size:13.5px;font-weight:700;color:var(--navy);margin-bottom:3px}
  .log-desc{font-size:12.5px;color:var(--gray-700);line-height:1.75;margin-bottom:5px;word-break:break-word}
  .log-meta{display:flex;flex-wrap:wrap;gap:2px 16px;font-size:11.5px;color:var(--gray-500)}
  .log-meta span{white-space:nowrap}
  .log-meta .log-ip{direction:ltr;unicode-bidi:embed}

  /* ============================================================================
     لوحة المزامنة مع الأكتف دايركتوري
     ⚠️ كانت زرارين مرصوصين جنب فلتر الجدول في ترويسة الكارت. ده بيخلّي إجراءين
        نادرين وليهم أثر حقيقي على الحسابات شكلهم زي فلتر عرض. بقوا لوحة مستقلة
        فوق الجدول: كل إجراء ليه عنوان وسطر بيقول بيعمل إيه بالظبط.
     ============================================================================ */
  /* ⚠️ اللوحة دي لونها أزرق مش أخضر النظام — عن قصد.
        كل حاجة خضرا في الشاشة دي بتشتغل على قاعدة بيانات النظام. اللوحة دي
        بس هي اللي بتتكلم مع **الدليل النشط**، وهي حاجة تانية خالص: خارج
        النظام، وبتلمس حسابات دخول حقيقية. اللون بيقول الفرق ده من غير ما
        الموظف يقرا سطر. والدرجة نفسها المستخدمة في شارة وسيلة الدخول في
        سجل تسجيل الدخول (.badge-method) — مش لون جديد اخترعناه هنا. */
  .sync-panel{background:var(--white);border:1px solid #c7d7fe;border-radius:14px;
              box-shadow:0 2px 8px rgba(24,73,169,.06);margin-bottom:20px;overflow:hidden}

  /* ⚠️ الترويسة بقت <button>: هي مفتاح الطيّ، فلازم تشتغل بالكيبورد وقارئ
        الشاشة زي أي زرار. <div onclick> كان هيبان زيّها للعين بس. */
  .sync-panel-head{width:100%;display:flex;align-items:center;gap:11px;padding:15px 20px;
                   background:var(--blue-light);border:0;border-bottom:1px solid #c7d7fe;
                   font-family:inherit;text-align:start;cursor:pointer}
  .sync-panel-head:hover{background:#e6eeff}
  .sync-panel-head:focus-visible{outline:2px solid var(--blue);outline-offset:-2px}
  .sync-panel-head .ic{width:34px;height:34px;border-radius:10px;background:var(--white);border:1px solid #c7d7fe;color:var(--blue);
                       display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .sync-panel-head .ic svg{width:17px;height:17px}
  .sync-panel-head .txt{flex:1;min-width:0}
  .sync-panel-head .t{display:block;font-size:14.5px;font-weight:700;color:var(--blue);line-height:1.4}
  .sync-panel-head .s{display:block;font-size:11.5px;color:var(--gray-500);margin-top:2px;line-height:1.6}
  /* شارة «قراءة فقط» جنب العنوان: الجملة الكاملة موجودة تحته، والشارة هي اللي
     بتفضل قدام العين وقت ما اللوحة تكون مطوية. */
  .sync-panel-head .dom-badge{flex-shrink:0;font-size:10.5px;font-weight:700;padding:3px 10px;
                              border-radius:999px;background:var(--white);border:1px solid #c7d7fe;color:var(--blue)}
  .sync-panel-head .chev{width:16px;height:16px;flex-shrink:0;color:var(--blue);transition:transform .2s}
  .sync-panel.is-open .sync-panel-head .chev{transform:rotate(180deg)}

  /* ⚠️ مطوية افتراضيًا: دي إجراءات إدارية بتتعمل مرة كل فترة، وكانت واخدة
        تلت الشاشة الأولى فوق الجدول اللي هو شغل الموظف اليومي. */
  .sync-actions{display:none;grid-template-columns:1fr;gap:14px;padding:18px 20px}
  .sync-panel.is-open .sync-actions{display:grid}
  @@media(min-width:860px){ .sync-actions{grid-template-columns:1fr 1fr} }
  .sync-action{border:1px solid var(--gray-200);border-radius:12px;padding:16px 17px;
               display:flex;flex-direction:column;gap:9px;transition:border-color .15s,box-shadow .15s}
  .sync-action:hover{border-color:var(--gray-300);box-shadow:0 2px 10px rgba(16,70,49,.06)}
  .sync-action.accent{border-color:rgba(16,70,49,.22);background:linear-gradient(180deg,#fcfcfd,#fff)}
  .sync-action b{font-size:13.5px;font-weight:700;color:var(--navy-dark);display:flex;align-items:center;gap:7px}
  .sync-action b svg{width:15px;height:15px;flex-shrink:0;opacity:.8}
  .sync-action p{font-size:11.5px;color:var(--gray-500);line-height:1.75;flex:1;margin:0}
  .sync-action .safe{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:700;
                     padding:2px 9px;border-radius:999px;background:var(--green-light);color:var(--green);align-self:flex-start}
  .sync-action .care{background:var(--amber-light,#fffaeb);color:var(--gold-dark)}
  .sbtn{display:inline-flex;align-items:center;justify-content:center;gap:8px;align-self:flex-start;
        padding:9px 18px;border-radius:9px;border:1px solid var(--gray-200);background:var(--white);
        color:var(--navy);font-family:inherit;font-size:12.5px;font-weight:600;cursor:pointer;
        transition:background .15s,border-color .15s,box-shadow .15s}
  .sbtn svg{width:14px;height:14px;flex-shrink:0}
  .sbtn:hover{background:var(--gray-50,#f5f5f6);border-color:var(--gray-300);box-shadow:0 1px 4px rgba(16,70,49,.08)}
  .sbtn.primary{background:var(--navy);border-color:var(--navy);color:#fff}
  .sbtn.primary:hover{background:var(--navy-dark,#104631);border-color:var(--navy-dark,#104631)}
  .sbtn:disabled{opacity:.55;cursor:default;box-shadow:none}
  .sbtn.is-busy svg{animation:spin 1s linear infinite}

  /* نتيجة المزامنة — بدل نافذة alert() بتاعة المتصفح */
  .sync-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:18px}
  .sync-stat{background:var(--gray-50,#f5f5f6);border:1px solid var(--gray-100);border-radius:10px;padding:12px 14px}
  .sync-stat .v{font-size:22px;font-weight:700;color:var(--navy);line-height:1.2}
  .sync-stat .l{font-size:11.5px;color:var(--gray-500);margin-top:2px}
  .sync-stat.warn .v{color:var(--red)}
  .sync-section{margin-top:18px}
  .sync-section h4{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:8px}
  .sync-note{font-size:12px;line-height:1.8;padding:10px 12px;border-radius:8px;margin-bottom:10px}
  .sync-note.info{background:var(--blue-light);color:var(--blue);border:1px solid var(--blue-pale)}
  .sync-note.danger{background:#fef3f2;color:#b42318;border:1px solid #fecdca}
  .sync-list{max-height:220px;overflow-y:auto;border:1px solid var(--gray-100);border-radius:8px}
  .sync-list .row{display:flex;flex-wrap:wrap;gap:4px 12px;padding:9px 12px;font-size:12.5px;border-bottom:1px solid var(--gray-100)}
  .sync-list .row:last-child{border-bottom:none}
  .sync-list .row .id{font-weight:700;color:var(--navy);direction:ltr}
  .sync-list .row .muted{color:var(--gray-500)}
  .sync-list .more{padding:8px 12px;font-size:12px;color:var(--gray-500);background:var(--gray-50,#f5f5f6)}
  .group-tag{display:inline-block;background:var(--gray-100);border-radius:6px;padding:2px 8px;font-size:11px;margin:2px;direction:ltr}

  /* ============================================================================
     عمود الإجراءات في الجدول
     ⚠️ .ad-actions كانت مكتوبة في housing-management.js من غير أي CSS في المشروع
        كله، فالزرّان كانا ملتصقين بلا أي فاصل بينهما — نفس علّة .log-entry و
        .housing-info-grid: كلاس في الجافاسكريبت بلا ستايل يقابله.
     ============================================================================ */
  .ad-actions{display:flex;align-items:center;gap:8px;flex-wrap:nowrap}
  .abtn{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:8px;
        border:1px solid var(--gray-200);background:var(--white);color:var(--navy);
        font-family:inherit;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;
        transition:background .15s,border-color .15s,box-shadow .15s}
  .abtn svg{width:13px;height:13px;flex-shrink:0;opacity:.75}
  .abtn:hover{background:var(--gray-50,#f5f5f6);border-color:var(--gray-300);box-shadow:0 1px 3px rgba(16,70,49,.07)}
  .abtn:active{transform:translateY(1px)}
  .abtn.primary{background:var(--navy);border-color:var(--navy);color:#fff}
  .abtn.primary svg{opacity:1}
  .abtn.primary:hover{background:var(--navy-dark,#104631);border-color:var(--navy-dark,#104631)}

  /* ============================================================================
     نافذة «إدارة الحساب»
     ⚠️ كانت شبكة من عناوين تقنية خام (UPN / DN / UAC) بنفس وزن اسم الطالب،
        وتحتها صفّ أزرار بأربعة ألوان مختلفة بلا أي شرح. الموظف لا يعرف ما الذي
        يفعله «إعادة التزويد» ولا الفرق بينه وبين «مزامنة الخصائص».
        التصميم الآن: ترويسة تعرّف الحساب، ثم أقسام معنونة، والتفاصيل التقنية
        داخل قسم يُطوى، وكل إجراء في بطاقة تشرح أثره قبل الضغط — نفس لغة
        لوحة المزامنة فوق الجدول حتى لا تبدو الشاشتان من نظامين.
     ============================================================================ */
  .acct-head{display:flex;align-items:center;gap:14px;padding:15px 16px;border:1px solid var(--gray-100);
             border-radius:14px;background:linear-gradient(180deg,#fcfcfd,#fff);margin-bottom:22px}
  .acct-head .av{width:46px;height:46px;border-radius:12px;background:var(--blue-pale);color:var(--navy);
                 display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .acct-head .av svg{width:22px;height:22px}
  .acct-head .who{flex:1;min-width:0;display:flex;flex-direction:column}
  .acct-head .u{display:block;font-size:15px;font-weight:700;color:var(--navy-dark);word-break:break-all;line-height:1.5}
  .acct-head .s{display:block;font-size:12px;color:var(--gray-500);margin-top:3px;line-height:1.7}

  .acct-sec{margin-bottom:22px}
  .acct-sec:last-child{margin-bottom:0}
  .acct-sec > h4{font-size:12px;font-weight:700;color:var(--gray-500);margin-bottom:11px;
                 padding-bottom:7px;border-bottom:1px solid var(--gray-100)}
  /* auto-fit وليس media query: النافذة عرضها لا يتبع عرض الشاشة، فاستعلام
     الشاشة كان يفرض عمودين داخل نافذة ضيّقة فتفيض البطاقات خارج حدودها. */
  .acct-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:13px 24px}
  .acct-f{min-width:0;overflow-wrap:anywhere}
  .acct-f .k{display:block;font-size:11px;color:var(--gray-500);margin-bottom:3px}
  .acct-f .v{display:block;font-size:13.5px;font-weight:600;color:var(--navy-dark);
             line-height:1.7;word-break:break-word}
  .acct-f.wide{grid-column:1/-1}
  .acct-mono{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
             font-size:11.5px;font-weight:500;line-height:1.85;color:var(--gray-700);
             background:var(--gray-50,#f5f5f6);border:1px solid var(--gray-100);
             border-radius:8px;padding:8px 10px;word-break:break-all}

  /* التفاصيل التقنية مطويّة: يحتاجها الفني عند العطل، ولا تزاحم الموظف يوميًا */
  .acct-tech{margin-top:14px;border:1px solid var(--gray-100);border-radius:10px;overflow:hidden}
  .acct-tech summary{cursor:pointer;list-style:none;padding:9px 12px;font-size:12px;font-weight:600;
                     color:var(--gray-700);background:var(--gray-50,#f5f5f6);user-select:none}
  .acct-tech summary::-webkit-details-marker{display:none}
  .acct-tech summary::before{content:'+';display:inline-block;width:15px;font-weight:700;color:var(--gray-500)}
  .acct-tech[open] summary::before{content:'\2212'}
  .acct-tech .in{padding:14px 13px}

  .acct-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
  .acct-action{min-width:0;border:1px solid var(--gray-200);border-radius:12px;padding:14px 15px;
               display:flex;flex-direction:column;gap:9px;transition:border-color .15s,box-shadow .15s}
  .acct-action:hover{border-color:var(--gray-300);box-shadow:0 2px 10px rgba(16,70,49,.06)}
  .acct-action p{font-size:11.5px;color:var(--gray-500);line-height:1.75;margin:0;flex:1}
  .acct-action .sbtn{align-self:flex-start;white-space:nowrap}
  .acct-action .sbtn.danger{background:var(--red);border-color:var(--red);color:#fff}
  .acct-action .sbtn.danger:hover{background:#912018;border-color:#912018}
  .acct-action .sbtn.ok{background:var(--green);border-color:var(--green);color:#fff}
  .acct-action .sbtn.ok:hover{background:#054f30;border-color:#054f30}
  .acct-action.warn{border-color:#fecdca;background:linear-gradient(180deg,#fef3f2,#fff)}
  .acct-empty{padding:22px;text-align:center;color:var(--gray-500);font-size:13px;
              border:1px dashed var(--gray-200);border-radius:12px}
</style>

<div class="page-header">
  <h2>@SharedLocalizer["Page_Housing"]</h2>
  <p>@SharedLocalizer["hou_pageSubtitle"]</p>
</div>

<div class="stats-grid" id="statsGrid"></div>

@* إجراءان منفصلان عن قصد: التحديث بيقرا حالة المربوطين بس (بلا خطر)، والربط
   بيلمس طلاب لسه مالهمش حساب — وده اللي محتاج معاينة قبل الحفظ.
   الاتنين بصلاحية housing.syncAd، والـ API بيتحقق منها كمان. *@
@if (User.HasClaim("permission", "housing.syncAd"))
{
  <div class="sync-panel" id="adPanel">
    <button type="button" class="sync-panel-head" id="adPanelToggle"
            aria-expanded="false" aria-controls="adPanelBody">
      <span class="ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
      </span>
      @* ⚠️ <span> مش <h3>/<p>: العنصر الأب بقى <button>، والزرار مابيقبلش
         عناصر كتلية جوّاه — متصفحات كتير بتطلّعها بره الزرار وقت التحليل
         فيتكسر الصف. الحجم والوزن من الـ CSS زي ما كانوا. *@
      <span class="txt">
        <span class="t">@SharedLocalizer["hm_syncTitle"]</span>
        <span class="s">@SharedLocalizer["hm_syncSubtitle"]</span>
      </span>
      <span class="dom-badge">@SharedLocalizer["hm_readOnly"]</span>
      <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="sync-actions" id="adPanelBody">
      <div class="sync-action">
        <b>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
          @SharedLocalizer["hm_refreshTitle"]
        </b>
        <p>@SharedLocalizer["hm_refreshDesc"]</p>
        <span class="safe">@SharedLocalizer["hm_refreshSafe"]</span>
        <button class="sbtn" id="adRefreshBtn" onclick="refreshAdStatuses()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
          <span>@SharedLocalizer["hm_refreshBtn"]</span>
        </button>
      </div>

      <div class="sync-action accent">
        <b>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
          @SharedLocalizer["hm_linkTitle"]
        </b>
        <p>@SharedLocalizer["hm_linkDesc1"] <span dir="ltr">h + @SharedLocalizer["hs_colStudentId"]</span> @SharedLocalizer["hm_linkDesc2"]</p>
        <span class="safe care">@SharedLocalizer["hm_linkCare"]</span>
        <button class="sbtn primary" id="adLinkBtn" onclick="linkExistingAdAccounts()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
          <span>@SharedLocalizer["hm_linkBtn"]</span>
        </button>
      </div>
    </div>
  </div>
}

@* ============================================================================
   شريط الفلاتر - نفس مكوّن .filters-bar المستخدم في سجل تسجيل الدخول وسجل
   العمليات وسجل الأخطاء. مكتوب مرة واحدة في site.css ومحدش بيكتب ستايل محلي.

   ⚠️ الشاشة دي كانت الوحيدة اللي فلترها قائمة يتيمة في ترويسة البطاقة:
      بلا خانة بحث خالص، وبلا ترقيم صفحات - بتنادي GET /api/HousingAccountManagement
      اللي بيرجّع **كل** الحسابات في رد واحد وترسمهم كلهم. مع ٢١ طالب ده
      شغّال، ومع دفعة قبول كاملة الصفحة بتقف.

   ⚠️ ونقطة /paged كانت موجودة على الخادم من الأصل ومحدش بيناديها.
   ============================================================================ *@
<div class="filters-bar">
  <div class="filter-group">
    <label for="hsSearch">@SharedLocalizer["hs_search"]</label>
    <input type="text" id="hsSearch" placeholder='@(SharedLocalizer["hs_searchPlaceholder"].Value)'>
  </div>
  <div class="filter-group">
    <label for="statusFilter">@SharedLocalizer["hs_colStatus"]</label>
    <select id="statusFilter">
      <option value="" >@SharedLocalizer["hs_filterAll"]</option>
      <option value="enabled" >@SharedLocalizer["hs_filterEnabled"]</option>
      <option value="disabled" >@SharedLocalizer["hs_filterDisabled"]</option>
      <option value="unknown" >@SharedLocalizer["hs_filterUnknown"]</option>
    </select>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">@SharedLocalizer["hs_accountsTitle"]</div>
    <div class="card-tools">
      @* تحديث عرض الجدول من قاعدة البيانات — مالوش علاقة بالدومين، فأيقونة بس.
         إجراءات المزامنة اتنقلت للوحة مستقلة فوق الجدول. *@
      <button class="tbtn icon-only" onclick="loadAccounts()" title="@SharedLocalizer["hs_refresh"]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
      </button>
    </div>
  </div>
  <div class="card-body">
    <div class="table-wrap">
      <table id="hsTable">
        <thead>
          <tr>
            <th data-sort="student_id">@SharedLocalizer["hs_colStudentId"]</th>
            <th data-sort="full_name_english">@SharedLocalizer["hs_colNameEn"]</th>
            <th data-sort="college">@SharedLocalizer["hs_colCollege"]</th>
            <th data-sort="ad_status">@SharedLocalizer["hs_colStatus"]</th>
            <th data-sort="ad_username">@SharedLocalizer["hs_colUsername"]</th>
            <th data-sort="ad_last_sync_at">@SharedLocalizer["hs_colLastSync"]</th>
            <th >@SharedLocalizer["hs_colActions"]</th>
          </tr>
        </thead>
        <tbody id="accountsTableBody"></tbody>
      </table>
    </div>

    @* حالات الجدول (تحميل / لا نتائج / خطأ) من NuhTable.bind، وصفّ الترقيم من
       NuhTable.pager - النسخة الوحيدة في النظام (js/table-state.js).
       ⚠️ اتشالت هنا لوحة .loading و.empty-state المنفصلتين: كانوا تحت الجدول
          مش جواه، فالمستخدم كان بيشوف ترويسة أعمدة فاضية وتحتها دايرة تحميل
          في مكان تاني - وباقي شاشات النظام بتعرض الحالة جوّه الجدول نفسه. *@
    <div id="hsPager" class="in-card"></div>
  </div>
</div>

<div class="modal-overlay" id="detailsModal">
  <div class="modal">
    <div class="modal-header">
      <h3 >@SharedLocalizer["hs_manageAccount"]</h3>
      <button class="modal-close" onclick="closeModal('detailsModal')" aria-label="@SharedLocalizer["close"]"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="modal-body" id="detailsModalBody"></div>
    <div class="modal-footer">
      <button class="hbtn btn-outline" onclick="closeModal('detailsModal')" >@SharedLocalizer["hs_close"]</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="lifecycleModal">
  <div class="modal">
    <div class="modal-header">
      <h3 >@SharedLocalizer["hs_lifecycleLog"]</h3>
      <button class="modal-close" onclick="closeModal('lifecycleModal')" aria-label="@SharedLocalizer["close"]"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="modal-body" id="lifecycleModalBody"></div>
    <div class="modal-footer">
      <button class="hbtn btn-outline" onclick="closeModal('lifecycleModal')" >@SharedLocalizer["hs_close"]</button>
    </div>
  </div>
</div>

@* نتيجة المزامنة مع الدومين — بدل نافذة المتصفح، عشان النتيجة تتقرا وتتراجع *@
<div class="modal-overlay" id="adSyncModal">
  <div class="modal" style="max-width:720px">
    <div class="modal-header">
      <h3 id="adSyncTitle"></h3>
      <button class="modal-close" onclick="closeModal('adSyncModal')" aria-label="@SharedLocalizer["close"]"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="modal-body" id="adSyncBody"></div>
    <div class="modal-footer" id="adSyncFooter"></div>
