        <label id="lblFullNameAr">@SharedLocalizer["reg_lblFullName"]<span class="req">*</span></label>
        <div class="name-row">
          <div>
            <label for="ar_first">@SharedLocalizer["reg_lblNameFirst"]</label>
            <div class="input-wrap">
              <input type="text" id="ar_first" autocomplete="off">
            </div>
          </div>
          <div>
            <label for="ar_middle">@SharedLocalizer["reg_lblNameMiddle"]</label>
            <div class="input-wrap">
              <input type="text" id="ar_middle" autocomplete="off">
            </div>
          </div>
          <div>
            <label for="ar_family">@SharedLocalizer["reg_lblNameFamily"]</label>
            <div class="input-wrap">
              <input type="text" id="ar_family" autocomplete="off">
            </div>
          </div>
        </div>
        <span class="field-error" id="err-name_ar" >@SharedLocalizer["reg_errNameParts"]</span>
      </div>
      <div class="field name-group" role="group" aria-labelledby="lblFullNameEn">
        <label id="lblFullNameEn">@SharedLocalizer["reg_lblFullNameEn"]<span class="req">*</span></label>
        <div class="name-row">
          <div>
            <label for="en_first">@SharedLocalizer["reg_lblNameFirst"]</label>
            <div class="input-wrap">
              <input type="text" id="en_first" dir="ltr" autocomplete="off">
            </div>
          </div>
          <div>
            <label for="en_middle">@SharedLocalizer["reg_lblNameMiddle"]</label>
            <div class="input-wrap">
              <input type="text" id="en_middle" dir="ltr" autocomplete="off">
            </div>
          </div>
          <div>
            <label for="en_family">@SharedLocalizer["reg_lblNameFamily"]</label>
            <div class="input-wrap">
              <input type="text" id="en_family" dir="ltr" autocomplete="off">
            </div>
          </div>
        </div>
        <span class="field-error" id="err-name_en" >@SharedLocalizer["reg_errNameParts"]</span>
      </div>
      <span class="field-error name-group" id="err-name_match" >@SharedLocalizer["reg_valNameMismatch"]</span>
      <div class="field">
        <label for="student_id">@SharedLocalizer["reg_lblStudentId"]<span class="req">*</span></label>
        <div class="input-wrap with-icon">
          <input type="text" id="student_id" maxlength="9" placeholder="">
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
        </div>
        <span class="field-error" id="err-student_id" >@SharedLocalizer["reg_errRequired"]</span>
        <span class="field-error" id="val-student_id_start" >@SharedLocalizer["reg_valStudentIdStart"]</span>
        <span class="field-error" id="val-student_id" >@SharedLocalizer["reg_valStudentId"]</span>
      </div>
            <div class="field">
        <label for="national_id">@SharedLocalizer["reg_lblNationalId"]<span class="req">*</span></label>
        <div class="input-wrap with-icon">
          <input type="text" id="national_id" placeholder="" maxlength="10">
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        </div>
        <span class="field-error" id="err-national_id" >@SharedLocalizer["reg_errRequired"]</span>
        <span class="field-error" id="val-national_id" >@SharedLocalizer["reg_valNationalId"]</span>
      </div>
      <div class="field">
        <label for="phone">@SharedLocalizer["reg_lblPhone"]</label>
        <div class="phone-wrap" id="phoneWrap">
          <span class="cc">+966</span>
          @* من غير maxlength: المتصفح بيقص اللصق قبل التنظيف، فلصق 0501234567
             كان بيضيّع رقم. الحد في normalizeSaMobile بعد التنظيف. *@
          <input type="tel" id="phone" placeholder='@(SharedLocalizer["reg_phPhone"].Value)'
                 inputmode="numeric" autocomplete="tel-national" dir="ltr">
        </div>
        <span class="field-error" id="val-phone" >@SharedLocalizer["reg_valPhone"]</span>
      </div>
      <div class="field">
        <label for="gender">@SharedLocalizer["reg_lblGender"]<span class="req">*</span></label>
        <div class="input-wrap with-icon">
          @* ⚠️ الموظف بيسجّل لقسمه هو، فلما يكون له قسم بنعرض خياره وحده ونقفل
             الخانة. والقفل ده راحة مش حراسة — الخادم بيفرض نفس القيمة على أي
             حال في StudentService.CreateAsync، لأن نداء واحد بالـ API كان
             بينشئ طالبة تحت قسم الطلاب فتختفي عن القسمين.
             الأدمن (بلا قسم) بيشوف الاختيارين زي ما هما.
             ⚠️ وبوابة تسجيل الطالب لنفسه (wwwroot/register/register-form.html)
             مالهاش دعوة بالكلام ده: الطالب بيحدد جنسه بنفسه ومفيش قسم أصلًا. *@
          <select id="gender" disabled="@genderLockAttr">
            @if (!genderLocked)
            {
              <option value="" >@SharedLocalizer["reg_optSelectGender"]</option>
              <option value="male" >@SharedLocalizer["reg_optMale"]</option>
              <option value="female" >@SharedLocalizer["reg_optFemale"]</option>
            }
            else if (scopeGender == "male")
            {
              <option value="male" selected>@SharedLocalizer["reg_optMale"]</option>
            }
            else
            {
              <option value="female" selected>@SharedLocalizer["reg_optFemale"]</option>
            }
          </select>
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/></svg>
        </div>
        <span class="field-error" id="err-gender" >@SharedLocalizer["reg_optSelectGender"]</span>
      </div>
    </div>
  </div>
</div>

