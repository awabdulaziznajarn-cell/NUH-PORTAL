@{
    ViewData["Title"] = SharedLocalizer["Page_Register"].Value;
    var role = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "").ToLowerInvariant();
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
    var canRegister = role != "user" && role != "cyber";

    // ⚠️ قسم الموظف (طلاب/طالبات) من نفس الـ claim اللي بتقرا منه التصفية في
    //    السيرفر — مصدر واحد لا نسخة. الفاضي معناه «بيشوف القسمين» (الأدمن).
    var scopeGender = (User.FindFirst(NUH_PORTAL.Core.ClaimConstants.ScopeGender)?.Value ?? "").Trim().ToLowerInvariant();
    if (scopeGender != "male" && scopeGender != "female") scopeGender = "";
    var genderLocked = scopeGender.Length > 0;
    // القيمة null بتخلّي Razor يشيل السمة خالص — والفاضي "" كان هيبقى
    // disabled="" يعني مقفولة على الأدمن كمان.
    string? genderLockAttr = genderLocked ? "disabled" : null;
    // اسم حالة السكن يتبع جنس الطالب. المشرف جنسه ثابت من قسمه فبيتطبع صح
    // من الخادم؛ الأدمن بيغيّره من القائمة فالجافاسكربت بيحدّثه.
    var residentKey = scopeGender == "female" ? "stu_residentF" : "stu_resident";

    // تنبيه: Razor بيهرّب أي نص بيطبعه ترميز HTML، حتى لو كان جوه وسم script.
    // يعني لو طبعنا نص الترجمة مباشرة وحطيناه في textContent، المستخدم بيشوف
    // رموز زي 0627x& بدل الحروف العربية. الحل: نسلسله JSON ونطبعه بـ Html.Raw،
    // والـ serializer بيهرّب الاقتباسات والأقواس الزاوية صح فيفضل آمن جوه script.
    var __bldPlaceholders = System.Text.Json.JsonSerializer.Serialize(new
    {
        genderFirst = SharedLocalizer["reg_optSelectGenderFirst"].Value,
        selectBuilding = SharedLocalizer["reg_optSelectBuilding"].Value,
        floorFirst = SharedLocalizer["reg_optSelectFloorFirst"].Value,
        selectApartment = SharedLocalizer["reg_optSelectApartment"].Value,
        selectRoom = SharedLocalizer["reg_optSelectRoom"].Value
    });
}

<style>
  /* خاص بصفحة التسجيل فقط — الباقي من site.css */
  /* ⚠️ تعريفات .form-card* اتشالت من هنا — كانت مكرّرة حرفيًا في أربع شاشات.
     مكانها الآن wwwroot/css/site.css مرة واحدة، فأي تغيير في الشكل يوصلها كلها. */
  /* الخانات دي من غير أيقونة، والقاعدة العامة .input-wrap input بتحجز 40px
     على الشمال للأيقونة — من غير الإلغاء ده بيبان فراغ كبير جوه كل خانة. */
  /* خانة الجوال: مفتاح +966 ثابت والمشرف يكتب ٩ أرقام تبدأ بـ 5 — نفس صيغة
     نموذج الطالب بالحرف، عشان الشاشتين ما يختلفوش في نفس الحقل. */
  .toast{position:fixed;top:24px;left:50%;transform:translateX(-50%) translateY(-80px);background:var(--green);color:#fff;padding:14px 24px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.2);z-index:999;transition:transform .4s cubic-bezier(.16,1,.3,1);display:flex;align-items:center;gap:10px}
  .toast.show{transform:translateX(-50%) translateY(0)}
</style>

<div class="page-header">
  <h2 >@SharedLocalizer["reg_pageTitle"]</h2>
  <p >@SharedLocalizer["reg_pageSubtitle"]</p>
</div>

<div class="form-card">
