@section Scripts {
<script src="/i18n.js"></script>
<script>
  var USER_ID = @userId;

  function validate() {
    var ok = true;
    var required = ['full_name', 'full_name_english', 'student_id', 'national_id', 'college', 'department', 'academic_level', 'housing_building', 'room_number', 'apartment_number'];
    required.forEach(function (id) {
      var el = document.getElementById(id);
      var err = document.getElementById('err-' + id);
      if (!el.value.trim()) {
        el.classList.add('error');
        if (err) err.classList.add('show');
        ok = false;
      } else {
        el.classList.remove('error');
        if (err) err.classList.remove('show');
      }
    });
    function showValError(id, valId, condition) {
      var el = document.getElementById(id);
      var val = document.getElementById(valId);
      if (el.value.trim() && !condition) {
        el.classList.add('error');
        if (val) val.classList.add('show');
        ok = false;
      } else if (el.value.trim()) {
        el.classList.remove('error');
        if (val) val.classList.remove('show');
      }
    }
    showValError('full_name', 'val-full_name', /^[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\s]+$/.test(document.getElementById('full_name').value.trim()));
    showValError('full_name_english', 'val-full_name_english', /^[a-zA-Z\s]+$/.test(document.getElementById('full_name_english').value.trim()));
    showValError('student_id', 'val-student_id', /^\d{9,10}$/.test(document.getElementById('student_id').value.trim()));
    showValError('national_id', 'val-national_id', /^\d{10}$/.test(document.getElementById('national_id').value.trim()));
    showValError('phone', 'val-phone', /^9665\d{8}$/.test(document.getElementById('phone').value.trim()));
    var gender = document.getElementById('gender');
    var errGender = document.getElementById('err-gender');
    if (!gender.value) { gender.classList.add('error'); errGender.classList.add('show'); ok = false; }
    else { gender.classList.remove('error'); errGender.classList.remove('show'); }
    return ok;
  }

  async function submitForm() {
    if (!validate()) return;
    var btn = document.getElementById('registerStudentButton');
    btn.classList.add('loading');
    var data = {
      full_name: document.getElementById('full_name').value.trim(),
      full_name_english: document.getElementById('full_name_english').value.trim(),
      student_id: document.getElementById('student_id').value.trim(),
      national_id: document.getElementById('national_id').value.trim(),
      phone: document.getElementById('phone').value.trim(),
      gender: document.getElementById('gender').value,
      college: document.getElementById('college').value,
      department: document.getElementById('department').value,
      academic_level: document.getElementById('academic_level').value,
      ad_username: document.getElementById('ad_username').value.trim(),
      housing_building: document.getElementById('housing_building').value,
      room_number: document.getElementById('room_number').value.trim(),
      apartment_number: document.getElementById('apartment_number').value.trim(),
      status: document.getElementById('status').value
    };
    try {
      var res = await fetch('/api/students', {
        method: 'POST',
        headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
        body: JSON.stringify(data)
      });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.ok) {
        var createdStudent = await res.json();
        await fetch('/api/requests', {
          method: 'POST',
          headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
          body: JSON.stringify({ requestType: 'housing', studentId: createdStudent.id, submittedBy: USER_ID })
        });
        showToast(t('reg_toastSuccess'));
        resetForm();
      } else {
        var err = await res.json().catch(function () { return {}; });
        showToast(t('reg_toastErrorFmt').replace('{0}', (err.message || t('reg_errGeneric'))), true);
      }
    } catch (e) {
      showToast(t('reg_toastConnError'), true);
    } finally {
      btn.classList.remove('loading');
    }
  }

  function resetForm() {
    ['full_name', 'full_name_english', 'student_id', 'national_id', 'phone', 'ad_username', 'room_number', 'apartment_number'].forEach(function (id) {
      document.getElementById(id).value = '';
      document.getElementById(id).classList.remove('error');
    });
    ['college', 'department', 'academic_level', 'gender', 'housing_building', 'status'].forEach(function (id) {
      document.getElementById(id).selectedIndex = 0;
      document.getElementById(id).classList.remove('error');
    });
    document.querySelectorAll('.field-error').forEach(function (e) { e.classList.remove('show'); });
  }

  function showToast(msg, isError) {
    var t = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    t.style.background = isError ? '#991B1B' : '#0F6E56';
    t.classList.add('show');
    setTimeout(function () { t.classList.remove('show'); }, 3500);
  }

  function digitsOnly(e) { e.value = e.value.replace(/\D/g, ''); }
  function validateField(id, valId, regex) {
    var el = document.getElementById(id);
    var val = document.getElementById(valId);
    if (el.value.trim() && !regex.test(el.value.trim())) { el.classList.add('error'); if (val) val.classList.add('show'); }
    else { el.classList.remove('error'); if (val) val.classList.remove('show'); }
  }
  ['student_id', 'national_id', 'phone'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', function () { digitsOnly(this); });
  });
  document.getElementById('full_name').addEventListener('input', function () {
    validateField('full_name', 'val-full_name', /^[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\s]+$/);
    var err = document.getElementById('err-full_name'); if (this.value.trim()) err.classList.remove('show');
  });
  document.getElementById('full_name_english').addEventListener('input', function () {
    validateField('full_name_english', 'val-full_name_english', /^[a-zA-Z\s]+$/);
    var err = document.getElementById('err-full_name_english'); if (this.value.trim()) err.classList.remove('show');
  });
  document.getElementById('student_id').addEventListener('input', function () {
    document.getElementById('ad_username').value = this.value;
    validateField('student_id', 'val-student_id', /^\d{9,10}$/);
    var err = document.getElementById('err-student_id'); if (this.value.trim()) err.classList.remove('show');
  });
  document.getElementById('national_id').addEventListener('input', function () {
    validateField('national_id', 'val-national_id', /^\d{10}$/);
    var err = document.getElementById('err-national_id'); if (this.value.trim()) err.classList.remove('show');
  });
  document.getElementById('phone').addEventListener('input', function () {
    validateField('phone', 'val-phone', /^9665\d{8}$/);
  });

  window.onLanguageChange = function () { /* لا نص ديناميكي دائم يحتاج إعادة تطبيق */ };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
</script>
}
