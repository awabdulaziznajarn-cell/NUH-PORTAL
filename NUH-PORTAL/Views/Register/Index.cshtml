<div class="form-card">
  <div class="form-card-header">
    <div class="form-card-header-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
    </div>
    <div class="form-card-title" >@SharedLocalizer["reg_sectionHousing"]</div>
  </div>
  <div class="form-card-body">
    <div class="form-grid-3">
      <div class="field">
        <label >@SharedLocalizer["reg_lblBuilding"]<span>*</span></label>
        <div class="input-wrap">
          @* القائمة بتفضل فاضية ومقفولة لحد ما يتحدد النوع — نفس سلوك شاشة تسجيل
             الطالب لنفسه. الخيارات الثابتة اتشالت من هنا عشان ماتظهرش قبل الاختيار. *@
          <select id="housing_building" disabled>
            <option value="" >@SharedLocalizer["reg_optSelectGenderFirst"]</option>
          </select>
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        </div>
        <span class="field-error" id="err-housing_building" >@SharedLocalizer["reg_optSelectBuilding"]</span>
      </div>
      <div class="field">
        <label >@SharedLocalizer["reg_lblFloor"]<span>*</span></label>
        <div class="input-wrap">
          <select id="floor_number">
            <option value="" >@SharedLocalizer["reg_optSelectFloor"]</option>
            <option value="0" >@SharedLocalizer["reg_optFloorGround"]</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-4h6v4"/></svg>
        </div>
        <span class="field-error" id="err-floor_number" >@SharedLocalizer["reg_errRequired"]</span>
      </div>
      <div class="field">
        <label >@SharedLocalizer["reg_lblApartment"]<span>*</span></label>
        <div class="input-wrap">
          @* الشقة بتتولّد من الدور (الدور×4+1 .. +4) — القائمة مقفولة لحد ما يتحدد الدور *@
          <select id="apartment_number" disabled>
            <option value="" >@SharedLocalizer["reg_optSelectFloorFirst"]</option>
          </select>
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        </div>
        <span class="field-error" id="err-apartment_number" >@SharedLocalizer["reg_errRequired"]</span>
      </div>
      <div class="field">
        <label >@SharedLocalizer["reg_lblRoom"]<span>*</span></label>
        <div class="input-wrap">
          <select id="room_number">
            <option value="" >@SharedLocalizer["reg_optSelectRoom"]</option>
          </select>
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        </div>
        <span class="field-error" id="err-room_number" >@SharedLocalizer["reg_errRequired"]</span>
      </div>
      <div class="field">
        <label >@SharedLocalizer["reg_lblStatus"]</label>
        <div class="input-wrap">
          <select id="status">
            <option value="active" >@SharedLocalizer["reg_statusActive"]</option>
            <option value="inactive" >@SharedLocalizer["reg_statusInactive"]</option>
          </select>
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
      </div>
    </div>
  </div>
  <div class="form-actions">
    @if (canRegister)
    {
      <button class="btn btn-primary" id="registerStudentButton" onclick="submitForm()">
        <svg class="btn-text" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
        <span class="btn-text" >@SharedLocalizer["reg_btnRegister"]</span>
        <div class="spinner"></div>
      </button>
    }
    <button class="btn btn-secondary" onclick="resetForm()">
      <span >@SharedLocalizer["reg_btnReset"]</span>
    </button>
  </div>
</div>

<div class="toast" id="toast">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
  <span id="toast-msg" >@SharedLocalizer["reg_toastSuccess"]</span>
</div>

@section Scripts {
<script src="/i18n.js"></script>
<script src="/lookups.js"></script>
<script src="/js/name-fields.js"></script>
<script src="/js/housing-fields.js"></script>
<script src="/js/phone-field.js"></script>
<script>
  var USER_ID = @userId;

  function validate() {
    var ok = true;
    // خانات الاسم الستة بتتحقق في NuhName — قواعدها مشتركة مع باقي الشاشات
    if (!NuhName.validate('')) ok = false;
    // ⚠️ الجوال بقى مطلوب: من غيره الطالب مايقدرش يتابع طلبه (التحقق بآخر ٤ أرقام
    //    بيقارن بجوال الطالب)، ولا يستقبل أي رسالة لاحقًا. كان اختياري وده كان
    //    بيخلّي المشرف يسجّل طالب مالوش أي طريقة يعرف بيها حالة طلبه.
    var required = ['student_id', 'national_id', 'phone', 'college', 'department', 'academic_level', 'housing_building', 'floor_number', 'room_number', 'apartment_number'];
    required.forEach(function (id) {
      var el = document.getElementById(id);
      var err = document.getElementById('err-' + id);
      if (!el.value.trim()) {
        el.classList.add('error');
        if (err) err.classList.add('show');
        ok = false;
      } else {
        el.classList.remove('error');
        if (err) err.classList.remove('show');
      }
    });
    function showValError(id, valId, condition) {
      var el = document.getElementById(id);
      var val = document.getElementById(valId);
      if (el.value.trim() && !condition) {
        el.classList.add('error');
        if (val) val.classList.add('show');
        ok = false;
      } else if (el.value.trim()) {
        el.classList.remove('error');
        if (val) val.classList.remove('show');
      }
    }
    // ٩ أرقام بالظبط وبيبدأ بـ 4 — نفس قاعدة شاشة تسجيل الطالب لنفسه
    var __sid = document.getElementById('student_id').value.trim();
    showValError('student_id', 'val-student_id_start', /^4/.test(__sid));
    showValError('student_id', 'val-student_id', /^\d{9}$/.test(__sid));
    showValError('national_id', 'val-national_id', /^\d{10}$/.test(document.getElementById('national_id').value.trim()));
    showValError('phone', 'val-phone', NuhPhone.isValid(NuhPhone.normalize(document.getElementById('phone').value)));
    var gender = document.getElementById('gender');
    var errGender = document.getElementById('err-gender');
    if (!gender.value) { gender.classList.add('error'); errGender.classList.add('show'); ok = false; }
    else { gender.classList.remove('error'); errGender.classList.remove('show'); }
    return ok;
  }

  async function submitForm() {
    if (!validate()) return;
    var btn = document.getElementById('registerStudentButton');
    btn.classList.add('loading');
    var data = {
      full_name: NuhName.join('', 'ar'),
      full_name_english: NuhName.join('', 'en'),
      student_id: document.getElementById('student_id').value.trim(),
      national_id: document.getElementById('national_id').value.trim(),
      // يُرسَل بالصيغة الموحّدة 9665XXXXXXXX — نفس المخزّن في قاعدة البيانات
      phone: NuhPhone.toStorage(document.getElementById('phone').value),
      gender: document.getElementById('gender').value,
      college: document.getElementById('college').value,
      department: document.getElementById('department').value,
      academic_level: document.getElementById('academic_level').value,
      housing_building: document.getElementById('housing_building').value,
      floor_number: document.getElementById('floor_number').value,
      room_number: document.getElementById('room_number').value.trim(),
      apartment_number: document.getElementById('apartment_number').value.trim(),
      status: document.getElementById('status').value
    };
    try {
      var res = await fetch('/api/students', {
        method: 'POST',
        headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
        body: JSON.stringify(data)
      });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.ok) {
        var createdStudent = await res.json();
        await fetch('/api/requests', {
          method: 'POST',
          headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
          body: JSON.stringify({ requestType: 'housing', studentId: createdStudent.id, submittedBy: USER_ID })
        });
        showToast(t('reg_toastSuccess'));
        resetForm();
      } else {
        var err = await res.json().catch(function () { return {}; });
        showToast(t('reg_toastErrorFmt').replace('{0}', (err.message || t('reg_errGeneric'))), true);
      }
    } catch (e) {
      showToast(t('reg_toastConnError'), true);
    } finally {
      btn.classList.remove('loading');
    }
  }

  function resetForm() {
    NuhName.clear('');
    ['student_id', 'national_id', 'phone', 'ad_username'].forEach(function (id) {
      document.getElementById(id).value = '';
      document.getElementById(id).classList.remove('error');
    });
    ['college', 'department', 'academic_level', 'gender', 'housing_building', 'floor_number', 'apartment_number', 'room_number', 'status'].forEach(function (id) {
      document.getElementById(id).selectedIndex = 0;
      document.getElementById(id).classList.remove('error');
    });
    document.querySelectorAll('.field-error').forEach(function (e) { e.classList.remove('show'); });
  }

  function showToast(msg, isError) {
    var t = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    t.style.background = isError ? '#991B1B' : '#0F6E56';
    t.classList.add('show');
    setTimeout(function () { t.classList.remove('show'); }, 3500);
  }

  function digitsOnly(e) { e.value = e.value.replace(/\D/g, ''); }
  function validateField(id, valId, regex) {
    var el = document.getElementById(id);
    var val = document.getElementById(valId);
    if (el.value.trim() && !regex.test(el.value.trim())) { el.classList.add('error'); if (val) val.classList.add('show'); }
    else { el.classList.remove('error'); if (val) val.classList.remove('show'); }
  }
  ['student_id', 'national_id', 'phone'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', function () { digitsOnly(this); });
  });
  NuhName.attach('');
  document.getElementById('student_id').addEventListener('input', function () {
    // معاينة اسم مستخدم الشبكة — ADProvisioningService بيبنيه كده بالظبط
    document.getElementById('ad_username').value = this.value.trim() ? 'h' + this.value.trim() : '';
    validateField('student_id', 'val-student_id_start', /^4/);
    validateField('student_id', 'val-student_id', /^\d{9}$/);
    var err = document.getElementById('err-student_id'); if (this.value.trim()) err.classList.remove('show');
  });
  document.getElementById('national_id').addEventListener('input', function () {
    validateField('national_id', 'val-national_id', /^\d{10}$/);
    var err = document.getElementById('err-national_id'); if (this.value.trim()) err.classList.remove('show');
  });
  // القاعدة كلها في js/phone-field.js — نفس ملف شاشات الطالب
  NuhPhone.attach({ input: 'phone', wrap: 'phoneWrap' });
  document.getElementById('phone').addEventListener('input', function () {
    validateField('phone', 'val-phone', NuhPhone.VALID);
  });

  // ===== القوائم المنسدلة من قاعدة البيانات (lookups) =====
  // بنستبدل الخيارات الثابتة فقط لو الـ API رجّع بيانات؛ لو القوائم لسه ماتهاجرتش
  // بتفضل الخيارات الثابتة كما هي فالتسجيل ما بيقفش أبدًا.
  var lkCollege = document.getElementById('college');
  var lkDept = document.getElementById('department');
  var lkLevel = document.getElementById('academic_level');
  var lkBuilding = document.getElementById('housing_building');
  var lkGender = document.getElementById('gender');

  async function lkLoadColleges() {
    var i = await Lookups.fetchList('/api/lookups/colleges');
    if (i.length) Lookups.fill(lkCollege, i, { keep: lkCollege.value });
  }
  // ⚠️ قائمة الأقسام كانت بتتحمّل بكل الأقسام من كل الكليات قبل اختيار الكلية،
  //    فبتفتح على عشرات الخيارات المختلطة وممكن يتختار قسم لا يتبع الكلية.
  //    القاعدة اتنقلت لـ lookups.js (Lookups.dependent) — نفس المكان اللي
  //    بوابة الطالب بتقرا منه، فالشاشتين بيتصرّفوا بنفس الطريقة.
  var deptGate = Lookups.dependent({
    parent: lkCollege,
    child: lkDept,
    url: function (id) { return '/api/lookups/departments' + (id ? ('?collegeId=' + id) : ''); },
    fallbackUrl: '/api/lookups/departments',
    waitText: '@SharedLocalizer["reg_optSelectCollegeFirst"]',
    chooseText: '@SharedLocalizer["reg_optSelectDepartment"]'
  });
  async function lkLoadLevels() {
    var i = await Lookups.fetchList('/api/lookups/academic-levels');
    if (i.length) Lookups.fill(lkLevel, i, { keep: lkLevel.value });
  }
  // احتياطي لو جداول القوائم لسه ماتهاجرتش — نفس التوزيع المعتمد
  var FALLBACK_BUILDINGS = { male: ['65','66','67','68','69','70'], female: ['40','41','42','43'] };
  var BLD_PH = @Html.Raw(__bldPlaceholders);

  // الشقة بتتولد من الدور، والغرفة 1-4 — نفس منطق شاشة تسجيل الطالب بالحرف
  NuhHousing.attach({
    floor: 'floor_number', apartment: 'apartment_number', room: 'room_number',
    labels: { floorFirst: BLD_PH.floorFirst, selectApartment: BLD_PH.selectApartment, selectRoom: BLD_PH.selectRoom }
  });

  async function lkLoadBuildings(gender) {
    // ⚠️ من غير نوع: القائمة تتفضّى وتتقفل. الكود القديم كان بيعمل return
    //    ويسيب الخيارات اللي في الصفحة، فكانت كل المباني بتبان قبل اختيار النوع
    //    وممكن المشرف يسكّن طالب في مبنى مش بتاع نوعه.
    lkBuilding.innerHTML = '';
    var ph = document.createElement('option');
    ph.value = '';
    lkBuilding.appendChild(ph);

    if (!gender) {
      ph.textContent = BLD_PH.genderFirst;
      lkBuilding.disabled = true;
      lkBuilding.value = '';
      return;
    }

    ph.textContent = BLD_PH.selectBuilding;
    lkBuilding.disabled = false;

    var i = await Lookups.fetchList('/api/lookups/buildings?gender=' + encodeURIComponent(gender));
    if (i.length) { Lookups.fill(lkBuilding, i, { keep: '' }); return; }

    // القوائم مش متاحة — نرجع للتوزيع الثابت بدل ما القائمة تفضل فاضية
    (FALLBACK_BUILDINGS[gender] || []).forEach(function (code) {
      var o = document.createElement('option');
      o.value = code; o.textContent = code;
      lkBuilding.appendChild(o);
    });
  }

  // الأقسام تتفلتر حسب الكلية، والمباني حسب النوع
  // تغيير الكلية بيحدّث الأقسام من جوّه Lookups.dependent — مفيش ربط تاني هنا.
  lkGender.addEventListener('change', function () { lkLoadBuildings(lkGender.value); });

  lkLoadColleges().then(function () { deptGate.refresh(); });
  lkLoadLevels();
  lkLoadBuildings(lkGender.value); // الحالة الابتدائية: مقفولة لحد ما يتحدد النوع

  window.onLanguageChange = function () { /* لا نص ديناميكي دائم يحتاج إعادة تطبيق */ };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
</script>
}
