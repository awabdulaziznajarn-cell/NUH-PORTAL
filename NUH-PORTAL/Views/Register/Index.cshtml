@{
    ViewData["Title"] = SharedLocalizer["Page_Register"].Value;
    var role = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "").ToLowerInvariant();
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
    var canRegister = role != "user" && role != "cyber";
}

<style>
  /* خاص بصفحة التسجيل فقط — الباقي من site.css */
  .breadcrumb{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--gray-500);margin-bottom:20px}
  .breadcrumb a{color:var(--navy);text-decoration:none;font-weight:500}
  .breadcrumb span{color:var(--gray-300)}
  .form-card{background:var(--white);border-radius:16px;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(27,42,94,.05);overflow:hidden;margin-bottom:20px}
  .form-card-header{padding:18px 24px;border-bottom:1px solid var(--gray-100);display:flex;align-items:center;gap:10px}
  .form-card-header-icon{width:36px;height:36px;border-radius:10px;background:var(--gray-100);display:flex;align-items:center;justify-content:center}
  .form-card-title{font-size:15px;font-weight:700;color:var(--navy-dark)}
  .form-card-body{padding:24px}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .form-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px}
  .field{display:flex;flex-direction:column;gap:7px}
  .field label{font-size:13px;font-weight:600;color:var(--gray-700)}
  .field label span{color:#EF4444;margin-right:2px}
  .input-wrap{position:relative}
  .input-wrap input,.input-wrap select{width:100%;height:46px;background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:10px;padding:0 14px 0 40px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;color:var(--navy-dark);transition:all .2s;appearance:none;outline:none}
  .input-wrap input:focus,.input-wrap select:focus{border-color:var(--navy);background:var(--white);box-shadow:0 0 0 3px rgba(27,42,94,.08)}
  .input-wrap input.error,.input-wrap select.error{border-color:#EF4444}
  .input-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gray-300);pointer-events:none}
  .field-error{font-size:11px;color:#EF4444;font-weight:500;display:none}
  .field-error.show{display:block}
  .form-actions{display:flex;gap:12px;justify-content:flex-end;padding:20px 24px;border-top:1px solid var(--gray-100)}
  .form-actions .btn{padding:0 28px;height:46px;border-radius:10px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;font-weight:700;cursor:pointer;border:none;transition:all .2s;display:flex;align-items:center;gap:8px}
  .btn-secondary{background:var(--gray-100);color:var(--gray-700)}
  .form-actions .btn.loading{pointer-events:none;opacity:.75}
  .form-actions .btn .spinner{width:18px;height:18px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;display:none}
  .form-actions .btn.loading .spinner{display:block}
  .form-actions .btn.loading .btn-text{display:none}
  @@keyframes spin{to{transform:rotate(360deg)}}
  .toast{position:fixed;top:24px;left:50%;transform:translateX(-50%) translateY(-80px);background:var(--green);color:#fff;padding:14px 24px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.2);z-index:999;transition:transform .4s cubic-bezier(.16,1,.3,1);display:flex;align-items:center;gap:10px}
  .toast.show{transform:translateX(-50%) translateY(0)}
</style>

<div class="breadcrumb">
