@{
    ViewData["Title"] = SharedLocalizer["sil_pageTitle"].Value;
}

<style>
  .badge-ok{background:var(--green-light);color:var(--green)}
  .badge-fail{background:var(--red-light);color:var(--red)}
  .badge-out{background:var(--gray-100);color:var(--gray-700)}
  .badge-method{background:#eff4ff;color:#1849a9;font-size:11px}
  .mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}
</style>

<div class="page-header">
  <h2>@SharedLocalizer["sil_pageTitle"]</h2>
  <p>@SharedLocalizer["sil_pageSubtitle"]</p>
</div>

<div class="filters-bar">
  <div class="filter-group">
    <label for="eventFilter">@SharedLocalizer["sil_lblEvent"]</label>
    <select id="eventFilter">
      <option value="">@SharedLocalizer["sil_evt_all"]</option>
      <option value="login_success">@SharedLocalizer["sil_evt_login_success"]</option>
      <option value="login_failed">@SharedLocalizer["sil_evt_login_failed"]</option>
      <option value="logout">@SharedLocalizer["sil_evt_logout"]</option>
    </select>
  </div>
  <div class="filter-group">
    <label for="searchBox">@SharedLocalizer["sil_search"]</label>
    <input type="text" id="searchBox" placeholder="">
  </div>
  <div class="filter-group">
    <label for="fromDate">@SharedLocalizer["sil_fromDate"]</label>
    <input type="date" id="fromDate">
  </div>
  <div class="filter-group">
    <label for="toDate">@SharedLocalizer["sil_toDate"]</label>
    <input type="date" id="toDate">
  </div>
</div>

<div class="card">
  <div style="overflow-x:auto">
    @* ⚠️ عمود «#» و«عنوان IP» من غير data-sort عن قصد: الأول ترقيم عرض
       مالوش وجود في قاعدة البيانات، والتاني نصّ زي 10.20.3.44 بيترتّب
       أبجديًّا لا رقميًّا — فـ 10 بيجي قبل 9 والترتيب بيبان غلط. *@
    <table id="silTable">
      <thead>
        <tr>
          <th>@SharedLocalizer["col_seq"]</th>
          <th data-sort="occurred_at">@SharedLocalizer["sil_col_time"]</th>
          <th data-sort="username">@SharedLocalizer["sil_col_user"]</th>
          <th data-sort="full_name">@SharedLocalizer["sil_col_fullName"]</th>
          <th data-sort="event_type">@SharedLocalizer["sil_col_event"]</th>
          <th data-sort="method">@SharedLocalizer["sil_col_method"]</th>
          <th data-sort="success">@SharedLocalizer["sil_col_result"]</th>
          <th>@SharedLocalizer["sil_col_ip"]</th>
        </tr>
      </thead>
      <tbody id="tbody">
        <tr><td colspan="8" style="text-align:center;padding:60px 20px"><div class="spinner"></div></td></tr>
      </tbody>
    </table>
  </div>
</div>

@* صفّ الترقيم من NuhTable.pager - النسخة الوحيدة في النظام (js/table-state.js) *@
<div id="silPager"></div>

@section Scripts {
<script src="/i18n.js"></script>
<script>
  // الصفحة والفلاتر في الرابط - NuhUrl في js/url-state.js.
  // ⚠️ الشاشة مابتخرجش لصفحة تانية بنفسها، لكن الخروج من القائمة الجانبية
  //    والرجوع كان بيمسح مدى التاريخ والبحث والصفحة - وسجل الدخول بالذات
  //    بيتفلتر على مدى تاريخ ضيّق وبيتنقّل فيه صفحات كتير.
  var SIL_EVENTS = ['', 'login_success', 'login_failed', 'logout'];
  var page = NuhUrl.int('page', 1, 1), pageSize = 50, totalPages = 1, cache = [];
  var SIL_DEFAULTS = { page: 1, event: '', q: '', from: '', to: '', sort: '', asc: '' };

  function syncUrl() {
    NuhUrl.sync({
      page: page,
      event: document.getElementById('eventFilter').value,
      q: document.getElementById('searchBox').value.trim(),
      from: document.getElementById('fromDate').value,
      to: document.getElementById('toDate').value,
      sort: silSort.by(), asc: silSort.by() ? (silSort.asc() ? '1' : '0') : ''
    }, SIL_DEFAULTS);
  }
  // تهريب HTML — التعريف الوحيد في /js/esc.js
  var esc = function (v) { return escHtml(v); };
  // الجدول وحالاته من NuhTable، والترويسات من NUH.headers في التخطيط — مفيش نسخة محلية.
  var silTable = NuhTable.bind('tbody', 8);

  // شكل التاريخ من NuhFmt — التعريف الوحيد في /js/date-format.js
  function fmt(v) { return NuhFmt.dateTime(v); }

  function eventBadge(ev, success) {
    if (ev === 'logout') return '<span class="badge badge-out">' + t('sil_evt_logout') + '</span>';
    if (ev === 'login_failed' || !success) return '<span class="badge badge-fail">' + t('sil_evt_login_failed') + '</span>';
    return '<span class="badge badge-ok">' + t('sil_evt_login_success') + '</span>';
  }

  function buildUrl() {
    syncUrl();
    var u = '/api/logs/signins?page=' + page + '&pageSize=' + pageSize;
    var ev = document.getElementById('eventFilter').value;
    var s = document.getElementById('searchBox').value.trim();
    var f = document.getElementById('fromDate').value;
    var tt = document.getElementById('toDate').value;
    if (ev) u += '&eventType=' + encodeURIComponent(ev);
    if (s) u += '&search=' + encodeURIComponent(s);
    if (f) u += '&fromDate=' + encodeURIComponent(f);
    if (tt) u += '&toDate=' + encodeURIComponent(tt);
    return u + silSort.qs();
  }

  // ⚠️ setLang تستدعي onLanguageChange المربوطة بـ render، فكانت الصفحة ترسم
  //    «لا توجد سجلات» قبل انطلاق أول نداء، ثم تمتلئ فجأة. أي بطء عادي كان
  //    يبدو كعطل. التفرقة نفسها صارت في NuhTable لكل الشاشات.

  function render() {
    if (!silTable.isDone()) return silTable.loading();
    if (!cache.length) return silTable.rows('', t('sil_noItems'));
    silTable.rows(cache.map(function (s, i) {
      var n = (page - 1) * pageSize + i + 1;
      // ⚠️ كان صف الخروج بيعرض «-» في خانة النتيجة بافتراض إن الخروج ملوش نتيجة.
      //    لكن السجل نفسه بيخزّن success لكل الأحداث بما فيها الخروج،
      //    فالعمود كان يبان فاضي كأنه بيان ناقص. دلوقتي بيقرا من نفس الحقل لكل الصفوف.
      var result = s.success
        ? '<span class="badge badge-ok">' + t('sil_result_success') + '</span>'
        : '<span class="badge badge-fail">' + t('sil_result_fail') + '</span>';
      return '<tr>' +
        '<td style="color:var(--gray-500)">' + n + '</td>' +
        '<td>' + fmt(s.occurredAt) + '</td>' +
        '<td class="mono">' + esc(s.username || '-') + '</td>' +
        '<td>' + esc(s.fullName || '-') + '</td>' +
        '<td>' + eventBadge(s.eventType, s.success) + '</td>' +
        '<td>' + (s.method ? '<span class="badge badge-method">' + esc(s.method) + '</span>' : '-') + '</td>' +
        '<td>' + result + '</td>' +
        '<td class="mono">' + esc(s.ipAddress || '-') + '</td></tr>';
    }).join(''), t('sil_noItems'));
  }

  async function load() {
    try {
      var res = await fetch(buildUrl(), { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (!res.ok) { silTable.error(t('sil_loadError')); return; }
      var body = await res.json();
      silTable.done();
      cache = body.data || [];
      totalPages = body.totalPages || 1;
      render();
      NuhTable.pager('silPager',
        { page: page, pageSize: pageSize, total: body.totalRecords || 0, totalPages: totalPages },
        {
          summary: t('sil_totalFmt').replace('{0}', body.totalRecords || 0),
          prev: t('aud_prev'), next: t('aud_next')
        },
        function (p) { page = p; load(); });
    } catch (e) { silTable.error(t('sil_loadError')); }
  }

  // ترتيب الأعمدة من نسخة واحدة في النظام — NuhTable.sort. الأعمدة معرّفة
  // بـ data-sort على الـ <th>، والخادم هو اللي بيرتّب (الجدول مقسّم صفحات،
  // والترتيب في المتصفح كان هيرتّب الصفحة اللي قدامك بس).
  var silSort = NuhTable.sort('silTable', function () { page = 1; load(); },
    { by: NuhUrl.get('sort', ''), asc: NuhUrl.get('asc', '1') === '1' });

  function onFilter() { page = 1; load(); }
  document.getElementById('eventFilter').addEventListener('change', onFilter);
  document.getElementById('searchBox').addEventListener('keyup', function (e) { if (e.key === 'Enter') onFilter(); });
  document.getElementById('fromDate').addEventListener('change', onFilter);
  document.getElementById('toDate').addEventListener('change', onFilter);

  window.onLanguageChange = function () { render(); };
  setLang(localStorage.getItem('uiLanguage') || 'ar');

  (function initFromUrl() {
    document.getElementById('eventFilter').value = NuhUrl.one('event', SIL_EVENTS, '');
    document.getElementById('searchBox').value = NuhUrl.get('q', '');
    document.getElementById('fromDate').value = NuhUrl.date('from');
    document.getElementById('toDate').value = NuhUrl.date('to');
    if (window.NuhSelect && NuhSelect.enhance) NuhSelect.enhance(document);
  })();

  load();
</script>
}
