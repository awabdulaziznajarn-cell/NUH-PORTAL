@{
    ViewData["Title"] = SharedLocalizer["sil_pageTitle"].Value;
}

<style>
  .filters-bar{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:16px;align-items:end}
  .filter-group{display:flex;flex-direction:column;gap:4px}
  .filter-group label{font-size:11px;font-weight:600;color:var(--gray-500)}
  .filter-group select,.filter-group input{padding:8px 10px;border:1px solid var(--gray-200);border-radius:8px;font-family:inherit;font-size:13px;background:var(--white);color:var(--navy-dark);min-width:150px}
  .spinner{width:32px;height:32px;border:3px solid var(--gray-200);border-top-color:var(--navy);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto}
  @@keyframes spin{to{transform:rotate(360deg)}}
  .badge-ok{background:var(--green-light);color:var(--green)}
  .badge-fail{background:var(--red-light);color:var(--red)}
  .badge-out{background:var(--gray-100);color:var(--gray-700)}
  .badge-method{background:#EEF2FF;color:#3730A3;font-size:11px}
  .mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}
</style>

<div class="page-header">
  <h2>@SharedLocalizer["sil_pageTitle"]</h2>
  <p>@SharedLocalizer["sil_pageSubtitle"]</p>
</div>

<div class="filters-bar">
  <div class="filter-group">
    <label>@SharedLocalizer["sil_lblEvent"]</label>
    <select id="eventFilter">
      <option value="">@SharedLocalizer["sil_evt_all"]</option>
      <option value="login_success">@SharedLocalizer["sil_evt_login_success"]</option>
      <option value="login_failed">@SharedLocalizer["sil_evt_login_failed"]</option>
      <option value="logout">@SharedLocalizer["sil_evt_logout"]</option>
    </select>
  </div>
  <div class="filter-group">
    <label>@SharedLocalizer["sil_search"]</label>
    <input type="text" id="searchBox" placeholder="">
  </div>
  <div class="filter-group">
    <label>@SharedLocalizer["sil_fromDate"]</label>
    <input type="date" id="fromDate">
  </div>
  <div class="filter-group">
    <label>@SharedLocalizer["sil_toDate"]</label>
    <input type="date" id="toDate">
  </div>
</div>

<div class="card">
  <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>@SharedLocalizer["sil_col_time"]</th>
          <th>@SharedLocalizer["sil_col_user"]</th>
          <th>@SharedLocalizer["sil_col_fullName"]</th>
          <th>@SharedLocalizer["sil_col_event"]</th>
          <th>@SharedLocalizer["sil_col_method"]</th>
          <th>@SharedLocalizer["sil_col_result"]</th>
          <th>@SharedLocalizer["sil_col_ip"]</th>
        </tr>
      </thead>
      <tbody id="tbody">
        <tr><td colspan="8" style="text-align:center;padding:60px 20px"><div class="spinner"></div></td></tr>
      </tbody>
    </table>
  </div>
</div>

<div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:16px;padding:0 4px">
  <span id="totalLabel" style="font-size:13px;color:var(--gray-500)"></span>
  <button id="prevBtn" class="btn btn-cancel" disabled>@SharedLocalizer["aud_prev"]</button>
  <span id="pageInd" style="font-size:13px;font-weight:600;color:var(--navy-dark);min-width:60px;text-align:center">1 / 1</span>
  <button id="nextBtn" class="btn btn-cancel" disabled>@SharedLocalizer["aud_next"]</button>
</div>

@section Scripts {
<script src="/i18n.js"></script>
<script>
  var page = 1, pageSize = 50, totalPages = 1, cache = [];
  var esc = function (v) { return String(v == null ? '' : v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); };
  function authHeaders() { var tk = localStorage.getItem('staffToken'); return tk ? { 'Authorization': 'Bearer ' + tk } : {}; }

  function fmt(d) {
    if (!d) return '';
    var x = new Date(d); if (isNaN(x.getTime())) return '';
    var p = function (n) { return String(n).padStart(2, '0'); };
    return p(x.getDate()) + '/' + p(x.getMonth() + 1) + '/' + x.getFullYear() + ' ' + p(x.getHours()) + ':' + p(x.getMinutes());
  }

  function eventBadge(ev, success) {
    if (ev === 'logout') return '<span class="badge badge-out">' + t('sil_evt_logout') + '</span>';
    if (ev === 'login_failed' || !success) return '<span class="badge badge-fail">' + t('sil_evt_login_failed') + '</span>';
    return '<span class="badge badge-ok">' + t('sil_evt_login_success') + '</span>';
  }

  function buildUrl() {
    var u = '/api/logs/signins?page=' + page + '&pageSize=' + pageSize;
    var ev = document.getElementById('eventFilter').value;
    var s = document.getElementById('searchBox').value.trim();
    var f = document.getElementById('fromDate').value;
    var tt = document.getElementById('toDate').value;
    if (ev) u += '&eventType=' + encodeURIComponent(ev);
    if (s) u += '&search=' + encodeURIComponent(s);
    if (f) u += '&fromDate=' + encodeURIComponent(f);
    if (tt) u += '&toDate=' + encodeURIComponent(tt);
    return u;
  }

  function render() {
    var tb = document.getElementById('tbody');
    if (!cache.length) { tb.innerHTML = '<tr><td colspan="8" style="text-align:center;color:var(--gray-500);padding:40px">' + t('sil_noItems') + '</td></tr>'; return; }
    tb.innerHTML = cache.map(function (s, i) {
      var n = (page - 1) * pageSize + i + 1;
      var result = s.eventType === 'logout'
        ? '—'
        : (s.success ? '<span class="badge badge-ok">' + t('sil_result_success') + '</span>' : '<span class="badge badge-fail">' + t('sil_result_fail') + '</span>');
      return '<tr>' +
        '<td style="color:var(--gray-500)">' + n + '</td>' +
        '<td>' + fmt(s.occurredAt) + '</td>' +
        '<td class="mono">' + esc(s.username || '—') + '</td>' +
        '<td>' + esc(s.fullName || '—') + '</td>' +
        '<td>' + eventBadge(s.eventType, s.success) + '</td>' +
        '<td>' + (s.method ? '<span class="badge badge-method">' + esc(s.method) + '</span>' : '—') + '</td>' +
        '<td>' + result + '</td>' +
        '<td class="mono">' + esc(s.ipAddress || '—') + '</td></tr>';
    }).join('');
  }

  async function load() {
    try {
      var res = await fetch(buildUrl(), { headers: authHeaders() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (!res.ok) { document.getElementById('tbody').innerHTML = '<tr><td colspan="8" style="text-align:center;color:#991B1B;padding:40px">' + t('sil_loadError') + '</td></tr>'; return; }
      var body = await res.json();
      cache = body.data || [];
      totalPages = body.totalPages || 1;
      render();
      document.getElementById('pageInd').textContent = page + ' / ' + totalPages;
      document.getElementById('prevBtn').disabled = page <= 1;
      document.getElementById('nextBtn').disabled = page >= totalPages;
      document.getElementById('totalLabel').textContent = t('sil_totalFmt').replace('{0}', body.totalRecords || 0);
    } catch (e) { document.getElementById('tbody').innerHTML = '<tr><td colspan="8" style="text-align:center;color:#991B1B;padding:40px">' + t('sil_loadError') + '</td></tr>'; }
  }

  function onFilter() { page = 1; load(); }
  document.getElementById('prevBtn').addEventListener('click', function () { if (page > 1) { page--; load(); } });
  document.getElementById('nextBtn').addEventListener('click', function () { if (page < totalPages) { page++; load(); } });
  document.getElementById('eventFilter').addEventListener('change', onFilter);
  document.getElementById('searchBox').addEventListener('keyup', function (e) { if (e.key === 'Enter') onFilter(); });
  document.getElementById('fromDate').addEventListener('change', onFilter);
  document.getElementById('toDate').addEventListener('change', onFilter);

  window.onLanguageChange = function () { render(); };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
  load();
</script>
}
