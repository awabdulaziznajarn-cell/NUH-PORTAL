@using System.Text.Json
@{
    ViewData["Title"] = SharedLocalizer["fh_HandoverTitle"].Value;

    // ⚠️ النصوص من SharedResource كبقية الشاشة: ملف .js لا يمر على Razor.
    string L(string k) => SharedLocalizer[k].Value;
    var keys = new[]
    {
        "fh_Loading","fh_NoUnits","fh_LoadError","fh_BtnSelect","fh_UnitsList",
        "fh_StOccupied","fh_StVacant","fh_StOutOfService","fh_StNotExists","fh_StPendingSync",
        "fh_NoOccupant","fh_NotAssignable","fh_Tower",
        "fh_PagerShow","fh_PagerTo","fh_PagerOf","fh_Page","fh_PageOf","fh_Prev","fh_Next"
    };
    var fhT = JsonSerializer.Serialize(keys.ToDictionary(k => k, k => L(k)));
}

@*
    ⚠️ البطاقة والجدول وحقل البحث من site.css و components.css المشتركة —
       نفس مكوّنات بقية الشاشات، فلا تنحرف هذه عنها مع أي تعديل على التصميم.
*@
<div class="page-header" style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap">
  <div>
    <h2>@SharedLocalizer["fh_HandoverTitle"]</h2>
    <p>@SharedLocalizer["fh_SelectUnitSub"]</p>
  </div>
  <a class="btn btn-cancel" href="/FacultyHousing">← @SharedLocalizer["fh_UnitsList"]</a>
</div>

<div class="card">
  <div class="card-header">
    <div class="card-title">@SharedLocalizer["fh_UnitsList"]</div>
    @*
        ⚠️ الفلاتر هنا تخدم سؤال الشاشة وحده - «أي وحدة؟» - فاقتصرت على
           النوع والبرج وحالة الإشغال. ولم تُدرَج «خارج الخدمة» و«غير موجودة»
           و«بانتظار المزامنة» رغم دعم الخادم لها: وحدة بهذه الحالات لا تُسكَّن
           أصلًا، فعرضها يقود المستخدم إلى صف بلا زر اختيار.
           الصف والقوائم والبحث كلها من .card-tools المشتركة - نفس مكوّنات
           قائمة أعضاء هيئة التدريس بالضبط، فلا تنحرف الشاشتان عن بعضهما.
    *@
    <div class="card-tools">
      <div class="fh-seg" id="fhTypeSeg">
        <button class="is-on" data-type="">@SharedLocalizer["fh_All"]</button>
        <button data-type="tower">@SharedLocalizer["fh_Towers"]</button>
        <button data-type="villa">@SharedLocalizer["fh_Villas"]</button>
      </div>
      <select id="fhStatus">
        <option value="">@SharedLocalizer["fh_AllStatuses"]</option>
        <option value="occupied">@SharedLocalizer["fh_StOccupied"]</option>
        <option value="vacant">@SharedLocalizer["fh_StVacant"]</option>
      </select>
      <select id="fhTower">
        <option value="">@SharedLocalizer["fh_AllTowers"]</option>
      </select>
      <div class="search-wrap">
        <input type="text" id="fhSearch" placeholder="@SharedLocalizer["fh_SearchPh"]" autofocus>
      </div>
    </div>
  </div>
  <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>@SharedLocalizer["fh_ColUnit"]</th>
          <th>@SharedLocalizer["fh_ColAccount"]</th>
          <th>@SharedLocalizer["fh_ColOccupant"]</th>
          <th>@SharedLocalizer["fh_ColStatus"]</th>
          <th>@SharedLocalizer["fh_ColActions"]</th>
        </tr>
      </thead>
      <tbody id="fhBody">
        <tr><td colspan="5" class="fh-empty">@SharedLocalizer["fh_Loading"]</td></tr>
      </tbody>
    </table>
  </div>
  @* صفّ الترقيم نفسه المستخدم في قائمة أعضاء هيئة التدريس - .table-pager من site.css *@
  <div id="fhPager" class="table-pager"></div>
</div>

@section Scripts {
  <script>window.FH_T = @Html.Raw(fhT);</script>
  <script src="~/js/faculty-housing-select.js" asp-append-version="true"></script>
}
