<style>
  /* خاص بشاشة سكن أعضاء هيئة التدريس — الباقي من site.css و components.css */
  .fh-stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:22px}
  .fh-stat{background:var(--white);border-radius:14px;padding:15px 18px;border:1px solid var(--gray-100);
           box-shadow:0 2px 8px rgba(16,70,49,.05);display:flex;flex-direction:column;gap:5px;
           cursor:pointer;transition:transform .18s,box-shadow .18s,border-color .18s}
  .fh-stat:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(16,70,49,.1)}
  .fh-stat.is-on{border-color:var(--gold-ink);box-shadow:0 0 0 3px rgba(219,161,2,.18)}
  .fh-stat-num{font-size:25px;font-weight:900;color:var(--navy-dark);line-height:1}
  .fh-stat-label{font-size:11.5px;color:var(--gray-500);font-weight:500}
  .fh-stat.ok .fh-stat-num{color:var(--green)}
  .fh-stat.warn .fh-stat-num{color:#93370d}
  .fh-stat.bad .fh-stat-num{color:var(--red)}

  .fh-flag{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;
           padding:2px 8px;border-radius:20px;background:var(--gold-pale);color:#93370d;white-space:nowrap}
  /* ⚠️ رمادية لا كهرمانية: «مُعطَّل» حالة قائمة في الدليل قد تكون مقصودة،
     مش مخالفة في بياناتنا زي «اسم مخالف» و«وحدة تنظيمية». لون التحذير
     على حاجة متعمَّدة بيعلّم المستخدم يتجاهل اللون. */
  .fh-flag-off{background:var(--gray-100);color:var(--gray-700)}

  /* ترويسة سجل الوحدة: اسم الدخول ومسار الحساب في الدليل.
     ⚠️ الاتنين لاتينيان طويلان جوّه صفحة عربية، فالعزل الاتجاهي شرط لا زينة:
        من غيره بتتقدّم اللاحقة على المقدّمة وتتقرا الحاجة بالمقلوب.
     ⚠️ وde بدل style مكتوب جوه السكربت: القيمة كانت مكتوبة في نصّ HTML
        داخل faculty-housing-page.js، فتنسيق الترويسة كان في ملفين. */
  .fh-upn{font-family:Consolas,'Courier New',monospace;font-size:11.5px;color:var(--gray-700);
          direction:ltr;unicode-bidi:isolate;display:inline-block;word-break:break-all}
  .fh-dn-inline{font-family:Consolas,'Courier New',monospace;font-size:10.5px;color:var(--gray-500);
                direction:ltr;unicode-bidi:isolate;display:inline-block;word-break:break-all}

  /* الاستيراد */
  .fh-imp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-bottom:16px}
  .fh-ou{border:1px solid var(--gray-200);border-radius:12px;padding:13px 15px;background:var(--gray-50)}
  .fh-ou.ok{border-color:#a9efc5;background:#f3fcf6}
  .fh-ou.bad{border-color:#fda29b;background:var(--red-light)}
  .fh-ou-title{font-size:13px;font-weight:700;color:var(--navy-dark);margin-bottom:6px;
               display:flex;align-items:center;justify-content:space-between;gap:8px}
  .fh-ou-dn{font-family:Consolas,monospace;font-size:10.5px;color:var(--gray-500);
            direction:ltr;text-align:left;word-break:break-all;margin-bottom:8px}
  .fh-attrs{display:flex;flex-wrap:wrap;gap:5px}
  .fh-attr{font-family:Consolas,monospace;font-size:10.5px;padding:2px 7px;border-radius:6px;direction:ltr}
  .fh-attr.y{background:var(--green-light);color:var(--green)}
  .fh-attr.n{background:var(--red-light);color:var(--red)}

  /* ⚠️ شريط المزامنة (.fh-sync*) اتنقل لـ css/components.css - تعريف واحد
        يخدمه ولوحة «إدارة حسابات الإسكان» معًا، بعد ما كانوا نسختين
        مختلفتين لنفس الفكرة: واحدة رأسها أخضر فاتح والتانية أزرق كامل.
        الشرح كامل هناك. */

  /* نتيجة فحص الصلاحيات — خلاصة ثم جدول */
  .fh-verdict{display:flex;align-items:center;gap:10px;padding:11px 15px;border-radius:12px;
              font-size:14px;font-weight:700;margin-bottom:13px}
  .fh-verdict.ok{background:var(--green-light);color:var(--green)}
  .fh-verdict.bad{background:var(--red-light);color:var(--red)}
  .fh-vic{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:13px;flex:none}
  .fh-verdict.ok .fh-vic{background:var(--green)}
  .fh-verdict.bad .fh-vic{background:var(--red)}
  .fh-verdict span.fh-vsub{font-weight:400;font-size:12.5px;opacity:.92}
  table.fh-acc{width:100%;border-collapse:collapse;font-size:12.5px}
  table.fh-acc th{background:var(--gray-50);color:var(--gray-500);font-weight:600;padding:8px 11px;
                  border-bottom:1px solid var(--gray-100);text-align:center;white-space:nowrap}
  table.fh-acc th:first-child,table.fh-acc td:first-child{text-align:start}
  /* اسم الوحدة يأخذ نصيبه من العرض؛ خانات العلامات لا تحتاج أكثر من قدرها */
  table.fh-acc th:first-child{width:40%}
  table.fh-acc td{padding:10px 11px;border-bottom:1px solid var(--gray-100);text-align:center;color:var(--gray-700)}
  table.fh-acc tr:last-child td{border-bottom:none}
  table.fh-acc tr.bad td{background:#fff8f7}
  table.fh-acc td:first-child{font-weight:600;color:var(--navy-dark)}
  .fh-acc-y{color:var(--green);font-weight:800}
  .fh-acc-n{color:var(--red);font-weight:800}
  .fh-acc-na{color:var(--gray-300)}
  .fh-acc-cnt{font-variant-numeric:tabular-nums}
  /* الاسم التقني للوحدة في الدليل — بجانب اسمها المقروء */
  .fh-ouname{font-family:Consolas,monospace;font-size:10.5px;background:var(--gray-100);color:var(--gray-700);
             padding:1px 7px;border-radius:6px;direction:ltr;display:inline-block;margin-inline-start:6px}
  .fh-det-btn{margin-top:11px;font-family:inherit;font-size:11.5px;color:var(--gray-500);cursor:pointer;
              background:var(--gray-50);border:1px solid var(--gray-200);border-radius:9px;padding:5px 12px}
  .fh-det-btn:hover{border-color:var(--navy);color:var(--navy)}
  .fh-det-btn:focus-visible{outline:2px solid var(--gold-ink);outline-offset:2px}
  .fh-det-box{margin-top:10px;background:var(--gray-50);border:1px solid var(--gray-100);border-radius:11px;
              padding:11px 14px;font-size:11.5px;color:var(--gray-700);line-height:2}
  .fh-det-box + .fh-det-box{margin-top:7px}
  /* الفقرة الشارحة — سطر واحد يفتح عند الطلب */
  .fh-shortnote{display:flex;align-items:center;gap:9px;font-size:12.5px;color:var(--gray-500);
                margin-bottom:12px;flex-wrap:wrap}
  .fh-shortnote button{font-family:inherit;font-size:11.5px;font-weight:700;color:var(--navy);background:none;
                       border:none;border-bottom:1px dashed var(--navy);cursor:pointer;padding:0}

  /* ---------- معاينة الاستيراد: شرائح تفلتر وصفوف ملوّنة ---------- */
  /* ⚠️ الشريحة زرّ لا شارة: هي بتفلتر الجدول، فلازم تبان إنها بتتضغط -
     مؤشّر اليد وحدّ بيتلوّن عند المرور. الشكل الأساسي زي .badge-sync
     عشان ما تبقاش عنصرًا جديدًا في الشاشة. */
  .fh-pvchips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
  .fh-pvchip{font-family:inherit;font-size:11.5px;font-weight:600;padding:4px 11px;border-radius:999px;
    background:var(--gray-50);color:var(--gray-700);border:1.5px solid var(--gray-200);cursor:pointer;transition:all .18s}
  /* ⚠️ :not(.is-on) شرط لا زخرفة: قاعدة الـ hover أخصّ من .is-on (صنف +
     محدِّدين زائفين مقابل صنفين)، فكانت بتغلب عليها ونصّ الشريحة المختارة
     يبقى بلون خلفيتها - يعني الشريحة اللي إنت فالتر بيها تختفي كتابتها
     أول ما تحطّ الماوس عليها. */
  .fh-pvchip:hover:not(:disabled):not(.is-on){border-color:var(--navy);color:var(--navy)}
  .fh-pvchip.is-on{background:var(--navy);border-color:var(--navy);color:var(--white)}
  .fh-pvchip.is-on:hover{background:var(--navy-light);border-color:var(--navy-light)}
  /* العدّاد صفر: يبان إنه رقم لا زرّ */
  .fh-pvchip.is-dead{opacity:.55;cursor:default}
  .fh-pvchip:focus-visible{outline:2px solid var(--gold-ink);outline-offset:2px}

  /* ⚠️ خلفية خفيفة لا نصّ ملوّن: النصّ في الصف ده بيانات (اسم ساكن، حساب)،
     وتلوينه بيوحي إن البيانات نفسها فيها حاجة. الخلفية بتوسم **الصف**. */
  tr.fh-pv-new td{background:#f0fdf4}
  tr.fh-pv-chg td{background:#fffbeb}
  tr.fh-pv-ign td{opacity:.6}

  /* سجل الوحدة */
  .tl{position:relative;padding-inline-start:26px}
  .tl::before{content:'';position:absolute;inset-inline-start:7px;top:6px;bottom:6px;width:2px;background:var(--gray-200)}
  .tl-item{position:relative;padding-bottom:20px}
  .tl-item:last-child{padding-bottom:0}
  .tl-dot{position:absolute;inset-inline-start:-26px;top:3px;width:16px;height:16px;border-radius:50%;
          background:var(--gray-300);border:3px solid var(--white);box-shadow:0 0 0 2px var(--gray-200)}
  .tl-item.now .tl-dot{background:var(--green);box-shadow:0 0 0 2px var(--green)}
  .tl-card{background:var(--white);border:1px solid var(--gray-100);border-radius:12px;padding:12px 15px}
  .tl-item.now .tl-card{border-color:#a9efc5;background:#f3fcf6}
  .tl-top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:5px}
  .tl-top b{font-size:14px;color:var(--navy-dark)}
  /* الاسم الإنجليزي تحت العربي - عزل الاتجاه من .cell-en في site.css */
  .tl-en{font-size:11.5px;font-weight:500;color:var(--gray-500);line-height:1.6;margin-top:-2px}
  /* صفوف بيانات الشاغل: عنوان ثابت + قيمة، بدل فقرة نصّ متصلة */
  .oc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:4px 18px;margin-top:8px}
  .oc-row{display:flex;align-items:baseline;gap:8px;padding:3px 0;min-width:0}
  .oc-k{font-size:11.5px;color:var(--gray-500);font-weight:600;flex-shrink:0;min-width:76px}
  .oc-v{font-size:12.5px;color:var(--navy-dark);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .oc-warn{margin-top:10px;padding:8px 12px;border-radius:8px;background:#fffaeb;
           border-inline-start:3px solid var(--gold);font-size:11.5px;color:#93370d;line-height:1.7}
  /* تبويبا نافذة السجل + جدول التعديلات */
  .fh-tabs{display:flex;gap:6px;padding:0 20px;border-bottom:1px solid var(--gray-100);background:var(--white)}
  .fh-tab{border:none;background:none;padding:11px 14px;font-family:inherit;font-size:13px;font-weight:600;
    color:var(--gray-500);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
  .fh-tab:hover{color:var(--navy)}
  .fh-tab.active{color:var(--navy);border-bottom-color:var(--navy)}
  .fh-tabnum{display:inline-block;min-width:18px;padding:0 5px;border-radius:9px;background:var(--gray-100);
    color:var(--gray-700);font-size:11px;font-weight:700;line-height:18px;text-align:center}
  .fh-tab.active .fh-tabnum{background:var(--green-light);color:var(--green)}
  .fh-tab-rep{margin-inline-start:auto;align-self:center;background:var(--navy);color:#fff;font-size:12px;
    font-weight:700;padding:6px 13px;border-radius:8px;text-decoration:none;margin-bottom:6px}
  .fh-tab-rep:hover{background:var(--navy-dark);color:#fff}
  /* ⚠️ ‏.fh-modal* اتشالوا من هنا لـ css/components.css: بقوا مستعملين في
     شاشة «تغيير بيانات ساكن» كمان، ونسختين لنفس النافذة كانوا هيفترقوا عند
     أول تعديل.
     ⚠️ وبطاقة البند (.ch-*) وجدول التغييرات (.chg-tbl) اتشالوا خالص: تبويب
     «التعديلات» بقى خطّ زمني (.nuh-tl) زي تبويب «الشاغلون» جنبه وزي سجل
     إجراءات حساب الطالب - شكل واحد لنفس السؤال في التلات مواضع.
     وقيم التغيير (.chg-old و.chg-new) باقية في components.css وهي نفس
     المكوّن اللي بيستخدمه تفاصيل الطلب.
     واللون الأحمر للقيمة القديمة اتشال لأن الأحمر معناه «خطأ» في النظام
     وده تعديل صحيح مش غلط. */
  .tl-meta{font-size:12px;color:var(--gray-500);line-height:1.95}
  .tl-meta code{font-family:Consolas,monospace;background:var(--gray-50);padding:1px 6px;
                border-radius:5px;direction:ltr;display:inline-block}

</style>

<div class="page-header">
  <h2>@SharedLocalizer["fh_PageTitle"]</h2>
  <p>@SharedLocalizer["fh_PageSub"]</p>
</div>

<div class="fh-stats" id="fhStats"></div>
<div id="fhMsg"></div>

@if (canImport)
{
@* ⚠️ فوق القائمة لا تحتها: الأداتان كانتا في ترويسة بطاقة أسفل جدول يتجاوز
   المئتي صفّ وشريط ترقيم، فمن يقصدهما لا يجدهما. والنتيجة تُفتح في هذا
   الموضع نفسه لا في أسفل الصفحة، حتى لا تعقب كلَّ ضغطة رحلةُ تمرير. *@
<div class="fh-sync" id="fhSyncBox">
  <div class="fh-sync-bar">
    <div class="fh-sync-ttl">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
        <path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
      </svg>
      <span>@SharedLocalizer["fh_SyncTitle"]</span>
    </div>
    <div class="fh-sync-btns">
      <button class="btn btn-cancel" id="fhCheckBtn">@SharedLocalizer["fh_CheckAccess"]</button>
      <button class="btn btn-primary" id="fhPreviewBtn">@SharedLocalizer["fh_PreviewImport"]</button>
      <button type="button" class="fh-sync-x" id="fhSyncClose" hidden
              aria-label="@SharedLocalizer["close"]"><span aria-hidden="true">&times;</span></button>
    </div>
  </div>
  <div class="fh-sync-panel" id="fhSyncPanel" hidden>
    <div id="fhAccess"></div>
    <div id="fhPreview"></div>
  </div>
</div>
}

<div class="card" style="margin-bottom:20px">
  <div class="card-header">
    <div class="card-title">@SharedLocalizer["fh_UnitsList"]</div>
    <div class="card-tools">
      <div class="fh-seg" id="fhTypeSeg">
        <button class="is-on" data-type="">@SharedLocalizer["fh_All"]</button>
        <button data-type="tower">@SharedLocalizer["fh_Towers"]</button>
        <button data-type="villa">@SharedLocalizer["fh_Villas"]</button>
      </div>
      <select id="fhStatus">
        <option value="">@SharedLocalizer["fh_AllStatuses"]</option>
        <option value="occupied">@SharedLocalizer["fh_StOccupied"]</option>
        <option value="vacant">@SharedLocalizer["fh_StVacant"]</option>
        <option value="out_of_service">@SharedLocalizer["fh_StOutOfService"]</option>
        <option value="not_exists">@SharedLocalizer["fh_StNotExists"]</option>
        <option value="pending_sync">@SharedLocalizer["fh_StPendingSync"]</option>
      </select>
      <select id="fhTower">
        <option value="">@SharedLocalizer["fh_AllTowers"]</option>
      </select>
      <div class="search-wrap">
        <input type="text" id="fhSearch" placeholder="@SharedLocalizer["fh_SearchPh"]">
      </div>
    </div>
  </div>
  <div style="overflow-x:auto">
    @* tbl-2line: محاذاة البداية للخلايا و«.num» في الوسط - نفس قاعدة قائمة الطلاب *@
    <table id="fhTable" class="tbl-2line">
      @* ⚠️ ثمانية أعمدة صارت سبعة - نفس قاعدة قائمة الطلاب: كل خلية بسطرين،
         أساسي غامق وثانوي رمادي.
         ⚠️ والهوية والجوال عمود **واحد** بسطرين لا عمودان، تمامًا كعمود
            «الرقم الجامعي والجوال» في قائمة الطلاب - فالشاشتان تُقرآن بالطريقة
            نفسها. وترتيب الجدول بالهوية الوطنية باقٍ على العمود المدمج.
         ⚠️ والشارات (مستورد · اسم مخالف · مُعطَّل) نزلت تحت حساب الدومين لا
            بجانبه، فلا تدفع الحساب بعيدًا عن حافة العمود. *@
      <thead>
        <tr>
          @* ⚠️ عمود التسلسل بلا data-sort: ترقيم موضع لا بيانات، والترتيب
             عليه لا معنى له - هو نفسه يتغيّر مع كل ترتيب. ونفس المفتاح
             المشترك (col_seq) المستعمل في قائمة الطلاب وإدارة الحسابات. *@
          <th class="num">@SharedLocalizer["col_seq"]</th>
          @* ⚠️ «إجراءات» بلا data-sort: ليست بيانات أصلًا. *@
          <th data-sort="unit">@SharedLocalizer["fh_ColUnit"]</th>
          <th data-sort="occupant">@SharedLocalizer["fh_ColOccupant"]</th>
          <th data-sort="national_id">@SharedLocalizer["fh_ColIdMobile"]</th>
          <th data-sort="ad_account">@SharedLocalizer["fh_ColAccount"]</th>
          <th data-sort="since">@SharedLocalizer["fh_ColSince"]</th>
          <th data-sort="status">@SharedLocalizer["fh_ColStatus"]</th>
          <th class="num">@SharedLocalizer["fh_ColActions"]</th>
        </tr>
      </thead>
      <tbody id="fhBody">
        <tr><td colspan="8" class="fh-empty">@SharedLocalizer["fh_Loading"]</td></tr>
      </tbody>
    </table>
  </div>
  <div id="fhPager" class="table-pager"></div>
</div>



<!-- سجل الوحدة -->
<div class="modal-overlay" id="fhHistoryOverlay">
  <div class="fh-modal">
    <div class="fh-modal-head">
      <div>
        <div class="card-title" id="fhHistTitle">@SharedLocalizer["fh_HistoryTitle"]</div>
        <div class="fh-modal-sub" id="fhHistSub"></div>
      </div>
      <button class="modal-close" onclick="fhCloseHistory()" aria-label="@SharedLocalizer["close"]"><span aria-hidden="true">&times;</span></button>
    </div>
    @* ⚠️ تبويبان لا شاشتان: السكّان يجيب «من يسكن ومنذ متى»، والتعديلات تجيب
       «من غيّر وماذا كانت القيمة قبل». الأول كان موجودًا وحده، فبقي الثاني
       مكتوبًا في قاعدة البيانات بلا سبيل لقراءته إلا باستعلام مباشر. *@
    <div class="fh-tabs">
      <button class="fh-tab active" id="fhTabOcc" onclick="fhHistTab('occ')">@SharedLocalizer["fh_TabOccupants"]</button>
      <button class="fh-tab" id="fhTabChg" onclick="fhHistTab('chg')">@SharedLocalizer["fh_TabChanges"] <span class="fh-tabnum" id="fhChgCount">0</span></button>
      @* ⚠️ لا نبني شاشة تقرير ثالثة. الزر يفتح «سجل العمليات» - وهو المكان
         الذي فيه التصدير والفلاتر أصلًا - مصفّى مسبقًا على هذه الوحدة وحدها.
         يظهر لمن يملك صلاحية عرض السجل فقط، وإلا فتح صفحة ممنوعة. *@
      @if (User.HasClaim("permission", "auditLogs.view"))
      {
        <a class="fh-tab-rep" id="fhFullReport" href="#">⬇ @SharedLocalizer["fh_FullReport"]</a>
      }
    </div>
    <div class="fh-modal-body" id="fhHistBody"></div>
    <div class="fh-modal-body" id="fhChgBody" style="display:none"></div>
  </div>
</div>

@section Scripts {
  <script>
    window.FH_T = @Html.Raw(fhT);
    // ⚠️ الصلاحيات تُمرَّر للواجهة لإخفاء ما لا يملكه المستخدم فقط.
    //    الحماية الفعلية على نقاط الـ API نفسها: إخفاء زر لا يمنع طلبًا.
    window.FH_CAN = { manage: @canManage.ToString().ToLowerInvariant(), sync: @canSync.ToString().ToLowerInvariant() };
  </script>
  @* لازم قبل faculty-housing-page.js — renderChanges بتنادي NuhFacultyLog *@
  <script src="~/js/faculty-audit-log.js" asp-append-version="true"></script>
  <script src="~/js/faculty-housing-page.js" asp-append-version="true"></script>
}
