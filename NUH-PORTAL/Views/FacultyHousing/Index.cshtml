<style>
  /* خاص بشاشة سكن أعضاء هيئة التدريس — الباقي من site.css و components.css */
  .fh-stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:22px}
  .fh-stat{background:var(--white);border-radius:14px;padding:15px 18px;border:1px solid var(--gray-100);
           box-shadow:0 2px 8px rgba(16,70,49,.05);display:flex;flex-direction:column;gap:5px;
           cursor:pointer;transition:transform .18s,box-shadow .18s,border-color .18s}
  .fh-stat:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(16,70,49,.1)}
  .fh-stat.is-on{border-color:var(--gold);box-shadow:0 0 0 3px rgba(219,161,2,.18)}
  .fh-stat-num{font-size:25px;font-weight:900;color:var(--navy-dark);line-height:1}
  .fh-stat-label{font-size:11.5px;color:var(--gray-500);font-weight:500}
  .fh-stat.ok .fh-stat-num{color:var(--green)}
  .fh-stat.warn .fh-stat-num{color:#93370d}
  .fh-stat.bad .fh-stat-num{color:var(--red)}

  .fh-flag{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;
           padding:2px 8px;border-radius:20px;background:#fef0c7;color:#93370d;white-space:nowrap}

  /* الاستيراد */
  .fh-imp-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-bottom:16px}
  .fh-ou{border:1px solid var(--gray-200);border-radius:12px;padding:13px 15px;background:var(--gray-50)}
  .fh-ou.ok{border-color:#a9efc5;background:#f3fcf6}
  .fh-ou.bad{border-color:#fda29b;background:var(--red-light)}
  .fh-ou-title{font-size:13px;font-weight:700;color:var(--navy-dark);margin-bottom:6px;
               display:flex;align-items:center;justify-content:space-between;gap:8px}
  .fh-ou-dn{font-family:Consolas,monospace;font-size:10.5px;color:var(--gray-500);
            direction:ltr;text-align:left;word-break:break-all;margin-bottom:8px}
  .fh-attrs{display:flex;flex-wrap:wrap;gap:5px}
  .fh-attr{font-family:Consolas,monospace;font-size:10.5px;padding:2px 7px;border-radius:6px;direction:ltr}
  .fh-attr.y{background:var(--green-light);color:var(--green)}
  .fh-attr.n{background:var(--red-light);color:var(--red)}

  /* سجل الوحدة */
  .tl{position:relative;padding-inline-start:26px}
  .tl::before{content:'';position:absolute;inset-inline-start:7px;top:6px;bottom:6px;width:2px;background:var(--gray-200)}
  .tl-item{position:relative;padding-bottom:20px}
  .tl-item:last-child{padding-bottom:0}
  .tl-dot{position:absolute;inset-inline-start:-26px;top:3px;width:16px;height:16px;border-radius:50%;
          background:var(--gray-300);border:3px solid var(--white);box-shadow:0 0 0 2px var(--gray-200)}
  .tl-item.now .tl-dot{background:var(--green);box-shadow:0 0 0 2px var(--green)}
  .tl-card{background:var(--white);border:1px solid var(--gray-100);border-radius:12px;padding:12px 15px}
  .tl-item.now .tl-card{border-color:#a9efc5;background:#f3fcf6}
  .tl-top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:5px}
  .tl-top b{font-size:14px;color:var(--navy-dark)}
  /* صفوف بيانات الشاغل: عنوان ثابت + قيمة، بدل فقرة نصّ متصلة */
  .oc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:4px 18px;margin-top:8px}
  .oc-row{display:flex;align-items:baseline;gap:8px;padding:3px 0;min-width:0}
  .oc-k{font-size:11.5px;color:var(--gray-500);font-weight:600;flex-shrink:0;min-width:76px}
  .oc-v{font-size:12.5px;color:var(--navy-dark);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .oc-warn{margin-top:10px;padding:8px 12px;border-radius:8px;background:#fffaeb;
           border-inline-start:3px solid var(--gold);font-size:11.5px;color:#93370d;line-height:1.7}
  /* تبويبا نافذة السجل + جدول التعديلات */
  .fh-tabs{display:flex;gap:6px;padding:0 20px;border-bottom:1px solid var(--gray-100);background:var(--white)}
  .fh-tab{border:none;background:none;padding:11px 14px;font-family:inherit;font-size:13px;font-weight:600;
    color:var(--gray-500);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
  .fh-tab:hover{color:var(--navy)}
  .fh-tab.active{color:var(--navy);border-bottom-color:var(--navy)}
  .fh-tabnum{display:inline-block;min-width:18px;padding:0 5px;border-radius:9px;background:var(--gray-100);
    color:var(--gray-700);font-size:11px;font-weight:700;line-height:18px;text-align:center}
  .fh-tab.active .fh-tabnum{background:var(--green-light);color:var(--green)}
  .fh-tab-rep{margin-inline-start:auto;align-self:center;background:var(--navy);color:#fff;font-size:12px;
    font-weight:700;padding:6px 13px;border-radius:8px;text-decoration:none;margin-bottom:6px}
  .fh-tab-rep:hover{background:var(--navy-dark);color:#fff}
  .ch-item{border:1px solid var(--gray-100);border-radius:12px;padding:12px 15px;margin-bottom:12px;background:var(--white)}
  .ch-top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:9px}
  .ch-act{font-size:13.5px;font-weight:700;color:var(--navy-dark)}
  .ch-meta{font-size:11.5px;color:var(--gray-500)}
  .ch-tbl{width:100%;border-collapse:collapse;font-size:12px}
  .ch-tbl th{padding:5px 8px;text-align:start;font-weight:600;background:var(--gray-50);color:var(--gray-700);font-size:11.5px}
  .ch-tbl td{padding:5px 8px;border-top:1px solid var(--gray-100);vertical-align:top}
  .ch-old{color:var(--red);text-decoration:line-through}
  .ch-new{color:var(--green);font-weight:600}
  .tl-meta{font-size:12px;color:var(--gray-500);line-height:1.95}
  .tl-meta code{font-family:Consolas,monospace;background:var(--gray-50);padding:1px 6px;
                border-radius:5px;direction:ltr;display:inline-block}

  .fh-modal{background:var(--white);border-radius:16px;width:760px;max-width:94vw;max-height:88vh;
            display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3);overflow:hidden}
  .fh-modal-head{padding:16px 20px;background:#f3fcf6;border-bottom:1px solid #c6ecd6;
                 display:flex;align-items:center;justify-content:space-between;gap:12px}
  .fh-modal-body{padding:20px;overflow-y:auto;scrollbar-width:thin}
  .fh-x{background:none;border:none;cursor:pointer;color:var(--gray-500);font-size:22px;line-height:1;padding:0 4px}

  @@media(max-width:900px){ .fh-modal{width:96vw} }
</style>

<div class="page-header">
  <h2>@SharedLocalizer["fh_PageTitle"]</h2>
  <p>@SharedLocalizer["fh_PageSub"]</p>
</div>

<div class="fh-stats" id="fhStats"></div>
<div id="fhMsg"></div>

<div class="card" style="margin-bottom:20px">
  <div class="card-header">
    <div class="card-title">@SharedLocalizer["fh_UnitsList"]</div>
    <div class="card-tools">
      <div class="fh-seg" id="fhTypeSeg">
        <button class="is-on" data-type="">@SharedLocalizer["fh_All"]</button>
        <button data-type="tower">@SharedLocalizer["fh_Towers"]</button>
        <button data-type="villa">@SharedLocalizer["fh_Villas"]</button>
      </div>
      <select id="fhStatus">
        <option value="">@SharedLocalizer["fh_AllStatuses"]</option>
        <option value="occupied">@SharedLocalizer["fh_StOccupied"]</option>
        <option value="vacant">@SharedLocalizer["fh_StVacant"]</option>
        <option value="out_of_service">@SharedLocalizer["fh_StOutOfService"]</option>
        <option value="not_exists">@SharedLocalizer["fh_StNotExists"]</option>
        <option value="pending_sync">@SharedLocalizer["fh_StPendingSync"]</option>
      </select>
      <select id="fhTower">
        <option value="">@SharedLocalizer["fh_AllTowers"]</option>
      </select>
      <div class="search-wrap">
        <input type="text" id="fhSearch" placeholder="@SharedLocalizer["fh_SearchPh"]">
      </div>
    </div>
  </div>
  <div style="overflow-x:auto">
    <table id="fhTable">
      <thead>
        <tr>
          <th>@SharedLocalizer["fh_ColUnit"]</th>
          <th>@SharedLocalizer["fh_ColAccount"]</th>
          <th>@SharedLocalizer["fh_ColOccupant"]</th>
          <th>@SharedLocalizer["fh_ColNationalId"]</th>
          <th>@SharedLocalizer["fh_ColMobile"]</th>
          <th>@SharedLocalizer["fh_ColSince"]</th>
          <th>@SharedLocalizer["fh_ColStatus"]</th>
          <th>@SharedLocalizer["fh_ColActions"]</th>
        </tr>
      </thead>
      <tbody id="fhBody">
        <tr><td colspan="8" class="fh-empty">@SharedLocalizer["fh_Loading"]</td></tr>
      </tbody>
    </table>
  </div>
  <div id="fhPager" class="table-pager"></div>
</div>

@if (canImport)
{
<div class="card">
  <div class="card-header">
    <div class="card-title">@SharedLocalizer["fh_ImportTitle"]</div>
    <div style="display:flex;gap:10px">
      <button class="btn btn-cancel" id="fhCheckBtn">@SharedLocalizer["fh_CheckAccess"]</button>
      <button class="btn btn-primary" id="fhPreviewBtn">@SharedLocalizer["fh_PreviewImport"]</button>
    </div>
  </div>
  <div class="card-body">
    <div class="fh-note">@Html.Raw(SharedLocalizer["fh_ImportNote"].Value)
    </div>

    <div id="fhAccess"></div>
    <div id="fhPreview"></div>
  </div>
</div>
}


<!-- سجل الوحدة -->
<div class="modal-overlay" id="fhHistoryOverlay">
  <div class="fh-modal">
    <div class="fh-modal-head">
      <div>
        <div class="card-title" id="fhHistTitle">@SharedLocalizer["fh_HistoryTitle"]</div>
        <div style="font-size:12px;color:var(--gray-500);margin-top:2px" id="fhHistSub"></div>
      </div>
      <button class="fh-x" onclick="fhCloseHistory()" aria-label="إغلاق">&times;</button>
    </div>
    @* ⚠️ تبويبان لا شاشتان: السكّان يجيب «من يسكن ومنذ متى»، والتعديلات تجيب
       «من غيّر وماذا كانت القيمة قبل». الأول كان موجودًا وحده، فبقي الثاني
       مكتوبًا في قاعدة البيانات بلا سبيل لقراءته إلا باستعلام مباشر. *@
    <div class="fh-tabs">
      <button class="fh-tab active" id="fhTabOcc" onclick="fhHistTab('occ')">@SharedLocalizer["fh_TabOccupants"]</button>
      <button class="fh-tab" id="fhTabChg" onclick="fhHistTab('chg')">@SharedLocalizer["fh_TabChanges"] <span class="fh-tabnum" id="fhChgCount">0</span></button>
      @* ⚠️ لا نبني شاشة تقرير ثالثة. الزر يفتح «سجل العمليات» - وهو المكان
         الذي فيه التصدير والفلاتر أصلًا - مصفّى مسبقًا على هذه الوحدة وحدها.
         يظهر لمن يملك صلاحية عرض السجل فقط، وإلا فتح صفحة ممنوعة. *@
      @if (User.HasClaim("permission", "auditLogs.view"))
      {
        <a class="fh-tab-rep" id="fhFullReport" href="#">⬇ @SharedLocalizer["fh_FullReport"]</a>
      }
    </div>
    <div class="fh-modal-body" id="fhHistBody"></div>
    <div class="fh-modal-body" id="fhChgBody" style="display:none"></div>
  </div>
</div>

@section Scripts {
  <script>
    window.FH_T = @Html.Raw(fhT);
    // ⚠️ الصلاحيات تُمرَّر للواجهة لإخفاء ما لا يملكه المستخدم فقط.
    //    الحماية الفعلية على نقاط الـ API نفسها: إخفاء زر لا يمنع طلبًا.
    window.FH_CAN = { manage: @canManage.ToString().ToLowerInvariant(), sync: @canSync.ToString().ToLowerInvariant() };
  </script>
  <script src="~/js/faculty-housing-page.js" asp-append-version="true"></script>
}
