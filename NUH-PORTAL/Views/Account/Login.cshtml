@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>تسجيل الدخول — نظام إسكان الطلاب والطالبات</title>
  <link rel="stylesheet" href="/css/site.css" />
  <style>
    /* خاص بصفحة الدخول — نفس هوية login.html */
    body{
      min-height:100vh;display:flex;align-items:center;
      background:url('/nni1.jpg') center/cover no-repeat fixed;
      position:relative;
    }
    body::before{content:'';position:fixed;inset:0;background:linear-gradient(120deg,rgba(17,28,66,.25),rgba(17,28,66,.05) 45%,rgba(17,28,66,.35));}
    .login-card{
      position:relative;z-index:1;
      background:#fff;border-radius:22px;overflow:hidden;
      width:430px;max-width:92vw;
      margin-inline-start:6vw;
      box-shadow:0 30px 70px rgba(9,14,36,.45);
      border-top:6px solid var(--navy-dark);
    }
    .login-inner{padding:30px 34px 26px;text-align:center}
    .login-logo{
      background:#fff;border:1px solid rgba(201,168,76,.25);border-radius:18px;
      box-shadow:0 6px 20px rgba(0,0,0,.08);
      display:inline-block;padding:14px 30px;margin-bottom:18px;
    }
    .login-logo img{width:120px;height:84px;object-fit:contain;display:block}
    .login-title{font-size:21px;font-weight:800;color:var(--navy-dark);position:relative;padding-bottom:14px;margin-bottom:22px}
    .login-title::after{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:46px;height:3px;border-radius:2px;background:linear-gradient(90deg,var(--gold),var(--gold-light));}
    .field{margin-bottom:16px;text-align:right}
    .field label{display:block;font-size:13px;font-weight:700;color:var(--navy-dark);margin-bottom:8px}
    .input-wrap{position:relative}
    .input-wrap svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--gray-300)}
    .input-wrap input{
      width:100%;padding:12px 16px;padding-left:40px;
      border:1px solid var(--gray-200);border-radius:24px;
      font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;
      background:var(--gray-50);color:var(--navy-dark);
    }
    .input-wrap input:focus{outline:none;border-color:var(--gold);background:#fff}
    .login-btn{
      width:100%;padding:13px;margin-top:6px;
      border:none;border-radius:12px;
      background:var(--navy-dark);color:#fff;
      font-family:'IBM Plex Sans Arabic',sans-serif;font-size:15px;font-weight:700;
      cursor:pointer;transition:background .2s,transform .15s;
    }
    .login-btn:hover{background:var(--navy)}
    .login-btn:active{transform:scale(.99)}
    .login-error{background:var(--red-light);color:var(--red);font-size:12.5px;font-weight:600;padding:10px 12px;border-radius:12px;margin-bottom:14px;text-align:right}
    .login-footer{margin-top:20px;font-size:11px;color:var(--gray-500)}
    .login-back{display:inline-block;margin-top:10px;font-size:12px;color:var(--gray-500);text-decoration:none}
    .login-back:hover{color:var(--navy)}
    @@media (max-width:640px){ body{justify-content:center} .login-card{margin-inline-start:0} }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-inner">
      <div class="login-logo"><img src="/nu-logo.png" alt="جامعة نجران"></div>
      <div class="login-title">نظام إسكان الطلاب والطالبات</div>

      @if (ViewData["Error"] is string err && !string.IsNullOrEmpty(err))
      {
        <div class="login-error">@err</div>
      }

      <form method="post" action="/Account/Login">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div class="field">
          <label for="username">اسم المستخدم</label>
          <div class="input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input id="username" name="username" type="text" placeholder="أدخل اسم المستخدم" autocomplete="username" required autofocus />
          </div>
        </div>
        <div class="field">
          <label for="password">كلمة المرور</label>
          <div class="input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input id="password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required />
          </div>
        </div>
        <button class="login-btn" type="submit">تسجيل الدخول للنظام</button>
      </form>

      <a class="login-back" href="/">→ الرجوع لبوابة السكن الجامعي</a>
      <div class="login-footer">عمادة التحول الرقمي ومصادر المعرفة - تقنية المعلومات - جامعة نجران 2026</div>
    </div>
  </div>
</body>
</html>
