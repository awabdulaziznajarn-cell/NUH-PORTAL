@{
    Layout = null;
    var __lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "ar";
    var __dir = __lang == "ar" ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@__lang" dir="@__dir">
<head><meta charset="utf-8" /><title>@SharedLocalizer["login_loading"]</title></head>
<body style="font-family:sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;color:#166a45">
  <div>@SharedLocalizer["login_loading"]</div>
  <script type="application/json" id="bridge-data">@Html.Raw(ViewData["BridgeJson"])</script>
  <script>
    (function () {
      var data = JSON.parse(document.getElementById('bridge-data').textContent);
      // نفس مفاتيح الدخول القديم — عشان الصفحات الحالية تشتغل بنفس الجلسة
      localStorage.setItem('staffToken', data.token);
      localStorage.setItem('staffUser', JSON.stringify(data.user));
      location.replace(data.redirect);
    })();
  </script>
</body>
</html>
