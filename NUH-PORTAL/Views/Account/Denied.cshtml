@{
    Layout = null;
    var __lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "ar";
    var __dir = __lang == "ar" ? "rtl" : "ltr";
    var roles = (string)(ViewData["Roles"] ?? "");
    var permCount = (int)(ViewData["PermissionCount"] ?? 0);
    var fullName = (string)(ViewData["FullName"] ?? "");
    ViewData["Title"] = SharedLocalizer["denied_title"].Value;
}
<!DOCTYPE html>
<html lang="@__lang" dir="@__dir">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@SharedLocalizer["denied_title"]</title>
  <link rel="stylesheet" href="/css/site.css" />
  <style>
    body{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--gray-50);padding:24px}
    .denied-card{max-width:520px;width:100%;background:#fff;border:1px solid var(--gray-200);border-radius:16px;
      box-shadow:0 4px 24px rgba(16,70,49,.07);padding:36px 32px;text-align:center}
    .denied-icon{width:64px;height:64px;border-radius:50%;background:#fef0c7;display:flex;align-items:center;
      justify-content:center;margin:0 auto 18px}
    .denied-title{font-size:20px;font-weight:800;color:var(--navy-dark);margin-bottom:8px}
    .denied-msg{font-size:14px;color:var(--gray-700);line-height:1.8;margin-bottom:20px}
    .denied-facts{background:var(--gray-50);border:1px solid var(--gray-100);border-radius:10px;
      padding:14px 16px;margin-bottom:18px;text-align:start}
    .denied-row{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:4px 0}
    .denied-row .k{color:var(--gray-500);font-weight:600}
    .denied-row .v{color:var(--navy-dark);font-weight:700}
    .denied-hint{background:#fef0c7;border:1px solid #fedf89;color:#93370d;border-radius:10px;
      padding:12px 14px;font-size:13px;line-height:1.7;margin-bottom:18px;text-align:start}
    .denied-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
    .denied-btn{padding:10px 22px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;
      border:none;text-decoration:none;display:inline-block;font-family:inherit}
    .denied-btn.primary{background:var(--navy);color:#fff}
    .denied-btn.ghost{background:#fff;color:var(--gray-700);border:1.5px solid var(--gray-200)}
  </style>
</head>
<body>
  <div class="denied-card">
    <div class="denied-icon">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#93370d" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </div>

    <div class="denied-title">@SharedLocalizer["denied_title"]</div>
    <div class="denied-msg">@SharedLocalizer["denied_message"]</div>

    <div class="denied-facts">
      @if (!string.IsNullOrWhiteSpace(fullName))
      {
        <div class="denied-row"><span class="k">@SharedLocalizer["denied_userLabel"]</span><span class="v">@fullName</span></div>
      }
      <div class="denied-row"><span class="k">@SharedLocalizer["denied_roleLabel"]</span><span class="v">@(string.IsNullOrWhiteSpace(roles) ? "-" : roles)</span></div>
      <div class="denied-row"><span class="k">@SharedLocalizer["denied_permsLabel"]</span><span class="v">@permCount</span></div>
    </div>

    @* صفر صلاحيات = مشكلة إعداد مش مشكلة صفحة. بنقولها صريحة عشان محدش يدوّر
       في الاتجاه الغلط زي ما حصل قبل كده لما كانت الصفحة دي هي صفحة الدخول. *@
    @if (permCount == 0)
    {
      <div class="denied-hint">@SharedLocalizer["denied_noPerms"]</div>
    }

    <div class="denied-actions">
      <a class="denied-btn primary" href="/Home">@SharedLocalizer["denied_backHome"]</a>
      <form method="post" action="/Account/Logout" style="display:inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="denied-btn ghost">@SharedLocalizer["denied_logout"]</button>
      </form>
    </div>
  </div>
</body>
</html>
