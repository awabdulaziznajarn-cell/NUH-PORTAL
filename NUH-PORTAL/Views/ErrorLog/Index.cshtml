@{
    ViewData["Title"] = SharedLocalizer["err_pageTitle"].Value;
}

<style>
  .badge-500{background:var(--red-light);color:var(--red)}
  .mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}
  .clip{max-width:360px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  tbody tr{cursor:pointer}
  .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center}
  .modal-overlay.open{display:flex}
  .modal{background:var(--white);border-radius:16px;padding:28px;min-width:420px;max-width:720px;width:92%;max-height:88vh;overflow:auto;box-shadow:0 8px 40px rgba(0,0,0,.15)}
  .modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
  .modal-title{font-size:16px;font-weight:700;color:var(--navy-dark)}
  .modal-row{display:flex;flex-direction:column;gap:2px;margin-bottom:12px}
  .modal-row-label{font-size:11px;font-weight:600;color:var(--gray-500)}
  .modal-row-value{font-size:14px;font-weight:500;color:var(--navy-dark);word-break:break-word}
  .stack{background:#161b26;color:#dcdfe4;border-radius:10px;padding:14px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;white-space:pre-wrap;word-break:break-word;max-height:320px;overflow:auto}
</style>

<div class="page-header">
  <h2>@SharedLocalizer["err_pageTitle"]</h2>
  <p>@SharedLocalizer["err_pageSubtitle"]</p>
</div>

<div class="filters-bar">
  <div class="filter-group">
    <label for="searchBox">@SharedLocalizer["err_search"]</label>
    <input type="text" id="searchBox" placeholder="">
  </div>
  <div class="filter-group">
    <label for="fromDate">@SharedLocalizer["err_fromDate"]</label>
    <input type="date" id="fromDate">
  </div>
  <div class="filter-group">
    <label for="toDate">@SharedLocalizer["err_toDate"]</label>
    <input type="date" id="toDate">
  </div>
</div>

<div class="card">
  <div style="overflow-x:auto">
    <table id="errTbl">
      <thead>
        <tr>
          @* ⚠️ «#» ترقيم عرض مش موجود في قاعدة البيانات، و«الرسالة» نصّ
             طويل حرّ — ترتيبه أبجديًّا مالوش أي معنى تشغيلي. الاتنين
             بلا data-sort عن قصد. *@
          <th>#</th>
          <th data-sort="occurred_at">@SharedLocalizer["err_col_time"]</th>
          <th data-sort="request_path">@SharedLocalizer["err_col_path"]</th>
          <th data-sort="exception_type">@SharedLocalizer["err_col_type"]</th>
          <th>@SharedLocalizer["err_col_message"]</th>
          <th data-sort="status_code">@SharedLocalizer["err_col_status"]</th>
          <th data-sort="username">@SharedLocalizer["err_col_user"]</th>
        </tr>
      </thead>
      <tbody id="tbody">
        <tr><td colspan="7" style="text-align:center;padding:60px 20px"><div class="spinner"></div></td></tr>
      </tbody>
    </table>
  </div>
</div>

@* صفّ الترقيم من NuhTable.pager - النسخة الوحيدة في النظام (js/table-state.js) *@
<div id="errPager"></div>

<div class="modal-overlay" id="detailModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">@SharedLocalizer["err_modalTitle"]</div>
      <button class="modal-close" id="modalClose" aria-label="@SharedLocalizer["close"]"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="modal-row"><span class="modal-row-label">@SharedLocalizer["err_col_time"]</span><span class="modal-row-value" id="d_time"></span></div>
    <div class="modal-row"><span class="modal-row-label">@SharedLocalizer["err_col_type"]</span><span class="modal-row-value mono" id="d_type"></span></div>
    <div class="modal-row"><span class="modal-row-label">@SharedLocalizer["err_col_message"]</span><span class="modal-row-value" id="d_message"></span></div>
    <div class="modal-row"><span class="modal-row-label">@SharedLocalizer["err_col_path"]</span><span class="modal-row-value mono" id="d_path"></span></div>
    <div class="modal-row"><span class="modal-row-label">@SharedLocalizer["err_modal_user"]</span><span class="modal-row-value" id="d_user"></span></div>
    <div class="modal-row"><span class="modal-row-label">@SharedLocalizer["err_modal_ua"]</span><span class="modal-row-value" id="d_ua"></span></div>
    <div class="modal-row"><span class="modal-row-label">@SharedLocalizer["err_modal_stack"]</span><div class="stack" id="d_stack"></div></div>
  </div>
</div>

@section Scripts {
<script src="/i18n.js"></script>
<script>
  // الصفحة والفلاتر في الرابط - نفس آلية باقي الشاشات (js/url-state.js)
  var page = NuhUrl.int('page', 1, 1), pageSize = 50, totalPages = 1, cache = [];
  var ERR_DEFAULTS = { page: 1, q: '', from: '', to: '', sort: '', asc: '' };

  function syncUrl() {
    NuhUrl.sync({
      page: page,
      q: document.getElementById('searchBox').value.trim(),
      from: document.getElementById('fromDate').value,
      to: document.getElementById('toDate').value,
      sort: errSort.by(), asc: errSort.by() ? (errSort.asc() ? '1' : '0') : ''
    }, ERR_DEFAULTS);
  }
  // تهريب HTML — التعريف الوحيد في /js/esc.js
  var esc = function (v) { return escHtml(v); };
  // الجدول وحالاته من NuhTable، والترويسات من NUH.headers في التخطيط — مفيش نسخة محلية.
  var errTable = NuhTable.bind('tbody', 7);

  // شكل التاريخ من NuhFmt — التعريف الوحيد في /js/date-format.js
  function fmt(v) { return NuhFmt.dateTime(v); }

  function buildUrl() {
    syncUrl();
    var u = '/api/logs/errors?page=' + page + '&pageSize=' + pageSize;
    var s = document.getElementById('searchBox').value.trim();
    var f = document.getElementById('fromDate').value;
    var tt = document.getElementById('toDate').value;
    if (s) u += '&search=' + encodeURIComponent(s);
    if (f) u += '&fromDate=' + encodeURIComponent(f);
    if (tt) u += '&toDate=' + encodeURIComponent(tt);
    return u + errSort.qs();
  }

  // ⚠️ setLang تستدعي onLanguageChange المربوطة بـ render، فكانت الصفحة ترسم
  //    «لا توجد سجلات» قبل انطلاق أول نداء، ثم تمتلئ فجأة. أي بطء عادي كان
  //    يبدو كعطل. التفرقة نفسها صارت في NuhTable لكل الشاشات.

  function render() {
    if (!errTable.isDone()) return errTable.loading();
    if (!cache.length) return errTable.rows('', t('err_noItems'));
    errTable.rows(cache.map(function (e, i) {
      var n = (page - 1) * pageSize + i + 1;
      return '<tr onclick="openDetail(' + e.id + ')">' +
        '<td style="color:var(--gray-500)">' + n + '</td>' +
        '<td>' + fmt(e.occurredAt) + '</td>' +
        '<td class="mono"><span class="badge badge-gray">' + esc(e.requestMethod) + '</span> <span class="clip" title="' + esc(e.requestPath) + '">' + esc(e.requestPath) + '</span></td>' +
        '<td class="mono">' + esc(e.exceptionType) + '</td>' +
        '<td><div class="clip" title="' + esc(e.message) + '">' + esc(e.message) + '</div></td>' +
        '<td><span class="badge badge-500">' + esc(e.statusCode) + '</span></td>' +
        '<td>' + esc(e.username || '-') + '</td></tr>';
    }).join(''), t('err_noItems'));
  }

  async function load() {
    try {
      var res = await fetch(buildUrl(), { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (!res.ok) { errTable.error(t('err_loadError')); return; }
      var body = await res.json();
      errTable.done();
      cache = body.data || [];
      totalPages = body.totalPages || 1;
      render();
      NuhTable.pager('errPager',
        { page: page, pageSize: pageSize, total: body.totalRecords || 0, totalPages: totalPages },
        {
          summary: t('err_totalFmt').replace('{0}', body.totalRecords || 0),
          prev: t('aud_prev'), next: t('aud_next')
        },
        function (p) { page = p; load(); });
    } catch (e) { errTable.error(t('err_loadError')); }
  }

  async function openDetail(id) {
    try {
      var res = await fetch('/api/logs/errors/' + id, { headers: NUH.headers() });
      if (!res.ok) return;
      var d = await res.json();
      document.getElementById('d_time').textContent = fmt(d.occurredAt);
      document.getElementById('d_type').textContent = d.exceptionType || '';
      document.getElementById('d_message').textContent = d.message || '';
      document.getElementById('d_path').textContent = (d.requestMethod || '') + ' ' + (d.requestPath || '');
      document.getElementById('d_user').textContent = (d.username || '-') + (d.ipAddress ? ' · ' + d.ipAddress : '');
      document.getElementById('d_ua').textContent = d.userAgent || '-';
      document.getElementById('d_stack').textContent = d.stackTrace || '-';
      document.getElementById('detailModal').classList.add('open');
    } catch (e) { }
  }

  // ترتيب الأعمدة من نسخة واحدة في النظام — NuhTable.sort. الأعمدة معرّفة
  // بـ data-sort على الـ <th>، والخادم هو اللي بيرتّب (الجدول مقسّم صفحات،
  // والترتيب في المتصفح كان هيرتّب الصفحة اللي قدامك بس).
  var errSort = NuhTable.sort('errTbl', function () { page = 1; load(); },
    { by: NuhUrl.get('sort', ''), asc: NuhUrl.get('asc', '1') === '1' });

  function onFilter() { page = 1; load(); }
  document.getElementById('searchBox').addEventListener('keyup', function (e) { if (e.key === 'Enter') onFilter(); });
  document.getElementById('fromDate').addEventListener('change', onFilter);
  document.getElementById('toDate').addEventListener('change', onFilter);
  document.getElementById('modalClose').addEventListener('click', function () { document.getElementById('detailModal').classList.remove('open'); });
  document.getElementById('detailModal').addEventListener('click', function (e) { if (e.target === this) this.classList.remove('open'); });

  window.onLanguageChange = function () { render(); };
  setLang(localStorage.getItem('uiLanguage') || 'ar');

  (function initFromUrl() {
    document.getElementById('searchBox').value = NuhUrl.get('q', '');
    document.getElementById('fromDate').value = NuhUrl.date('from');
    document.getElementById('toDate').value = NuhUrl.date('to');
  })();

  load();
</script>
}
