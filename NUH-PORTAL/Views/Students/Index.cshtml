@model NUH_PORTAL.ViewModels.StudentsIndexViewModel
@{
    ViewData["Title"] = SharedLocalizer["Page_Students"].Value;
    // الأزرار بتتحكّم فيها الصلاحية مش الدور — والفحص الحقيقي على السيرفر
    // (StudentsController + StudentService)؛ ده إخفاء واجهة بس.
    var canEdit = User.HasClaim("permission", "students.edit");
    var canDelete = User.HasClaim("permission", "students.delete");

    // ⚠️ قسم الموظف من نفس الـ claim اللي بتقرا منه التصفية في السيرفر —
    //    مصدر واحد لا نسخة. الفاضي معناه «بيشوف القسمين» (الأدمن).
    var scopeGender = (User.FindFirst(NUH_PORTAL.Core.ClaimConstants.ScopeGender)?.Value ?? "").Trim().ToLowerInvariant();
    if (scopeGender != "male" && scopeGender != "female") scopeGender = "";
    var genderLocked = scopeGender.Length > 0;
    // القيمة null بتخلّي Razor يشيل السمة خالص — والفاضي "" كان هيبقى
    // disabled="" يعني مقفولة على الأدمن كمان.
    string? genderLockAttr = genderLocked ? "disabled" : null;

    // النصوص بتتسلسل JSON عشان Razor بيهرّب أي نص بيطبعه ترميز HTML حتى جوه script،
    // فلو اتحطت في textContent المستخدم بيشوف رموز بدل الحروف العربية.
    var __housingPh = System.Text.Json.JsonSerializer.Serialize(new
    {
        floorFirst = SharedLocalizer["reg_optSelectFloorFirst"].Value,
        selectApartment = SharedLocalizer["reg_optSelectApartment"].Value,
        selectRoom = SharedLocalizer["reg_optSelectRoom"].Value
    });
}
@functions {
    // كود الكلية (زي ما بيتخزّن من فورم التسجيل) → اسم مترجم؛ وأي نص عربي جاهز يرجع زي ما هو
    private string CollegeName(string? c)
    {
        var key = (c ?? "").Trim().ToLowerInvariant() switch
        {
            "engineering" => "reg_collegeEngineering",
            "medicine" => "reg_collegeMedicine",
            "cs" => "reg_collegeCS",
            "science" => "reg_collegeScience",
            "business" => "reg_collegeBusiness",
            "arts" => "reg_collegeArts",
            "education" => "reg_collegeEducation",
            "pharmacy" => "reg_collegePharmacy",
            _ => null
        };
        return key != null ? SharedLocalizer[key].Value : (c ?? "");
    }

    // ⚠️ الوضع الأكاديمي قد يكون فارغًا في سجلات قديمة سجّلها الطالب بنفسه قبل
    //    أن يضبطه RegistrationFlowService. وبدون هذا الفحص يُركَّب مفتاح ناقص
    //    «stu_status_» فيظهر اسم المفتاح نصًّا خامًا في الجدول بدل الحالة.
    // حالة السكن باسم يوافق الطالب — «مقيم» / «مقيمة». الاختيار بين
    // المفتاحين هنا مرة واحدة بدل ما كل شاشة تكتب النص بإيدها.
    private string ResidentText(Gender? g)
        => SharedLocalizer[g == Gender.Female ? "stu_residentF" : "stu_resident"].Value;

    private string StudentStatusText(StudentStatus? st)
        => SharedLocalizer[st == null ? "stu_status_none" : "stu_status_" + st].Value;
}

@* ⚠️ الشاشتين دول (الطلاب وحسابات السكن) كانوا الوحيدين من غير ترويسة صفحة
   (عنوان + وصف)، فالمحتوى كان بيبدأ من مكان مختلف عن باقي الشاشات. *@
<div class="page-header">
  <h2>@SharedLocalizer["Page_Students"]</h2>
  <p>@SharedLocalizer["stu_pageSubtitle"]</p>
</div>

<div class="stats-row">
  <div class="stat-pill">
    <div class="stat-pill-num" id="cnt-total">@Model.Stats.total</div>
    <div class="stat-pill-label" >@SharedLocalizer["stu_total"]</div>
  </div>
  <div class="stat-pill">
    <div class="stat-pill-num" style="color:#0F6E56" id="cnt-active">@Model.Stats.active</div>
    <div class="stat-pill-label" >@SharedLocalizer["stu_active"]</div>
  </div>
  <div class="stat-pill">
    <div class="stat-pill-num" style="color:#92400E" id="cnt-pending">@Model.Stats.submitted</div>
    <div class="stat-pill-label" >@SharedLocalizer["stu_pending"]</div>
  </div>
  <div class="stat-pill">
    <div class="stat-pill-num" style="color:#8891A8" id="cnt-left">@Model.Stats.left</div>
    <div class="stat-pill-label" >@SharedLocalizer["stu_leftLabel"]</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div >@SharedLocalizer["stu_registered"]</div>
    <div class="card-tools">
      <div class="search-wrap">
        <input id="searchBox" type="text" placeholder='@(SharedLocalizer["stu_searchPlaceholder"].Value)' />
        <span class="search-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
      </div>
      <a class="btn btn-primary" href="/Register" >@SharedLocalizer["stu_addNew"]</a>
    </div>
  </div>

  <div style="overflow-x:auto">
    <table id="stuTable">
      <thead>
        <tr>
          <th>#</th>
          <th data-sort="full_name">@SharedLocalizer["stu_col_name"]</th>
          <th data-sort="student_id">@SharedLocalizer["stu_col_studentId"]</th>
          <th >@SharedLocalizer["stu_col_nationalId"]</th>
          <th >@SharedLocalizer["stu_col_phone"]</th>
          <th data-sort="college">@SharedLocalizer["stu_col_college"]</th>
          <th >@SharedLocalizer["stu_col_level"]</th>
          <th >@SharedLocalizer["stu_col_nameEn"]</th>
          <th >@SharedLocalizer["stu_col_building"]</th>
          <th >@SharedLocalizer["stu_col_room"]</th>
          <th >@SharedLocalizer["stu_col_academic"]</th>
          <th data-sort="status">@SharedLocalizer["stu_col_status"]</th>
          <th >@SharedLocalizer["stu_col_actions"]</th>
        </tr>
      </thead>
      <tbody id="studentsBody">
        @{ int i = (Model.Page.Page - 1) * Model.Page.PageSize; }
        @foreach (var s in Model.Page.Items)
        {
          i++;
          <tr>
            <td>@i</td>
            <td>@s.full_name</td>
            <td>@s.student_id</td>
            <td>@s.national_id</td>
            <td>@s.phone</td>
            <td data-lk="college:@s.college">@CollegeName(s.college)</td>
            <td data-lk="level:@s.academic_level">@s.academic_level</td>
            <td>@s.full_name_english</td>
            <td data-lk="building:@s.housing_building">@s.housing_building</td>
            <td>@s.room_number</td>
            <td><span>@StudentStatusText(s.student_status)</span></td>
            <td>
              @if (s.status == StudentState.left)
              {
                <span class="badge badge-left" >@SharedLocalizer["stu_badge_left"]</span>
              }
              else
              {
                <span class="badge badge-active" >@ResidentText(s.gender)</span>
              }
            </td>
            <td>
              <div class="row-actions">
                @if (canEdit)
                {
                  <button class="action-btn action-edit" onclick="openEditModal(@s.Id)" >@SharedLocalizer["stu_edit"]</button>
                }
                @if (canDelete)
                {
                  <button class="action-btn action-delete" onclick="deleteStudent(@s.Id, this)" >@SharedLocalizer["stu_delete"]</button>
                }
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  @* صفّ الترقيم من NuhTable.pager - النسخة الوحيدة في النظام (js/table-state.js) *@
  <div id="stuPager" class="in-card"></div>
</div>

@if (canEdit)
{
<div class="edit-overlay" id="editOverlay" onclick="if(event.target===this)closeEditModal()">
  <div class="edit-modal" role="dialog" aria-modal="true">
    <div class="edit-modal-header">
      <div>
        <div class="edit-modal-title" >@SharedLocalizer["stu_editTitle"]</div>
        <div class="edit-modal-sub" >@SharedLocalizer["stu_editSubtitle"]</div>
      </div>
      <button class="edit-close" type="button" onclick="closeEditModal()" aria-label='@(SharedLocalizer["stu_editCancel"].Value)'>✕</button>
    </div>
    <div class="edit-modal-body">
      <input type="hidden" id="e_id">
      <div class="e-grid">
        @* ⚠️ عنوان مجموعة لا تسمية حقل - الشرح في Views/Register/Index.cshtml *@
        <div class="e-field name-group" role="group" aria-labelledby="eLblFullNameAr">

          <label id="eLblFullNameAr">@SharedLocalizer["reg_lblFullName"]<span>*</span></label>

          <div class="name-row">

            <div>

              <label for="e_ar_first">@SharedLocalizer["reg_lblNameFirst"]</label>

              <input type="text" id="e_ar_first" autocomplete="off">

            </div>

            <div>

              <label for="e_ar_middle">@SharedLocalizer["reg_lblNameMiddle"]</label>

              <input type="text" id="e_ar_middle" autocomplete="off">

            </div>

            <div>

              <label for="e_ar_family">@SharedLocalizer["reg_lblNameFamily"]</label>

              <input type="text" id="e_ar_family" autocomplete="off">

            </div>

          </div>

          <span class="field-error" id="e_err-name_ar" >@SharedLocalizer["reg_errNameParts"]</span>

        </div>

        <div class="e-field name-group" role="group" aria-labelledby="eLblFullNameEn">

          <label id="eLblFullNameEn">@SharedLocalizer["reg_lblFullNameEn"]<span>*</span></label>

          <div class="name-row">

            <div>

              <label for="e_en_first">@SharedLocalizer["reg_lblNameFirst"]</label>

              <input type="text" id="e_en_first" dir="ltr" autocomplete="off">

            </div>

            <div>

              <label for="e_en_middle">@SharedLocalizer["reg_lblNameMiddle"]</label>

              <input type="text" id="e_en_middle" dir="ltr" autocomplete="off">

            </div>

            <div>

              <label for="e_en_family">@SharedLocalizer["reg_lblNameFamily"]</label>

              <input type="text" id="e_en_family" dir="ltr" autocomplete="off">

            </div>

          </div>

          <span class="field-error" id="e_err-name_en" >@SharedLocalizer["reg_errNameParts"]</span>

        </div>

        <span class="field-error name-group" id="e_err-name_match" >@SharedLocalizer["reg_valNameMismatch"]</span>
        <div class="e-field">
          <label for="e_student_id">@SharedLocalizer["reg_lblStudentId"]</label>
          <input type="text" id="e_student_id" maxlength="10" readonly>
        </div>
        <div class="e-field">
          <label for="e_national_id">@SharedLocalizer["reg_lblNationalId"]<span>*</span></label>
          <input type="text" id="e_national_id" maxlength="10">
          <span class="field-error" id="e-err-national_id" >@SharedLocalizer["reg_errRequired"]</span>
          <span class="field-error" id="e-val-national_id" >@SharedLocalizer["reg_valNationalId"]</span>
        </div>
        <div class="e-field">
          <label for="e_phone">@SharedLocalizer["reg_lblPhone"]</label>
          @* من غير maxlength: المتصفح بيقص اللصق قبل التنظيف فيضيّع رقم *@
          <div class="phone-wrap" id="e_phoneWrap">
            <span class="cc">+966</span>
            <input type="tel" id="e_phone" placeholder='@(SharedLocalizer["reg_phPhone"].Value)'
                   inputmode="numeric" autocomplete="tel-national" dir="ltr">
          </div>
          <span class="field-error" id="e-val-phone" >@SharedLocalizer["reg_valPhone"]</span>
        </div>
        <div class="e-field">
          <label for="e_gender">@SharedLocalizer["reg_lblGender"]<span>*</span></label>
          @* ⚠️ تغيير جنس طالب قائم = نقله لقسم تاني، فيختفي من قائمة اللي
             بيتابعه. مقفول على مشرف القسم ومفتوح للأدمن وحده — والحارس
             الحقيقي في StudentService.UpdateAsync، ده إخفاء واجهة بس.
             ومشرف القسم أصلًا ما بيفتحش سجل من القسم التاني، فالخيار الوحيد
             المعروض عليه هو قسمه. *@
          <select id="e_gender" disabled="@genderLockAttr">
            @if (!genderLocked)
            {
              <option value="" >@SharedLocalizer["reg_optSelectGender"]</option>
              <option value="male" >@SharedLocalizer["reg_optMale"]</option>
              <option value="female" >@SharedLocalizer["reg_optFemale"]</option>
            }
            else if (scopeGender == "male")
            {
              <option value="male" selected>@SharedLocalizer["reg_optMale"]</option>
            }
            else
            {
              <option value="female" selected>@SharedLocalizer["reg_optFemale"]</option>
            }
          </select>
          <span class="field-error" id="e-err-gender" >@SharedLocalizer["reg_optSelectGender"]</span>
        </div>
        <div class="e-field">
          <label for="e_college">@SharedLocalizer["reg_lblCollege"]<span>*</span></label>
          <select id="e_college">
            <option value="" >@SharedLocalizer["reg_optSelectCollege"]</option>
            <option value="engineering" >@SharedLocalizer["reg_collegeEngineering"]</option>
            <option value="medicine" >@SharedLocalizer["reg_collegeMedicine"]</option>
            <option value="cs" >@SharedLocalizer["reg_collegeCS"]</option>
            <option value="science" >@SharedLocalizer["reg_collegeScience"]</option>
            <option value="business" >@SharedLocalizer["reg_collegeBusiness"]</option>
            <option value="arts" >@SharedLocalizer["reg_collegeArts"]</option>
            <option value="education" >@SharedLocalizer["reg_collegeEducation"]</option>
            <option value="pharmacy" >@SharedLocalizer["reg_collegePharmacy"]</option>
          </select>
          <span class="field-error" id="e-err-college" >@SharedLocalizer["reg_optSelectCollege"]</span>
        </div>
        <div class="e-field">
          <label for="e_department">@SharedLocalizer["reg_lblDepartment"]<span>*</span></label>
          <select id="e_department">
            <option value="" >@SharedLocalizer["reg_optSelectDepartment"]</option>
            <option value="cs" >@SharedLocalizer["reg_deptCS"]</option>
            <option value="computer" >@SharedLocalizer["reg_deptComputer"]</option>
            <option value="electrical" >@SharedLocalizer["reg_deptElectrical"]</option>
            <option value="mechanical" >@SharedLocalizer["reg_deptMechanical"]</option>
            <option value="civil" >@SharedLocalizer["reg_deptCivil"]</option>
            <option value="math" >@SharedLocalizer["reg_deptMath"]</option>
            <option value="physics" >@SharedLocalizer["reg_deptPhysics"]</option>
            <option value="chemistry" >@SharedLocalizer["reg_deptChemistry"]</option>
            <option value="biology" >@SharedLocalizer["reg_deptBiology"]</option>
            <option value="business" >@SharedLocalizer["reg_deptBusiness"]</option>
            <option value="accounting" >@SharedLocalizer["reg_deptAccounting"]</option>
            <option value="islamic" >@SharedLocalizer["reg_deptIslamic"]</option>
            <option value="arabic" >@SharedLocalizer["reg_deptArabic"]</option>
            <option value="english" >@SharedLocalizer["reg_deptEnglish"]</option>
          </select>
          <span class="field-error" id="e-err-department" >@SharedLocalizer["reg_optSelectDepartment"]</span>
        </div>
        <div class="e-field">
          <label for="e_academic_level">@SharedLocalizer["reg_lblAcademicLevel"]<span>*</span></label>
          <select id="e_academic_level">
            <option value="" >@SharedLocalizer["reg_optSelectLevel"]</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
          </select>
          <span class="field-error" id="e-err-academic_level" >@SharedLocalizer["reg_optSelectLevel"]</span>
        </div>
        <div class="e-field">
          <label for="e_housing_building">@SharedLocalizer["reg_lblBuilding"]<span>*</span></label>
          <select id="e_housing_building">
            <option value="" >@SharedLocalizer["reg_optSelectBuilding"]</option>
            <option value="65">65</option>
            <option value="66">66</option>
            <option value="67">67</option>
            <option value="68">68</option>
            <option value="69">69</option>
            <option value="70">70</option>
          </select>
          <span class="field-error" id="e-err-housing_building" >@SharedLocalizer["reg_optSelectBuilding"]</span>
        </div>
        <div class="e-field">
          <label for="e_floor_number">@SharedLocalizer["reg_lblFloor"]<span>*</span></label>
          <select id="e_floor_number">
            <option value="" >@SharedLocalizer["reg_optSelectFloor"]</option>
            <option value="0" >@SharedLocalizer["reg_optFloorGround"]</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
          <span class="field-error" id="e-err-floor_number" >@SharedLocalizer["reg_optSelectFloor"]</span>
        </div>
        <div class="e-field">
          <label for="e_apartment_number">@SharedLocalizer["reg_lblApartment"]<span>*</span></label>
          @* الشقة بتتولّد من الدور — مقفولة لحد ما يتحدد الدور *@
          <select id="e_apartment_number" disabled>
            <option value="" >@SharedLocalizer["reg_optSelectFloorFirst"]</option>
          </select>
          <span class="field-error" id="e-err-apartment_number" >@SharedLocalizer["reg_errRequired"]</span>
        </div>
        <div class="e-field">
          <label for="e_room_number">@SharedLocalizer["reg_lblRoom"]<span>*</span></label>
          <select id="e_room_number">
            <option value="" >@SharedLocalizer["reg_optSelectRoom"]</option>
          </select>
          <span class="field-error" id="e-err-room_number" >@SharedLocalizer["reg_errRequired"]</span>
        </div>
        @* ⚠️ خانة «الحالة» اتشالت من هنا — وماكانتش زيادة، كانت بتمسح بيانات:
           الطالب اللي حالته left (غادر السكن، اتسجّلت من شاشة «تحديث حالة
           الطالب» بسبب وتاريخ) ماكانش له خيار مطابق في القائمة، فـ
           setEditSelect بيقع على أول خيار = «نشط»، وأي حفظ للمودال — حتى لو
           الموظف غيّر رقم الجوال بس — كان بيرجّعه «مقيم» ويمسح قرار الشاشة
           التانية بلا ما حد ياخد باله.
           وحالة السكن ليها شاشة واحدة مسؤولة عنها: «تحديث حالة الطالب» —
           بتسجّل السبب والتاريخ والسجل. كاتبان لنفس العمود = تفارق مؤكّد.
           و inactive ماكانش بيقراه حاجة في النظام أصلًا. *@
      </div>
    </div>
    <div class="edit-modal-actions">
      <button class="btn btn-primary" id="editSaveBtn" type="button" onclick="submitEdit()">
        <span class="btn-text" >@SharedLocalizer["stu_editSave"]</span>
        <div class="spinner2"></div>
      </button>
      <button class="btn btn-cancel" type="button" onclick="closeEditModal()" >@SharedLocalizer["stu_editCancel"]</button>
    </div>
  </div>
</div>

<div class="toast" id="toast">
  <span id="toast-msg"></span>
</div>
}

@section Scripts {
<style>
  .action-btn{display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border-radius:8px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:12px;cursor:pointer;border:none;transition:all .2s}
  .action-delete{background:var(--red-light);color:var(--red)}
  .action-delete:hover{background:#fee2e2}
  .action-edit{background:#eef1f8;color:var(--navy)}
  .action-edit:hover{background:#e0e6f5}
  /* مودال تعديل بيانات الطالب */
  /* ⚠️ .edit-modal-header اتشالت من هنا — كانت مكرّرة في ثلاث شاشات.
     مكانها الآن site.css مرة واحدة. */
  .name-group{grid-column:1/-1}
  .name-row{display:grid;grid-template-columns:1fr 1.6fr 1fr;gap:12px}
  .name-row>div{display:flex;flex-direction:column;gap:4px}
  .name-row label{font-size:11px;font-weight:500;color:var(--gray-500)}
  @@media(max-width:700px){.name-row{grid-template-columns:1fr}}
  /* خانة الجوال: نفس صيغة باقي الشاشات — مفتاح +966 ثابت و٩ أرقام تبدأ بـ 5 */
  .phone-wrap{display:flex;align-items:stretch;direction:ltr;background:var(--gray-50);
              border:1.5px solid var(--gray-200);border-radius:10px;overflow:hidden;transition:all .2s}
  .phone-wrap:focus-within{border-color:var(--navy);background:#fff;box-shadow:0 0 0 3px rgba(27,42,94,.08)}
  .phone-wrap.ok{border-color:var(--green)}
  .phone-wrap .cc{display:flex;align-items:center;flex-shrink:0;padding:0 13px;background:var(--gray-100);
                  border-right:1.5px solid var(--gray-200);font-size:13.5px;font-weight:700;
                  color:var(--gray-700);letter-spacing:.5px;user-select:none}
  .phone-wrap input{flex:1;min-width:0;height:44px;padding:0 14px;border:none;outline:none;background:transparent;
                    font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;font-weight:600;
                    letter-spacing:1.2px;color:var(--navy-dark)}
  .phone-wrap input:focus{box-shadow:none;background:transparent}
</style>
<script src="/i18n.js"></script>
<script src="/lookups.js"></script>

<script src="/js/name-fields.js"></script>
<script src="/js/housing-fields.js"></script>
<script src="/js/phone-field.js"></script>
<script>
  var CAN_EDIT = @(canEdit ? "true" : "false");
  var CAN_DELETE = @(canDelete ? "true" : "false");
  // حالة الصفحة - مصدرها الرابط (NuhUrl في js/url-state.js) لا الافتراضيات.
  // ⚠️ الشاشة دي مابتخرجش لصفحة تانية بنفسها، لكن الموظف بيخرج منها من
  //    القائمة الجانبية ويرجع - وكان بيلاقي بحثه وصفحته راحوا.
  var state = {
    page: NuhUrl.int('page', @Model.Page.Page, 1),
    pageSize: @Model.Page.PageSize,
    totalPages: @Model.Page.TotalPages,
    total: @Model.Page.TotalCount,
    filter: NuhUrl.get('q', '')
  };
  var STATE_DEFAULTS = { page: 1, q: '', sort: '', asc: '' };

  function syncUrl() {
    NuhUrl.sync({
      page: state.page, q: state.filter,
      sort: stuSort.by(), asc: stuSort.by() ? (stuSort.asc() ? '1' : '0') : ''
    }, STATE_DEFAULTS);
  }

  // الترويسات من NUH.headers في التخطيط — الكوكي بيتبعت لوحده، ومفيش توكن.

  // تهريب HTML — التعريف الوحيد في /js/esc.js
  var esc = function (v) { return escHtml(v); };

  // نص الحالة من القاموس. الحقل الفارغ له مفتاحه الخاص «غير محدد» - نفس
  // قاعدة الخادم في StudentStatusText أعلاه، فلا يختلف أول تحميل عن إعادة الفلترة.
  function studentStatusText(st) {
    if (!st) return t('stu_status_none');
    var k = 'stu_status_' + st;
    var v = t(k);
    return v === k ? st : v;
  }

  // صفّ الترقيم كامل من نسخة واحدة في النظام - NuhTable.pager
  function renderPager() {
    NuhTable.pager('stuPager',
      { page: state.page, pageSize: state.pageSize, total: state.total, totalPages: state.totalPages || 1 },
      {
        summary: t('stu_pageInfoFmt')
          .replace('{0}', state.page).replace('{1}', state.totalPages || 1).replace('{2}', state.total),
        prev: t('stu_prev'), next: t('stu_next')
      },
      function (p) { state.page = p; loadPage(); });
  }

  // رسالة عطل مكان الصفوف - بزرار إعادة محاولة.
  // صفّ الخطأ + زرّ إعادة المحاولة من NuhTable - الشرح في js/table-state.js
  var stuTableState = NuhTable.bind('studentsBody',
    document.querySelectorAll('#stuTable thead th').length || 8);
  function showLoadError(msg) { stuTableState.error(msg, loadPage, t('stu_retry')); }

  async function loadPage() {
    syncUrl();
    var url = '/api/Students/paged?page=' + state.page + '&pageSize=' + state.pageSize +
              '&filterText=' + encodeURIComponent(state.filter) + stuSort.qs();
    var res, data;
    try {
      res = await fetch(url, { headers: NUH.headers() });
    } catch (e) {
      // انقطاع الشبكة كان بيرمي استثناء مالوش ماسك: الصفوف القديمة بتفضل
      // معروضة كأنها نتيجة الفلتر الجديد.
      return showLoadError(t('stu_loadErrorNet'));
    }
    if (res.status === 401) { window.location.replace('/Account/Login'); return; }
    // ⚠️ كان `if (!res.ok) return;` - الموظف يضغط فلتر فمايحصلش حاجة، والصفوف
    //    القديمة تفضل مكانها وهو فاكرها النتيجة. الخطأ الصامت بيدّي بيانات
    //    غلط بثقة، والظاهر بيقول للموظف يحاول تاني.
    if (!res.ok) return showLoadError(t('stu_loadErrorFmt').replace('{0}', res.status));
    data = await res.json();
    state.totalPages = data.totalPages;
    state.total = data.totalCount;

    var rows = '';
    var i = (data.page - 1) * data.pageSize;
    (data.items || []).forEach(function (s) {
      i++;
      rows += '<tr>' +
        '<td>' + i + '</td>' +
        '<td>' + esc(s.full_name) + '</td>' +
        '<td>' + esc(s.student_id) + '</td>' +
        '<td>' + esc(s.national_id) + '</td>' +
        '<td>' + esc(s.phone) + '</td>' +
        '<td>' + esc(collegeName(s.college)) + '</td>' +
        '<td>' + esc(levelName(s.academic_level)) + '</td>' +
        '<td>' + esc(s.full_name_english) + '</td>' +
        '<td>' + esc(buildingName(s.housing_building)) + '</td>' +
        '<td>' + esc(s.room_number) + '</td>' +
        '<td>' + esc(studentStatusText(s.student_status)) + '</td>' +
        '<td>' + (s.status === 'left'
            ? '<span class="badge badge-left">' + t('stu_badge_left') + '</span>'
            : '<span class="badge badge-active">' + t(normalizeGender(s.gender) === 'female' ? 'stu_residentF' : 'stu_resident') + '</span>') + '</td>' +
        '<td><div class="row-actions">' +
          (CAN_EDIT ? '<button class="action-btn action-edit" onclick="openEditModal(' + s.id + ')">' + t('stu_edit') + '</button>' : '') +
          (CAN_DELETE ? '<button class="action-btn action-delete" onclick="deleteStudent(' + s.id + ', this)">' + t('stu_delete') + '</button>' : '') +
        '</div></td>' +
      '</tr>';
    });
    document.getElementById('studentsBody').innerHTML = rows ||
      '<tr><td colspan="13" style="text-align:center;color:var(--gray-500);padding:28px">' + t('stu_noResults') + '</td></tr>';
    renderPager();
  }

  // ترتيب الأعمدة كامل من نسخة واحدة في النظام - NuhTable.sort.
  // الأعمدة اللي بتترتّب معرّفة بـ data-sort على الـ <th> في الجدول فوق، مش
  // في قائمة مكتوبة هنا كمان - فإضافة عمود بقت في مكان واحد.
  var stuSort = NuhTable.sort('stuTable', function () { state.page = 1; loadPage(); },
    { by: NuhUrl.get('sort', ''), asc: NuhUrl.get('asc', '1') === '1' });

  var searchTimer = null;
  document.getElementById('searchBox').addEventListener('input', function (e) {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function () {
      state.filter = e.target.value.trim();
      state.page = 1;
      loadPage();
    }, 350);
  });

  async function deleteStudent(id, btn) {
    // الحذف إجراء خطر: نافذة حمراء ولا تُغلق بالضغط خارجها
    if (!await NuhDialog.confirm({ message: t('stu_confirmDelete'), danger: true })) return;
    var res = await fetch('/api/Students/' + id, { method: 'DELETE', headers: NUH.headers() });
    var data = await res.json().catch(function () { return {}; });
    if (res.ok) { loadPage(); }
    else { NuhDialog.error(data.message || t('stu_deleteFailed')); }
  }

  // ===== تعديل بيانات الطالب =====
  function eGet(id) { return document.getElementById('e_' + id); }

  // القاعدة كلها في js/phone-field.js — نفس ملف باقي الشاشات
  var editPhone = NuhPhone.attach({ input: 'e_phone', wrap: 'e_phoneWrap' });

  function showToast(msg, isError) {
    var el = document.getElementById('toast');
    if (!el) return;
    document.getElementById('toast-msg').textContent = msg;
    el.style.background = isError ? '#991B1B' : '#0F6E56';
    el.classList.add('show');
    setTimeout(function () { el.classList.remove('show'); }, 3500);
  }

  function normalizeGender(g) {
    g = (g || '').toString().trim().toLowerCase();
    if (g === 'm' || g === 'male' || g === 'ذكر') return 'male';
    if (g === 'f' || g === 'female' || g === 'أنثى' || g === 'انثى') return 'female';
    return '';
  }

  var HOUSING_PH = @Html.Raw(__housingPh);
  // الشقة بتتولد من الدور، والغرفة 1-4 — نفس منطق شاشات التسجيل (js/housing-fields.js)
  var housingRefresh = NuhHousing.attach({
    floor: 'e_floor_number', apartment: 'e_apartment_number', room: 'e_room_number',
    labels: { floorFirst: HOUSING_PH.floorFirst, selectApartment: HOUSING_PH.selectApartment, selectRoom: HOUSING_PH.selectRoom }
  });

  function setEditSelect(id, val) {
    var el = eGet(id);
    if (!el) return;
    el.value = (val == null ? '' : String(val));
    if (el.selectedIndex < 0) el.selectedIndex = 0;
  }

  function clearEditErrors() {
    var ov = document.getElementById('editOverlay');
    if (!ov) return;
    ov.querySelectorAll('.field-error').forEach(function (e) { e.classList.remove('show'); });
    ov.querySelectorAll('input, select').forEach(function (e) { e.classList.remove('error'); });
  }

  async function openEditModal(id) {
    clearEditErrors();
    var data;
    try {
      var res = await fetch('/api/Students/' + id, { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (!res.ok) { showToast(t('stu_editLoadError'), true); return; }
      data = await res.json();
    } catch (e) { showToast(t('reg_toastConnError'), true); return; }

    eGet('id').value = data.id;
    NuhName.fill('e_', 'ar', data.full_name);
    NuhName.fill('e_', 'en', data.full_name_english);
    ['student_id', 'national_id', 'phone'].forEach(function (f) {
      eGet(f).value = (data[f] == null ? '' : data[f]);
    });
    // الجوال متخزّن 9665XXXXXXXX والخانة بتعرض ٩ أرقام فقط (المفتاح ثابت جنبها)
    editPhone.validate();
    setEditSelect('gender', normalizeGender(data.gender));
    // الدور متخزّن كود ("0" = الأرضي) — القيمة الفاضية بتخلّي "اختر الدور" ظاهرة
    setEditSelect('floor_number', data.floor_number == null ? '' : String(data.floor_number));
    housingRefresh(); // بيولّد شقق الدور ده وغرف 1-4
    // القيم القديمة الخارجة عن الترقيم (زي 101 و201) مالهاش خيار مطابق فبتفضل فاضية
    // والموظف لازم يختار من جديد — ده اللي اتفقنا عليه بدل ما نحفظ رقم مش موجود.
    setEditSelect('apartment_number', data.apartment_number == null ? '' : String(data.apartment_number));
    setEditSelect('room_number', data.room_number == null ? '' : String(data.room_number));
    // college/department/academic_level/housing_building من قاعدة البيانات (مع fallback للخيارات الثابتة لو مش متهاجرة)
    await lkLoadEditAll(data);
    document.getElementById('editOverlay').classList.add('show');
  }

  function closeEditModal() {
    var ov = document.getElementById('editOverlay');
    if (ov) ov.classList.remove('show');
  }

  function validateEdit() {
    var ok = true;
    // خانات الاسم الستة بتتحقق في NuhName — نفس القواعد بالظبط اللي في شاشة التسجيل
    if (!NuhName.validate('e_')) ok = false;
    var required = ['national_id', 'college', 'department', 'academic_level', 'housing_building', 'floor_number', 'room_number', 'apartment_number'];
    required.forEach(function (id) {
      var el = eGet(id);
      var err = document.getElementById('e-err-' + id);
      if (!el.value.trim()) { el.classList.add('error'); if (err) err.classList.add('show'); ok = false; }
      else { el.classList.remove('error'); if (err) err.classList.remove('show'); }
    });
    function valErr(id, valId, cond) {
      var el = eGet(id);
      var val = document.getElementById(valId);
      if (el.value.trim() && !cond) { el.classList.add('error'); if (val) val.classList.add('show'); ok = false; }
      else if (el.value.trim()) { el.classList.remove('error'); if (val) val.classList.remove('show'); }
    }
    valErr('national_id', 'e-val-national_id', NuhId.isNationalId(eGet('national_id').value));
    valErr('phone', 'e-val-phone', NuhPhone.isValid(NuhPhone.normalize(eGet('phone').value)));
    var g = eGet('gender'), ge = document.getElementById('e-err-gender');
    if (!g.value) { g.classList.add('error'); if (ge) ge.classList.add('show'); ok = false; }
    else { g.classList.remove('error'); if (ge) ge.classList.remove('show'); }
    return ok;
  }

  async function submitEdit() {
    if (!validateEdit()) return;
    var btn = document.getElementById('editSaveBtn');
    btn.classList.add('loading');
    var id = eGet('id').value;
    var payload = {
      full_name: NuhName.join('e_', 'ar'),
      full_name_english: NuhName.join('e_', 'en'),
      student_id: eGet('student_id').value.trim(),
      national_id: eGet('national_id').value.trim(),
      // الصيغة الموحّدة 9665XXXXXXXX — نفس المخزّن في قاعدة البيانات
      phone: NuhPhone.toStorage(eGet('phone').value),
      gender: eGet('gender').value,
      college: eGet('college').value,
      department: eGet('department').value,
      academic_level: eGet('academic_level').value,
      housing_building: eGet('housing_building').value,
      floor_number: eGet('floor_number').value,
      room_number: eGet('room_number').value.trim(),
      // الحالة مش في الحمولة عن قصد — UpdateAsync بيتخطّى الحقل الغائب
      // فبتفضل زي ما هي (شوف التعليق على الخانة المشالة فوق).
      apartment_number: eGet('apartment_number').value.trim()
    };
    try {
      var res = await fetch('/api/Students/' + id, {
        method: 'PUT',
        headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
        body: JSON.stringify(payload)
      });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (res.ok) { closeEditModal(); loadPage(); showToast(t('stu_editSuccess')); }
      else {
        var err = await res.json().catch(function () { return {}; });
        showToast(t('reg_toastErrorFmt').replace('{0}', (err.message || t('reg_errGeneric'))), true);
      }
    } catch (e) {
      showToast(t('reg_toastConnError'), true);
    } finally {
      btn.classList.remove('loading');
    }
  }

  // ===== قوائم منسدلة من قاعدة البيانات داخل مودال التعديل =====
  // لو الـ API رجّع بيانات نستبدل الخيارات الثابتة؛ وإلا نستخدم الثابتة كما هي (fallback آمن).
  function lkFillOrFallback(sel, items, code) {
    if (items && items.length) { Lookups.fill(sel, items, { keep: code }); }
    else { sel.value = (code == null ? '' : String(code)); if (sel.selectedIndex < 0) sel.selectedIndex = 0; }
  }
  async function lkLoadEditAll(data) {
    var colleges = await Lookups.fetchList('/api/lookups/colleges');
    lkFillOrFallback(eGet('college'), colleges, data.college);
    var cid = Lookups.selectedId(eGet('college'));
    var depUrl = '/api/lookups/departments' + (cid ? ('?collegeId=' + cid) : '');
    var deps = await Lookups.fetchList(depUrl);
    if (cid && !deps.length) deps = await Lookups.fetchList('/api/lookups/departments');
    lkFillOrFallback(eGet('department'), deps, data.department);
    var levels = await Lookups.fetchList('/api/lookups/academic-levels');
    lkFillOrFallback(eGet('academic_level'), levels, data.academic_level);
    var g = normalizeGender(data.gender);
    var blds = g ? await Lookups.fetchList('/api/lookups/buildings?gender=' + encodeURIComponent(g)) : [];
    lkFillOrFallback(eGet('housing_building'), blds, data.housing_building);
  }

  // أرقام فقط + تحقق لحظي داخل المودال
  if (CAN_EDIT) {
    ['national_id', 'phone'].forEach(function (id) {
      var el = eGet(id);
      if (el) el.addEventListener('input', function () { this.value = this.value.replace(/\D/g, ''); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeEditModal();
    });
    // الأقسام تتفلتر حسب الكلية، والمباني حسب النوع
    eGet('college').addEventListener('change', async function () {
      var cid = Lookups.selectedId(this);
      var url = '/api/lookups/departments' + (cid ? ('?collegeId=' + cid) : '');
      var deps = await Lookups.fetchList(url);
      if (cid && !deps.length) deps = await Lookups.fetchList('/api/lookups/departments');
      if (deps.length) Lookups.fill(eGet('department'), deps, { keep: '' });
    });
    eGet('gender').addEventListener('change', async function () {
      if (!this.value) return;
      var blds = await Lookups.fetchList('/api/lookups/buildings?gender=' + encodeURIComponent(this.value));
      if (blds.length) Lookups.fill(eGet('housing_building'), blds, { keep: '' });
    });
  }

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم كل عناصر الترجمة وبيستدعي onLanguageChange
  window.onLanguageChange = function () { renderPager(); };
  setLang(localStorage.getItem('uiLanguage') || 'ar');

  (function initFromUrl() {
    var sb = document.getElementById('studentSearch') || document.getElementById('searchBox');
    if (sb) sb.value = state.filter;
    renderPager();
    // أول صفحة مرسومة من الخادم - مانعيدش تحميلها إلا لو الرابط فيه حالة فعلًا
    if (state.page > 1 || state.filter || stuSort.by()) loadPage();
  })();

  NuhName.attach('e_');
</script>
}
