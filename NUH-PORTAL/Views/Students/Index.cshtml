@section Scripts {
<style>
  .action-btn{display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border-radius:8px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:12px;cursor:pointer;border:none;transition:all .2s}
  .action-delete{background:var(--red-light);color:var(--red)}
  .action-delete:hover{background:#fee2e2}
  .action-edit{background:#eef1f8;color:var(--navy)}
  .action-edit:hover{background:#e0e6f5}
  .row-actions{display:flex;gap:6px;align-items:center}
  th.sortable{cursor:pointer;user-select:none;white-space:nowrap;transition:color .15s}
  th.sortable:hover{color:var(--navy)}
  .sort-ind{font-size:10px;color:var(--navy);font-weight:700}
  /* مودال تعديل بيانات الطالب */
  .edit-overlay{position:fixed;inset:0;background:rgba(15,23,42,.5);display:none;align-items:center;justify-content:center;z-index:1000;padding:20px}
  .edit-overlay.show{display:flex}
  .edit-modal{background:#fff;border-radius:16px;width:100%;max-width:780px;max-height:92vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3);overflow:hidden}
  .edit-modal-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:20px 24px;border-bottom:1px solid var(--gray-100)}
  .edit-modal-title{font-size:16px;font-weight:700;color:var(--navy-dark)}
  .edit-modal-sub{font-size:12px;color:var(--gray-500);margin-top:4px}
  .edit-close{background:var(--gray-100);border:none;width:32px;height:32px;border-radius:8px;cursor:pointer;font-size:13px;color:var(--gray-700);flex-shrink:0}
  .edit-close:hover{background:#e5e7eb}
  .edit-modal-body{padding:24px;overflow-y:auto}
  .e-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .e-field{display:flex;flex-direction:column;gap:6px}
  .e-field label{font-size:13px;font-weight:600;color:var(--gray-700)}
  .e-field label span{color:#EF4444;margin-right:2px}
  .e-field input,.e-field select{width:100%;height:44px;background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:10px;padding:0 14px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:14px;color:var(--navy-dark);outline:none;appearance:none}
  .e-field input:focus,.e-field select:focus{border-color:var(--navy);background:#fff;box-shadow:0 0 0 3px rgba(27,42,94,.08)}
  .e-field input.error,.e-field select.error{border-color:#EF4444}
  .e-field input[readonly]{background:#eef0f4;color:var(--gray-500);cursor:not-allowed}
  .e-field .field-error{font-size:11px;color:#EF4444;font-weight:500;display:none}
  .e-field .field-error.show{display:block}
  .edit-modal-actions{display:flex;gap:12px;justify-content:flex-end;padding:18px 24px;border-top:1px solid var(--gray-100)}
  .edit-modal-actions .btn{padding:0 24px;height:44px;border-radius:10px;font-family:'IBM Plex Sans Arabic',sans-serif;font-weight:700;font-size:14px;cursor:pointer;border:none;display:flex;align-items:center;gap:8px}
  .edit-modal-actions .btn.loading{opacity:.75;pointer-events:none}
  .spinner2{width:16px;height:16px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin2 .6s linear infinite;display:none}
  .btn.loading .spinner2{display:block}
  .btn.loading .btn-text{display:none}
  @@keyframes spin2{to{transform:rotate(360deg)}}
  .toast{position:fixed;top:24px;left:50%;transform:translateX(-50%) translateY(-90px);background:#0F6E56;color:#fff;padding:14px 24px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,.2);z-index:1100;transition:transform .4s cubic-bezier(.16,1,.3,1)}
  .toast.show{transform:translateX(-50%) translateY(0)}
  @@media(max-width:640px){.e-grid{grid-template-columns:1fr}}
</style>
<script src="/i18n.js"></script>
<script>
  var CAN_EDIT = @(canEdit ? "true" : "false");
  // حالة الصفحة (أول تحميل جاي جاهز من السيرفر)
  var state = {
    page: @Model.Page.Page,
    pageSize: @Model.Page.PageSize,
    totalPages: @Model.Page.TotalPages,
    total: @Model.Page.TotalCount,
    filter: '',
    sortBy: '',
    sortAsc: false
  };

  function authHeaders() {
    var t2 = localStorage.getItem('staffToken');
    return t2 ? { 'Authorization': 'Bearer ' + t2 } : {};
  }

  var esc = function (v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  };

  // نص الحالة من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function studentStatusText(st) {
    var k = 'stu_status_' + st;
    var v = t(k);
    return v === k ? (st || '') : v;
  }

  // سطر معلومات الصفحة بصيغة مترجمة مع أرقام
  function renderPageInfo() {
    var el = document.getElementById('pageInfo');
    if (!el) return;
    el.textContent = t('stu_pageInfoFmt')
      .replace('{0}', state.page).replace('{1}', state.totalPages || 1).replace('{2}', state.total);
  }

  async function loadPage() {
    var url = '/api/Students/paged?page=' + state.page + '&pageSize=' + state.pageSize +
              '&filterText=' + encodeURIComponent(state.filter) +
              (state.sortBy ? '&sortBy=' + encodeURIComponent(state.sortBy) + '&sortAsc=' + state.sortAsc : '');
    var res = await fetch(url, { headers: authHeaders() });
    if (!res.ok) return;
    var data = await res.json();
    state.totalPages = data.totalPages;
    state.total = data.totalCount;

    var rows = '';
    var i = (data.page - 1) * data.pageSize;
    (data.items || []).forEach(function (s) {
      i++;
      rows += '<tr>' +
        '<td>' + i + '</td>' +
        '<td>' + esc(s.full_name) + '</td>' +
        '<td>' + esc(s.student_id) + '</td>' +
        '<td>' + esc(s.national_id) + '</td>' +
        '<td>' + esc(s.phone) + '</td>' +
        '<td>' + esc(collegeName(s.college)) + '</td>' +
        '<td>' + esc(s.academic_level) + '</td>' +
        '<td>' + esc(s.full_name_english) + '</td>' +
        '<td>' + esc(s.housing_building) + '</td>' +
        '<td>' + esc(s.room_number) + '</td>' +
        '<td>' + esc(studentStatusText(s.student_status)) + '</td>' +
        '<td>' + (s.status === 'left'
            ? '<span class="badge badge-left">' + t('stu_badge_left') + '</span>'
            : '<span class="badge badge-active">' + t('stu_resident') + '</span>') + '</td>' +
        '<td><div class="row-actions">' +
          (CAN_EDIT ? '<button class="action-btn action-edit" onclick="openEditModal(' + s.id + ')">' + t('stu_edit') + '</button>' : '') +
          '<button class="action-btn action-delete" onclick="deleteStudent(' + s.id + ', this)">' + t('stu_delete') + '</button>' +
        '</div></td>' +
      '</tr>';
    });
    document.getElementById('studentsBody').innerHTML = rows ||
      '<tr><td colspan="13" style="text-align:center;color:var(--gray-500);padding:28px">' + t('stu_noResults') + '</td></tr>';
    renderPageInfo();
    updatePagerButtons();
  }

  function updatePagerButtons() {
    document.getElementById('prevBtn').disabled = state.page <= 1;
    document.getElementById('nextBtn').disabled = state.page >= state.totalPages;
  }

  // ترتيب الأعمدة: أول ضغطة تصاعدي، وتكرار الضغط على نفس العمود يعكس الاتجاه
  function sortByColumn(field) {
    if (state.sortBy === field) { state.sortAsc = !state.sortAsc; }
    else { state.sortBy = field; state.sortAsc = true; }
    state.page = 1;
    updateSortIndicators();
    loadPage();
  }

  function updateSortIndicators() {
    ['full_name', 'student_id', 'college', 'status'].forEach(function (f) {
      var el = document.getElementById('sort-' + f);
      if (el) el.textContent = (state.sortBy === f) ? (state.sortAsc ? ' ▲' : ' ▼') : '';
    });
  }

  function changePage(delta) {
    var next = state.page + delta;
    if (next < 1 || (state.totalPages && next > state.totalPages)) return;
    state.page = next;
    loadPage();
  }

  var searchTimer = null;
  document.getElementById('searchBox').addEventListener('input', function (e) {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function () {
      state.filter = e.target.value.trim();
      state.page = 1;
      loadPage();
    }, 350);
  });

  async function deleteStudent(id, btn) {
    if (!confirm(t('stu_confirmDelete'))) return;
    var res = await fetch('/api/Students/' + id, { method: 'DELETE', headers: authHeaders() });
    var data = await res.json().catch(function () { return {}; });
    if (res.ok) { loadPage(); }
    else { alert(data.message || t('stu_deleteFailed')); }
  }

  // ===== تعديل بيانات الطالب =====
  function eGet(id) { return document.getElementById('e_' + id); }

  function showToast(msg, isError) {
    var el = document.getElementById('toast');
    if (!el) return;
    document.getElementById('toast-msg').textContent = msg;
    el.style.background = isError ? '#991B1B' : '#0F6E56';
    el.classList.add('show');
    setTimeout(function () { el.classList.remove('show'); }, 3500);
  }

  function normalizeGender(g) {
    g = (g || '').toString().trim().toLowerCase();
    if (g === 'm' || g === 'male' || g === 'ذكر') return 'male';
    if (g === 'f' || g === 'female' || g === 'أنثى' || g === 'انثى') return 'female';
    return '';
  }

  function setEditSelect(id, val) {
    var el = eGet(id);
    if (!el) return;
    el.value = (val == null ? '' : String(val));
    if (el.selectedIndex < 0) el.selectedIndex = 0;
  }

  function clearEditErrors() {
    var ov = document.getElementById('editOverlay');
    if (!ov) return;
    ov.querySelectorAll('.field-error').forEach(function (e) { e.classList.remove('show'); });
    ov.querySelectorAll('input, select').forEach(function (e) { e.classList.remove('error'); });
  }

  async function openEditModal(id) {
    clearEditErrors();
    var data;
    try {
      var res = await fetch('/api/Students/' + id, { headers: authHeaders() });
      if (res.status === 401) { localStorage.removeItem('staffToken'); window.location.replace('/Account/Login'); return; }
      if (!res.ok) { showToast(t('stu_editLoadError'), true); return; }
      data = await res.json();
    } catch (e) { showToast(t('reg_toastConnError'), true); return; }

    eGet('id').value = data.id;
    ['full_name', 'full_name_english', 'student_id', 'national_id', 'phone', 'room_number', 'apartment_number'].forEach(function (f) {
      eGet(f).value = (data[f] == null ? '' : data[f]);
    });
    setEditSelect('gender', normalizeGender(data.gender));
    ['college', 'department', 'academic_level', 'housing_building', 'status'].forEach(function (f) {
      setEditSelect(f, data[f]);
    });
    if (!eGet('status').value) eGet('status').value = 'active';
    document.getElementById('editOverlay').classList.add('show');
  }

  function closeEditModal() {
    var ov = document.getElementById('editOverlay');
    if (ov) ov.classList.remove('show');
  }

  function validateEdit() {
    var ok = true;
    var required = ['full_name', 'full_name_english', 'national_id', 'college', 'department', 'academic_level', 'housing_building', 'room_number', 'apartment_number'];
    required.forEach(function (id) {
      var el = eGet(id);
      var err = document.getElementById('e-err-' + id);
      if (!el.value.trim()) { el.classList.add('error'); if (err) err.classList.add('show'); ok = false; }
      else { el.classList.remove('error'); if (err) err.classList.remove('show'); }
    });
    function valErr(id, valId, cond) {
      var el = eGet(id);
      var val = document.getElementById(valId);
      if (el.value.trim() && !cond) { el.classList.add('error'); if (val) val.classList.add('show'); ok = false; }
      else if (el.value.trim()) { el.classList.remove('error'); if (val) val.classList.remove('show'); }
    }
    valErr('full_name', 'e-val-full_name', /^[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\s]+$/.test(eGet('full_name').value.trim()));
    valErr('full_name_english', 'e-val-full_name_english', /^[a-zA-Z\s]+$/.test(eGet('full_name_english').value.trim()));
    valErr('national_id', 'e-val-national_id', /^\d{10}$/.test(eGet('national_id').value.trim()));
    valErr('phone', 'e-val-phone', /^9665\d{8}$/.test(eGet('phone').value.trim()));
    var g = eGet('gender'), ge = document.getElementById('e-err-gender');
    if (!g.value) { g.classList.add('error'); if (ge) ge.classList.add('show'); ok = false; }
    else { g.classList.remove('error'); if (ge) ge.classList.remove('show'); }
    return ok;
  }

  async function submitEdit() {
    if (!validateEdit()) return;
    var btn = document.getElementById('editSaveBtn');
    btn.classList.add('loading');
    var id = eGet('id').value;
    var payload = {
      full_name: eGet('full_name').value.trim(),
      full_name_english: eGet('full_name_english').value.trim(),
      student_id: eGet('student_id').value.trim(),
      national_id: eGet('national_id').value.trim(),
      phone: eGet('phone').value.trim(),
      gender: eGet('gender').value,
      college: eGet('college').value,
      department: eGet('department').value,
      academic_level: eGet('academic_level').value,
      housing_building: eGet('housing_building').value,
      room_number: eGet('room_number').value.trim(),
      apartment_number: eGet('apartment_number').value.trim(),
      status: eGet('status').value
    };
    try {
      var res = await fetch('/api/Students/' + id, {
        method: 'PUT',
        headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()),
        body: JSON.stringify(payload)
      });
      if (res.status === 401) { localStorage.removeItem('staffToken'); window.location.replace('/Account/Login'); return; }
      if (res.ok) { closeEditModal(); loadPage(); showToast(t('stu_editSuccess')); }
      else {
        var err = await res.json().catch(function () { return {}; });
        showToast(t('reg_toastErrorFmt').replace('{0}', (err.message || t('reg_errGeneric'))), true);
      }
    } catch (e) {
      showToast(t('reg_toastConnError'), true);
    } finally {
      btn.classList.remove('loading');
    }
  }

  // أرقام فقط + تحقق لحظي داخل المودال
  if (CAN_EDIT) {
    ['national_id', 'phone'].forEach(function (id) {
      var el = eGet(id);
      if (el) el.addEventListener('input', function () { this.value = this.value.replace(/\D/g, ''); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeEditModal();
    });
  }

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم كل عناصر الترجمة وبيستدعي onLanguageChange
  window.onLanguageChange = function () { renderPageInfo(); };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
  updatePagerButtons();
  updateSortIndicators();
</script>
}
