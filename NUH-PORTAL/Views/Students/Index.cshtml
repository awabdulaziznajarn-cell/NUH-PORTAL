        <div class="e-field">
          <label >@SharedLocalizer["reg_lblAcademicLevel"]<span>*</span></label>
          <select id="e_academic_level">
            <option value="" >@SharedLocalizer["reg_optSelectLevel"]</option>
            <option value="1">1</option>
