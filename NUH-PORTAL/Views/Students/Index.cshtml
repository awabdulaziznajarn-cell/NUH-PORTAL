            <option value="66">66</option>
            <option value="67">67</option>
            <option value="68">68</option>
            <option value="69">69</option>
            <option value="70">70</option>
          </select>
          <span class="field-error" id="e-err-housing_building" >@SharedLocalizer["reg_optSelectBuilding"]</span>
        </div>
        <div class="e-field">
          <label >@SharedLocalizer["reg_lblRoom"]<span>*</span></label>
          <input type="text" id="e_room_number" placeholder='@(SharedLocalizer["reg_phRoom"].Value)'>
          <span class="field-error" id="e-err-room_number" >@SharedLocalizer["reg_errRequired"]</span>
        </div>
        <div class="e-field">
          <label >@SharedLocalizer["reg_lblApartment"]<span>*</span></label>
          <input type="text" id="e_apartment_number" placeholder='@(SharedLocalizer["reg_phApartment"].Value)'>
