        </div>
        <div class="e-field">
          <label >@SharedLocalizer["reg_lblDepartment"]<span>*</span></label>
          <select id="e_department">
            <option value="" >@SharedLocalizer["reg_optSelectDepartment"]</option>
            <option value="cs" >@SharedLocalizer["reg_deptCS"]</option>
            <option value="computer" >@SharedLocalizer["reg_deptComputer"]</option>
            <option value="electrical" >@SharedLocalizer["reg_deptElectrical"]</option>
            <option value="mechanical" >@SharedLocalizer["reg_deptMechanical"]</option>
            <option value="civil" >@SharedLocalizer["reg_deptCivil"]</option>
            <option value="math" >@SharedLocalizer["reg_deptMath"]</option>
            <option value="physics" >@SharedLocalizer["reg_deptPhysics"]</option>
            <option value="chemistry" >@SharedLocalizer["reg_deptChemistry"]</option>
            <option value="biology" >@SharedLocalizer["reg_deptBiology"]</option>
            <option value="business" >@SharedLocalizer["reg_deptBusiness"]</option>
            <option value="accounting" >@SharedLocalizer["reg_deptAccounting"]</option>
