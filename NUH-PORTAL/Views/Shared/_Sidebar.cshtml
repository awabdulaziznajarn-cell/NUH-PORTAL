  @* ⚠️ نفس مفتاح Brand_Copyright اللي بتستعمله بوابة الطالب وصفحة الدخول.
     كتابة النصّ هنا بالإيد كانت هتخلّي تعديله في ملف الترجمة يوصل لصفحتين
     ويسيب التالتة - وde حصل فعلًا مع نصّ التذييل قبل كده. *@
  <div class="sidebar-foot">@SharedLocalizer["Brand_Copyright"]</div>

  @* ⚠️ بطاقة المستخدم وزر «تسجيل الخروج» انتقلا إلى طرف الشريط العلوي
     (Views/Shared/_Layout.cshtml). لا تُعِدهما هنا: نموذج الخروج يجب أن
     يبقى في مكان واحد فقط، وإلا صار في الصفحة نموذجان بنفس الإجراء. *@
</aside>

<script>
  // فتح/قفل مجموعات السايدبار (accordion) — مع حفظ الحالة وتفعيل المجموعة اللي فيها الصفحة الحالية
  (function () {
    // ⚠️ رقم ٢ في اسم المفتاح مقصود. المنطق القديم كان بيحفظ حالة **كل**
    //    المجموعات مع أي ضغطة، فكانت المجموعات اللي النظام بيفتحها لوحده
    //    تتسجّل مفتوحة واحدة ورا التانية لحد ما القائمة كلها تتفرد.
    //    إصلاح المنطق لوحده مكانش كفاية: الحالة الغلط **متخزّنة أصلًا** في
    //    متصفّح كل مستخدم، والكود الجديد كان هيقراها زي ما هي. تغيير اسم
    //    المفتاح بيخلّي المحفوظ القديم يتجاهَل، فالكل يبدأ من نضيف من غير
    //    ما حد يمسح حاجة بإيده.
    var NAV_KEY = 'navGroups2';
    // موضع تمرير القائمة - يُحفظ لكل تبويب على حدة مثل حالة المجموعات
    var NAV_SCROLL_KEY = 'navScroll';
    // ⚠️ بنحفظ **المجموعة اللي المستخدم لمسها بس** — مش حالة كل المجموعات.
    //
    //    الغلط اللي كان هنا: الدالة كانت بتمشي على كل المجموعات وتحفظ حالتها
    //    الحالية مع أي ضغطة. وتحت في init() فيه سطر بيفتح **إجباريًّا**
    //    المجموعة اللي فيها الصفحة المفتوحة (عشان البند النشط يبان) — والفتح
    //    ده مش اختيار المستخدم.
    //
    //    فكانت النتيجة تتراكم كده:
    //      • تفتح /FacultyHousing → init بتفتح «سكن أعضاء هيئة التدريس»
    //      • تدوس على «القوائم المرجعية» عشان تفتحها → persist بتحفظ **الاتنين**
    //        مفتوحين، مع إنك فتحت واحدة بس
    //      • تكرّرها على شاشات تانية → كل مجموعة بتتسجّل مفتوحة واحدة ورا التانية
    //      • تروح للرئيسية تلاقي القائمة كلها مفرودة
    //
    //    عشان كده كانت بتبان بعد ما تفتح «القوائم المرجعية» أو «إعدادات النظام»
    //    بالذات: دول آخر مجموعتين، فالتراكم بيبقى واضح عندهم.
    function persist(group) {
      try {
        var k = group.getAttribute('data-group'); if (!k) return;
        var st = {};
        try { st = JSON.parse(sessionStorage.getItem(NAV_KEY) || '{}'); } catch (e) { }
        st[k] = group.classList.contains('collapsed');
        sessionStorage.setItem(NAV_KEY, JSON.stringify(st));
      } catch (e) { }
    }
    window.toggleNavGroup = function (btn) {
      var g = btn.closest('.nav-group'); if (!g) return;
      g.classList.toggle('collapsed'); persist(g);
    };
    function init() {
      // ⚠️ sessionStorage لا localStorage: حالة المجموعات تخصّ جلسة العمل الحالية.
      //    كانت محفوظة بلا انتهاء، فالمستخدم يخرج ويدخل في اليوم التالي فيجد
      //    «إعدادات النظام» مفتوحة من جلسة أمس. الآن كل جلسة تبدأ بقائمة مطويّة
      //    فيرى الأقسام الرئيسية أولًا، وما يفتحه يبقى مفتوحًا حتى نهاية جلسته.
      //    (صفحة الدخول تمسحها أيضًا، لتغطية الخروج والدخول في نفس التبويب.)
      var saved = {};
      try { saved = JSON.parse(sessionStorage.getItem(NAV_KEY) || '{}'); } catch (e) { }
      // الحالة المحفوظة تُطبَّق في الاتجاهين: مقفولة *ومفتوحة*. الاكتفاء بإضافة
      // collapsed كان يعني أن اختيار المستخدم بفتح مجموعة يضيع مع كل صفحة.
      document.querySelectorAll('.sidebar-nav .nav-group').forEach(function (g) {
        var k = g.getAttribute('data-group');
        if (!k || !(k in saved)) return;
        g.classList.toggle('collapsed', saved[k] === true);
      });
      var path = (location.pathname || '').replace(/\/+$/, '').toLowerCase(); if (path === '') path = '/home';
      // ⚠️ العنصر النشط واحد لا أكثر. قاعدة البادئة وحدها كانت تُضيء بندين معًا
      //    متى كان مسار بند امتدادًا لمسار بند آخر: على /FacultyHousing/Handover
      //    يطابق «قائمة أعضاء هيئة التدريس» (/FacultyHousing) و«تغيير ساكن وحدة»
      //    (/FacultyHousing/Handover) في آن واحد. المطابقة الأطول هي الأدق دائمًا،
      //    فنجمع المرشّحين ثم نُضيء أطولهم وحده. القاعدة هنا لكل بنود القائمة،
      //    فأي شاشة فرعية تُضاف مستقبلًا تعمل من غير استثناء خاص بها.
      var bestItem = null, bestLen = -1;
      document.querySelectorAll('.sidebar-nav a.nav-item').forEach(function (a) {
        var href = (a.getAttribute('href') || '').replace(/\/+$/, '').toLowerCase();
        if (!href) return;
        if ((path === href || path.indexOf(href + '/') === 0) && href.length > bestLen) {
          bestLen = href.length; bestItem = a;
        }
      });
      if (bestItem) {
        bestItem.classList.add('active');
        // ⚠️ الفتح ده عرض مؤقّت عشان البند النشط يبان — **مش** اختيار المستخدم،
        //    فما بيتحفظش. persist بتتنادى من الضغط اليدوي بس.
        var bg = bestItem.closest('.nav-group'); if (bg) bg.classList.remove('collapsed');
      }
    }
    // ⚠️ كل انتقال بين الصفحات بيعيد بناء السايدبار من الصفر، يعني القائمة
    //    بترجع لأولها. اللي بيختار «المستخدمون» من «إعدادات النظام» — وهي آخر
    //    مجموعة تحت — كان بيلاقي القائمة رجعت فوق خالص والعنصر اللي لسه مختاره
    //    مش باين. بنحرّك القائمة بالقدر اللي يخلّي العنصر النشط ظاهر وبس.
    //    مش scrollIntoView: دي بتحرّك كل العناصر الأب كمان (الصفحة نفسها).
    //    ⚠️ ولم تكن تعمل أصلًا: .sidebar-nav لم يكن لها overflow-y، فلم تكن
    //       حاوية تمرير، و scrollTop عليها لا يفعل شيئًا. والشريط نفسه كان
    //       min-height:100vh وهو position:fixed، فينمو خارج الشاشة ويصير ما
    //       تحته غير قابل للوصول إطلاقًا. أُصلح الاثنان في site.css.
    function revealActive(nav) {
      var a = nav.querySelector('a.nav-item.active');
      if (!a) return;

      var max = nav.scrollHeight - nav.clientHeight;
      if (max <= 0) return;                           // القائمة كلها ظاهرة

      var pad = 12;                                   // فسحة صغيرة فوق/تحت العنصر
      var nr = nav.getBoundingClientRect(), ar = a.getBoundingClientRect();

      // ⚠️ الموضع يُحسب من حدود العنصر لا من offsetTop: العنصر الأب في التموضع
      //    هو .sidebar (position:fixed) لا .sidebar-nav، فـ offsetTop يشمل
      //    الشعار وما قبله ويعطي رقمًا لا معنى له هنا.
      var top = ar.top - nr.top + nav.scrollTop;
      var bot = top + a.offsetHeight;

      // ⚠️ البند ظاهر بالكامل أصلًا؟ مانلمسش التمرير خالص.
      //    ده كان ناقص، والنتيجة كانت باينة للمستخدم: تكون واقف في «إدارة
      //    حسابات السكن» وشايف «قائمة أعضاء هيئة التدريس» قدامك في القائمة،
      //    تدوس عليها — فالقائمة تقفز لآخرها ويختفي نص البنود اللي فوق،
      //    مع إن اللي دوست عليه كان ظاهر من الأصل. القفزة كانت من الشرط
      //    اللي تحت («البند في آخر شاشة → انزل للنهاية») وهو بيتنفّذ من
      //    غير ما حد يسأل الأول: هو محتاج تمرير أصلًا ولا لأ؟
      if (ar.top >= nr.top + pad && ar.bottom <= nr.bottom - pad) return;

      // ⚠️ العنصر في آخر شاشة من القائمة: ننزل إلى النهاية بدل الحدّ الأدنى.
      //    الحدّ الأدنى يُظهر العنصر ملتصقًا بالحافة السفلى وما بعده مخفيّ -
      //    فمن يفتح «سجل الدخول والخروج» لا يرى «المستخدمون» و«الأدوار
      //    والصلاحيات» تحته ويظنّهما غير موجودين.
      if (top >= max + pad && bot <= max + nav.clientHeight - pad) {
        nav.scrollTop = max;
        return;
      }

      if (ar.bottom > nr.bottom - pad) nav.scrollTop += ar.bottom - nr.bottom + pad;
      else if (ar.top < nr.top + pad) nav.scrollTop -= nr.top - ar.top + pad;
    }

    // ⚠️ كان الاسترجاع ينتظر DOMContentLoaded — أي بعد رسم الصفحة كاملة، فيرى
    //    المستخدم الحركة. السكربت هنا بعد <nav> مباشرة، فالعناصر مقروءة بالفعل
    //    ويمكن التنفيذ فورًا قبل أول رسم.
    init();

    var navEl = document.querySelector('.sidebar-nav');
    if (navEl) {
      // ⚠️ استعادة موضع تمرير القائمة قبل أول رسم.
      //    كل انتقال بين الصفحات يعيد بناء الشريط من الصفر، فكانت القائمة ترجع
      //    إلى أولها في كل مرة. من يقف على «التقارير» - وهي أسفل القائمة -
      //    فقائمته مُمرَّرة لأسفل، فإذا ضغط «المستويات الدراسية» رأى القائمة
      //    تقفز إلى أعلاها فجأة. والبند الذي ضغط عليه كان ظاهرًا أمامه
      //    بالضرورة، فالإبقاء على الموضع كما هو يعني ألّا تتحرّك القائمة أصلًا.
      //    والاستعادة قبل revealActive لا بعدها: الأخيرة لا تلمس التمرير ما دام
      //    البند النشط ظاهرًا، فتصير تصحيحًا للحالات الاستثنائية فقط.
      try {
        var savedTop = parseInt(sessionStorage.getItem(NAV_SCROLL_KEY) || '', 10);
        if (savedTop > 0) navEl.scrollTop = savedTop;
      } catch (e) { }

      // قبل أول رسم: القائمة تبان من أول لحظة على العنصر النشط، مش بتتحرك بعدين
      revealActive(navEl);
      // رفع منع الحركة بعد أول رسم — الضغط اليدوي بعدها يتحرك بسلاسة كالمعتاد
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { navEl.classList.remove('no-anim'); });
      });

      // ⚠️ pagehide لا beforeunload: الأخيرة لا تُنفَّذ عند الرجوع من ذاكرة
      //    الصفحات (bfcache) في بعض المتصفحات، فيضيع الموضع مع زر الرجوع.
      window.addEventListener('pagehide', function () {
        try { sessionStorage.setItem(NAV_SCROLL_KEY, String(navEl.scrollTop)); } catch (e) { }
      });
    }

    // ===== شارة الطلبات المستنية =====
    // جرس الإشعارات ممكن يعدّي من غير ما حد ياخد باله، فبنحط الرقم على الزر نفسه.
    // العدد = الطلبات الواقفة عند مرحلة المستخدم الحالي، فبيقل لوحده مع كل طلب بيتقفل.
    // الكوكي بتتبعت تلقائيًا فمش محتاجين ترويسة توثيق هنا.
    async function refreshRequestsBadge() {
      var badge = document.getElementById('navRequestsBadge');
      if (!badge) return;
      try {
        var res = await fetch('/api/workflow/queue/my-count', { credentials: 'same-origin' });
        if (!res.ok) return;                       // 401/403 - مانعملش حاجة
        var data = await res.json();
        var n = (data && data.count) || 0;
        if (n > 0) {
          badge.textContent = n > 99 ? '99+' : n;
          badge.style.display = 'inline-flex';
        } else {
          badge.style.display = 'none';
        }
      } catch (e) { /* الشبكة - الشارة مش حاجة حرجة */ }
    }

    refreshRequestsBadge();
    setInterval(refreshRequestsBadge, 60000);
    // بعد أي اعتماد/رفض في نفس التبويب الصفحة بتعيد التحميل، وبيتحدّث الرقم معاها.
    window.refreshRequestsBadge = refreshRequestsBadge;
  })();
</script>
