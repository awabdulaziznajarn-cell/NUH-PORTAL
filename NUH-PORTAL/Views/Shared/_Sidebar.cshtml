@* السايدبار الموحد — قوائم parent/child بتتفتح وتتقفل (accordion). النصوص من SharedResource (.resx). *@
@* ⚠️ الشاشة اللي شرطها *مركّب* (أكتر من صلاحية) بنسأل عنها نظام الصلاحيات
   نفسه بدل ما نعيد كتابة الشرط هنا. الشاشة اللي شرطها صلاحية واحدة بتفضل
   HasClaim عادي — لأن الفحص ده *هو* السياسة نفسها فمفيش نسختين يفارقوا. *@
@inject IAuthorizationService Authz
@{
  // إخفاء عنوان المجموعة نفسه لو المستخدم مالوش أي شاشة جوّاها — عشان مايظهرش قسم فاضي
  bool Perm(string p) => User.HasClaim("permission", p);
  var canStudents = Perm("students.view") || Perm("students.create")
                    || Perm("students.bulkImport") || Perm("students.changeStatus")
                    || Perm("students.investigate");
  var canRequests = Perm("requests.view") || Perm("housing.view");
  var canSystem   = Perm("reports.view") || Perm("auditLogs.view") || Perm("errorLogs.view")
                    || Perm("signInLog.view") || Perm("users.view") || Perm("roles.view");
  var canFaculty  = Perm("facultyHousing.view");

  // ⚠️ مسارات الشاشات لا تُكتب هنا إطلاقًا. كانت كل مجموعة تحمل قائمة مساراتها
  //    مرة ثانية في هذا الملف (InGroup) بجانب الـ href المكتوب في البند نفسه،
  //    فأي شاشة تُضاف أو يتغيّر مسارها تحتاج تعديلين، وأي سهو بينهما يظهر
  //    كمجموعة لا تُفتح أو بندين مضيئين معًا. المصدر الوحيد الآن هو الـ href
  //    المكتوب في البند: الخادم يرسل كل المجموعات مطويّة، والسكربت أسفل <nav>
  //    يقارن المسار الحالي بالـ href ويفتح مجموعة البند المطابق - وينفّذ قبل
  //    أول رسم مع .no-anim، فلا يرى المستخدم أي حركة.
}
<style>
  /* السايدبار بطول الشاشة، والقائمة بتعمل scroll جوّاها عشان توصل لكل الشاشات (إعدادات النظام تحت) */
  .sidebar{height:100vh}
  /* ⚠️ ::-webkit-scrollbar بتشتغل في كروم وإيدج بس. فايرفوكس بيتجاهلها
     تمامًا وبيرسم الشريط بعرضه الافتراضي (١٦ بكسل تقريبًا) وبلونه الفاتح —
     فالسايدبار كان شكله عريض ومقطوع من الجنب في فايرفوكس بس.
     scrollbar-width و scrollbar-color هما المعياريتين اللي فايرفوكس بيقراهم،
     ومنطقة المحتوى (.main في site.css) عندها الاتنين أصلاً — عشان كده هي
     كانت شكلها مظبوط والسايدبار لأ. */
  .sidebar-nav{overflow-y:auto;min-height:0;
    scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.22) transparent}
  .sidebar-nav::-webkit-scrollbar{width:5px}
  .sidebar-nav::-webkit-scrollbar-track{background:transparent}
  .sidebar-nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:3px}
  .sidebar-nav:hover::-webkit-scrollbar-thumb{background:rgba(255,255,255,.3)}
  .nav-group{display:flex;flex-direction:column;gap:2px}
  /* المستوى الأول: نفس مقاس .nav-item ووزنه - رأس المجموعة زرّ تنقّل لا لافتة. */
  .nav-group-header{display:flex;align-items:center;gap:10px;width:100%;padding:10px 12px;background:none;border:none;cursor:pointer;font-family:inherit;font-size:13.5px;font-weight:700;color:rgba(255,255,255,.82);border-radius:10px;transition:all .2s;text-align:start}
  .nav-group-header:hover{background:rgba(255,255,255,.07);color:#fff}
  .nav-group-header .ng-icon{width:16px;height:16px;flex-shrink:0;opacity:.9}
  .nav-group-header .ng-title{flex:1;text-align:start}
  .nav-group-header .ng-chevron{width:13px;height:13px;flex-shrink:0;transition:transform .22s ease;opacity:.7}
  .nav-group.collapsed .ng-chevron{transform:rotate(-90deg)}
  .nav-group-body{overflow:hidden;max-height:700px;transition:max-height .26s ease;display:flex;flex-direction:column;gap:4px;padding-top:2px}
  /* أثناء تحميل الصفحة لا حركة إطلاقًا: استرجاع الحالة المحفوظة يجب أن يبدو
     كأن الصفحة فُتحت عليه، لا كأن القائمة تتحرك وحدها. تُرفع بعد أول رسم. */
  .sidebar-nav.no-anim .nav-group-body,
  .sidebar-nav.no-anim .ng-chevron{transition:none}
  .nav-group.collapsed .nav-group-body{max-height:0;padding-top:0}
  /* المستوى الثاني: أصغر وأبهت من رأسه - هي التي تصنع الشجرة. */
  .nav-group-body .nav-item{padding-inline-start:22px;font-size:13px;font-weight:500;color:rgba(255,255,255,.62)}
  .nav-group-body .nav-item:hover{color:#fff}
  /* ⚠️ لازم صراحةً: ‏.nav-group-body .nav-item و.nav-item.active لهما نفس
     الأولوية (كلاسان لكلٍّ منهما)، وهذا الملف يُحمَّل بعد site.css - فبلا
     السطر ده كان لون البند النشط يصير أبيض **على خلفية بيضاء**، أي يختفي
     نصّه تمامًا. */
  .nav-group-body .nav-item.active{color:var(--navy);font-weight:700}
</style>
<aside class="sidebar">
  <div class="sidebar-logo">
    @* ⚠️ الشعار رابط للرئيسية — كان <div> عليه حركة عند المرور وهو مش قابل
       للضغط أصلًا. و«جامعة نجران» اتشالت من تحت العنوان لأنها مطبوعة جوّه
       الصورة نفسها؛ فضلت في alt عشان قارئ الشاشة والصور اللي ما تحمّلش. *@
    <a class="sidebar-logo-image-container" href="/Home" title="@SharedLocalizer["Brand_Title"]">
      <img src="/nu-logo.svg" alt="@SharedLocalizer["Brand_Sub"]">
    </a>
    <div class="sidebar-logo-title">@SharedLocalizer["Brand_Title"]</div>
  </div>

  <nav class="sidebar-nav no-anim">
    <a class="nav-item" href="/Home">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span>@SharedLocalizer["Nav_Dashboard"]</span>
    </a>

    @if (canStudents)
    {
    <div class="nav-group collapsed" data-group="students">
      <button class="nav-group-header" type="button" onclick="toggleNavGroup(this)">
        <svg class="ng-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <span class="ng-title">@SharedLocalizer["Nav_Section_Students"]</span>
        <svg class="ng-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-group-body">
        @if (User.HasClaim("permission", "students.view"))
        {
          <a class="nav-item" href="/Students">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            <span>@SharedLocalizer["Nav_StudentsList"]</span>
          </a>
        }
        @if (User.HasClaim("permission", "students.create"))
        {
          <a class="nav-item" href="/Register">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            <span>@SharedLocalizer["Nav_RegisterSingle"]</span>
          </a>
        }
        @if (User.HasClaim("permission", "students.bulkImport"))
        {
          <a class="nav-item" href="/Bulk">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 11 9 11 11 13 11 13 12 10 12 10 9"/></svg>
            <span>@SharedLocalizer["Nav_BulkExcel"]</span>
          </a>
        }
        @* ⚠️ صلاحية مستقلة: الشاشة دي بتجمّع كل بيانات الطالب في صفحة واحدة،
           فمابتظهرش لمجرد إن الموظف بيشوف الطلاب. الشرح في ApplicationPermissions. *@
        @if (User.HasClaim("permission", "students.investigate"))
        {
          <a class="nav-item" href="/StudentFile">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><circle cx="11.5" cy="14.5" r="2.5"/><path d="M15 18l-1.6-1.6"/></svg>
            <span>@SharedLocalizer["Nav_StudentFile"]</span>
          </a>
        }
        @if (User.HasClaim("permission", "students.changeStatus"))
        {
          <a class="nav-item" href="/StudentStatus">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>@SharedLocalizer["Nav_UpdateStatus"]</span>
          </a>
        }
        @* شاشة «المغادرة والإخلاء» اتشالت — كانت نسخة تانية من نفس الفورم اللي في
           /StudentStatus بنفس أنواع الحالات. الرابط القديم بيحوّل عليها من Program.cs *@
      </div>
    </div>
    }

    @if (canRequests)
    {
    <div class="nav-group collapsed" data-group="requests">
      <button class="nav-group-header" type="button" onclick="toggleNavGroup(this)">
        <svg class="ng-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span class="ng-title">@SharedLocalizer["Nav_Section_Requests"]</span>
        <svg class="ng-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-group-body">
        @if (User.HasClaim("permission", "requests.view"))
        {
          <a class="nav-item" href="/Requests">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>@SharedLocalizer["Nav_AllRequests"]</span>
            @* عدد الطلبات المستنية إجراء من المستخدم الحالي — بيتملى من الـ API تحت *@
            <span id="navRequestsBadge" style="display:none;margin-inline-start:auto;background:#d92d20;color:#fff;font-size:11px;font-weight:700;min-width:20px;height:20px;border-radius:10px;align-items:center;justify-content:center;padding:0 6px;line-height:1"></span>
          </a>
        }
        @if (User.HasClaim("permission", "housing.view"))
        {
          <a class="nav-item" href="/Housing">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>@SharedLocalizer["Nav_Housing"]</span>
          </a>
        }
      </div>
    </div>
    }

    @if (canFaculty)
    {
    <div class="nav-group collapsed" data-group="faculty">
      <button class="nav-group-header" type="button" onclick="toggleNavGroup(this)">
        <svg class="ng-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-5h6v5"/><path d="M9 10h.01M15 10h.01"/></svg>
        <span class="ng-title">@SharedLocalizer["Nav_Section_FacultyHousing"]</span>
        <svg class="ng-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-group-body">
        <a class="nav-item" href="/FacultyHousing">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 22v-4h6v4M9 6h.01M15 6h.01M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/></svg>
          <span>@SharedLocalizer["Nav_FacultyUnits"]</span>
        </a>
        @* ⚠️ بند «تغيير بيانات ساكن وحدة» اتشال ومعاه شرط الصلاحية اللي كان
           بيغلّفه وحده: كان بيفتح جدولًا تانيًا لنفس الـ٢٤٢ وحدة عشان تختار
           منه، والاختيار دلوقتي من صفّ القائمة نفسها (زرّ «تغيير الساكن»
           للمشغولة و«تسكين» للشاغرة). بند تاني يودّي على نفس الصفحة كان
           هيبقى تكرارًا من نوع تاني. *@
      </div>
    </div>
    }

    @if (User.HasClaim("permission", "lookups.manage"))
    {
      <div class="nav-group collapsed" data-group="lookups">
        <button class="nav-group-header" type="button" onclick="toggleNavGroup(this)">
          <svg class="ng-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          <span class="ng-title">@SharedLocalizer["Nav_Section_Lookups"]</span>
          <svg class="ng-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="nav-group-body">
          <a class="nav-item" href="/Colleges">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            <span>@SharedLocalizer["Nav_Colleges"]</span>
          </a>
          <a class="nav-item" href="/Departments">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="6" height="6" rx="1"/><rect x="15" y="15" width="6" height="6" rx="1"/><path d="M6 9v6a2 2 0 0 0 2 2h7"/></svg>
            <span>@SharedLocalizer["Nav_Departments"]</span>
          </a>
          <a class="nav-item" href="/Buildings">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 22v-4h6v4M9 6h.01M15 6h.01M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/></svg>
            <span>@SharedLocalizer["Nav_Buildings"]</span>
          </a>
          <a class="nav-item" href="/AcademicLevels">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
            <span>@SharedLocalizer["Nav_AcademicLevels"]</span>
          </a>
          <a class="nav-item" href="/Terms">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="11" x2="12" y2="11"/></svg>
            <span>@SharedLocalizer["Nav_Terms"]</span>
          </a>
        </div>
      </div>
    }

    @if (canSystem)
    {
    <div class="nav-group collapsed" data-group="system">
      <button class="nav-group-header" type="button" onclick="toggleNavGroup(this)">
        <svg class="ng-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        <span class="ng-title">@SharedLocalizer["Nav_Section_System"]</span>
        <svg class="ng-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-group-body">
        @* نفس سياسة ReportsController بالحرف — مش نسخة منها. لو الشرط اتغيّر
           في Program.cs، القائمة بتتغيّر معاه من غير ما حد يفتكر يعدّلها. *@
        @if ((await Authz.AuthorizeAsync(User, "reports.page")).Succeeded)
        {
          <a class="nav-item" href="/Reports">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>@SharedLocalizer["Nav_Reports"]</span>
          </a>
        }
        @if (User.HasClaim("permission", "auditLogs.view"))
        {
          <a class="nav-item" href="/AuditLog">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>@SharedLocalizer["Nav_AuditLog"]</span>
          </a>
        }
        @if (User.HasClaim("permission", "errorLogs.view"))
        {
          <a class="nav-item" href="/ErrorLog">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
