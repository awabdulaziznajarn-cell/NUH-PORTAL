@inject NUH_PORTAL.Services.Interfaces.IUiBootstrapService UiBootstrap
@{
    // ثقافة الطلب الحالية (من كوكي .AspNetCore.Culture عبر UseRequestLocalization)
    var __lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "ar";
    var __isAr = __lang == "ar";
    var __dir = __isAr ? "rtl" : "ltr";
    // نرجّع المستخدم لنفس الصفحة بعد تبديل اللغة
    var __returnUrl = Uri.EscapeDataString(Context.Request.Path.ToString() + Context.Request.QueryString.ToString());

    // هوية المستخدم للشريط العلوي. الحرفان الأولان من الاسم يصنعان الأيقونة —
    // أوضح من أيقونة عامة موحّدة لكل المستخدمين، ولا تحتاج رفع صورة.
    var __fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var __roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var __nameParts = __fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var __initials = __nameParts.Length == 0 ? "?"
        : (__nameParts.Length == 1 ? __nameParts[0].Substring(0, 1)
        : __nameParts[0].Substring(0, 1) + __nameParts[1].Substring(0, 1));

    // قاموس الترجمة + خريطة القوائم — الاتنين بيتبنوا مرة واحدة ويتخزّنوا في الكاش.
    // قبل كده كانوا بيتبنوا من الأول في كل طلب: قراءة 1380 مورد من الـ resx +
    // أربع استعلامات قاعدة بيانات، لكل ضغطة على أي صفحة — وده كان سبب التأخير
    // اللي بيحسّه مستخدمو الموظفين بس (صفحات الطالب HTML ثابت ومش بتعدّي على الـ Layout).
    // معالجة الأخطاء اتنقلت جوه الخدمة نفسها وبترجع "{}" زي السلوك القديم.
    var __i18nJson = UiBootstrap.GetI18nJson();
    var __lkMapJson = await UiBootstrap.GetLookupMapJsonAsync();
}
<!DOCTYPE html>
<html lang="@__lang" dir="@__dir" id="html-root">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - @SharedLocalizer["AppTitleSuffix"]</title>
  @* ⚠️ asp-append-version بتضيف بصمة محتوى الملف في الرابط، فالمتصفح يجيب
     النسخة الجديدة أول ما تتغيّر ويفضل مخزّنها لحد ما تتغيّر تاني.
     من غيرها كان لازم Ctrl+Shift+R بعد كل نشر عشان تشوف تعديل التصميم —
     وده مستحيل تطلبه من كل موظف. كل ملفات الجافاسكريبت كانت عليها البصمة
     وده الملف الوحيد اللي كان ناقصها. *@
  <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
  @* ⚠️ components.css لازم يتحمّل بعد site.css — فيه ستايلات المكوّنات المشتركة
     (بطاقة النموذج .form-card / شبكة الحقول .form-grid / الحقل .field /
     أزرار إجراءات الصف .action-* / القائمة المنسدلة المخصّصة .nsel-*).
     الستايلات دي كانت مكرّرة بالحرف جوه الشاشات واتنقلت هنا، لكن الربط اتضاف
     في register-form.html بس واتنسي في الـ Layout — فكل شاشات الموظفين فقدت
     تنسيقها: القوائم المنسدلة بتظهر مرتين (المخصّصة + الأصلية اللي .nsel-native
     بتخفيها)، وأزرار تعديل/حذف بتبان نصًّا عاريًا، والنماذج بتتفكّك. *@
  <link rel="stylesheet" href="/css/components.css" asp-append-version="true" />
</head>
<body class="app-shell">
  <partial name="_Sidebar" />

  <div class="main">
    <div class="topbar">
      <div class="topbar-title">@ViewData["Title"]</div>
      <div class="topbar-right">
        @* ⚠️ زرّ واحد بيوَدّي للّغة التانية، بدل قطعتين (ع | EN) واحدة مضيّئة.
           السبب توحيد لا تجميل: نفس الوظيفة كان ليها تلات أشكال في النظام -
           القطعتان هنا، وزرّ واحد في بوابة الطالب، وشكل تالت في صفحة الدخول.
           والقطعتان أسوأهم قراءةً: المستخدم لازم يفهم إن المضيّء هو الحالي
           وإن التاني هو اللي هيروح له، بدل ما يقرا اسم اللغة ويدوس.
           والنصّ من pt_langToggle: قيمته في الملف العربي «English» وفي
           الإنجليزي «العربية» - يعني دايمًا اسم اللغة اللي رايح لها. *@
        <a class="topbar-lang" href="/Culture/Set?culture=@(__isAr ? "en" : "ar")&amp;returnUrl=@__returnUrl">@SharedLocalizer["pt_langToggle"]</a>
        <div class="topbar-date" id="dateNow"></div>
        <div class="notif-wrapper">
          <button class="notif-btn" type="button" onclick="toggleNotifDropdown(event)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span class="notif-dot hidden"></span>
            <span class="notif-badge" id="notif-badge"></span>
          </button>
          <div class="notif-dropdown" id="notif-dropdown">
            <div class="notif-header">
              <span>@SharedLocalizer["Notifications"]</span>
              <button type="button" onclick="markAllNotifRead()">@SharedLocalizer["MarkAllRead"]</button>
            </div>
            <div class="notif-list" id="notif-dropdown-list"></div>
          </div>
        </div>

        @* ⚠️ الهوية والخروج كانا أسفل القائمة الجانبية: زر خروج بعرض كامل ظاهر
           طوال الوقت رغم أنه أندر إجراء، والاسم في أبعد نقطة عن مكان العمل.
           هنا في طرف الشريط العلوي: الاسم ظاهر، والخروج تحت ضغطة واحدة. *@
        <div class="user-menu" id="userMenu">
          <button class="user-btn" type="button" id="userMenuBtn" aria-haspopup="menu" aria-expanded="false"
                  onclick="toggleUserMenu(event)" title="@__fullName">
            <span class="user-mono">@__initials</span>
            <span class="nm"><b>@__fullName</b><i>@__roleName</i></span>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="user-dd" id="userDropdown" role="menu">
            <div class="who">
              <span class="user-mono">@__initials</span>
              <span class="t"><b>@__fullName</b><i>@__roleName</i></span>
            </div>
            <form method="post" action="/Account/Logout">
              @Html.AntiForgeryToken()
              <button class="out" type="submit" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>@SharedLocalizer["Logout"]</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="content">
      @RenderBody()
    </div>
  </div>

  @* تهريب HTML (escHtml) — التعريف الوحيد في النظام.
     ⚠️ أول سكربت خالص عن قصد: السكربت اللي تحته بينادي escHtml وقت التحميل
        (جرس الإشعارات)، وباقي الملفات المشتركة بتناديه وقت بناء الصفوف. *@
  <script src="/js/esc.js" asp-append-version="true"></script>

  @* شكل التاريخ في كل الواجهة (NuhFmt) — التعريف الوحيد في js/date-format.js.
     ⚠️ بدري كده عن قصد: شاشات بتنادي NuhFmt وقت التحميل لا وقت الحدث، وحقل
        التاريخ (date-field.js) بيقرا منه كمان. *@
  <script src="/js/date-format.js" asp-append-version="true"></script>

  @* حالة الشاشة في الرابط (NuhUrl) — التعريف الوحيد في js/url-state.js.
     ⚠️ قبل قسم Scripts عن قصد: الشاشات بتقرا الحالة من الرابط **وهي**
        بتتهيّأ، يعني قبل أول نداء للـ API لا بعده. *@
  <script src="/js/url-state.js" asp-append-version="true"></script>

  @* قواعد الرقم الجامعي والهوية والجوال (NuhId) — **متولّدة** من
     Core/IdentityRules.cs عن طريق UiController، مش ملف ثابت.
     ⚠️ مفيش asp-append-version هنا: ده راوت مش ملف على القرص. تحديث
        القاعدة بيوصل بالـ ETag اللي الراوت بيرجّعه. *@
  <script src="/js/nuh-id.js"></script>

  <script>
    // قاموس الترجمة كامل (مصدره ملفات .resx) — المصدر الوحيد لنصوص الـ JS الديناميكية عبر t()
    window.__I18N = @Html.Raw(__i18nJson);
    // خريطة القوائم (كود → اسم) — i18n.js بيقرأ منها في collegeName()/deptName()
    window.__LKMAP = @Html.Raw(__lkMapJson);
    // ⚠️ جدول انتقالات مسار الطلب — تعريفه الوحيد Core/RequestWorkflow.cs.
    //    js/request-workflow.js يقرأ منه، وكان السطر ده ناقص أصلًا: فالملف
    //    بيقرا مصفوفة فاضية، و NuhWorkflow.forStatus بيرجع null دايمًا.
    //    النتيجة إن صفوف شاشة الطلبات المرسومة بالجافاسكربت (بعد تبديل تبويب
    //    أو بحث أو تغيير صفحة) كانت بتطلع بلا أزرار إجراء وبلا تمييز للصف،
    //    بينما أول رسمة من السيرفر بتطلع صح — فالأزرار «تختفي» بعد أول ضغطة.
    window.__WF = @Html.Raw(NUH_PORTAL.Core.RequestWorkflow.ToJson());
    @* مجموعات إجراءات السجل (أي إجراء يخصّ الطلاب/الطلبات) — تعريفها الوحيد
       Core/AuditActionGroups.cs. شاشة التقارير بتقرا منها بدل ما تكتب القوائم
       بنفسها، وإلا كانت نسخة تفترق أول ما يتضاف إجراء جديد. *@
    window.__AUDIT_GROUPS = @Html.Raw(NUH_PORTAL.Core.AuditActionGroups.ToJson());

    // حاجات مشتركة لكل صفحات الـ MVC — الدور من كليم السيرفر.
    // ⚠️ headers() كانت ترسل staffToken من localStorage في ترويسة Authorization.
    //    لم يعد أي كود يكتب هذا المفتاح بعد توحيد الدخول على الكوكي، وأي بقيّة
    //    قديمة منه في متصفح مستخدم كانت تُرسَل كتوكن منتهٍ — والترويسة تسبق
    //    الكوكي في سياسة NUH_Smart، فيُرفَض النداء بـ 401 بينما الصفحة نفسها
    //    مفتوحة بكوكي سليم. الكوكي يُرسَل تلقائيًا لنفس الأصل، فلا ترويسة أصلًا.
    //    الدالة باقية (ترجع {}) لأن شاشات كثيرة تدمجها بـ Object.assign.
    var NUH = {
      role: '@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")',
      // ⚠️ اسم الإدارة في ترويسة الوثائق المطبوعة. بيتحسب هنا في السيرفر لا
      //    في الجافاسكريبت: الأدوار كليمات على الكوكي، والواجهة ماتقراهاش.
      //    والترتيب مقصود - الأدمن عنده صلاحيات المشرف والسيبراني كلها، فلو
      //    الفحص كان بالصلاحية بدل الدور كان هيطلع «إدارة الإسكان» على ورقة
      //    طالعة من تقنية المعلومات.
      @* ⚠️ الأسماء من Resources/SharedResource لا مكتوبة هنا. كانت مكتوبة في
         السطر ده بالإيد، والنتيجة إن اللي عايز يعدّل اسم إدارة بيدوّر عليه
         في ملف الترجمة **وما يلاقيهوش** - وde حصل فعلًا. أسماء الجهات الرسمية
         بتتغيّر (إدارة تبقى عمادة، وقسم يتنقل)، فمكانها ملف النصوص.

         ⚠️ والقيمة **عربية في الملفين** (ar و en) عن قصد: الوثيقة المطبوعة
         عربية دايمًا مهما كانت لغة الواجهة - البنود المُلزِمة عربية والبصمة
         محسوبة عليها (الشرح الكامل في js/pledge-doc.js). لو الملف الإنجليزي
         شايل ترجمة، موظف واجهته إنجليزي كان هيطلّع ورقة عربية بترويسة
         إنجليزية. القيمة واحدة، فاللغة مابتفرقش.

         ⚠️ و Html.Raw + JsonSerializer لا '@(...)' العادية: رازر بيعمل ترميز
         HTML لأي @(...)، فالعربي بيتحوّل لكيانات (&#x625;...) جوّه نصّ
         جافاسكريبت، وبعدين escHtml في pledge-doc.js بتحوّل الـ & لـ &amp;
         والكيان بيظهر على الورقة نصًّا خامًا - وde حصل فعلًا. JsonSerializer
         بيطلّع نصّ جافاسكريبت سليم بحروف حقيقية، وHtml.Raw بيمنع الترميز. *@
      printDept: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
          (User.IsInRole("admin") ? SharedLocalizer["doc_deptIT"]
          : User.IsInRole("cyber") ? SharedLocalizer["doc_deptCyber"]
          : SharedLocalizer["doc_deptHousing"]).Value)),
      token: function () { return ''; },
      headers: function () { return {}; }
    };

    // ⚠️ تنظيف نهائي لمفاتيح الدخول القديمة. محدش بيكتبها من يوم ما الدخول اتوحّد
    //    على الكوكي، لكن أي متصفح موظف شغّال من قبل التوحيد لسه شايلها. وطول ما
    //    هي موجودة، أي كود قديم يقراها هيبعت توكن منتهي في ترويسة Authorization —
    //    والترويسة بتسبق الكوكي، فالنداء يترفض ٤٠١ والجلسة سليمة. السطر ده بيموّتها
    //    في كل متصفح من غير ما حد يمسح بياناته بإيده.
    try { localStorage.removeItem('staffToken'); localStorage.removeItem('staffUser'); } catch (e) { }

    // مزامنة لغة الواجهة مع ثقافة السيرفر — عشان صفحات i18n.js (تقارير/تفاصيل الطلب/المغادرة) تتبع نفس الاختيار
    try { localStorage.setItem('uiLanguage', '@__lang'); } catch (e) { }

    // نصوص الإشعارات المترجمة (الجرس موحّد في كل الصفحات ويُبنى بالـ JS)
    var NUH_I18N = {
      notifEmpty: '@(SharedLocalizer["Notif_Empty"].Value)',
      notifError: '@(SharedLocalizer["Notif_LoadError"].Value)'
    };

    // ⚠️ كانت ar-EG بأرقام عربية-هندية (٢٠٢٦) بينما كل أرقام النظام لاتينية.
    //    NuhFmt هو نفس المصدر اللي بترسم منه الجداول وحقول التاريخ.
    document.getElementById('dateNow').textContent = NuhFmt.dateFull(new Date());

    // ===== جرس الإشعارات (موحّد في كل الصفحات) =====
    async function loadUnreadCount() {
      try {
        var res = await fetch('/api/notifications/unread-count?role=' + encodeURIComponent(NUH.role), { headers: NUH.headers() });
        if (!res.ok) return;
        var data = await res.json();
        var badge = document.getElementById('notif-badge');
        var dot = document.querySelector('.notif-dot');
        if (data && data.count > 0) {
          badge.textContent = data.count;
          badge.classList.add('show');
          if (dot) dot.classList.remove('hidden');
        } else {
          badge.classList.remove('show');
          if (dot) dot.classList.add('hidden');
        }
      } catch (e) { /* صامت - الجرس مش أساسي */ }
    }

    async function loadNotifDropdown() {
      var list = document.getElementById('notif-dropdown-list');
      try {
        var res = await fetch('/api/notifications?role=' + encodeURIComponent(NUH.role), { headers: NUH.headers() });
        if (!res.ok) { list.innerHTML = '<div class="notif-empty">' + NUH_I18N.notifError + '</div>'; return; }
        var data = await res.json();
        list.innerHTML = (data && data.length) ? data.map(function (n) {
          return '<div class="notif-item" onclick="openNotif(' + n.id + ', ' + (n.request_id || 0) + ', this)" data-id="' + n.id + '" style="cursor:pointer">' +
            '<div class="notif-item-dot" style="background:' + (n.status === 'pending' ? '#1B2A5E' : '#CBD5E1') + '"></div>' +
            '<div>' +
              '<div class="notif-item-text">' + escHtml(n.message) + '</div>' +
              '<div class="notif-item-time">' + NuhFmt.date(n.sent_at || Date.now()) + '</div>' +
            '</div>' +
          '</div>';
        }).join('') : '<div class="notif-empty">' + NUH_I18N.notifEmpty + '</div>';
      } catch (e) {
        list.innerHTML = '<div class="notif-empty">' + NUH_I18N.notifError + '</div>';
      }
    }

    function toggleNotifDropdown(e) {
      e.stopPropagation();
      var dd = document.getElementById('notif-dropdown');
      var isOpen = dd.classList.contains('open');
      document.querySelectorAll('.notif-dropdown.open').forEach(function (d) { d.classList.remove('open'); });
      if (!isOpen) {
        dd.classList.add('open');
        if (!dd.dataset.loaded) { loadNotifDropdown(); dd.dataset.loaded = '1'; }
      }
    }

    // الضغط على الإشعار بيفتح الطلب اللي اتبعت بسببه. قبل كده كان بيعلّمه مقروء وبس،
    // فالمستخدم بيدوس ومفيش أي استجابة ظاهرة غير إن النقطة بتبهت.
    async function openNotif(id, requestId, el) {
      await markNotifRead(id, el);
      if (requestId) window.location.href = '/Requests/Details/' + requestId;
    }

    async function markNotifRead(id, el) {
      try {
        await fetch('/api/notifications/read', {
          method: 'PATCH',
          headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
          body: JSON.stringify([id])
        });
        el.querySelector('.notif-item-dot').style.background = '#CBD5E1';
        loadUnreadCount();
      } catch (e) { }
    }

    async function markAllNotifRead() {
      var ids = [];
      document.querySelectorAll('#notif-dropdown-list .notif-item[data-id]').forEach(function (el) {
        ids.push(parseInt(el.dataset.id));
      });
      if (!ids.length) return;
      try {
        await fetch('/api/notifications/read', {
          method: 'PATCH',
          headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
          body: JSON.stringify(ids)
        });
        document.querySelectorAll('#notif-dropdown-list .notif-item-dot').forEach(function (d) { d.style.background = '#CBD5E1'; });
        loadUnreadCount();
      } catch (e) { }
    }

    function setUserMenu(open) {
      var m = document.getElementById('userMenu');
      if (!m) return;
      m.classList.toggle('open', open);
      var b = document.getElementById('userMenuBtn');
      if (b) b.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function toggleUserMenu(e) {
      e.stopPropagation();
      var m = document.getElementById('userMenu');
      setUserMenu(!m.classList.contains('open'));
    }

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.notif-wrapper')) {
        document.querySelectorAll('.notif-dropdown.open').forEach(function (d) { d.classList.remove('open'); });
      }
      // الضغط على الجرس يقفل قائمة المستخدم والعكس — القائمتان لا تفتحان معًا
      if (!e.target.closest('.user-menu')) setUserMenu(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      setUserMenu(false);
      document.querySelectorAll('.notif-dropdown.open').forEach(function (d) { d.classList.remove('open'); });
    });

    loadUnreadCount();
    setInterval(loadUnreadCount, 30000);
  </script>
  @* حالات الجداول (تحميل / لا توجد نتائج / خطأ) — تعريف واحد لكل الشاشات.
     ⚠️ لازم قبل قسم Scripts: الشاشات بتنادي NuhTable.bind وقت التحميل لا وقت الحدث. *@
  <script src="/js/table-state.js" asp-append-version="true"></script>

  @* مفتاح التفعيل/التعطيل المشترك (NuhSwitch) — نفس سبب table-state.js: الشاشات
     بتناديه وقت بناء صفوف الجدول لا وقت الحدث، فلازم قبل قسم Scripts.
     ⚠️ الملف كان اتعمل ومحدّش بيحمّله: فـ NuhSwitch كان undefined، و
     NuhSwitch.cell() جوّه بناء الصف كان بيرمي استثناء في نص renderTable —
     فالرأس بيتكتب والجسم لأ. ده سبب إن القوائم المرجعية وشاشة المستخدمين
     كانت بترجع الداتا 200 من الـ API وتفضل الجداول فاضية. *@
  <script src="/js/switch-field.js" asp-append-version="true"></script>

  @* منطق مراحل الطلب (NuhWorkflow) — بتستخدمه الرئيسية وشاشة الطلبات، وبيقرأ
     خريطة المراحل المكتوبة فوق في نفس الـ Layout. كان هو كمان مش متحمَّل. *@
  <script src="/js/request-workflow.js" asp-append-version="true"></script>

  @* مسمّيات الإجراءات والحقول في السجلات (NuhAudit) — رابع ملف من نفس النوع.
     كان متحمَّل في شاشة «سجل العمليات» وحدها، بينما faculty-housing-page.js
     بينادي NuhAudit.actionText/fieldText كمان — فنافذة «سجل إشغال الوحدة» في
     سكن أعضاء هيئة التدريس كانت بترمي «NuhAudit is not defined» وتفضل فاضية.
     مكانه هنا لا في الشاشتين: التحميل في شاشة والاستدعاء في تانية هو بالظبط
     اللي وقّعنا في switch-field و request-workflow قبل كده. *@
  <script src="/js/audit-labels.js" asp-append-version="true"></script>

  @* قائمة الاختيار بشكل النظام بدل قائمة نظام التشغيل — بتشتغل تلقائيًا على
     كل <select>. بعد قسم Scripts عمدًا: الشاشات بتبني قوائمها في القسم ده،
     فلازم تكون موجودة قبل ما نلفّ عليها. *@

  @await RenderSectionAsync("Scripts", required: false)
  <script src="/js/select-field.js" asp-append-version="true"></script>

  @* حقل التاريخ بشكل النظام بدل تقويم ويندوز (NuhDate) — نفس سبب
     select-field.js بالظبط، وبيشتغل تلقائيًا على كل <input type="date">.
     ⚠️ بعد قسم Scripts زيّه: الشاشات اللي بتبني حقول بالجافاسكريبت بتنادي
        NuhDate.enhance بنفسها. *@
  <script src="/js/date-field.js" asp-append-version="true"></script>

  @* ===== إنهاء الجلسة عند الخمول =====
     المهلة تأتي من Core/SessionPolicy.cs — نفس الرقم الذي يفحص به الخادم.
     كتابته هنا رقمًا ثانيًا كان يعني أن يفترق الاثنان مع أول تعديل. *@
  @* نوافذ التأكيد والتنبيه بشكل النظام — بديل confirm/alert/prompt المتصفح *@
  <script src="/js/dialog.js" asp-append-version="true"></script>
  @* قفل الزر أثناء نداء له أثر — خط الدفاع الأول ضد الضغطة المزدوجة،
     وخلفه بوابة الطلب في Core/RequestGate على الخادم. *@
  <script src="/js/busy-button.js" asp-append-version="true"></script>
  <script src="/js/idle-session.js" asp-append-version="true"></script>
  <script>
    NuhIdle.start({
      minutes: @NUH_PORTAL.Core.SessionPolicy.IdleTimeoutMinutes,
      warnSeconds: @NUH_PORTAL.Core.SessionPolicy.WarnBeforeSeconds
    });
  </script>
</body>
</html>
