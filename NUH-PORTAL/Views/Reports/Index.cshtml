      <div class="stat-card stat-card-clickable" data-drill="student"><div class="stat-top"><div class="stat-icon" style="background:#fffaeb;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#93370d" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg></div></div><div class="stat-num" id="statStudentOps">0</div><div class="stat-label" >@SharedLocalizer["rep_16"]</div></div>
      <div class="stat-card stat-card-clickable" data-drill="request"><div class="stat-top"><div class="stat-icon" style="background:#f4eefa;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#80519f" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div></div><div class="stat-num" id="statRequestOps">0</div><div class="stat-label" >@SharedLocalizer["rep_17"]</div></div>
