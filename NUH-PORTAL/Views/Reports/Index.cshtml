      <div class="stat-card" data-drill="delete"><div class="stat-top"><div class="stat-icon" style="background:#fef3f2;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b42318" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></div></div><div class="stat-num" id="statDeletes">0</div><div class="stat-label" >@SharedLocalizer["rep_19"]</div></div>
