@{
    ViewData["Title"] = "تسجيل جماعي (Excel)";
}

<style>
  /* خاص بصفحة التسجيل الجماعي — الباقي من site.css */
  .breadcrumb{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--gray-500);margin-bottom:20px}
  .breadcrumb a{color:var(--navy);text-decoration:none;font-weight:500}
  .breadcrumb span{color:var(--gray-300)}
  .step-indicator{display:flex;align-items:center;gap:0;margin-bottom:28px}
  .step{display:flex;align-items:center;gap:8px;padding:10px 16px;background:var(--gray-100);font-size:12px;font-weight:600;color:var(--gray-500);position:relative}
  .step:first-child{border-radius:8px 0 0 8px}
  .step:last-child{border-radius:0 8px 8px 0}
  .step.active{background:var(--navy);color:var(--white)}
  .step.completed{background:var(--green);color:var(--white)}
  .step-num{width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,.12);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700}
  .step.active .step-num,.step.completed .step-num{background:rgba(255,255,255,.2)}
  .step-content{display:none}
  .step-content.active{display:block}
  .form-card{background:var(--white);border-radius:16px;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(27,42,94,.05);overflow:hidden;margin-bottom:20px}
  .form-card-header{padding:18px 24px;border-bottom:1px solid var(--gray-100);display:flex;align-items:center;gap:10px}
  .form-card-header-icon{width:36px;height:36px;border-radius:10px;background:var(--gray-100);display:flex;align-items:center;justify-content:center}
  .form-card-title{font-size:15px;font-weight:700;color:var(--navy-dark)}
  .form-card-body{padding:24px}
  .bbtn{padding:10px 24px;border:none;border-radius:10px;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:8px}
  .bbtn:disabled{opacity:.5;cursor:not-allowed}
  .bbtn-primary{background:var(--navy);color:var(--white)}
  .bbtn-success{background:var(--green);color:var(--white)}
  .bbtn-gold{background:var(--gold);color:var(--navy-dark)}
  .bbtn-outline{background:transparent;border:1.5px solid var(--gray-300);color:var(--gray-700)}
  .btn-row{display:flex;gap:12px;margin-top:20px}
  .btn-row.center{justify-content:center}
  .upload-area{border:2px dashed var(--gray-300);border-radius:16px;padding:48px 24px;text-align:center;cursor:pointer;transition:all .2s}
  .upload-area:hover{border-color:var(--navy);background:var(--gray-50)}
  .upload-area.dragover{border-color:var(--gold);background:rgba(201,168,76,.06)}
  .upload-icon{font-size:32px;margin-bottom:12px}
  .upload-text{font-size:15px;font-weight:700;color:var(--navy-dark);margin-bottom:4px}
  .upload-hint{font-size:12px;color:var(--gray-500)}
  .upload-area input[type=file]{display:none}
  .file-info{display:flex;align-items:center;gap:10px;padding:14px 18px;background:var(--gray-50);border-radius:12px;margin-top:12px}
  .file-info-name{font-size:13px;font-weight:700;color:var(--navy-dark)}
  .file-info-size{font-size:11px;color:var(--gray-500)}
  .alert{padding:14px 18px;border-radius:12px;font-size:13px;font-weight:600;margin-bottom:16px;display:flex;align-items:center;gap:10px}
  .alert-success{background:var(--green-light);color:var(--green)}
  .alert-error{background:var(--red-light);color:var(--red)}
  .alert-info{background:#EBF4FF;color:#1A56DB}
  .summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px}
  .summary-card{background:var(--gray-50);border-radius:12px;padding:20px;text-align:center}
  .summary-card-value{font-size:28px;font-weight:800;color:var(--navy-dark)}
  .summary-card-label{font-size:12px;color:var(--gray-500);margin-top:4px}
  .table-wrapper{overflow-x:auto}
  .error-row{background:#FFF8F8}
  .error-msg{color:var(--red);font-size:12px}
  .hidden{display:none!important}
  .spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;vertical-align:middle}
  @@keyframes spin{to{transform:rotate(360deg)}}
</style>

<div class="breadcrumb"><a href="/Home">الرئيسية</a><span>/</span><span>تسجيل جماعي (Excel)</span></div>
<div class="page-header">
  <h2>رفع ملف Excel للتسجيل الجماعي</h2>
  <p>قم بتحميل نموذج بيانات الطلاب، تعبئة البيانات، رفع الملف، التحقق من الصحة، ثم إنشاء الطلب</p>
</div>

<div class="step-indicator" id="stepIndicator">
  <div class="step active" data-step="1"><span class="step-num">1</span><span>تحميل النموذج</span></div>
  <div class="step" data-step="2"><span class="step-num">2</span><span>رفع الملف</span></div>
  <div class="step" data-step="3"><span class="step-num">3</span><span>التحقق</span></div>
  <div class="step" data-step="4"><span class="step-num">4</span><span>معاينة</span></div>
  <div class="step" data-step="5"><span class="step-num">5</span><span>إنشاء</span></div>
</div>

<div class="step-content active" data-step="1">
  <div class="form-card">
    <div class="form-card-header">
      <div class="form-card-header-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></div>
      <div class="form-card-title">تحميل نموذج بيانات الطلاب</div>
    </div>
    <div class="form-card-body">
      <div class="alert alert-info">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <span>النموذج يحتوي على الحقول التالية: الرقم الجامعي (9-10 أرقام)، الهوية الوطنية (10 أرقام)، الاسم الكامل بالعربية، الاسم الكامل بالإنجليزية، الجوال (9665xxxxxxxx)، الكلية، القسم، المستوى الدراسي (1-5)، الجنس (ذكر/أنثى)، رقم المبنى، رقم الشقة، رقم الغرفة</span>
      </div>
      <div class="btn-row center">
        <button class="bbtn bbtn-primary" id="downloadTplBtn" onclick="downloadTemplate()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>تحميل نموذج بيانات الطلاب</span>
        </button>
      </div>
      <div class="btn-row center" style="margin-top:20px">
        <button class="bbtn bbtn-success" onclick="goToStep(2)">التالي - رفع الملف</button>
      </div>
    </div>
  </div>
</div>

<div class="step-content" data-step="2">
  <div class="form-card">
    <div class="form-card-header">
      <div class="form-card-header-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></div>
      <div class="form-card-title">رفع ملف Excel</div>
    </div>
    <div class="form-card-body">
      <div class="upload-area" id="uploadArea" onclick="document.getElementById('fileInput').click()">
        <div class="upload-icon">📂</div>
        <div class="upload-text">اختر ملف Excel أو اسحبه وأفلته هنا</div>
        <div class="upload-hint">الحد الأقصى 10 MB، صيغة .xlsx فقط</div>
        <input type="file" id="fileInput" accept=".xlsx" onchange="handleFileSelect(event)">
      </div>
      <div id="fileInfo" class="file-info hidden">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <div><div class="file-info-name" id="fileName"></div><div class="file-info-size" id="fileSize"></div></div>
        <button class="bbtn bbtn-outline" style="margin-left:auto;padding:6px 12px;font-size:11px" onclick="clearFile()">إزالة</button>
      </div>
      <div id="uploadAlert" class="hidden"></div>
      <div class="btn-row center" style="margin-top:16px">
        <button class="bbtn bbtn-outline" onclick="goToStep(1)">السابق</button>
        <button class="bbtn bbtn-primary" id="uploadBtn" onclick="uploadFile()" disabled>تحميل والتحقق</button>
      </div>
    </div>
  </div>
</div>

<div class="step-content" data-step="3">
  <div class="form-card">
    <div class="form-card-header">
      <div class="form-card-header-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
      <div class="form-card-title">نتيجة التحقق</div>
    </div>
    <div class="form-card-body">
      <div id="validationSummary" class="summary-grid"></div>
      <div id="validationAlert" class="hidden"></div>
      <div id="errorTableWrapper" class="table-wrapper hidden">
        <h4 style="margin-bottom:12px;font-size:14px;color:var(--red)">الأخطاء</h4>
        <table><thead><tr><th>الصف</th><th>رقم الطالب</th><th>العمود</th><th>وصف الخطأ</th></tr></thead><tbody id="errorTableBody"></tbody></table>
      </div>
      <div class="btn-row center" style="margin-top:16px">
        <button class="bbtn bbtn-outline" onclick="goToStep(2)">السابق</button>
        <button class="bbtn bbtn-success" id="previewBtn" onclick="goToStep(4)" disabled>التالي - معاينة</button>
      </div>
    </div>
  </div>
</div>

<div class="step-content" data-step="4">
  <div class="form-card">
    <div class="form-card-header">
      <div class="form-card-header-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></div>
      <div class="form-card-title">معاينة البيانات الصحيحة</div>
    </div>
    <div class="form-card-body">
      <div id="previewSummary" class="summary-grid" style="margin-bottom:12px"></div>
      <div class="alert alert-info" style="margin-bottom:12px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <span>العدد الإجمالي للطلاب الصحيحين: <strong id="previewTotalCount">0</strong></span>
      </div>
      <div class="table-wrapper"><table><thead><tr><th>#</th><th>رقم الطالب</th><th>الاسم بالعربية</th><th>الاسم بالإنجليزية</th><th>الجوال</th><th>الكلية</th><th>المستوى</th><th>الجنس</th><th>المبنى</th><th>الشقة</th><th>الغرفة</th></tr></thead><tbody id="previewTableBody"></tbody></table></div>
      <div id="createError" class="alert alert-error hidden" style="margin-top:12px"></div>
      <div class="btn-row center" style="margin-top:16px">
        <button class="bbtn bbtn-outline" onclick="goToStep(3)">السابق</button>
        <button class="bbtn bbtn-gold" id="createBtn" onclick="createBulkRequest()">إنشاء طلب التسجيل الجماعي</button>
      </div>
    </div>
  </div>
</div>

<div class="step-content" data-step="5">
  <div class="form-card">
    <div class="form-card-header">
      <div class="form-card-header-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
      <div class="form-card-title">تم الإنشاء بنجاح</div>
    </div>
    <div class="form-card-body" style="text-align:center;padding:40px 24px">
      <div style="font-size:48px;margin-bottom:16px">✅</div>
      <h3 style="font-size:20px;font-weight:800;color:var(--green);margin-bottom:8px">تم إنشاء طلب التسجيل الجماعي</h3>
      <p style="font-size:14px;color:var(--gray-500);margin-bottom:8px">رقم الطلب: <strong id="createdRequestNumber" style="color:var(--navy-dark);font-size:18px"></strong></p>
      <p style="font-size:13px;color:var(--gray-500);margin-bottom:24px" id="createdStats"></p>
      <div class="btn-row center">
        <button class="bbtn bbtn-primary" onclick="resetWizard()">رفع ملف جديد</button>
        <button class="bbtn bbtn-outline" onclick="window.location='/Requests'">عرض الطلبات</button>
        <button class="bbtn bbtn-outline" id="viewRequestBtn" onclick="viewCreatedRequest()">عرض الطلب</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  var selectedFile = null;
  var validationResult = null;

  function goToStep(step) {
    document.querySelectorAll('.step-content').forEach(function (s) { s.classList.remove('active'); });
    document.querySelectorAll('.step').forEach(function (s) { s.classList.remove('active'); });
    document.querySelector('.step-content[data-step="' + step + '"]').classList.add('active');
    document.querySelector('.step[data-step="' + step + '"]').classList.add('active');
    if (step === 3 && validationResult) showValidationResult(validationResult);
    if (step === 4 && validationResult) { showPreview(validationResult); document.getElementById('createError').classList.add('hidden'); }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function downloadTemplate() {
    var btn = document.getElementById('downloadTplBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> جاري التحميل...';
    fetch('/api/BulkRegistration/template', { method: 'GET', headers: NUH.headers() })
      .then(function (res) {
        if (res.status === 401) { window.location.replace('/Account/Login'); return null; }
        if (!res.ok) throw new Error('فشل التحميل');
        return res.blob();
      })
      .then(function (blob) {
        if (!blob) return;
        var url = window.URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'BulkRegistrationTemplate.xlsx';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);
      })
      .catch(function (err) { alert(err.message); })
      .finally(function () {
        btn.disabled = false;
        btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>تحميل نموذج بيانات الطلاب</span>';
      });
  }

  function handleFileSelect(event) {
    var file = event.target.files[0];
    if (!file) return;
    if (!file.name.endsWith('.xlsx')) { showUploadAlert('error', 'الرجاء اختيار ملف .xlsx فقط'); return; }
    if (file.size > 10 * 1024 * 1024) { showUploadAlert('error', 'حجم الملف يتجاوز 10 MB'); return; }
    selectedFile = file;
    document.getElementById('fileName').textContent = file.name;
    document.getElementById('fileSize').textContent = (file.size / 1024).toFixed(1) + ' KB';
    document.getElementById('fileInfo').classList.remove('hidden');
    document.getElementById('uploadArea').style.display = 'none';
    document.getElementById('uploadAlert').classList.add('hidden');
    document.getElementById('uploadBtn').disabled = false;
  }

  function clearFile() {
    selectedFile = null;
    document.getElementById('fileInput').value = '';
    document.getElementById('fileInfo').classList.add('hidden');
    document.getElementById('uploadArea').style.display = 'block';
    document.getElementById('uploadBtn').disabled = true;
  }

  function showUploadAlert(type, msg) {
    var el = document.getElementById('uploadAlert');
    el.className = 'alert ' + (type === 'error' ? 'alert-error' : 'alert-success');
    el.innerHTML = msg;
    el.classList.remove('hidden');
  }

  async function uploadFile() {
    if (!selectedFile) return;
    var btn = document.getElementById('uploadBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> جاري التحقق...';

    var formData = new FormData();
    formData.append('file', selectedFile);

    try {
      var res = await fetch('/api/BulkRegistration/validate', { method: 'POST', headers: NUH.headers(), body: formData });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (!res.ok) {
        var errMsg = 'خطأ';
        try { var errData = await res.json(); errMsg = errData.message || errData.title || 'خطأ'; } catch (e) { }
        showUploadAlert('error', 'خطأ في التحقق: ' + errMsg);
        return;
      }
      validationResult = await res.json();
      goToStep(3);
    } catch (err) {
      showUploadAlert('error', 'خطأ في التحقق: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = 'تحميل والتحقق';
    }
  }

  function showValidationResult(data) {
    document.getElementById('validationSummary').innerHTML =
      '<div class="summary-card"><div class="summary-card-value">' + data.totalRecords + '</div><div class="summary-card-label">إجمالي السجلات</div></div>' +
      '<div class="summary-card"><div class="summary-card-value" style="color:var(--green)">' + data.validRecords + '</div><div class="summary-card-label">الصحيحة</div></div>' +
      '<div class="summary-card"><div class="summary-card-value" style="color:var(--red)">' + data.errorRecords + '</div><div class="summary-card-label">الخاطئة</div></div>';

    var alertEl = document.getElementById('validationAlert');
    if (data.errorRecords > 0) {
      alertEl.className = 'alert alert-error';
      alertEl.innerHTML = 'يوجد ' + data.errorRecords + ' أخطاء في الملف. يرجى مراجعة الجدول أدناه.';
    } else {
      alertEl.className = 'alert alert-success';
      alertEl.innerHTML = 'جميع السجلات صحيحة!';
    }
    alertEl.classList.remove('hidden');

    var errorWrapper = document.getElementById('errorTableWrapper');
    if (data.errors && data.errors.length > 0) {
      errorWrapper.classList.remove('hidden');
      document.getElementById('errorTableBody').innerHTML = data.errors.map(function (e) {
        return '<tr class="error-row"><td>' + e.row + '</td><td>' + escHtml(e.studentID) + '</td><td>' + escHtml(e.columnName || '') + '</td><td class="error-msg">' + escHtml(e.errorDescription) + '</td></tr>';
      }).join('');
    } else {
      errorWrapper.classList.add('hidden');
    }

    document.getElementById('previewBtn').disabled = data.validRecords === 0;
  }

  function showPreview(data) {
    var allRecords = data.preview || [];
    var totalValid = data.validRecords || 0;
    var displayCount = Math.min(20, allRecords.length);
    document.getElementById('previewSummary').innerHTML =
      '<div class="summary-card"><div class="summary-card-value">' + data.totalRecords + '</div><div class="summary-card-label">إجمالي السجلات</div></div>' +
      '<div class="summary-card"><div class="summary-card-value" style="color:var(--green)">' + totalValid + '</div><div class="summary-card-label">السجلات الصحيحة</div></div>' +
      '<div class="summary-card"><div class="summary-card-value" style="color:var(--navy-dark)">أول ' + displayCount + ' سجل</div><div class="summary-card-label">المعروض حالياً</div></div>';
    document.getElementById('previewTotalCount').textContent = totalValid;
    var tbEl = document.getElementById('previewTableBody');
    if (displayCount > 0) {
      tbEl.innerHTML = allRecords.slice(0, displayCount).map(function (s, i) {
        return '<tr><td>' + (i + 1) + '</td><td>' + escHtml(s.studentID) + '</td><td>' + escHtml(s.fullNameArabic) + '</td><td>' + escHtml(s.fullNameEnglish) + '</td><td>' + escHtml(s.mobile) + '</td><td>' + escHtml(s.college) + '</td><td>' + (s.academicLevel || '') + '</td><td>' + escHtml(s.gender || '') + '</td><td>' + escHtml(s.buildingNumber || '') + '</td><td>' + escHtml(s.apartmentNumber || '') + '</td><td>' + escHtml(s.roomNumber || '') + '</td></tr>';
      }).join('');
    } else {
      tbEl.innerHTML = '<tr><td colspan="11" style="text-align:center;color:var(--gray-500)">لا توجد بيانات صحيحة للمعاينة</td></tr>';
    }
  }

  async function createBulkRequest() {
    var btn = document.getElementById('createBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> جاري الإنشاء...';

    try {
      if (!validationResult) throw new Error('لا توجد نتيجة تحقق');
      var records = (validationResult.preview || []).filter(function (s) { return s; });
      var body = {
        fileName: validationResult.fileName || '',
        students: records.map(function (s) {
          return {
            studentID: s.studentID || '',
            nationalID: s.nationalID || '',
            fullNameArabic: s.fullNameArabic || '',
            fullNameEnglish: s.fullNameEnglish || '',
            mobile: s.mobile || '',
            college: s.college || '',
            department: s.department || '',
            academicLevel: s.academicLevel || '',
            gender: s.gender || '',
            buildingNumber: s.buildingNumber || '',
            apartmentNumber: s.apartmentNumber || '',
            roomNumber: s.roomNumber || ''
          };
        })
      };
      var res = await fetch('/api/BulkRegistration/create', {
        method: 'POST',
        headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
        body: JSON.stringify(body)
      });
      if (res.status === 401) { window.location.replace('/Account/Login'); return; }
      if (!res.ok) {
        var errMsg = 'خطأ';
        var errRef = '';
        try {
          var errData = await res.json();
          if (errData.reference) errRef = ' [' + errData.reference + ']';
          errMsg = (errData.detail || errData.message || errData.title || errData.error || 'خطأ') + errRef;
        } catch (e) { }
        var ce = document.getElementById('createError');
        ce.textContent = 'خطأ: ' + errMsg;
        ce.classList.remove('hidden');
        return;
      }
      var data = await res.json();
      document.getElementById('createdRequestNumber').textContent = data.requestNumber || '';
      document.getElementById('createdStats').textContent = 'تم إضافة ' + (data.recordCount || 0) + ' طالب';
      document.getElementById('viewRequestBtn').setAttribute('data-id', data.requestId || '');
      goToStep(5);
    } catch (err) {
      var ce2 = document.getElementById('createError');
      ce2.textContent = 'خطأ: ' + err.message;
      ce2.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.innerHTML = 'إنشاء طلب التسجيل الجماعي';
    }
  }

  function resetWizard() {
    selectedFile = null;
    validationResult = null;
    document.getElementById('fileInput').value = '';
    document.getElementById('fileInfo').classList.add('hidden');
    document.getElementById('uploadArea').style.display = 'block';
    document.getElementById('uploadBtn').disabled = true;
    document.getElementById('validationSummary').innerHTML = '';
    document.getElementById('validationAlert').classList.add('hidden');
    document.getElementById('errorTableWrapper').classList.add('hidden');
    document.getElementById('createError').classList.add('hidden');
    document.getElementById('previewTableBody').innerHTML = '';
    goToStep(1);
  }

  function viewCreatedRequest() {
    var id = document.getElementById('viewRequestBtn').getAttribute('data-id');
    if (id) window.location.href = '/Requests/Details/' + id;
  }

  // سحب وإفلات
  (function () {
    var area = document.getElementById('uploadArea');
    area.addEventListener('dragover', function (e) { e.preventDefault(); this.classList.add('dragover'); });
    area.addEventListener('dragleave', function (e) { e.preventDefault(); this.classList.remove('dragover'); });
    area.addEventListener('drop', function (e) {
      e.preventDefault();
      this.classList.remove('dragover');
      var files = e.dataTransfer.files;
      if (files.length) {
        document.getElementById('fileInput').files = files;
        handleFileSelect({ target: { files: [files[0]] } });
      }
    });
  })();
</script>
}
