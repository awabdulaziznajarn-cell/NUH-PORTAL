@{
    ViewData["Title"] = SharedLocalizer["Page_RequestDetails"].Value;
    var reqId = (int)(ViewData["ReqId"] ?? 0);
}

<style>
  /* خاص بصفحة تفاصيل الطلب - الباقي من site.css */
/* ⚠️ ستايل سجلّ دورة الحياة اتشال من هنا: كان تعريفًا ثانيًا لنفس المكوّن
   المكتوب في شاشة حسابات الإسكان، و**لا شيء في هذه الصفحة يرسمه أصلًا** -
   لا الـcshtml ولا request-details-page.js يكتب .log-entry. كود ميّت
   لمكوّن حيّ في شاشة أخرى. المكوّن الآن واحد في css/components.css (.nuh-tl). */
.card:hover { box-shadow:0 4px 20px rgba(16,70,49,0.09); }
/* عنوان القسم (أيقونة + نص) يبدأ من جهة البداية (يمين في العربية) بدل ما النص يتزاح للطرف */
.card-header { justify-content:flex-start; gap:10px; }
.card-header svg { flex-shrink:0; }
/* ⚠️ .card-body اتنقلت لـ css/components.css - كانت مكتوبة في شاشتين. */
/* ⚠️ شبكة البيانات (.info-*) اتنقلت لـ css/components.css - بقت مستخدمة في شاشتين. */
.badge-submitted { background:#fffaeb; color:#93370d; }
.badge-housing_approved { background:#eff4ff; color:#175cd3; }
.badge-housing_rejected { background:var(--red-light); color:var(--red); }
.badge-cyber_review { background:var(--purple-light); color:var(--purple); }
.badge-cyber_approved { background:var(--green-light); color:var(--green); }
.badge-cyber_rejected { background:var(--red-light); color:var(--red); }
.badge-ready_for_provisioning { background:#fffaeb; color:#93370d; }
.badge-completed { background:var(--green-light); color:var(--green); }
/* ⚠️ .badge-pending_supervisor و .badge-pending_cyber اتشالوا - نفس مرحلة
   submitted و cyber_review بمسمّى المسار التاني، وكانوا بلونين مختلفين
   لنفس الموقف. الصنف بقى بيتبني من RequestWorkflow.Canonical. */
.badge-pending_admin { background:var(--purple-light); color:var(--purple); }
.badge-need_more_info { background:#fffaeb; color:#b54708; }
.badge-approved { background:var(--green-light); color:var(--green); }
.badge-rejected { background:var(--red-light); color:var(--red); }
.timeline { position:relative; padding:0; margin:0; list-style:none; }
.timeline::before { content:''; position:absolute; top:8px; bottom:8px; inset-inline-start:15px; width:2px; background:var(--gray-200); }
.timeline-item { position:relative; padding:0 0 24px 44px; }
.timeline-item:last-child { padding-bottom:0; }
.timeline-dot { position:absolute; inset-inline-start:9px; top:4px; width:14px; height:14px; border-radius:50%; border:2px solid var(--gray-300); background:var(--white); z-index:1; }
.timeline-item.active .timeline-dot { border-color:var(--navy); background:var(--navy); box-shadow:0 0 0 4px rgba(16,70,49,0.1); }
.timeline-item.completed .timeline-dot { border-color:var(--green); background:var(--green); }
.timeline-item.rejected .timeline-dot { border-color:var(--red); background:var(--red); }
.timeline-label { font-size:13px; font-weight:600; color:var(--gray-500); }
.timeline-item.active .timeline-label, .timeline-item.completed .timeline-label { color:var(--navy-dark); }
.timeline-date { font-size:11px; color:var(--gray-500); margin-top:2px; }
.review-actions { display:flex; flex-direction:column; gap:16px; }
.review-option { display:flex; align-items:center; gap:12px; padding:16px; border:2px solid var(--gray-200); border-radius:12px; cursor:pointer; transition:all 0.2s ease; }
.review-option:hover { border-color:var(--gray-300); transform:translateY(-1px); box-shadow:0 2px 8px rgba(0,0,0,0.04); }
.review-option.selected-approve { border-color:var(--green); background:var(--green-light); }
.review-option.selected-reject { border-color:var(--red); background:var(--red-light); }
.review-option input[type="radio"] { width:18px; height:18px; accent-color:var(--navy); cursor:pointer; }
.review-option-text { font-size:14px; font-weight:600; color:var(--navy-dark); }
.review-option-desc { font-size:12px; color:var(--gray-500); }
/* صندوق اختيار الخانات المطلوب تصحيحها - يظهر مع «طلب معلومات إضافية» فقط.
   ⚠️ البادئة fieldpick- مقصودة. أول نسخة كانت مسمّية عنصر الاختيار .info-field،
      وده اسم مستخدم فوق في نفس الملف لصفوف بيانات الطلب. القاعدة الجديدة كانت
      بعده فغلبته، فصفوف البيانات كلها بقت مربعات بإطار ومحتواها في النص بدل
      تحت بعض. أي كلاس جديد هنا لازم يبقى اسمه ما يتلخبطش مع اللي فوق. */
.fieldpick-box { display:none; margin-top:14px; background:var(--gray-50); border:1.5px solid var(--gray-200); border-radius:12px; padding:14px; }
.fieldpick-box.visible { display:block; }
.fieldpick-title { display:block; font-size:13px; font-weight:700; color:var(--navy-dark); margin-bottom:4px; }
.fieldpick-hint { font-size:11.5px; color:var(--gray-500); line-height:1.9; margin-bottom:10px; }
.fieldpick-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:8px; }
.fieldpick-item { display:flex; align-items:center; gap:7px; background:#fff; border:1.5px solid var(--gray-200); border-radius:9px; padding:8px 10px; font-size:12.5px; font-weight:600; color:var(--navy-dark); cursor:pointer; transition:all .18s; }
.fieldpick-item:hover { border-color:var(--navy); }
.fieldpick-item input { width:15px; height:15px; accent-color:var(--navy); cursor:pointer; flex-shrink:0; }
.fieldpick-item:has(input:checked) { border-color:var(--navy); background:#eceded; }

.reject-reason-field { display:none; margin-top:12px; }
.reject-reason-field.visible { display:block; }
.reject-reason-field textarea { width:100%; padding:12px; border:1.5px solid var(--gray-200); border-radius:10px; font-family:'IBM Plex Sans Arabic',sans-serif; font-size:13px; resize:vertical; min-height:80px; transition:border-color 0.2s; }
.reject-reason-field textarea:focus { outline:none; border-color:var(--navy); }
.reject-reason-field textarea.error { border-color:var(--red); }
.reject-reason-field .error-msg { font-size:11px; color:var(--red); margin-top:4px; display:none; }
.submit-review-btn { padding:12px 28px; background:var(--navy); color:var(--white); border:none; border-radius:10px; font-family:'IBM Plex Sans Arabic',sans-serif; font-size:14px; font-weight:600; cursor:pointer; transition:all 0.2s; box-shadow:0 2px 8px rgba(16,70,49,0.2); }
.submit-review-btn:hover { opacity:0.92; transform:translateY(-1px); box-shadow:0 4px 12px rgba(16,70,49,0.3); }
.submit-review-btn:disabled { opacity:0.5; cursor:not-allowed; transform:none; box-shadow:none; }
/* ⚠️ .rejection-info اتشال - كان تصميم تالت لصندوق الملاحظة/السبب.
   التعريف الوحيد .note-block في css/components.css، والشاشة بتحمّله من التخطيط. */
.workflow-bar { display:flex; align-items:flex-start; justify-content:space-around; padding:12px 0 4px; position:relative; overflow:visible; }
.workflow-bar::before { content:''; position:absolute; top:22px; left:30px; right:30px; height:3px; background:var(--gray-200); z-index:0; border-radius:2px; }
.workflow-step { display:flex; flex-direction:column; align-items:center; position:relative; z-index:1; flex:0 1 auto; text-align:center; padding:0 4px; }
.workflow-circle { width:36px; height:36px; border-radius:50%; background:var(--white); border:3px solid var(--gray-200); display:flex; align-items:center; justify-content:center; margin-bottom:10px; transition:all 0.3s ease; flex-shrink:0; }
.workflow-step.active .workflow-circle { border-color:var(--navy); background:var(--navy); box-shadow:0 0 0 4px rgba(16,70,49,0.15); transform:scale(1.05); }
.workflow-step.completed .workflow-circle { border-color:var(--green); background:var(--green); }
.workflow-step.completed ~ .workflow-bar::before { /* no effect, handled via JS */ }
.workflow-step.rejected .workflow-circle { border-color:var(--red); background:var(--red); box-shadow:0 0 0 4px rgba(153,27,27,0.15); }
.workflow-step-label { font-size:11px; font-weight:600; color:var(--gray-500); max-width:120px; line-height:1.4; transition:color 0.3s; white-space:normal; word-break:keep-all; overflow-wrap:break-word; }
.workflow-step.active .workflow-step-label, .workflow-step.completed .workflow-step-label { color:var(--navy-dark); font-weight:700; }
.workflow-step.rejected .workflow-step-label { color:var(--red); }
.workflow-bar-connector { position:absolute; top:20px; height:3px; background:var(--gray-200); z-index:0; border-radius:2px; transition:background 0.5s ease; }
.workflow-bar-connector.done { background:linear-gradient(90deg,var(--green),var(--green-light)); }
  @@keyframes spin{to{transform:rotate(360deg)}}
</style>

@* ⚠️ رأس الصفحة كبقية شاشات النظام: كانت هذه الشاشة وحدها تبدأ ببطاقة
   مباشرة، فيبدو أعلاها مختلفًا عن كل شاشة أخرى. النص من SharedResource. *@
<div class="page-header">
  <h2>@SharedLocalizer["Page_RequestDetails"]</h2>
  <p>@SharedLocalizer["rd_pageSubtitle"]</p>
</div>

<div id="loading-state" style="text-align:center;padding:60px 20px;color:var(--gray-500)">
  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:12px"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
  <div >@SharedLocalizer["rd_loadingDetails"]</div>
</div>
<div id="error-state" style="display:none;text-align:center;padding:60px 20px;color:var(--red)">
  <div id="error-message"></div>
  <button onclick="location.reload()" style="margin-top:12px;padding:8px 20px;background:var(--navy);color:#fff;border:none;border-radius:8px;cursor:pointer;font-family:'IBM Plex Sans Arabic',sans-serif" >@SharedLocalizer["rd_retry"]</button>
</div>
<div id="detail-content" style="display:none">
</div>

@section Scripts {
<script>var __REQ_ID = @reqId;</script>
@* صلاحيات المستخدم للواجهة - الأزرار بتظهر أو تختفي على أساسها.
   الفحص الحقيقي على السيرفر في كل نداء؛ ده تحسين شكل مش حماية. *@
<script>window.NUH_PERMS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    User.FindAll("permission").Select(c => c.Value).ToArray()));</script>
<script src="/i18n.js"></script>
@* ⚠️ وثيقة التعهّد (العرض + الطباعة) - مشتركة مع شاشة «ملف الطالب».
   لازم تتحمّل قبل سكربت الشاشة لأن الشاشة بتناديها وقت الرندر. *@
@* ⚠️ nuh-qr.js قبل pledge-doc.js: الوثيقة بترسم رمز التحقّق
   لحظة المعاينة/الطباعة ومابتناديش عليه قبل كده، فلو اتأخّر الرمز بيختفي
   من غير ما حد ياخد باله - والورقة بتطلع من الطابعة ناقصة. *@
<script src="/js/nuh-qr.js" asp-append-version="true"></script>
<script src="/js/pledge-doc.js" asp-append-version="true"></script>
<script src="/js/request-details-page.js"></script>
}
