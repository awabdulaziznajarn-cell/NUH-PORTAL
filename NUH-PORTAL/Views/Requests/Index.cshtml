@model NUH_PORTAL.ViewModels.RequestsIndexViewModel
@{
    ViewData["Title"] = SharedLocalizer["Page_Requests"].Value;
    var role = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "").ToLowerInvariant();
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
}

<style>
  /* خاص بصفحة الطلبات فقط — الباقي من site.css */
  .tabs{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap}
  th.sortable{cursor:pointer;user-select:none;white-space:nowrap;transition:color .15s}
  th.sortable:hover{color:var(--navy)}
  .sort-ind{font-size:10px;color:var(--navy);font-weight:700}
  .tab-btn{padding:8px 20px;border-radius:10px;border:1.5px solid var(--gray-200);background:var(--white);font-family:'IBM Plex Sans Arabic',sans-serif;font-size:13px;font-weight:600;cursor:pointer;color:var(--gray-500);transition:all .2s}
  .tab-btn.active{background:var(--navy);color:var(--white);border-color:var(--navy)}
  .tab-btn:hover{border-color:var(--navy)}
  .stats-row{flex-wrap:wrap}
  .stats-row .stat-pill{min-width:120px}
  .badge-submitted{background:#FFF7ED;color:#92400E}
  .badge-housing_approved{background:#E0F2FE;color:#0369A1}
  .badge-housing_rejected{background:var(--red-light);color:var(--red)}
  .badge-cyber_review{background:#F3E8FF;color:#6B21A8}
  .badge-cyber_approved{background:var(--green-light);color:var(--green)}
  .badge-cyber_rejected{background:var(--red-light);color:var(--red)}
  .badge-ready_for_provisioning{background:#FFF7ED;color:#92400E}
  .badge-completed{background:var(--green-light);color:var(--green)}
  .badge-pending_supervisor{background:#FFF8E1;color:#B8860B}
  .badge-pending_cyber{background:#E3F2FD;color:#1565C0}
  .badge-need_more_info{background:#FFF3E0;color:#E65100}
  .badge-approved{background:var(--green-light);color:var(--green)}
  .badge-rejected{background:var(--red-light);color:var(--red)}
  .action-btn{padding:4px 12px;border-radius:8px;border:none;font-family:'IBM Plex Sans Arabic',sans-serif;font-size:12px;font-weight:600;cursor:pointer;margin:0 2px;transition:opacity .2s}
  .action-btn:hover{opacity:.8}
  .btn-approve{background:var(--green-light);color:var(--green)}
  .btn-reject{background:var(--red-light);color:var(--red)}
  .btn-cyber{background:#F3E8FF;color:#6B21A8}
</style>

<div class="page-header">
  <h2 >@SharedLocalizer["req_pageTitle"]</h2>
  <p >@SharedLocalizer["req_pageSubtitle"]</p>
</div>

@* ===== العدادات — من السيرفر ===== *@
<div class="stats-row">
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.Total</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_all"]</div></div>
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.Submitted</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_submitted"]</div></div>
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.HousingApproved</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_housingApproved"]</div></div>
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.CyberReview</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_cyberReview"]</div></div>
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.CyberApproved</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_cyberApproved"]</div></div>
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.ReadyForProvisioning</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_readyForProvisioning"]</div></div>
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.Completed</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_completed"]</div></div>
  <div class="stat-pill"><div class="stat-pill-num">@Model.Stats.Rejected</div><div class="stat-pill-label" >@SharedLocalizer["req_lbl_rejected"]</div></div>
</div>

@* ===== التبويبات — بتفلتر عبر /api/Requests/paged ===== *@
<div class="tabs">
  <button class="tab-btn active" onclick="switchTab('all', this)" >@SharedLocalizer["req_lbl_all"]</button>
  <button class="tab-btn" onclick="switchTab('submitted', this)" >@SharedLocalizer["req_lbl_submitted"]</button>
  <button class="tab-btn" onclick="switchTab('housing_approved', this)" >@SharedLocalizer["req_lbl_housingApproved"]</button>
  <button class="tab-btn" onclick="switchTab('cyber_review', this)" >@SharedLocalizer["req_lbl_cyberReview"]</button>
  <button class="tab-btn" onclick="switchTab('cyber_approved', this)" >@SharedLocalizer["req_lbl_cyberApproved"]</button>
  <button class="tab-btn" onclick="switchTab('ready_for_provisioning', this)" >@SharedLocalizer["req_lbl_readyForProvisioning"]</button>
  <button class="tab-btn" onclick="switchTab('completed', this)" >@SharedLocalizer["req_lbl_completed"]</button>
  <button class="tab-btn" onclick="switchTab('rejected', this)" >@SharedLocalizer["req_lbl_rejected"]</button>
</div>

<div class="card">
  <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th >@SharedLocalizer["req_col_type"]</th>
          <th >@SharedLocalizer["req_col_student"]</th>
          <th class="sortable" onclick="sortByColumn('submittedat')">@SharedLocalizer["req_col_date"]<span class="sort-ind" id="sort-submittedat"></span></th>
          <th class="sortable" onclick="sortByColumn('status')">@SharedLocalizer["req_col_status"]<span class="sort-ind" id="sort-status"></span></th>
          <th >@SharedLocalizer["req_col_stage"]</th>
          <th >@SharedLocalizer["req_col_action"]</th>
        </tr>
      </thead>
      <tbody id="requests-tbody">
        @if (Model.Page.Items.Count == 0)
        {
          <tr><td colspan="7" style="text-align:center;padding:40px;color:var(--gray-500)" >@SharedLocalizer["req_noRequests"]</td></tr>
        }
        @foreach (var r in Model.Page.Items)
        {
          var s = (r.Status ?? "").ToLowerInvariant();
          <tr style="cursor:pointer" onclick="location.href='/Requests/Details/@r.Id'">
            <td style="color:var(--gray-500)">@ReqNum(r.RequestNumber, r.RequestType?.ToString(), r.Id)</td>
            <td><span>@SharedLocalizer["req_type_" + (r.RequestType?.ToString() ?? "")]</span></td>
            <td>@(r.Student?.full_name ?? r.StudentId.ToString())</td>
            <td><span data-dt="@DateTime.SpecifyKind(r.SubmittedAt, DateTimeKind.Utc).ToString("o")">@r.SubmittedAt.ToString("yyyy/MM/dd")</span></td>
            <td><span class="badge badge-@s">@SharedLocalizer["req_badge_" + s]</span></td>
            <td><span>@SharedLocalizer["req_stage_" + s]</span></td>
            <td>
              @if (s == "submitted" && (role == "admin" || role == "supervisor"))
              {
                <button class="action-btn btn-approve" onclick="event.stopPropagation(); reviewRequest(@r.Id, 'housing_approved')" >@SharedLocalizer["req_act_housing_approved"]</button>
                <button class="action-btn btn-reject" onclick="event.stopPropagation(); reviewRequest(@r.Id, 'housing_rejected')" >@SharedLocalizer["req_act_housing_rejected"]</button>
              }
              else if (s == "housing_approved" && role == "admin")
              {
                <button class="action-btn btn-cyber" onclick="event.stopPropagation(); reviewRequest(@r.Id, 'cyber_review')" >@SharedLocalizer["req_act_cyber_review"]</button>
              }
              else if (s == "cyber_review" && (role == "cyber" || role == "admin"))
              {
                <button class="action-btn btn-approve" onclick="event.stopPropagation(); reviewRequest(@r.Id, 'cyber_approved')" >@SharedLocalizer["req_act_cyber_approved"]</button>
                <button class="action-btn btn-reject" onclick="event.stopPropagation(); reviewRequest(@r.Id, 'cyber_rejected')" >@SharedLocalizer["req_act_cyber_rejected"]</button>
              }
              else if (s == "cyber_approved" && role == "admin")
              {
                <button class="action-btn btn-cyber" onclick="event.stopPropagation(); reviewRequest(@r.Id, 'ready_for_provisioning')" >@SharedLocalizer["req_act_ready_for_provisioning"]</button>
              }
              else if (s == "ready_for_provisioning" && role == "admin")
              {
                <button class="action-btn btn-approve" onclick="event.stopPropagation(); reviewRequest(@r.Id, 'completed')" >@SharedLocalizer["req_act_completed"]</button>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-top:1px solid var(--gray-100)">
    <div style="font-size:12px;color:var(--gray-500)" id="pageInfo"></div>
    <div style="display:flex;gap:8px">
      <button class="btn btn-cancel" id="prevBtn" onclick="changePage(-1)" >@SharedLocalizer["req_prev"]</button>
      <button class="btn btn-cancel" id="nextBtn" onclick="changePage(1)" >@SharedLocalizer["req_next"]</button>
    </div>
  </div>
</div>

@functions {
    private static string ReqNum(string? requestNumber, string? type, int id)
        => !string.IsNullOrEmpty(requestNumber)
            ? requestNumber
            : (type == "bulk_req" ? "BRQ-" : "REQ-") + id.ToString("D6");

}

@section Scripts {
<script src="/i18n.js"></script>
<script>
  var ROLE = '@role';
  var USER_ID = @userId;

  // حالة الصفحة (أول صفحة جاهزة من السيرفر)
  var state = {
    page: @Model.Page.Page,
    pageSize: @Model.Page.PageSize,
    totalPages: @Model.Page.TotalPages,
    total: @Model.Page.TotalCount,
    status: 'all',
    sortBy: '',
    sortAsc: false
  };

  document.querySelectorAll('[data-dt]').forEach(function (el) {
    var d = new Date(el.dataset.dt);
    if (!isNaN(d)) el.textContent = d.toLocaleDateString('ar-EG');
  });

  // نصوص الحالة/النوع من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function typeText(ty) { var k = 'req_type_' + ty; var v = t(k); return v === k ? (ty || '—') : v; }
  function badgeText(s) { var k = 'req_badge_' + s; var v = t(k); return v === k ? (s || '') : v; }
  function stageText(s) { var k = 'req_stage_' + s; var v = t(k); return v === k ? (s || '') : v; }

  // سطر معلومات الصفحة بصيغة مترجمة مع أرقام
  function renderPageInfo() {
    var el = document.getElementById('pageInfo');
    if (!el) return;
    el.textContent = t('req_pageInfoFmt')
      .replace('{0}', state.page).replace('{1}', state.totalPages || 1).replace('{2}', state.total);
  }

  function reqNum(r) {
    if (r.requestNumber) return r.requestNumber;
    var prefix = r.requestType === 'bulk_req' ? 'BRQ-' : 'REQ-';
    return prefix + String(r.id).padStart(6, '0');
  }

  function actionsFor(s, id) {
    var stop = 'event.stopPropagation(); ';
    if (s === 'submitted' && (ROLE === 'admin' || ROLE === 'supervisor')) {
      return '<button class="action-btn btn-approve" onclick="' + stop + 'reviewRequest(' + id + ', \'housing_approved\')">' + t('req_act_housing_approved') + '</button>' +
             '<button class="action-btn btn-reject" onclick="' + stop + 'reviewRequest(' + id + ', \'housing_rejected\')">' + t('req_act_housing_rejected') + '</button>';
    }
    if (s === 'housing_approved' && ROLE === 'admin') {
      return '<button class="action-btn btn-cyber" onclick="' + stop + 'reviewRequest(' + id + ', \'cyber_review\')">' + t('req_act_cyber_review') + '</button>';
    }
    if (s === 'cyber_review' && (ROLE === 'cyber' || ROLE === 'admin')) {
      return '<button class="action-btn btn-approve" onclick="' + stop + 'reviewRequest(' + id + ', \'cyber_approved\')">' + t('req_act_cyber_approved') + '</button>' +
             '<button class="action-btn btn-reject" onclick="' + stop + 'reviewRequest(' + id + ', \'cyber_rejected\')">' + t('req_act_cyber_rejected') + '</button>';
    }
    if (s === 'cyber_approved' && ROLE === 'admin') {
      return '<button class="action-btn btn-cyber" onclick="' + stop + 'reviewRequest(' + id + ', \'ready_for_provisioning\')">' + t('req_act_ready_for_provisioning') + '</button>';
    }
    if (s === 'ready_for_provisioning' && ROLE === 'admin') {
      return '<button class="action-btn btn-approve" onclick="' + stop + 'reviewRequest(' + id + ', \'completed\')">' + t('req_act_completed') + '</button>';
    }
    return '';
  }

  async function loadPage() {
    var url = '/api/Requests/paged?page=' + state.page + '&pageSize=' + state.pageSize;
    if (state.status !== 'all') url += '&status=' + encodeURIComponent(state.status);
    if (state.sortBy) url += '&sortBy=' + encodeURIComponent(state.sortBy) + '&sortAsc=' + state.sortAsc;
    var res = await fetch(url, { headers: NUH.headers() });
    if (res.status === 401) { window.location.replace('/Account/Login'); return; }
    if (!res.ok) return;
    var data = await res.json();
    state.totalPages = data.totalPages;
    state.total = data.totalCount;

    var rows = '';
    (data.items || []).forEach(function (r) {
      var s = (r.status || '').toLowerCase();
      rows += '<tr style="cursor:pointer" onclick="location.href=\'/Requests/Details/' + r.id + '\'">' +
        '<td style="color:var(--gray-500)">' + reqNum(r) + '</td>' +
        '<td>' + escHtml(typeText(r.requestType)) + '</td>' +
        '<td>' + escHtml((r.student && r.student.full_name) || r.studentId || '') + '</td>' +
        '<td>' + (r.submittedAt ? new Date(r.submittedAt).toLocaleDateString('ar-EG') : '—') + '</td>' +
        '<td><span class="badge badge-' + s + '">' + badgeText(s) + '</span></td>' +
        '<td>' + escHtml(stageText(s)) + '</td>' +
        '<td>' + actionsFor(s, r.id) + '</td>' +
      '</tr>';
    });
    document.getElementById('requests-tbody').innerHTML = rows ||
      '<tr><td colspan="7" style="text-align:center;padding:40px;color:var(--gray-500)">' + t('req_noRequests') + '</td></tr>';
    renderPageInfo();
    updatePagerButtons();
  }

  function updatePagerButtons() {
    document.getElementById('prevBtn').disabled = state.page <= 1;
    document.getElementById('nextBtn').disabled = state.page >= state.totalPages;
  }

  // ترتيب الأعمدة: أول ضغطة تصاعدي، وتكرار الضغط يعكس الاتجاه
  function sortByColumn(field) {
    if (state.sortBy === field) { state.sortAsc = !state.sortAsc; }
    else { state.sortBy = field; state.sortAsc = true; }
    state.page = 1;
    updateSortIndicators();
    loadPage();
  }

  function updateSortIndicators() {
    ['submittedat', 'status'].forEach(function (f) {
      var el = document.getElementById('sort-' + f);
      if (el) el.textContent = (state.sortBy === f) ? (state.sortAsc ? ' ▲' : ' ▼') : '';
    });
  }

  function changePage(delta) {
    var next = state.page + delta;
    if (next < 1 || (state.totalPages && next > state.totalPages)) return;
    state.page = next;
    loadPage();
  }

  function switchTab(status, btn) {
    document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    state.status = status;
    state.page = 1;
    loadPage();
  }

  async function reviewRequest(id, newStatus) {
    var label = badgeText(newStatus);
    if (!confirm(t('req_confirmChangeFmt').replace('{0}', label))) return;
    try {
      var res = await fetch('/api/requests/' + id + '/review', {
        method: 'PUT',
        headers: Object.assign({ 'Content-Type': 'application/json' }, NUH.headers()),
        body: JSON.stringify({ status: newStatus, reviewedBy: USER_ID, notes: '' })
      });
      if (!res.ok) {
        var err = await res.json().catch(function () { return {}; });
        alert(err.message || t('req_updateFailed'));
        return;
      }
      // إعادة تحميل الصفحة علشان العدادات وأول صفحة يتحدّثوا من السيرفر
      location.reload();
    } catch (e) { }
  }

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم كل عناصر الترجمة وبيستدعي onLanguageChange
  window.onLanguageChange = function () { renderPageInfo(); };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
  updatePagerButtons();
  updateSortIndicators();
</script>
}
