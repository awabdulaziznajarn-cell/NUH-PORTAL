  </div>

  <div class="stat-card" style="cursor:pointer" onclick="location.href='/Students'">
    <div class="stat-top">
      <div class="stat-icon" style="background:#FFF7ED">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#92400E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
      </div>
      <span class="stat-badge" style="background:#FFF7ED;color:#92400E" >@SharedLocalizer["home_badge_transferred"]</span>
    </div>
    <div class="stat-num">@Model.StatusStats.Transferred</div>
    <div class="stat-label" >@SharedLocalizer["home_transferredStudents"]</div>
  </div>
</div>

@* ===== نشاط اليوم — بيتحمّل بالـ JS من سجل العمليات ===== *@
<div class="section-heading">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
  <span >@SharedLocalizer["home_todayActivity"]</span>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#E8F4FD">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
