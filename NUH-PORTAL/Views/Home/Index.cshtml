@if (isAdmin)
{
  @* ===== إحصائيات حسابات شبكة السكن — admin فقط (نفس صلاحية الـ API) ===== *@
  <div class="section-heading">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
    <span >@SharedLocalizer["home_housingAccountStats"]</span>
  </div>
  <div class="stats-row" style="flex-wrap:wrap">
    <div class="stat-pill"><div class="stat-pill-num" id="hs-total-accounts">0</div><div class="stat-pill-label" >@SharedLocalizer["home_totalAccounts"]</div></div>
    <div class="stat-pill"><div class="stat-pill-num" id="hs-enabled">0</div><div class="stat-pill-label" >@SharedLocalizer["home_enabled"]</div></div>
    <div class="stat-pill"><div class="stat-pill-num" id="hs-disabled">0</div><div class="stat-pill-label" >@SharedLocalizer["home_disabled"]</div></div>
    <div class="stat-pill"><div class="stat-pill-num" id="hs-synced-today">0</div><div class="stat-pill-label" >@SharedLocalizer["home_syncedToday"]</div></div>
    <div class="stat-pill"><div class="stat-pill-num" id="hs-without">0</div><div class="stat-pill-label" >@SharedLocalizer["home_withoutAccounts"]</div></div>
    <div class="stat-pill"><div class="stat-pill-num" id="hs-total-students">0</div><div class="stat-pill-label" >@SharedLocalizer["home_totalStudents"]</div></div>
  </div>
}

@* ===== آخر الطلاب + آخر الطلبات — من السيرفر ===== *@
<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestStudents"]</div>
      <a class="card-action" href="/Students" >@SharedLocalizer["home_viewAll"]</a>
    </div>
    <table>
      <thead>
        <tr><th >@SharedLocalizer["home_col_name"]</th><th >@SharedLocalizer["home_col_college"]</th><th >@SharedLocalizer["home_col_building"]</th><th >@SharedLocalizer["home_col_status"]</th></tr>
      </thead>
      <tbody>
        @if (Model.LatestStudents.Count == 0)
        {
          <tr><td colspan="4" style="text-align:center;padding:20px;color:var(--gray-500)" >@SharedLocalizer["home_noData"]</td></tr>
        }
        @foreach (var s in Model.LatestStudents)
        {
          <tr>
            <td>@s.full_name</td>
            <td>@CollegeName(s.college)</td>
            <td>@s.housing_building</td>
            <td>
              @if (s.status == "left")
              {
                <span class="badge badge-left" >@SharedLocalizer["home_badge_statusLeft"]</span>
              }
              else
              {
                <span class="badge badge-active" >@SharedLocalizer["home_resident"]</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestRequests"]</div>
      <a class="card-action" href="/Requests" >@SharedLocalizer["home_viewAll"]</a>
    </div>
    <table>
      <thead>
        <tr><th >@SharedLocalizer["home_col_reqType"]</th><th >@SharedLocalizer["home_col_date"]</th><th >@SharedLocalizer["home_col_status"]</th></tr>
      </thead>
      <tbody>
        @if (Model.LatestRequests.Count == 0)
        {
          <tr><td colspan="3" style="text-align:center;padding:20px;color:var(--gray-500)" >@SharedLocalizer["home_noRequests"]</td></tr>
        }
        @foreach (var r in Model.LatestRequests)
        {
          <tr>
            <td><span>@SharedLocalizer["home_reqType_" + (r.RequestType?.ToLowerInvariant() ?? "")]</span></td>
            <td><span data-dt="@DateTime.SpecifyKind(r.SubmittedAt, DateTimeKind.Utc).ToString("o")">@r.SubmittedAt.ToString("yyyy/MM/dd")</span></td>
            <td><span class="badge @ReqBadge(r.Status)">@SharedLocalizer["home_reqStatus_" + (r.Status?.ToLowerInvariant() ?? "")]</span></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@* ===== آخر العمليات — JS من سجل العمليات ===== *@
<div class="grid-2">
  <div class="card" style="grid-column:1/-1;margin-bottom:0">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestOperations"]</div>
      <a class="card-action" href="/AuditLog" >@SharedLocalizer["home_viewAll"]</a>
    </div>
    <table>
      <thead>
        <tr><th >@SharedLocalizer["home_col_user"]</th><th >@SharedLocalizer["home_col_action"]</th><th >@SharedLocalizer["home_col_time"]</th></tr>
      </thead>
      <tbody id="audit-activity-tbody">
        <tr><td colspan="3" style="text-align:center;padding:30px;color:var(--gray-500)" >@SharedLocalizer["home_loading"]</td></tr>
      </tbody>
    </table>
  </div>
</div>

@* ===== الرسوم البيانية ===== *@
<div class="grid-2" id="chartsRow" style="margin-bottom:24px">
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartOps7Title"]</div></div><div style="padding:16px;height:220px"><canvas id="chartOps7"></canvas></div></div>
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartLogins30Title"]</div></div><div style="padding:16px;height:220px"><canvas id="chartLogins30"></canvas></div></div>
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartStudentsTitle"]</div></div><div style="padding:16px;height:220px"><canvas id="chartStudents"></canvas></div></div>
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartRequestsTitle"]</div></div><div style="padding:16px;height:220px"><canvas id="chartRequests"></canvas></div></div>
</div>

@* ===== تنبيهات الأمان + إجراءات سريعة + آخر الإشعارات ===== *@
<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_securityAlerts"]</div>
      <a class="card-action" onclick="loadAlerts()" >@SharedLocalizer["home_refresh"]</a>
    </div>
    <div id="alerts-body" style="padding:16px;color:var(--gray-500);text-align:center" >@SharedLocalizer["home_noAlerts"]</div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_quickActions"]</div>
    </div>
    <div class="actions-grid">
      @if (canRegister)
      {
        <a class="action-btn" href="/Register"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg><span >@SharedLocalizer["home_action_register"]</span></a>
      }
      <a class="action-btn" href="/Students"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span >@SharedLocalizer["home_action_viewStudents"]</span></a>
      <a class="action-btn" href="/Requests"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg><span >@SharedLocalizer["home_action_allRequests"]</span></a>
      <a class="action-btn" href="/AuditLog"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span >@SharedLocalizer["home_action_exportReport"]</span></a>
      <a class="action-btn" href="/AuditLog"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span >@SharedLocalizer["home_action_auditLog"]</span></a>
      <a class="action-btn" href="/Reports"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span >@SharedLocalizer["home_action_reports"]</span></a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestNotifications"]</div>
    </div>
    <div class="activity-list" id="notif-list"></div>
  </div>
</div>

@functions {
    private static string ReqBadge(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "housing_approved" or "cyber_approved" or "ready_for_provisioning" or "completed" => "badge-approved",
        "housing_rejected" or "cyber_rejected" => "badge-rejected",
        _ => "badge-pending"
    };

    // كود الكلية (زي ما بيتخزّن من فورم التسجيل) → اسم مترجم؛ وأي نص عربي جاهز يرجع زي ما هو
    private string CollegeName(string? c)
    {
        var key = (c ?? "").Trim().ToLowerInvariant() switch
        {
            "engineering" => "reg_collegeEngineering",
            "medicine" => "reg_collegeMedicine",
            "cs" => "reg_collegeCS",
            "science" => "reg_collegeScience",
            "business" => "reg_collegeBusiness",
            "arts" => "reg_collegeArts",
            "education" => "reg_collegeEducation",
            "pharmacy" => "reg_collegePharmacy",
            _ => null
        };
        return key != null ? SharedLocalizer[key].Value : (c ?? "");
    }
}

@section Scripts {
@* @@ للهروب من الـ Razor — الرابط النهائي فيه @ عادية زي الصفحة القديمة *@
<script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.7/dist/chart.umd.min.js"></script>
<script src="/i18n.js"></script>
<script>
  var IS_ADMIN = @(isAdmin ? "true" : "false");

  // تواريخ الطلبات — نحولها لتوقيت المتصفح بنفس أسلوب الصفحة القديمة
  document.querySelectorAll('[data-dt]').forEach(function (el) {
    var d = new Date(el.dataset.dt);
    if (!isNaN(d)) el.textContent = d.toLocaleDateString('ar-EG');
  });

  async function apiFetch(url) {
    try {
      var res = await fetch(url, { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return null; }
      if (!res.ok) return null;
      return await res.json();
    } catch (e) { return null; }
  }

  function animateNum(id, target) {
    var el = document.getElementById(id);
    if (!el) return;
    var cur = 0;
    el.textContent = '0';
    var step = Math.max(1, Math.ceil(target / 30));
    var timer = setInterval(function () {
      cur = Math.min(cur + step, target);
      el.textContent = cur;
      if (cur >= target) clearInterval(timer);
    }, 40);
  }

  // ترجمة رمز الإجراء من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function translateAction(a) {
    var k = 'home_act_' + a;
    var v = t(k);
    return v === k ? a : v;
  }

  async function loadAuditStats() {
    var data = await apiFetch('/api/auditlogs/today-stats');
    if (!data) return;
    animateNum('cnt-today-logins', data.todayLogins || 0);
    animateNum('cnt-today-student-ops', data.todayStudentOps || 0);
    animateNum('cnt-today-request-ops', data.todayRequestOps || 0);
    animateNum('cnt-today-failed-logins', data.todayFailedLogins || 0);
    animateNum('cnt-today-deletes', data.todayDeletes || 0);
    animateNum('cnt-today-active-users', data.todayActiveUsers || 0);
    animateNum('cnt-today-total-ops', data.todayTotalOps || 0);
  }

  var auditActivityData;
  async function loadAuditActivity() {
    auditActivityData = await apiFetch('/api/auditlogs?pageSize=10&page=1');
    renderAuditActivity();
  }
  function renderAuditActivity() {
    if (typeof auditActivityData === 'undefined') return;
    var tbody = document.getElementById('audit-activity-tbody');
    if (!tbody) return;
    var data = auditActivityData;
    if (!data || !data.data) {
      tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;padding:20px;color:#991B1B">' + t('home_loadFailed') + '</td></tr>';
      return;
    }
    var fmt = new Intl.DateTimeFormat('ar-EG', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    tbody.innerHTML = data.data.slice(0, 10).map(function (r) {
      var user = (r.user && (r.user.full_name || r.user.username)) || r.user_id;
      var dt = r.action_at ? fmt.format(new Date(r.action_at)) : '—';
      return '<tr><td>' + escHtml(user) + '</td><td>' + escHtml(translateAction(r.action)) + '</td><td>' + dt + '</td></tr>';
    }).join('') || '<tr><td colspan="3" style="text-align:center;padding:20px;color:var(--gray-500)">' + t('home_noOperations') + '</td></tr>';
  }

  var alertsData;
  async function loadAlerts() {
    alertsData = await apiFetch('/api/auditlogs/alerts');
    renderAlerts();
  }
  function renderAlerts() {
    if (typeof alertsData === 'undefined') return;
    var el = document.getElementById('alerts-body');
    if (!el) return;
    var data = alertsData;
    if (!data || data.length === 0) {
      el.innerHTML = '<div style="padding:8px;color:var(--gray-500);text-align:center">' + t('home_noSecurityAlerts') + '</div>';
      return;
    }
    el.innerHTML = data.map(function (a) {
      var bg = a.severity === 'high' ? '#FEF2F2' : '#FFF7ED';
      var clr = a.severity === 'high' ? '#991B1B' : '#92400E';
      return '<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;margin-bottom:8px;border-radius:10px;background:' + bg + ';border:1px solid ' + clr + '20">' +
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="' + clr + '" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>' +
        '<div><div style="font-weight:600;font-size:13px;color:' + clr + '">' + escHtml(a.message_ar) + '</div>' +
        '<div style="font-size:11px;color:' + clr + 'CC">' + t('home_countFmt').replace('{0}', a.count) + '</div></div></div>';
    }).join('');
  }

  async function loadHousingStats() {
    // ملحوظة: النسخة القديمة كان فيها باج (متغير staffToken مش معرّف) فالأرقام دي ما كانتش بتتحمّل — متصلّح هنا
    var data = await apiFetch('/api/HousingAccountManagement/stats');
    if (!data) return;
    var map = {
      'hs-total-accounts': data.withAccounts || data.with_accounts || 0,
      'hs-enabled': data.enabled || 0,
      'hs-disabled': data.disabled || 0,
      'hs-synced-today': data.syncedLast24h || data.synced_last_24h || 0,
      'hs-without': data.withoutUsername || data.without_username || 0,
      'hs-total-students': data.totalStudents || data.total_students || 0
    };
    Object.keys(map).forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.textContent = map[id];
    });
  }

  var notifData;
  async function loadNotifCard() {
    notifData = await apiFetch('/api/notifications?role=' + encodeURIComponent(NUH.role));
    renderNotifCard();
  }
  function renderNotifCard() {
    if (typeof notifData === 'undefined') return;
    var list = document.getElementById('notif-list');
    if (!list) return;
    var data = notifData;
    if (!data) {
      list.innerHTML = '<div style="padding:16px;color:#991B1B">' + t('home_notifLoadFailed') + '</div>';
      return;
    }
    list.innerHTML = data.length ? data.slice(0, 8).map(function (n) {
      return '<div class="activity-item">' +
        '<div class="activity-dot" style="background:#C9A84C"></div>' +
        '<div><div class="activity-text">' + escHtml(n.message) + '</div>' +
        '<div class="activity-time">' + new Date(n.sent_at || Date.now()).toLocaleDateString('ar-EG') + '</div></div>' +
      '</div>';
    }).join('') : '<div style="padding:20px;text-align:center;color:var(--gray-500)">' + t('home_noNotifications') + '</div>';
  }

  var chartInstances = {};
  function renderChart(id, type, labels, data, bgColors) {
    if (chartInstances[id]) chartInstances[id].destroy();
    var ctx = document.getElementById(id).getContext('2d');
    chartInstances[id] = new Chart(ctx, {
      type: type,
      data: {
        labels: labels,
        datasets: [{
          label: '',
          data: data,
          backgroundColor: bgColors || '#1B2A5E',
          borderColor: '#1B2A5E',
          borderWidth: 1.5,
          tension: 0.3,
          fill: false
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
      }
    });
  }

  var chartData;
  async function loadCharts() {
    var data = await apiFetch('/api/auditlogs/chart-data');
    if (!data) return;
    chartData = data;
    renderCharts();
  }
  function renderCharts() {
    var data = chartData;
    if (!data) return;
    if (data.last7Days && data.last7Days.length) {
      renderChart('chartOps7', 'bar',
        data.last7Days.map(function (d) { return d.date.slice(5, 10); }),
        data.last7Days.map(function (d) { return d.count; }), '#1B2A5E');
    }
    if (data.login30 && data.login30.length) {
      renderChart('chartLogins30', 'line',
        data.login30.map(function (d) { return d.date.slice(5, 10); }),
        data.login30.map(function (d) { return d.count; }), '#C9A84C');
    }
    if (data.studentOps && data.studentOps.length) {
      renderChart('chartStudents', 'doughnut',
        data.studentOps.map(function (d) { return translateAction(d.action); }),
        data.studentOps.map(function (d) { return d.count; }), ['#1B2A5E', '#C9A84C', '#991B1B']);
    }
    if (data.requestOps && data.requestOps.length) {
      renderChart('chartRequests', 'doughnut',
        data.requestOps.map(function (d) { return translateAction(d.action); }),
        data.requestOps.map(function (d) { return d.count; }), ['#0F6E56', '#C9A84C', '#991B1B']);
    }
  }

  loadAuditStats();
  loadAuditActivity();
  loadAlerts();
  loadNotifCard();
  loadCharts();
  if (IS_ADMIN) loadHousingStats();

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم عناصر الترجمة وبيستدعي onLanguageChange
  window.onLanguageChange = function () {
    renderCharts();
    renderAuditActivity();
    renderAlerts();
    renderNotifCard();
  };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
</script>
}
