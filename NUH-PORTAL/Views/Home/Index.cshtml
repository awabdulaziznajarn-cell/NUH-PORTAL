      <span class="stat-badge" style="background:#E8F4FD;color:#1B2A5E" >@SharedLocalizer["home_badge_today"]</span>
    </div>
    <div class="stat-num" id="cnt-today-logins">0</div>
    <div class="stat-label" >@SharedLocalizer["home_todayLogins"]</div>
  </div>

  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#E1F5EE">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
