@model NUH_PORTAL.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = SharedLocalizer["Page_Home"].Value;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";

    // ⚠️ الشاشة كانت بتتحكم بالدور. بقت بالصلاحية عشان أي دور جديد يشتغل صح.
    bool Perm(string p) => User.HasClaim("permission", p);
    var canReviewHousing = Perm("requests.reviewHousing");
    var canReviewCyber   = Perm("requests.reviewCyber");
    var canComplete      = Perm("requests.complete");
    var canHousingView   = Perm("housing.view");
    var canRegister      = Perm("students.create");

    // الأرقام اللي بتستنى إجراء من المستخدم ده تحديدًا
    var waitHousing  = canReviewHousing ? Model.Stats.submitted : 0;
    var waitCyber    = canReviewCyber ? Model.Stats.cyber_review : 0;
    var waitProvision= canComplete ? Model.Stats.cyber_approved + Model.Stats.ready_for_provisioning : 0;

    var openRequests = Model.Stats.submitted + Model.Stats.housing_approved + Model.Stats.cyber_review
                     + Model.Stats.cyber_approved + Model.Stats.ready_for_provisioning;
}

<style>
  /* خاص بلوحة التحكم فقط — الباقي كله من site.css */
  /* ⚠️ auto-fill كان بيسيب أعمدة فاضية في آخر السطر، فالبطاقات تتزنق على اليمين
     ويفضل فراغ كبير على الشمال. auto-fit بيمدّد الموجود ويملا العرض. */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px}

  /* بطاقات «يحتاج إجراءك» — أكبر وقابلة للضغط، ودي أهم حاجة في الشاشة */
  .todo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;margin-bottom:8px}
  .todo-card{display:flex;align-items:center;gap:16px;background:var(--white);border:1px solid var(--gray-200);
             border-inline-start:4px solid var(--navy);border-radius:14px;padding:18px 20px;
             text-decoration:none;color:inherit;transition:box-shadow .18s,transform .18s,border-color .18s}
  .todo-card:hover{box-shadow:0 8px 24px rgba(16,70,49,.11);transform:translateY(-2px);border-color:var(--navy)}
  .todo-card .n{font-size:34px;font-weight:800;color:var(--navy-dark);line-height:1;min-width:52px}
  .todo-card .t{flex:1;min-width:0}
  .todo-card .t b{display:block;font-size:13.5px;font-weight:700;color:var(--navy-dark);line-height:1.5}
  .todo-card .t span{display:block;font-size:11.5px;color:var(--gray-500);margin-top:2px;line-height:1.6}
  .todo-card .go{color:var(--gray-300);flex-shrink:0}
  .todo-card:hover .go{color:var(--navy)}
  .todo-card.zero{border-inline-start-color:var(--gray-200);opacity:.72}
  .todo-card.zero .n{color:var(--gray-300)}
  .stat-card{background:var(--white);border-radius:16px;padding:20px;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(16,70,49,.05);display:flex;flex-direction:column;gap:12px;transition:transform .2s,box-shadow .2s}
  .stat-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(16,70,49,.1)}
  .stat-top{display:flex;align-items:center;justify-content:space-between}
  .stat-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center}
  .stat-badge{font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px}
  .stat-num{font-size:32px;font-weight:900;color:var(--navy-dark);line-height:1}
  .stat-label{font-size:13px;color:var(--gray-500);font-weight:500}
  .section-heading{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:var(--navy-dark);margin-bottom:12px}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}
  #chartsRow{grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
  .activity-list{padding:8px 0}
  .activity-item{display:flex;align-items:flex-start;gap:12px;padding:12px 20px;border-bottom:1px solid var(--gray-100)}
  .activity-item:last-child{border-bottom:none}
  .activity-dot{width:8px;height:8px;border-radius:50%;margin-top:6px;flex-shrink:0}
  .activity-text{font-size:13px;color:var(--navy-dark);font-weight:500;line-height:1.5}
  .activity-time{font-size:11px;color:var(--gray-500);margin-top:2px}
  .actions-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:16px}
  .action-btn{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 12px;border-radius:12px;border:1.5px solid var(--gray-100);background:var(--gray-50);cursor:pointer;transition:all .2s;text-decoration:none}
  .action-btn:hover{border-color:var(--navy);background:var(--white);transform:translateY(-2px);box-shadow:0 4px 12px rgba(16,70,49,.1)}
  .action-btn span{font-size:12px;font-weight:600;color:var(--navy-dark);text-align:center}
</style>

<div class="page-header">
  <h2><span >@SharedLocalizer["home_welcome"]</span> @fullName 👋</h2>
  <p >@SharedLocalizer["home_summaryToday"]</p>
</div>

@* ============================================================================
   ⚠️ الشاشة دي كانت ٢٥ عدّاد على ٤ أقسام (مسار الطلبات، حالات الطلاب، نشاط اليوم،
      حسابات الشبكة) ومعظمهم أصفار. لوحة التحكم المفروض تجاوب على سؤال واحد:
      «فيه إيه مستني إجراء مني؟» — والباقي مكانه الشاشة المتخصصة فيه.

      اتشال: «نشاط اليوم» (مكانه سجل الدخول وسجل الإجراءات)، «حالات الطلاب»
      (مكانها شاشة الطلاب)، و«تنبيهات الأمان» (كانت فاضية دايمًا).
   ============================================================================ *@

@* ===== يحتاج إجراءك — بيظهر حسب صلاحيات المستخدم بس ===== *@
@if (canReviewHousing || canReviewCyber || canComplete)
{
  <div class="section-heading">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    <span>@SharedLocalizer["dash_needsAction"]</span>
  </div>

  @* ⚠️ كان فيه لافتة خضراء «مفيش طلبات مستنية إجراء منك» بتحلّ محل البطاقات لما
     الكل صفر. اتشالت لسببين: الشاشة كانت بتتغيّر شكلها كل ما رقم يتحرك، والبطاقة
     الصفر نفسها بتقول نفس المعلومة وزيادة — بتقول *أنهي* طابور فاضي وتفضل قابلة
     للضغط. البطاقات دلوقتي ثابتة والصفر بيبان رمادي. *@
  <div class="todo-grid">
      @if (canReviewHousing)
      {
        <a class="todo-card @(waitHousing == 0 ? "zero" : "")" href="/Requests">
          <span class="n">@waitHousing</span>
          <span class="t"><b>@SharedLocalizer["dash_waitHousing"]</b><span>@SharedLocalizer["dash_waitHousingDesc"]</span></span>
          <span class="go"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></span>
        </a>
      }
      @if (canReviewCyber)
      {
        <a class="todo-card @(waitCyber == 0 ? "zero" : "")" href="/Requests">
          <span class="n">@waitCyber</span>
          <span class="t"><b>@SharedLocalizer["dash_waitCyber"]</b><span>@SharedLocalizer["dash_waitCyberDesc"]</span></span>
          <span class="go"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></span>
        </a>
      }
      @if (canComplete)
      {
        @* ⚠️ بطاقة «بانتظار التحويل للمراجعة الإلكترونية» اتشالت من هنا.
           كانت بتعدّ الطلبات في حالة housing_approved، والحالة دي مافيش طلب
           بيقف فيها أصلًا: موافقة الإسكان بتحوّل الطلب على cyber_review في
           نفس اللحظة (ReviewAsync: ("submitted","housing_approved") => "cyber_review").
           فالبطاقة كانت صفر دايمًا وبتاخد ربع صف «يحتاج إجراءك» من غير فايدة.
           معالجة الحالة نفسها اتسابت في شاشة الطلبات كشبكة أمان لأي صف قديم
           اتخزّن قبل التحويل ده — فمفيش طلب هيضيع. *@
        <a class="todo-card @(waitProvision == 0 ? "zero" : "")" href="/Requests">
          <span class="n">@waitProvision</span>
          <span class="t"><b>@SharedLocalizer["dash_waitProvision"]</b><span>@SharedLocalizer["dash_waitProvisionDesc"]</span></span>
          <span class="go"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></span>
        </a>
      }
  </div>
}

@* ===== نظرة عامة — أربعة أرقام بس ===== *@
<div class="section-heading" style="margin-top:24px">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
  <span>@SharedLocalizer["dash_overview"]</span>
</div>

<div class="stats-grid">
  <div class="stat-card" style="cursor:pointer" onclick="location.href='/Students'">
    <div class="stat-top">
      <div class="stat-icon" style="background:#eff4ff">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
    </div>
    <div class="stat-num">@Model.Stats.total</div>
    <div class="stat-label">@SharedLocalizer["home_totalStudents"]</div>
  </div>

  <div class="stat-card" style="cursor:pointer" onclick="location.href='/Requests'">
    <div class="stat-top">
      <div class="stat-icon" style="background:#fffaeb">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#93370d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
    </div>
    <div class="stat-num">@openRequests</div>
    <div class="stat-label">@SharedLocalizer["dash_openRequests"]</div>
  </div>

  @if (canHousingView)
  {
    <div class="stat-card" style="cursor:pointer" onclick="location.href='/Housing'">
      <div class="stat-top">
        <div class="stat-icon" style="background:#dff6e7">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#067647" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
      </div>
      <div class="stat-num" id="hs-enabled">0</div>
      <div class="stat-label">@SharedLocalizer["dash_adEnabled"]</div>
    </div>

    <div class="stat-card" style="cursor:pointer" onclick="location.href='/Housing'">
      <div class="stat-top">
        <div class="stat-icon" style="background:#fef3f2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b42318" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
      </div>
      <div class="stat-num" id="hs-disabled">0</div>
      <div class="stat-label">@SharedLocalizer["dash_adDisabled"]</div>
    </div>
  }
  else
  {
    <div class="stat-card" style="cursor:pointer" onclick="location.href='/Requests'">
      <div class="stat-top">
        <div class="stat-icon" style="background:#dff6e7">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#067647" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
      </div>
      <div class="stat-num">@Model.Stats.completed</div>
      <div class="stat-label">@SharedLocalizer["home_completedRequests"]</div>
    </div>
  }
</div>

@* ===== آخر الطلاب + آخر الطلبات — من السيرفر ===== *@
<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestStudents"]</div>
      <a class="card-action" href="/Students" >@SharedLocalizer["home_viewAll"]</a>
    </div>
    <table>
      <thead>
        <tr><th >@SharedLocalizer["home_col_name"]</th><th >@SharedLocalizer["home_col_college"]</th><th >@SharedLocalizer["home_col_building"]</th><th >@SharedLocalizer["home_col_status"]</th></tr>
      </thead>
      <tbody>
        @if (Model.LatestStudents.Count == 0)
        {
          <tr><td colspan="4" style="text-align:center;padding:20px;color:var(--gray-500)" >@SharedLocalizer["home_noData"]</td></tr>
        }
        @foreach (var s in Model.LatestStudents)
        {
          <tr>
            <td>@s.full_name</td>
            <td data-lk="college:@s.college">@CollegeName(s.college)</td>
            <td data-lk="building:@s.housing_building">@s.housing_building</td>
            <td>
              @if (s.status == StudentState.left)
              {
                <span class="badge badge-left" >@SharedLocalizer["home_badge_statusLeft"]</span>
              }
              else
              {
                <span class="badge badge-active" >@SharedLocalizer["home_resident"]</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestRequests"]</div>
      <a class="card-action" href="/Requests" >@SharedLocalizer["home_viewAll"]</a>
    </div>
    <table>
      <thead>
        <tr><th >@SharedLocalizer["home_col_reqType"]</th><th >@SharedLocalizer["home_col_date"]</th><th >@SharedLocalizer["home_col_status"]</th></tr>
      </thead>
      <tbody>
        @if (Model.LatestRequests.Count == 0)
        {
          <tr><td colspan="3" style="text-align:center;padding:20px;color:var(--gray-500)" >@SharedLocalizer["home_noRequests"]</td></tr>
        }
        @foreach (var r in Model.LatestRequests)
        {
          <tr>
            <td><span>@SharedLocalizer["home_reqType_" + (r.RequestType?.ToString() ?? "")]</span></td>
            <td><span data-dt="@DateTime.SpecifyKind(r.SubmittedAt, DateTimeKind.Utc).ToString("o")">@r.SubmittedAt.ToString("yyyy/MM/dd")</span></td>
            <td><span class="badge @ReqBadge(r.Status)">@SharedLocalizer["home_reqStatus_" + (r.Status?.ToLowerInvariant() ?? "")]</span></td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@* ===== آخر العمليات — JS من سجل العمليات ===== *@
<div class="grid-2">
  <div class="card" style="grid-column:1/-1;margin-bottom:0">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestOperations"]</div>
      <a class="card-action" href="/AuditLog" >@SharedLocalizer["home_viewAll"]</a>
    </div>
    <table>
      <thead>
        <tr><th >@SharedLocalizer["home_col_user"]</th><th >@SharedLocalizer["home_col_action"]</th><th >@SharedLocalizer["home_col_time"]</th></tr>
      </thead>
      <tbody id="audit-activity-tbody">
        <tr><td colspan="3" style="text-align:center;padding:30px;color:var(--gray-500)" >@SharedLocalizer["home_loading"]</td></tr>
      </tbody>
    </table>
  </div>
</div>

@* ===== الرسوم البيانية ===== *@
<div class="grid-2" id="chartsRow" style="margin-bottom:24px">
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartOps7Title"]</div></div><div class="chart-box"><canvas id="chartOps7"></canvas></div></div>
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartLogins30Title"]</div></div><div class="chart-box"><canvas id="chartLogins30"></canvas></div></div>
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartStudentsTitle"]</div></div><div class="chart-box"><canvas id="chartStudents"></canvas></div></div>
  <div class="card"><div class="card-header"><div class="card-title" >@SharedLocalizer["home_chartRequestsTitle"]</div></div><div class="chart-box"><canvas id="chartRequests"></canvas></div></div>
</div>

@* ===== تنبيهات الأمان + إجراءات سريعة + آخر الإشعارات ===== *@
<div class="grid-2">
  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_quickActions"]</div>
    </div>
    <div class="actions-grid">
      @if (canRegister)
      {
        <a class="action-btn" href="/Register"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg><span >@SharedLocalizer["home_action_register"]</span></a>
      }
      <a class="action-btn" href="/Students"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span >@SharedLocalizer["home_action_viewStudents"]</span></a>
      <a class="action-btn" href="/Requests"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg><span >@SharedLocalizer["home_action_allRequests"]</span></a>
      <a class="action-btn" href="/AuditLog"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span >@SharedLocalizer["home_action_exportReport"]</span></a>
      <a class="action-btn" href="/AuditLog"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span >@SharedLocalizer["home_action_auditLog"]</span></a>
      <a class="action-btn" href="/Reports"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#166a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span >@SharedLocalizer["home_action_reports"]</span></a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title" >@SharedLocalizer["home_latestNotifications"]</div>
    </div>
    <div class="activity-list" id="notif-list"></div>
  </div>
</div>

@functions {
    private static string ReqBadge(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "housing_approved" or "cyber_approved" or "ready_for_provisioning" or "completed" => "badge-approved",
        "housing_rejected" or "cyber_rejected" => "badge-rejected",
        _ => "badge-pending"
    };

    // كود الكلية (زي ما بيتخزّن من فورم التسجيل) → اسم مترجم؛ وأي نص عربي جاهز يرجع زي ما هو
    private string CollegeName(string? c)
    {
        var key = (c ?? "").Trim().ToLowerInvariant() switch
        {
            "engineering" => "reg_collegeEngineering",
            "medicine" => "reg_collegeMedicine",
            "cs" => "reg_collegeCS",
            "science" => "reg_collegeScience",
            "business" => "reg_collegeBusiness",
            "arts" => "reg_collegeArts",
            "education" => "reg_collegeEducation",
            "pharmacy" => "reg_collegePharmacy",
            _ => null
        };
        return key != null ? SharedLocalizer[key].Value : (c ?? "");
    }
}

@section Scripts {
@* @@ للهروب من الـ Razor — الرابط النهائي فيه @ عادية زي الصفحة القديمة *@
@* ⚠️ كانت بتتحمّل من CDN خارجي. عيبان: شبكة الجامعة لو حجبت المصدر
   الخارجي بتفضى الرسوم بلا سبب واضح للمستخدم، وأي تغيير في المصدر ده بيتنفّذ
   جوّه صفحة فيها جلسة إدارية. النسخة المحلية موجودة أصلًا وشاشة التقارير
   بتستخدمها. *@
<script src="/js/chart.umd.min.js"></script>
<script src="/js/chart-theme.js" asp-append-version="true"></script>
<script src="/i18n.js"></script>
<script>
  var CAN_HOUSING = @(canHousingView ? "true" : "false");

  // تواريخ الطلبات — نحولها لتوقيت المتصفح بنفس أسلوب الصفحة القديمة
  document.querySelectorAll('[data-dt]').forEach(function (el) {
    var d = new Date(el.dataset.dt);
    if (!isNaN(d)) el.textContent = d.toLocaleDateString('ar-EG');
  });

  async function apiFetch(url) {
    try {
      var res = await fetch(url, { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return null; }
      if (!res.ok) return null;
      return await res.json();
    } catch (e) { return null; }
  }

  function animateNum(id, target) {
    var el = document.getElementById(id);
    if (!el) return;
    var cur = 0;
    el.textContent = '0';
    var step = Math.max(1, Math.ceil(target / 30));
    var timer = setInterval(function () {
      cur = Math.min(cur + step, target);
      el.textContent = cur;
      if (cur >= target) clearInterval(timer);
    }, 40);
  }

  // ترجمة رمز الإجراء من القاموس (fallback للقيمة الخام لو مفيش مفتاح)
  function translateAction(a) {
    var k = 'home_act_' + a;
    var v = t(k);
    return v === k ? a : v;
  }

  var auditActivityData;
  async function loadAuditActivity() {
    auditActivityData = await apiFetch('/api/auditlogs?pageSize=10&page=1');
    renderAuditActivity();
  }
  function renderAuditActivity() {
    if (typeof auditActivityData === 'undefined') return;
    var tbody = document.getElementById('audit-activity-tbody');
    if (!tbody) return;
    var data = auditActivityData;
    if (!data || !data.data) {
      tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;padding:20px;color:#b42318">' + t('home_loadFailed') + '</td></tr>';
      return;
    }
    var fmt = new Intl.DateTimeFormat('ar-EG', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    tbody.innerHTML = data.data.slice(0, 10).map(function (r) {
      var user = (r.user && (r.user.full_name || r.user.username)) || r.user_id;
      var dt = r.action_at ? fmt.format(new Date(r.action_at)) : '-';
      return '<tr><td>' + escHtml(user) + '</td><td>' + escHtml(translateAction(r.action)) + '</td><td>' + dt + '</td></tr>';
    }).join('') || '<tr><td colspan="3" style="text-align:center;padding:20px;color:var(--gray-500)">' + t('home_noOperations') + '</td></tr>';
  }

  async function loadHousingStats() {
    // ملحوظة: النسخة القديمة كان فيها باج (متغير staffToken مش معرّف) فالأرقام دي ما كانتش بتتحمّل — متصلّح هنا
    var data = await apiFetch('/api/HousingAccountManagement/stats');
    if (!data) return;
    var map = {
      'hs-total-accounts': data.withAccounts || data.with_accounts || 0,
      'hs-enabled': data.enabled || 0,
      'hs-disabled': data.disabled || 0,
      'hs-synced-today': data.syncedLast24h || data.synced_last_24h || 0,
      'hs-without': data.withoutUsername || data.without_username || 0,
      'hs-total-students': data.totalStudents || data.total_students || 0
    };
    Object.keys(map).forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.textContent = map[id];
    });
  }

  var notifData;
  async function loadNotifCard() {
    notifData = await apiFetch('/api/notifications?role=' + encodeURIComponent(NUH.role));
    renderNotifCard();
  }
  function renderNotifCard() {
    if (typeof notifData === 'undefined') return;
    var list = document.getElementById('notif-list');
    if (!list) return;
    var data = notifData;
    if (!data) {
      list.innerHTML = '<div style="padding:16px;color:#b42318">' + t('home_notifLoadFailed') + '</div>';
      return;
    }
    list.innerHTML = data.length ? data.slice(0, 8).map(function (n) {
      return '<div class="activity-item">' +
        '<div class="activity-dot" style="background:#dba102"></div>' +
        '<div><div class="activity-text">' + escHtml(n.message) + '</div>' +
        '<div class="activity-time">' + new Date(n.sent_at || Date.now()).toLocaleDateString('ar-EG') + '</div></div>' +
      '</div>';
    }).join('') : '<div style="padding:20px;text-align:center;color:var(--gray-500)">' + t('home_noNotifications') + '</div>';
  }

  @* ⚠️ الدالة دي كانت نسخة تانية من اللي في js/reports-page.js بالحرف —
     ولو حد عدّل شكل الرسوم في شاشة كان لازم يفتكر يعدّلها في التانية.
     الشكل الموحّد بقى في js/chart-theme.js. *@
  function renderChart(id, type, labels, data, bgColors, totalLabel) {
    return NuhChart.render(id, type, labels, data, bgColors, totalLabel);
  }

  var chartData;
  async function loadCharts() {
    var data = await apiFetch('/api/auditlogs/chart-data');
    if (!data) return;
    chartData = data;
    renderCharts();
  }
  function renderCharts() {
    var data = chartData;
    if (!data) return;
    if (data.last7Days && data.last7Days.length) {
      renderChart('chartOps7', 'bar',
        data.last7Days.map(function (d) { return d.date.slice(5, 10); }),
        data.last7Days.map(function (d) { return d.count; }), '#166a45');
    }
    if (data.login30 && data.login30.length) {
      renderChart('chartLogins30', 'line',
        data.login30.map(function (d) { return d.date.slice(5, 10); }),
        data.login30.map(function (d) { return d.count; }), '#dba102');
    }
    if (data.studentOps && data.studentOps.length) {
      renderChart('chartStudents', 'doughnut',
        data.studentOps.map(function (d) { return translateAction(d.action); }),
        data.studentOps.map(function (d) { return d.count; }), NuhChart.palette, t('chart_total'));
    }
    if (data.requestOps && data.requestOps.length) {
      renderChart('chartRequests', 'doughnut',
        data.requestOps.map(function (d) { return translateAction(d.action); }),
        data.requestOps.map(function (d) { return d.count; }), NuhChart.palette, t('chart_total'));
    }
  }

  // ⚠️ loadAuditStats و loadAlerts اتشالوا مع بطاقاتهم — كانوا بينادوا الـ API
  //    على كل فتح للصفحة عشان أرقام مالهاش مكان تتعرض فيه.
  loadAuditActivity();
  loadNotifCard();
  loadCharts();
  if (CAN_HOUSING) loadHousingStats();

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم عناصر الترجمة وبيستدعي onLanguageChange
  window.onLanguageChange = function () {
    renderCharts();
    renderAuditActivity();
    renderNotifCard();
  };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
</script>
}
