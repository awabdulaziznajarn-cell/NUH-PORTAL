  </div>

  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#FEF2F2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#991B1B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
      </div>
      <span class="stat-badge" style="background:#FEF2F2;color:#991B1B" >@SharedLocalizer["home_badge_left"]</span>
    </div>
    <div class="stat-num">@Model.Stats.left</div>
    <div class="stat-label" >@SharedLocalizer["home_studentsLeft"]</div>
  </div>
</div>

@* ===== إحصائيات حالة الطلاب — من السيرفر ===== *@
