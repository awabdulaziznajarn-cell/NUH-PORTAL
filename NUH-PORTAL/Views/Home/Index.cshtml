@model NUH_PORTAL.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = SharedLocalizer["Page_Home"].Value;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";

    // ⚠️ الشاشة كانت بتتحكم بالدور. بقت بالصلاحية عشان أي دور جديد يشتغل صح.
    bool Perm(string p) => User.HasClaim("permission", p);
    var canReviewHousing = Perm("requests.reviewHousing");
    var canReviewCyber   = Perm("requests.reviewCyber");
    var canComplete      = Perm("requests.complete");
    var canHousingView   = Perm("housing.view");
    // ⚠️ دونات «حسابات شبكة السكن» أداة عمل الأمن السيبراني لا معلومة عامة:
    //    هو من يُنشئ الحساب ويعطّله. والمشرف يملك housing.view ليقرأ بيانات
    //    السكن، فربط الرسم بها كان يعرض عليه رقمًا لا يفعل به شيئًا ويزاحم
    //    رسمه هو. الشرط الآن على من يتصرّف في الحساب فعلًا.
    var canSeeAccountsChart = canReviewCyber || canComplete;
    // ⚠️ رسم المشرف: «الطلاب حسب المبنى». يظهر لمن يراجع طلبات الإسكان ولا
    //    يملك أدوات حساب الشبكة - أي المشرف والمشرفة. والمكان واحد لا رسمان:
    //    لكل دور أداته لا كومة رسوم يتخطّى معظمها.
    var canSeeBuildingsChart = canReviewHousing && !canSeeAccountsChart;
    var canRegister      = Perm("students.create");
    // ⚠️ رسم «العمليات آخر ٧ أيام» بياناته من سجل التدقيق، وكان ظاهرًا للكل
    //    لأن الـ endpoint كان مفتوحًا. اتقفل، فالبطاقة لازم تتبعه — وإلا بقى
    //    مكانها فاضي عند اللي مالوش الصلاحية.
    var canSeeOpsChart   = Perm("auditLogs.view");
    // ⚠️ تقسيم الطلاب/الطالبات يبان للي نطاقه القسمين (الأدمن) وحده.
    //    المشرف بيشوف قسمه بس، فالرسم عنده هيبقى ١٠٠٪ لقسم و٠٪ للتاني —
    //    رقم مالوش معنى وبياخد مساحة رسم مفيد. نفس الـ claim اللي بتقرا
    //    منه التصفية في السيرفر.
    var __scope = (User.FindFirst(NUH_PORTAL.Core.ClaimConstants.ScopeGender)?.Value ?? "").Trim().ToLowerInvariant();
    var canSeeGenderSplit = __scope != "male" && __scope != "female";

    // الأرقام اللي بتستنى إجراء من المستخدم ده تحديدًا
    var waitHousing  = canReviewHousing ? Model.Stats.submitted : 0;
    var waitCyber    = canReviewCyber ? Model.Stats.cyber_review : 0;
    var waitProvision= canComplete ? Model.Stats.cyber_approved + Model.Stats.ready_for_provisioning : 0;

    var openRequests = Model.Stats.submitted + Model.Stats.housing_approved + Model.Stats.cyber_review
                     + Model.Stats.cyber_approved + Model.Stats.ready_for_provisioning;
}

<style>
  /* خاص بلوحة التحكم فقط — الباقي كله من site.css */
  /* ⚠️ auto-fill كان بيسيب أعمدة فاضية في آخر السطر، فالبطاقات تتزنق على اليمين
     ويفضل فراغ كبير على الشمال. auto-fit بيمدّد الموجود ويملا العرض. */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px}

  /* بطاقات «يحتاج إجراءك» — أكبر وقابلة للضغط، ودي أهم حاجة في الشاشة */
  .todo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:8px}
  /* ⚠️ ‏.todo-card اتشالت هي كمان: كانت مكوّنًا سادسًا لنفس البطاقة (رقم ٣٤
     ووزن ٨٠٠، وحدّ ٤ بكسل على الحافة، وسطر شرح تحت العنوان) - فصفّ «يحتاج
     إجراءك» وصفّ «نظرة عامة» فوق بعض في نفس الشاشة كانوا بيبانوا من عيلتين.
     البطاقة دلوقتي .stat-card من components.css، وحالة الصفر .is-idle،
     والسهم .is-link - كلهم معرّفين هناك. وسطر الشرح نزل في title زي ما
     المكوّن بيقول: هو اللي كان بيزوّد ارتفاع الصفّ سطرًا كاملًا فوق الصفّ
     اللي تحته. */
  /* ⚠️ ‏.stat-card ومشتقّاتها (‏.stat-top و.stat-icon و.stat-num و.stat-label
     و.stat-sub و.stat-badge و.stat-card.alert) اتشالوا من هنا: كانوا **نسخة
     كاملة** من بطاقة المؤشّر مكتوبة جوّه <style> الشاشة - رقم ٣٢ ووزن ٩٠٠
     مقابل ٢٧ و٧٠٠ في المكوّن، وأيقونة في صندوق ٤٤ فوق الرقم مقابل أيقونة
     باهتة في خلفية البطاقة.
     ⚠️ والستايل الداخلي بيغلب الملف الخارجي (بيجي بعده في الصفحة)، فالشاشة
     دي كانت بتتجاهل components.css تمامًا وهي شكلها ماشي مع الباقي - لحد ما
     الأيقونة الباهتة اختفت وبانت.
     التعريف الوحيد دلوقتي في css/components.css زي كل الشاشات. */
  .section-heading{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:var(--navy-dark);margin-bottom:12px}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}
  #chartsRow{grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
  /* ⚠️ «الإجراءات السريعة» و«آخر الإشعارات» اتشالوا وستايلهم معاهم: الستة
     أزرار كلهم موجودين في القائمة الجانبية الظاهرة دايمًا على نفس الشاشة،
     والإشعارات في جرس الشريط العلوي بعدّادها — الشاشة كانت بتعرض نفس
     المعلومة مرتين. */

  /* ---------- لوحة «الطلبات الأطول انتظارًا» ----------
     ⚠️ كانت «آخر الطلبات»: جدول بأربعة أعمدة يعرض أحدث ما وصل. والأحدث هو ما
        عالجه المستخدم بنفسه للتو — أما اللي بيُنسى فهو الواقف من أيام. القائمة
        دلوقتي مرتّبة بالأقدم انتظارًا ومحصورة في الطلبات المفتوحة. */
  .rq-row{display:flex;align-items:center;gap:14px;padding:13px 20px;border-bottom:1px solid var(--gray-100);
    text-decoration:none;color:inherit;transition:background .15s}
  .rq-row:last-child{border-bottom:none}
  .rq-row:hover{background:var(--row-hover)}
  .rq-num{font-family:Consolas,monospace;font-size:12px;color:var(--gray-500);direction:ltr;flex-shrink:0;width:98px}
  .rq-main{flex:1;min-width:0}
  .rq-name{display:block;font-size:13.5px;font-weight:600;color:var(--navy-dark);line-height:1.5;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  /* ⚠️ الاسم الإنجليزي تحت العربي: نفس قاعدة الجداول - اسم الشخص بيانات لا
     ترجمة، فالشاشة الإنجليزية ماتخفيهوش. و unicode-bidi:isolate يعزل ترتيب
     حروفه بلا ما يزيح السطر للطرف التاني (لو اتكتب direction:ltr كان هيبعد
     عن الاسم اللي بيوصفه). */
  .rq-name-en{display:block;font-size:11.5px;font-weight:500;color:var(--gray-600);
    line-height:1.5;margin-top:1px;unicode-bidi:isolate;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rq-stage{display:block;font-size:11.5px;color:var(--gray-500);margin-top:3px}
  /* شارة العمر تتلوّن بعتبة لا بالحالة: أخضر أقل من يومين، وكهرماني حتى خمسة،
     وأحمر فوقها — فيُلتقط المتأخّر بالعين قبل قراءة الرقم. */
  .rq-age{flex-shrink:0;font-size:11.5px;font-weight:700;padding:3px 11px;border-radius:999px;white-space:nowrap}
  .age-ok{background:var(--green-light);color:var(--green)}
  .age-warn{background:var(--gold-pale);color:#93370d}
  .age-bad{background:var(--red-light);color:var(--red)}
  .rq-go{color:var(--gray-300);flex-shrink:0}
  .rq-row:hover .rq-go{color:var(--navy)}
  /* أين يقف الطلب من خطوات المسار الأربع — الرقم من RequestWorkflow.Step */
  .rq-steps{display:flex;gap:3px;width:78px;flex-shrink:0}
  .rq-steps i{height:4px;flex:1;border-radius:999px;background:var(--gray-200)}
  .rq-steps i.on{background:var(--navy)}
  @@media(max-width:760px){.rq-steps,.rq-num{display:none}}
  /* ⚠️ حالة الفراغ تقول ما جرى بدل بطاقة بيضاء: «لا يوجد طلب منتظر» جواب مفيد
     بذاته، والجدول الفارغ بيبان عطل. */
  .rq-empty{display:flex;flex-direction:column;align-items:center;gap:8px;padding:38px 20px;text-align:center}
  .rq-empty b{font-size:14px;font-weight:700;color:var(--navy-dark)}
  .rq-empty span{font-size:12.5px;color:var(--gray-500)}

  /* ---------- الرسوم ---------- */
  .charts{display:grid;grid-template-columns:1.35fr 1fr;gap:16px;margin-bottom:24px}
  .charts.one{grid-template-columns:1fr}
  /* صفّ الدونات: عمودان متساويان — الرسمان هنا متكافئان في الأهمية،
     بعكس صفّ الرسم الرئيسي اللي بياخد مساحة أكبر من اللي جنبه. */
  .charts.even{grid-template-columns:1fr 1fr}
  .chart-head{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--gray-100)}
  .chart-head .t{font-size:14px;font-weight:700;color:var(--navy-dark)}
  .chart-head .pill{font-size:11px;font-weight:600;color:var(--gray-700);background:var(--gray-100);padding:4px 12px;border-radius:999px}
  .chart-body{padding:14px 12px 10px;height:230px}
  /* وسيلة الإيضاح أسطر فيها الأرقام: الرقم جزء من القراءة لا في تلميح عائم لا
     يظهر إلا بالمرور بالفأرة — ولا يظهر أصلًا على الجوال. */
  .lg{padding:4px 18px 14px;display:flex;flex-direction:column;gap:8px}
  .lg-row{display:flex;align-items:center;gap:8px;font-size:12.5px}
  .lg-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
  .lg-name{color:var(--gray-700);font-weight:500}
  .lg-sep{color:var(--gray-300)}
  .lg-val{font-weight:700;color:var(--navy-dark);font-variant-numeric:tabular-nums}
  /* الحالة الوحيدة القابلة للتصرّف تُكتب بالأحمر - الباقي وصف لا عمل */
  .lg-row.todo .lg-name{color:var(--red);font-weight:700}
  .lg-note{font-size:11px;color:var(--gray-500);line-height:1.9;padding:10px 18px 14px;border-top:1px dashed var(--gray-200)}
  @@media(max-width:900px){.charts{grid-template-columns:1fr}}
</style>

<div class="page-header">
  <h2><span >@SharedLocalizer["home_welcome"]</span> @fullName 👋</h2>
  <p >@SharedLocalizer["home_summaryToday"]</p>
</div>

@* ============================================================================
   ⚠️ الشاشة دي كانت ٢٥ عدّاد على ٤ أقسام (مسار الطلبات، حالات الطلاب، نشاط اليوم،
      حسابات الشبكة) ومعظمهم أصفار. لوحة التحكم المفروض تجاوب على سؤال واحد:
      «فيه إيه مستني إجراء مني؟» — والباقي مكانه الشاشة المتخصصة فيه.

      اتشال: «نشاط اليوم» (مكانه سجل الدخول وسجل الإجراءات)، «حالات الطلاب»
      (مكانها شاشة الطلاب)، و«تنبيهات الأمان» (كانت فاضية دايمًا).
   ============================================================================ *@

@* ===== يحتاج إجراءك — بيظهر حسب صلاحيات المستخدم بس ===== *@
@if (canReviewHousing || canReviewCyber || canComplete)
{
  <div class="section-heading">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    <span>@SharedLocalizer["dash_needsAction"]</span>
  </div>

  @* ⚠️ كان فيه لافتة خضراء «مفيش طلبات مستنية إجراء منك» بتحلّ محل البطاقات لما
     الكل صفر. اتشالت لسببين: الشاشة كانت بتتغيّر شكلها كل ما رقم يتحرك، والبطاقة
     الصفر نفسها بتقول نفس المعلومة وزيادة — بتقول *أنهي* طابور فاضي وتفضل قابلة
     للضغط. البطاقات دلوقتي ثابتة والصفر بيبان رمادي. *@
  <div class="todo-grid">
      @if (canReviewHousing)
      {
        <a class="stat-card is-link @(waitHousing == 0 ? "is-idle" : "")" href="/Requests"
           title="@SharedLocalizer["dash_waitHousingDesc"]">
          <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg></span>
          <span class="stat-num">@waitHousing</span>
          <span class="stat-label">@SharedLocalizer["dash_waitHousing"]</span>
        </a>
      }
      @if (canReviewCyber)
      {
        <a class="stat-card is-link @(waitCyber == 0 ? "is-idle" : "")" href="/Requests"
           title="@SharedLocalizer["dash_waitCyberDesc"]">
          <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6z"/><path d="M9 12.2 11 14l4-4.2"/></svg></span>
          <span class="stat-num">@waitCyber</span>
          <span class="stat-label">@SharedLocalizer["dash_waitCyber"]</span>
        </a>
      }
      @if (canComplete)
      {
        @* ⚠️ بطاقة «بانتظار التحويل للمراجعة الإلكترونية» اتشالت من هنا.
           كانت بتعدّ الطلبات في حالة housing_approved، والحالة دي مافيش طلب
           بيقف فيها أصلًا: موافقة الإسكان بتحوّل الطلب على cyber_review في
           نفس اللحظة (ReviewAsync: ("submitted","housing_approved") => "cyber_review").
           فالبطاقة كانت صفر دايمًا وبتاخد ربع صف «يحتاج إجراءك» من غير فايدة.
           معالجة الحالة نفسها اتسابت في شاشة الطلبات كشبكة أمان لأي صف قديم
           اتخزّن قبل التحويل ده — فمفيش طلب هيضيع. *@
        <a class="stat-card is-link @(waitProvision == 0 ? "is-idle" : "")" href="/Requests"
           title="@SharedLocalizer["dash_waitProvisionDesc"]">
          <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg></span>
          <span class="stat-num">@waitProvision</span>
          <span class="stat-label">@SharedLocalizer["dash_waitProvision"]</span>
        </a>
      }
  </div>
}

@* ===== نظرة عامة — أربعة أرقام بس ===== *@
<div class="section-heading" style="margin-top:24px">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
  <span>@SharedLocalizer["dash_overview"]</span>
</div>

<div class="stats-grid">
  <div class="stat-card is-link" onclick="location.href='/Students'">
    <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
    <span class="stat-num">@Model.Stats.total</span>
    <span class="stat-label">@SharedLocalizer["home_totalStudents"]</span>
  </div>

  @* ⚠️ اتشال من هنا كارتا «طلاب» و«طالبات».
     السبب: دونات «توزيع الطلاب حسب الجنس» على نفس الشاشة تحتهم بتقول نفس
     الرقمين — وبتقولهم أحسن، لأنها بتوري النسبة. «١١ طالبة» لوحدها
     مابتقولش إنهم ١١ من ٢٥ ولا من ٥٠٠، والدونات بتقولها بالشكل من غير قراءة.
     وإجمالي الطلاب فوق باقي لأنه الرقم الأساسي اللي الباقي بيتقاس عليه. *@

  <div class="stat-card is-link" onclick="location.href='/Requests'">
    <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
    <span class="stat-num">@openRequests</span>
    <span class="stat-label">@SharedLocalizer["dash_openRequests"]</span>
  </div>

  @* ⚠️ اتشال من هنا كارتا «حسابات شبكة مفعّلة» و«معطّلة» — نفس سبب كارتي
     الجنس فوق: دونات «حسابات شبكة الإسكان الجامعي» على نفس الشاشة بتقول
     الرقمين وبتوري النسبة بينهم.
     ⚠️ والكارت البديل للي مالوش housing.view باقي زي ما هو: «طلبات مكتملة»
        رقم مالوش دونات، فمكانش مكرّرًا أصلًا. *@
  @if (!canHousingView)
  {
    <div class="stat-card is-link" onclick="location.href='/Requests'">
      <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
      <span class="stat-num">@Model.Stats.completed</span>
      <span class="stat-label">@SharedLocalizer["home_completedRequests"]</span>
    </div>
  }

  @* ===== سكن أعضاء هيئة التدريس =====
     ⚠️ الشرط على null لا على العدد: null معناها المستخدم مالوش صلاحية
        facultyHousing.view (الكنترولر مابيستعلمش أصلًا)، وصفر معناها مافيش
        وحدات. الفرق مهم - عرض «٠ وحدات» على حد مالوش صلاحية كذب مش إخفاء. *@
  @if (Model.FacultyStats is not null)
  {
    <div class="stat-card is-link" onclick="location.href='/FacultyHousing'">
      <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg></span>
      <span class="stat-num">@Model.FacultyStats.ActiveUnits</span>
      <span class="stat-label">@SharedLocalizer["dash_facultyUnits"]</span>
      @* ⚠️ الوحدات خارج الخدمة مش داخلة في الرقم فوق (مش قابلة للتسكين)،
         فبتتقال هنا عشان ما تختفيش من الشاشة خالص. وبتظهر لما تبقى أكبر
         من صفر بس - سطر بيقول «و٠ خارج الخدمة» ضجيج. *@
      @if (Model.FacultyStats.OutOfService > 0)
      {
        <span class="stat-sub">@string.Format(SharedLocalizer["dash_facultyOutOfServiceFmt"].Value, Model.FacultyStats.OutOfService)</span>
      }
    </div>

    <div class="stat-card is-link" onclick="location.href='/FacultyHousing'">
      <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.6v16.2a1 1 0 0 1-1.2 1L5 20V5.6a2 2 0 0 1 1.5-1.9l4-1A2 2 0 0 1 13 4.6Z"/></svg></span>
      <span class="stat-num">@Model.FacultyStats.Vacant</span>
      <span class="stat-label">@SharedLocalizer["dash_facultyVacant"]</span>
    </div>

    @* ⚠️ عدّاد استثناء: المفروض يبقى صفر. بيلبس اللون الكهرماني لما يبقى
       مش صفر، وبيفضل رمادي هادي وهو صفر. عدّاد بيصرخ طول الوقت بيتجاهَل. *@
    <div class="stat-card is-link @(Model.FacultyStats.PendingSync > 0 ? "alert" : "")" onclick="location.href='/FacultyHousing'">
      @* ⚠️ اللون مش مكتوب هنا: صنف .alert في components.css بيلوّن الرقم
         وشريط الحافة والأيقونة مع بعض. كان مكتوب inline بلونين مختلفين
         حسب العدد - يعني قاعدة تانية جنب القاعدة. *@
      <span class="stat-ghost" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></span>
      <span class="stat-num">@Model.FacultyStats.PendingSync</span>
      <span class="stat-label">@SharedLocalizer["dash_facultyUnsynced"]</span>
    </div>
  }
</div>

@* ============================================================================
   ⚠️ اتشال من هنا خمسة أقسام، وسبب واحد يجمعها: كلها كانت بتجاوب على أسئلة
      إجابتها في شاشة تانية على بُعد ضغطة.

      • «آخر الطلاب المسجلين» → خمسة صفوف من شاشة «قائمة الطلاب» كاملة.
      • «آخر العمليات»        → عشرة صفوف من شاشة «سجل العمليات» بفلاترها.
      • «نشاط تسجيل الدخول ٣٠ يوم» → كان بيرسم فاضي، وشاشة سجل الدخول موجودة.
      • «عمليات الطلاب» و«عمليات الطلبات» (دونات) → مجموع كل واحدة ٣ عمليات،
        والدونات تُقرأ لنسب لا لتلات أرقام.
      • «إجراءات سريعة» و«آخر الإشعارات» → الأزرار الستة في القائمة الجانبية
        الظاهرة على نفس الشاشة، والإشعارات في جرس الشريط العلوي بعدّادها.

      وبقي رسمان وقائمة واحدة: «الطلبات الأطول انتظارًا» — وهي السؤال الوحيد
      اللي مالوش إجابة في أي شاشة تانية، لأن مفيش شاشة بترتّب بالانتظار.
   ============================================================================ *@

@* ===== السطر التالت: رسم العمليات وحده بعرض الصفحة =====
   ⚠️ لوحده عن قصد: ده رسم زمني بسبعة أعمدة، ولما كان بيتقاسم الصف مع دونات
      كانت الأعمدة بتضيق والتواريخ تحتها بتتزاحم. الدونات دايرة صغيرة بتقرا في
      نص المساحة، والرسم الزمني لأ. *@
@if (canSeeOpsChart)
{
  <div class="charts one">
    <div class="card">
      <div class="chart-head">
        <span class="t" >@SharedLocalizer["dash_chartOpsTitle"]</span>
        <span class="pill" >@SharedLocalizer["dash_chartOpsUnit"]</span>
      </div>
      <div class="chart-body"><canvas id="chartOps7"></canvas></div>
    </div>
  </div>
}

@* ===== السطر الرابع: الدونات جنب بعض بنفس الحجم =====
   ⚠️ .even لا .charts العادية: دي بتدي الرسم الأول مساحة أكبر (1.35fr)، وهنا
      الرسمين متكافئين فلازم يتقسموا بالنص. وارتفاع البطاقتين بيتساوى لوحده
      لأن عناصر الـ grid بتتمدّد لأطول واحدة في الصف. *@
@{
    var chartsRow4 = (canSeeGenderSplit ? 1 : 0) + (canSeeAccountsChart ? 1 : 0) + (canSeeBuildingsChart ? 1 : 0);
    // الصنف محسوب هنا لا جوّه السمة: الاقتباسات جوّه @(...) داخل سمة
    // بتلخبط محلّل الرازر.
    var chartsRow4Class = chartsRow4 > 1 ? "charts even" : "charts one";
}
@if (chartsRow4 > 0)
{
  <div class="@chartsRow4Class">
    @if (canSeeGenderSplit)
    {
      <div class="card">
        <div class="chart-head">
          <span class="t" >@SharedLocalizer["dash_chartGenderTitle"]</span>
          <span class="pill" id="gndTotal"></span>
        </div>
        <div class="chart-body" style="height:190px"><canvas id="chartGender"></canvas></div>
        <div class="lg" id="gndLegend"></div>
      </div>
    }
    @if (canSeeBuildingsChart)
    {
      <div class="card">
        <div class="chart-head">
          <span class="t" >@SharedLocalizer["dash_chartBuildingsTitle"]</span>
          <span class="pill" id="bldTotal"></span>
        </div>
        <div class="chart-body"><canvas id="chartBuildings"></canvas></div>
        <div class="lg-note" >@SharedLocalizer["dash_buildingsNote"]</div>
      </div>
    }
    @if (canSeeAccountsChart)
    {
      <div class="card">
        <div class="chart-head">
          <span class="t" >@SharedLocalizer["dash_chartAccountsTitle"]</span>
          <span class="pill" id="accTotal"></span>
        </div>
        <div class="chart-body" style="height:190px"><canvas id="chartAccounts"></canvas></div>
        <div class="lg" id="accLegend"></div>
        <div class="lg-note" >@SharedLocalizer["dash_accNote2"]</div>
      </div>
    }
  </div>
}

@* ===== الطلبات الأطول انتظارًا ===== *@
<div class="card" style="margin-bottom:24px">
  <div class="card-header">
    <div class="card-title" >@SharedLocalizer["dash_oldestWaiting"]</div>
    <a class="card-action" href="/Requests" >@SharedLocalizer["home_viewAll"]</a>
  </div>
  <div id="waitingList">
    <div class="rq-empty"><span >@SharedLocalizer["home_loading"]</span></div>
  </div>
</div>

@section Scripts {
@* @@ للهروب من الـ Razor — الرابط النهائي فيه @ عادية زي الصفحة القديمة *@
@* ⚠️ كانت بتتحمّل من CDN خارجي. عيبان: شبكة الجامعة لو حجبت المصدر
   الخارجي بتفضى الرسوم بلا سبب واضح للمستخدم، وأي تغيير في المصدر ده بيتنفّذ
   جوّه صفحة فيها جلسة إدارية. النسخة المحلية موجودة أصلًا وشاشة التقارير
   بتستخدمها. *@
<script src="/js/chart.umd.min.js"></script>
@* ⚠️ chart-theme.js رجع هنا. كان اتشال بحجّة إن رسوم الشاشة دي «بإعداداتها
   الخاصة» — وده بالظبط اللي خلّى رسمة العمليات بلون أخضر فاتح مالوش علاقة
   بلون رسوم التقارير، مع إن الاتنين نفس النوع في نفس النظام.
   رسمة العمليات بقت بتنادي NuhChart.render، والقيم فوق الأعمدة بقت خيار
   جوّه الملف المشترك بدل ما تكون سبب لتقسيم الرسوم لنسختين. *@
<script src="/js/chart-theme.js" asp-append-version="true"></script>
<script src="/i18n.js"></script>
<script>
  var CAN_HOUSING = @(canHousingView ? "true" : "false");
  var CAN_ACC_CHART = @(canSeeAccountsChart ? "true" : "false");
  var CAN_BLD_CHART = @(canSeeBuildingsChart ? "true" : "false");
  var CAN_OPS_CHART = @(canSeeOpsChart ? "true" : "false");
  var CAN_GENDER_SPLIT = @(canSeeGenderSplit ? "true" : "false");
  var STATS_MALE = @Model.Stats.male, STATS_FEMALE = @Model.Stats.female;
  var accData = null;

  // تواريخ الطلبات — نحولها لتوقيت المتصفح بنفس أسلوب الصفحة القديمة
  document.querySelectorAll('[data-dt]').forEach(function (el) {
    var d = new Date(el.dataset.dt);
    if (!isNaN(d)) el.textContent = NuhFmt.date(d);
  });

  async function apiFetch(url) {
    try {
      var res = await fetch(url, { headers: NUH.headers() });
      if (res.status === 401) { window.location.replace('/Account/Login'); return null; }
      if (!res.ok) return null;
      return await res.json();
    } catch (e) { return null; }
  }

  function animateNum(id, target) {
    var el = document.getElementById(id);
    if (!el) return;
    var cur = 0;
    el.textContent = '0';
    var step = Math.max(1, Math.ceil(target / 30));
    var timer = setInterval(function () {
      cur = Math.min(cur + step, target);
      el.textContent = cur;
      if (cur >= target) clearInterval(timer);
    }, 40);
  }

  async function loadHousingStats() {
    // ملحوظة: النسخة القديمة كان فيها باج (متغير staffToken مش معرّف) فالأرقام دي ما كانتش بتتحمّل — متصلّح هنا
    var data = await apiFetch('/api/HousingAccountManagement/stats');
    if (!data) return;
    var map = {
      'hs-total-accounts': data.withAccounts || data.with_accounts || 0,
      'hs-enabled': data.enabled || 0,
      'hs-disabled': data.disabled || 0,
      'hs-synced-today': data.syncedLast24h || data.synced_last_24h || 0,
      'hs-without': data.withoutUsername || data.without_username || 0,
      'hs-total-students': data.totalStudents || data.total_students || 0
    };
    Object.keys(map).forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.textContent = map[id];
    });
    accData = { enabled: map['hs-enabled'], disabled: map['hs-disabled'], without: map['hs-without'] };
    if (CAN_ACC_CHART) renderAccounts(accData.enabled, accData.disabled, accData.without);
  }

  // ⚠️ القيم مكتوبة فوق الأعمدة: القراءة من الشبكة تقريبية والرقم المكتوب دقيق،
  //    والمحور الرأسي اتشال بعدها لأنه بقى تكرارًا لنفس الأرقام.
  // ⚠️ plugin الأرقام فوق الأعمدة اتنقل لـ js/chart-theme.js — كان مكتوب هنا
  //    جنب رسمة Chart.js كاملة بتتعدّى على NuhChart بالكامل.

  // ⚠️ نسبة كبيرة في وسط الدونات بدل المجموع: السؤال هو «كم النسبة المفعّلة»،
  //    والمجموع مذكور في وسيلة الإيضاح سطرًا سطرًا تحتها.
  // ⚠️ إضافة «النسبة في الوسط» اتشالت من هنا: كانت نسخة من nuhCenterTotal
  //    اللي في js/chart-theme.js بفرق إنها بتكتب نسبة بدل مجموع. بقت خيارًا
  //    في المكوّن (center) فالشاشة مابقتش تكتب رسمًا على الكانفاس بنفسها.

  // ⚠️ صفّ وسيلة الإيضاح - كان مكتوبًا **مرتين** في الملف ده بنفس الـ HTML
  //    حرفيًا (واحدة للجنس وواحدة للحسابات) والفرق بينهم صنف واحد.
  function lgRow(color, name, n, todo) {
    return '<div class="lg-row' + (todo ? ' todo' : '') + '">' +
           '<span class="lg-dot" style="background:' + color + '"></span>' +
           '<span class="lg-name">' + escHtml(name) + '</span><span class="lg-sep">-</span>' +
           '<span class="lg-val">' + t('dash_accStudentsFmt').replace('{0}', n) + '</span></div>';
  }

  // ألوان الرسوم من نفس توكنز النظام - NuhChart.colors بيقراها من base.css
  function chartColor(name, fallback) {
    return (window.NuhChart && NuhChart.colors && NuhChart.colors[name]) || fallback;
  }

  var opsChart, accChart, gndChart;
  var chartData;
  async function loadCharts() {
    var data = await apiFetch('/api/auditlogs/chart-data');
    if (!data) return;
    chartData = data;
    renderCharts();
  }
  function renderCharts() {
    var data = chartData;
    if (!data || !data.last7Days || !data.last7Days.length) return;
    // ⚠️ الرسمة دي كانت مبنية هنا بالإيد: لونها وخطّها ومحاورها وتلميحها —
    //    نسخة كاملة موازية لـ NuhChart، مع إن التعليق في نفس الملف بيقول إن
    //    دالة الرسم اتوحّدت في js/chart-theme.js. فكانت رسمة لوحة التحكم
    //    وحدها بأخضر فاتح (#a9efc5) مالوش علاقة بلون رسوم التقارير.
    //    بقت بتنادي نفس الدالة، فاللون والخط والتلميح واحد في النظام كله.
    opsChart = NuhChart.render(
      'chartOps7', 'bar',
      data.last7Days.map(function (d) { return d.date.slice(5, 10); }),
      data.last7Days.map(function (d) { return d.count; }),
      null, null,
      { valueLabels: true, hideY: true });
  }

  // ====================================================================
  //  دونات حسابات الشبكة — ثلاث حالات لا اثنتان.
  //
  //  ⚠️ «مفعّل / معطّل» وحدهما يصفان الموجود ولا يقولان للأمن السيبراني ما
  //     الذي ينتظره: التعطيل قرار إداري مضى. الحالة الثالثة «بلا حساب» هي
  //     طابور عمله، فاسمها مكتوب بالأحمر في وسيلة الإيضاح لأنها وحدها
  //     القابلة للتصرّف.
  //
  //  ⚠️ الألوان هنا حالات لا فئات: أخضر يعمل، وأحمر فاتح موقوف، ورمادي غير
  //     موجود — للحالات ترتيب طبيعي والفئات لا ترتيب لها.
  //
  //  ⚠️ الأرقام من نفس نداء بطاقتَي «مفعّلة» و«معطّلة» فوقها، فلا يمكن أن
  //     يفترق الرسم عن الرقم المكتوب بجانبه.
  // ====================================================================
  // ====================================================================
  //  دونات الطلاب/الطالبات.
  //
  //  ⚠️ الأرقام من Model.Stats نفسه اللي البطاقتين فوق بيقروا منه، فمستحيل
  //     الرسم يفارق الرقم المكتوب جنبه — ومفيش نداء API زيادة عشانه.
  //
  //  ⚠️ والرسم للي بيشوف القسمين وحده: المشرف عنده هيبقى ١٠٠٪/٠٪، فالشرط
  //     في الرازر فوق لا هنا.
  // ====================================================================
  function renderGender(male, female) {
    var el = document.getElementById('chartGender');
    if (!el || typeof Chart === 'undefined') return;
    male = male || 0; female = female || 0;
    var total = male + female;
    var pct = total ? Math.round(male * 100 / total) : 0;

    var pill = document.getElementById('gndTotal');
    if (pill) pill.textContent = t('dash_accTotalFmt').replace('{0}', total);

    // ⚠️ الأخضر والذهبي - لونا الجامعة من base.css لا لونين مكتوبين هنا.
    //    كانوا أزرق #175cd3 وبنفسجي #a4508b: لونين مالهمش وجود في لوحة
    //    النظام أصلًا، فالرسمة كانت باينة كأنها من نظام تاني.
    var GND = [chartColor('green', '#067647'), chartColor('gold', '#dba102')];

    gndChart = NuhChart.render('chartGender', 'doughnut',
      [t('dash_maleStudents'), t('dash_femaleStudents')], [male, female], GND, null,
      { legend: false, cutout: '72%', center: { value: pct + '%', label: t('dash_maleStudents') } });

    var lg = document.getElementById('gndLegend');
    if (lg) lg.innerHTML = lgRow(GND[0], t('dash_maleStudents'), male) +
                           lgRow(GND[1], t('dash_femaleStudents'), female);
  }

  function renderAccounts(enabled, disabled, without) {
    var el = document.getElementById('chartAccounts');
    if (!el || typeof Chart === 'undefined') return;
    enabled = enabled || 0; disabled = disabled || 0; without = without || 0;
    var withAcc = enabled + disabled;
    var total = withAcc + without;
    var pct = total ? Math.round(withAcc * 100 / total) : 0;

    var pill = document.getElementById('accTotal');
    if (pill) pill.textContent = t('dash_accTotalFmt').replace('{0}', total);

    // ⚠️ «معطّلة» كانت وردي فاتح #f2a9a2 و«بلا حساب» رمادي فاتح #cecfd2،
    //    وفرق اللونين بمقياس ΔE كان **١٠٫٣** والحدّ ١٥ - يعني حتى اللي شايف
    //    الألوان عادي مش فارق معاه الشريحتين. وتباين الاتنين على الأبيض كان
    //    أقل من ٣:١، فالشريحة نفسها بالكاد بتبان. الدرجتين الجديدتين فرقهم
    //    ٢٢٫٦ والتلاتة عدّوا ٣:١.
    // ⚠️ وهي حالات لا فئات: أخضر يعمل، وأحمر موقوف، ورمادي غير موجود.
    var ACC = [chartColor('green', '#067647'), chartColor('red', '#b42318'),
               chartColor('gray500', '#85888e')];

    accChart = NuhChart.render('chartAccounts', 'doughnut',
      [t('dash_accEnabledOne'), t('dash_accDisabledOne'), t('dash_accNoAccount')],
      [enabled, disabled, without], ACC, null,
      { legend: false, cutout: '72%', center: { value: pct + '%', label: t('dash_accCoverLabel') } });

    var lg = document.getElementById('accLegend');
    if (lg) {
      lg.innerHTML =
        lgRow(ACC[0], t('dash_accEnabledOne'), enabled, false) +
        lgRow(ACC[1], t('dash_accDisabledOne'), disabled, false) +
        lgRow(ACC[2], t('dash_accNoAccount'), without, true);
    }
  }

  // ====================================================================
  //  الطلاب حسب المبنى — رسم المشرف والمشرفة
  //  ⚠️ التجميع والفلترة بالجنس على الخادم (StudentService.GetCountByBuildingAsync)
  //     لا هنا: جلب كل الطلاب لعدّهم في المتصفح يعني نقل السجلّ كاملًا لرسم
  //     فيه أربعة أعمدة، وكان يمرّر بيانات الجنس الآخر إلى الصفحة أصلًا.
  //  ⚠️ أفقي لا رأسي: أسماء المباني نصّ عربي، ورأسيًا تُقلب أو تُقصّ تحت العمود.
  // ====================================================================
  var bldChart, bldData;
  async function loadBuildings() {
    bldData = await apiFetch('/api/Students/by-building');
    renderBuildings();
  }
  function renderBuildings() {
    var el = document.getElementById('chartBuildings');
    if (!el || typeof Chart === 'undefined' || !Array.isArray(bldData)) return;
    var rows = bldData.slice(0, 8);
    var total = bldData.reduce(function (a, x) { return a + (x.count || 0); }, 0);
    var pill = document.getElementById('bldTotal');
    if (pill) pill.textContent = t('dash_buildingsUnit').replace('{0}', total);
    if (bldChart) bldChart.destroy();
    if (!rows.length) {
      el.parentNode.innerHTML = '<div class="rq-empty"><span>' + t('dash_noBuildings') + '</span></div>';
      return;
    }
    // ⚠️ العمود كان بأخضر فاتح #a9efc5 وتباينه على الأبيض **1.33:1** - عمود
    //    بتدوّر عليه بعينك. بقى بلون الهوية (6.60:1). واللون من base.css.
    // ⚠️ والرسمة كلها كانت مكتوبة هنا بمحاورها وإضافة أرقامها - نسخة تالتة
    //    من كود موجود في js/chart-theme.js. بقت نداء واحد بخيار horizontal.
    bldChart = NuhChart.render('chartBuildings', 'bar',
      rows.map(function (x) { return t('dash_buildingPrefix') + ' ' + x.building; }),
      rows.map(function (x) { return x.count; }),
      chartColor('navy', '#166a45'), null,
      { horizontal: true, valueLabels: true });
  }

  // ====================================================================
  //  الطلبات الأطول انتظارًا
  //  ⚠️ الترتيب والفلترة على الخادم (openOnly + sortAsc): الجدول مقسّم صفحات،
  //     فترتيبٌ في المتصفح كان هيرتّب أول عشرين صف بس ويسمّيهم «الأقدم».
  // ====================================================================
  var waitingData;
  // ⚠️ waitingFailed مش تفصيلة: apiFetch بترجّع null في حالتين مختلفتين
  //    تمامًا - «مفيش طلبات» و«النداء فشل». ولو الاتنين اتعاملوا بنفس الشكل،
  //    عطل في الشبكة أو في الخادم بيظهر للمشرف **علامة صح خضرا** و«لا يوجد
  //    طلب منتظر». يعني الطابور مليان وهو شايفه فاضي، ومافيش أي إشارة إن في
  //    حاجة غلط. ده أخطر شكل للعطل: عطل بيتقري كخبر كويس.
  var waitingFailed = false;
  async function loadWaiting() {
    // ⚠️ ‏stagesince لا submittedat: اللوحة بتقول «الأطول انتظارًا» - يعني
    //    أطول واحد **واقف في مرحلته الحالية**، مش أقدم طلب في النظام. طلب
    //    قديم اتحرّك امبارح مش متأخّر، وطلب جديد واقف من ساعة ما اتقدّم هو
    //    اللي محتاج دفعة. المفتاح معرَّف في RequestService بنفس سلسلة
    //    COALESCE اللي في RequestDto.StageSince بالحرف.
    waitingData = await apiFetch('/api/Requests/paged?page=1&pageSize=5&openOnly=true&sortBy=stagesince&sortAsc=true');
    waitingFailed = (waitingData === null);
    renderWaiting();
  }

  // ⚠️ العتبات هنا وحدها: أقل من يومين أخضر، وحتى خمسة كهرماني، وفوقها أحمر.
  // ⚠️ فرق **أيام التقويم** لا قسمة على ٢٤ ساعة: القسمة كانت بتقول «اليوم»
  //    عن طلب اتقدّم امبارح الساعة ٨ مساءً وانت بتبصّ الساعة ٩ صباحًا - لأن
  //    اللي عدّى ١٣ ساعة، و floor(13/24) = 0. والموظف بيقرا التاريخ لا
  //    الساعات: بالنسبة له ده امبارح. المقارنة دلوقتي بين منتصف ليل اليوم
  //    ومنتصف ليل يوم الحدث بالتوقيت المحلي، فـ«اليوم» معناها اليوم فعلًا.
  function ageChip(iso) {
    var d = new Date(iso);
    var days = NaN;
    if (!isNaN(d.getTime())) {
      var a = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      var n = new Date();
      var b = new Date(n.getFullYear(), n.getMonth(), n.getDate());
      days = Math.round((b - a) / 86400000);
    }
    if (!isFinite(days) || days < 0) days = 0;
    var txt = days === 0 ? t('dash_ageToday')
            : days === 1 ? t('dash_ageOneDay')
            : days === 2 ? t('dash_ageTwoDays')
            : days <= 10 ? t('dash_ageDaysFmt').replace('{0}', days)
            : t('dash_ageManyDaysFmt').replace('{0}', days);
    return { txt: txt, cls: days < 2 ? 'age-ok' : (days <= 5 ? 'age-warn' : 'age-bad') };
  }

  // شريط الخطوات — الرقم من جدول المسار لا من سلّم مكتوب هنا.
  // ⚠️ need_more_info وحده خارج الجدول (مالوش انتقال، الطلب راجع للطالب)،
  //    وهو راجع لأول المسار فخطوته ١ — نفس السبب اللي خلّاه استثناءً في
  //    RequestWorkflow.OpenStatuses.
  function stepsBar(status) {
    var wf = (typeof NuhWorkflow !== 'undefined') ? NuhWorkflow.forStatus(status) : null;
    var step = (wf && wf.step) || (status === 'need_more_info' ? 1 : 0);
    var html = '<span class="rq-steps">';
    for (var i = 1; i <= 4; i++) html += '<i class="' + (i <= step ? 'on' : '') + '"></i>';
    return html + '</span>';
  }

  function renderWaiting() {
    var box = document.getElementById('waitingList');
    if (!box || typeof waitingData === 'undefined') return;
    var items = (waitingData && waitingData.items) || [];

    // فشل النداء - رسالة عطل بزرار إعادة محاولة، مش حالة فراغ.
    if (waitingFailed) {
      box.innerHTML = '<div class="rq-empty">' +
        '<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#b42318" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>' +
        '<b style="color:#b42318">' + t('dash_waitingError') + '</b>' +
        '<span>' + t('dash_waitingErrorSub') + '</span>' +
        '<button type="button" class="pill" style="cursor:pointer;border:1px solid var(--gray-200);background:var(--white);margin-top:4px" onclick="loadWaiting()">' +
        t('dash_retry') + '</button></div>';
      return;
    }

    if (!items.length) {
      box.innerHTML = '<div class="rq-empty">' +
        '<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#067647" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
        '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' +
        '<b>' + t('dash_noWaiting') + '</b><span>' + t('dash_noWaitingSub') + '</span></div>';
      return;
    }
    box.innerHTML = items.map(function (r) {
      var st = (r.status || '').toLowerCase();
      // ⚠️ نفس حقل الترتيب بالظبط: لو الشارة قرأت submittedAt والترتيب قرأ
      //    stageSince، اللوحة بتوري خمس صفوف مرتّبة بحاجة وأرقامها بتقول
      //    حاجة تانية - وده مكتوب حرفيًّا في تعليق RequestDto.StageSince.
      var age = ageChip(r.stageSince || r.submittedAt);
      var name = (r.student && r.student.full_name) || r.studentId || '';
      var nameEn = (r.student && r.student.full_name_english) || '';
      // ⚠️ المفتاح من NuhWorkflow لا مبني هنا — نفس مصدر شاشة الطلبات،
      //    عشان المرحلة الواحدة ما تظهرش باسمين في شاشتين.
      var stageKey = NuhWorkflow.stageKey(st);
      var stage = t(stageKey); if (stage === stageKey) stage = st;
      return '<a class="rq-row" href="/Requests/Details/' + r.id + '">' +
        '<span class="rq-num">' + escHtml(r.requestNumber || '-') + '</span>' +
        '<span class="rq-main"><span class="rq-name">' + escHtml(name) + '</span>' +
        (nameEn ? '<span class="rq-name-en">' + escHtml(nameEn) + '</span>' : '') +
        '<span class="rq-stage">' + escHtml(stage) + '</span></span>' +
        stepsBar(st) +
        '<span class="rq-age ' + age.cls + '">' + escHtml(age.txt) + '</span>' +
        '<span class="rq-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></span>' +
      '</a>';
    }).join('');
  }

  // ⚠️ النداءات اللي اتشالت مع بطاقاتها: loadAuditActivity و loadNotifCard
  //    و loadAuditStats و loadAlerts — كانت بتضرب الـ API على كل فتح للصفحة
  //    عشان أرقام مالهاش مكان تتعرض فيه.
  if (CAN_OPS_CHART) loadCharts();
  // الأرقام محقونة من الخادم — الرسم بيتبني فورًا بلا انتظار أي نداء.
  if (CAN_GENDER_SPLIT) renderGender(STATS_MALE, STATS_FEMALE);
  loadWaiting();
  if (CAN_BLD_CHART) loadBuildings();
  // ⚠️ الشرط كان CAN_HOUSING وحده — أي housing.view. ولمّا اتربطت الدونات
  //    بمن يتصرّف في الحساب (الأمن السيبراني) بقى عنده البطاقة ظاهرة والنداء
  //    مايتنفّذش أصلًا، فالمكان يفضل فاضي بلا حتى خطأ في الشبكة.
  if (CAN_HOUSING || CAN_ACC_CHART) loadHousingStats();

  // اللغة تتبع ثقافة السيرفر — setLang بيترجم عناصر الترجمة وبيستدعي onLanguageChange
  window.onLanguageChange = function () {
    renderCharts();
    renderWaiting();
    if (accData && CAN_ACC_CHART) renderAccounts(accData.enabled, accData.disabled, accData.without);
    if (CAN_BLD_CHART) renderBuildings();
  };
  setLang(localStorage.getItem('uiLanguage') || 'ar');
</script>
}
