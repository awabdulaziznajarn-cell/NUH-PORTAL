      </div>
      <span class="stat-badge" style="background:#F3E8FF;color:#6B21A8" >@SharedLocalizer["home_badge_cyberReview"]</span>
    </div>
    <div class="stat-num">@Model.Stats.cyber_review</div>
    <div class="stat-label" >@SharedLocalizer["home_underCyberReview"]</div>
  </div>

  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#E1F5EE">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F6E56" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <span class="stat-badge" style="background:#E1F5EE;color:#0F6E56" >@SharedLocalizer["home_badge_approved"]</span>
    </div>
    <div class="stat-num">@Model.Stats.cyber_approved</div>
