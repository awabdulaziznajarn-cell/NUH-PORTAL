@model NUH_PORTAL.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = SharedLocalizer["Page_Home"].Value;
    var role = (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "").ToLowerInvariant();
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var isAdmin = role == "admin";
    var canRegister = role != "cyber" && role != "user";
}

<style>
  /* خاص بلوحة التحكم فقط — الباقي كله من site.css */
  .stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px;margin-bottom:24px}
  .stat-card{background:var(--white);border-radius:16px;padding:20px;border:1px solid var(--gray-100);box-shadow:0 2px 8px rgba(27,42,94,.05);display:flex;flex-direction:column;gap:12px;transition:transform .2s,box-shadow .2s}
  .stat-card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(27,42,94,.1)}
  .stat-top{display:flex;align-items:center;justify-content:space-between}
  .stat-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center}
  .stat-badge{font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px}
  .stat-num{font-size:32px;font-weight:900;color:var(--navy-dark);line-height:1}
  .stat-label{font-size:13px;color:var(--gray-500);font-weight:500}
  .section-heading{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:700;color:var(--navy-dark);margin-bottom:12px}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}
  #chartsRow{grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}
  .activity-list{padding:8px 0}
  .activity-item{display:flex;align-items:flex-start;gap:12px;padding:12px 20px;border-bottom:1px solid var(--gray-100)}
  .activity-item:last-child{border-bottom:none}
  .activity-dot{width:8px;height:8px;border-radius:50%;margin-top:6px;flex-shrink:0}
  .activity-text{font-size:13px;color:var(--navy-dark);font-weight:500;line-height:1.5}
  .activity-time{font-size:11px;color:var(--gray-500);margin-top:2px}
  .actions-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:16px}
  .action-btn{display:flex;flex-direction:column;align-items:center;gap:8px;padding:16px 12px;border-radius:12px;border:1.5px solid var(--gray-100);background:var(--gray-50);cursor:pointer;transition:all .2s;text-decoration:none}
  .action-btn:hover{border-color:var(--navy);background:var(--white);transform:translateY(-2px);box-shadow:0 4px 12px rgba(27,42,94,.1)}
  .action-btn span{font-size:12px;font-weight:600;color:var(--navy-dark);text-align:center}
</style>

<div class="page-header">
  <h2><span >@SharedLocalizer["home_welcome"]</span> @fullName 👋</h2>
  <p >@SharedLocalizer["home_summaryToday"]</p>
</div>

@* ===== إحصائيات مسار الطلبات — أرقام حقيقية من السيرفر ===== *@
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#E6F1FB">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1B2A5E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <span class="stat-badge" style="background:#E6F1FB;color:#1B2A5E" >@SharedLocalizer["home_badge_total"]</span>
    </div>
    <div class="stat-num">@Model.Stats.total</div>
    <div class="stat-label" >@SharedLocalizer["home_totalStudents"]</div>
  </div>

  <div class="stat-card">
    <div class="stat-top">
      <div class="stat-icon" style="background:#FFF7ED">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#92400E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
      <span class="stat-badge" style="background:#FFF7ED;color:#92400E" >@SharedLocalizer["home_badge_housingReview"]</span>
    </div>
