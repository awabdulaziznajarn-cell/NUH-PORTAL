// ============================================================================
//  الملف الأساس — يُودَع في git ولا يحتوي أي سر
// ----------------------------------------------------------------------------
//  كل القيم الحسّاسة (اتصال DB / مفتاح JWT / كلمة مرور AD) فاضية هنا عمدًا،
//  وتتحدد في appsettings.Production.json أو appsettings.Development.json.
//
//  لو التطبيق قام والملف البيئي مفقود → هيرمي استثناء عند الإقلاع.
//  ده سلوك مقصود: أفضل ما يرفض الاشتغال من إنه يشتغل بمفتاح افتراضي معروف.
// ============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // عنوان الواجهة المسموح لها بالـ CORS — يتحدد لكل بيئة
  "AllowedOrigin": "",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=NUH_DB;User Id=svc_nuh_app;Password=aPCWLk1_RpLiNy2+11pji9W_;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;Connect Timeout=30;Application Name=NUH-PORTAL"
  },

  "HttpsRedirect": {
    "Enabled": false
  },

  // مكان تخزين مرفقات المستخدمين — لازم يفضل *برّه* مجلد النشر (D:\Publish)
  // عشان أي نشر ينضّف المجلد ما يمسحش مستندات الطلاب.
  //   {Root}\Housing-Transfer-Attachments\{رقم النقل}\
  //   {Root}\Student-Status-Attachments\{رقم الإجراء}\
  //   {Root}\Request-Attachments\{رقم الطلب}\
  // لو فاضي: بيستخدم App_Attachments جنب التطبيق (للتطوير المحلي فقط).
  "Storage": {
    "AttachmentsRoot": "D:\\NUH-DATA"
  },

  "Jwt": {
    // فاضي عمدًا — Program.cs يرمي استثناء لو أقل من 32 حرف
    "Key": "",
    "Issuer": "NUH-PORTAL",
    "Audience": "NUH-PORTAL-USERS"
  },

  "ActiveDirectory": {
    "Enabled": true,
    // لازم FQDN وليس NetBIOS — الكود يبني UPN بصيغة {Username}@{Domain}
    // ⚠️ القيمة الحقيقية في appsettings.Production.json (nuh.edu.sa).
    //    كانت مكتوبة هنا globalgroups.com — دومين قديم، وأي بيئة مالهاش ملف
    //    إعدادات خاص كانت هتشتغل عليه من غير ما حد ياخد باله.
    "Domain": "nuh.edu.sa",
    "DomainController": "NUH-AD-SRV1.nuh.edu.sa",
    "Port": 636,
    "ValidateCertificate": true
  },

  "Otp": {
    // Static = رمز ثابت لأي رقم (تطوير فقط). Sms = رمز عشوائي عبر المزوّد.
    "Mode": "Sms",
    "Salt": ""
  },

  "ADServiceAccount": {
    "Username": "",
    "Password": ""
  },

  // سكن أعضاء هيئة التدريس — مسارات الوحدات التنظيمية في الدومين.
  //
  // ⚠️ "Buludings" مكتوبة كده في الدومين والصح "Buildings". مانصلّحش الإملاء
  //    هنا: الـ DN لازم يطابق الواقع حرفًا بحرف، وإلا البحث يرجع فاضي والنظام
  //    يقول إن مافيش وحدات وهي موجودة. لو اتصلّحت في الدومين تتصلّح هنا.
  //
  // ⚠️ مش مكرّرة في appsettings.Production.json عن قصد: القيم واحدة في كل
  //    البيئات لأن الدومين واحد. التكرار معناه إن أي تصحيح لازم يتعمل مرتين،
  //    وأول مرة حد ينسى المرة التانية تبقى عندنا بيئة بتقرا من مسار قديم.
  //
  // ⚠️ تقسيم MALE/FEMALE تنظيمي في الدومين بس — الوحدات نفسها مختلطة، فبنقرا
  //    من الاتنين مع بعض ومابنخزّنش منهم جنس على الوحدة.
  "FacultyHousing": {
    "Enabled": true,
    "TowersMaleOu": "OU=MALE,OU=Buludings,OU=FACULTY,DC=nuh,DC=edu,DC=sa",
    "TowersFemaleOu": "OU=FEMALE,OU=Buludings,OU=FACULTY,DC=nuh,DC=edu,DC=sa",
    "VillasOu": "OU=Villas,OU=FACULTY,DC=nuh,DC=edu,DC=sa",
    "VillasMaleOu": "",
    "VillasFemaleOu": "",
    // سقف القراءة — لو اتعدّى بيبان تحذير صريح بدل ما النتيجة تتقطع بصمت
    "MaxImportResults": 2000
  }
}
