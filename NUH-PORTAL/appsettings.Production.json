// ============================================================================
//  بيئة الإنتاج — على السيرفر فقط
// ----------------------------------------------------------------------------
//  ❌ لا يُرفَع على git إطلاقًا (مضاف إلى .gitignore)
//  ❌ لا يُنسَخ ضمن مخرجات publish (مستبعد في .csproj) — فأي إعادة نشر لن تدهسه
//  🔒 صلاحيات NTFS: Read فقط لـ IIS AppPool\NUH-PORTAL
//  🔁 أي تعديل هنا يحتاج Recycle للـ Application Pool حتى يُقرأ
// ============================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "NUH_PORTAL": "Information",

      // يكتم سجلات TRACE المفصّلة (UPN، فلاتر LDAP، مجموعات المستخدم، موضوع
      // الشهادة، طول كلمة المرور) المسجَّلة بمستوى Information داخل
      // ActiveDirectoryService — بدون تعديل كود.
      "NUH_PORTAL.Services.ActiveDirectoryService": "Warning",

      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // ⚠️ استبدل بالـ FQDN الفعلي — يمنع هجمات Host header
  "AllowedHosts": "housing.globalgroups.com",

  // ⚠️ نفس عنوان الموقع بالضبط: بالبروتوكول، وبدون / في الآخر
  "AllowedOrigin": "https://housing.globalgroups.com",

  "ConnectionStrings": {
    // SQL Server Express — نسخة مسماة على نفس جهاز الـ IIS.
    //   .\SQLEXPRESS  = الجهاز المحلي، النسخة SQLEXPRESS
    //   لا نكتب رقم منفذ: النسخة المسماة تستخدم منفذًا ديناميكيًا،
    //   والاتصال المحلي يتم عبر Shared Memory بدون خدمة SQL Browser.
    //
    // كلمة المرور لازم تطابق تمامًا القيمة في 00-create-database-and-login.sql
    // Encrypt=True + TrustServerCertificate=True لأن Express يستخدم
    // شهادة موقّعة ذاتيًا محليًا (الاتصال داخل نفس الجهاز).
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=NUH_DB;User Id=svc_nuh_app;Password=aPCWLk1_RpLiNy2+11pji9W_;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;Connect Timeout=30;Application Name=NUH-PORTAL"
  },

  // IIS ينهي الـ TLS داخل العملية (inprocess) فالمخطط https يصل صحيحًا للتطبيق
  "HttpsRedirect": {
    "Enabled": true
  },

  "Jwt": {
    // 🔑 مفتاح مولَّد عشوائيًا (48 بايت / 64 حرف Base64)
    //    لا تشاركه ولا تعيد استخدامه في أي بيئة أخرى.
    //    تغييره يُبطل كل الجلسات النشطة فورًا — استخدم ذلك عند أي شك في تسريب.
    "Key": "UrRRODN4Uc04LiucG49WEuae1pi78iy4XQydrlkjZ16TtW+21ZZAfLnS858zGtS8",
    "Issuer": "NUH-PORTAL",
    "Audience": "NUH-PORTAL-USERS"
  },

  "ActiveDirectory": {
    "Enabled": true,
    "Domain": "globalgroups.com",
    "DomainController": "DC-01.globalgroups.com",
    "Port": 636,
    // لا تجعلها false في الإنتاج — تعطّل التحقق من شهادة الـ Domain Controller
    "ValidateCertificate": true,
    "RoleMappings": [
      { "AdGroup": "Housing_Admin", "ApplicationRole": "admin" },
      { "AdGroup": "Housing_Cyber", "ApplicationRole": "cyber" },
      { "AdGroup": "Housing_Supervisor", "ApplicationRole": "supervisor" },
      { "AdGroup": "Housing_Users", "ApplicationRole": "user" }
    ]
  },

  "Otp": {
    // 🚨🚨 اقرأ القسم ٠ في دليل النشر قبل تغيير هذه القيمة 🚨🚨
    //
    //  Mode = "Static" → رمز التحقق ثابت (123456) لأي رقم جوال
    //                     = تجاوز كامل للتحقق من هوية الطالب.
    //  Mode = "Sms"    → رمز عشوائي آمن، لكن SmsService حاليًا محاكي
    //                     (Provider = "Simulated") ولا يرسل رسائل فعلية،
    //                     أي أن الطالب لن يستلم الرمز.
    //
    //  القرار الحالي: أبقِ "Sms" ولا تعرّض بوابة الطالب (/register) للإنترنت
    //  حتى يُربَط مزوّد SMS حقيقي داخل SmsService.
    "Mode": "Sms",

    // ملح تجزئة الـ OTP — مولَّد عشوائيًا، ومختلف عن قيمة التطوير
    "Salt": "iZeWLryT3WoJ9E6x3hLJcy8WY5FTw7kl"
  },

  "ADServiceAccount": {
    // ⚠️ Username لازم يكون SAM مجرّد (nuh.portal)
    //    بدون globalgroups\ وبدون @globalgroups.com
    //    لأن ActiveDirectoryService.cs يبني الـ UPN بنفسه: {Username}@{Domain}
    //
    // 🚨 كلمة المرور القديمة abc@1234 مسرَّبة في تاريخ git —
    //    لازم تُدوَّر في AD قبل النشر.
    //
    // الصلاحيات المطلوبة على OU الطلاب:
    //    Create/Delete User Objects · Reset Password · Write Members (على المجموعات)
    "Username": "nuh.portal",
    "Password": "AD_SERVICE_PASSWORD_HERE"
  }
}
