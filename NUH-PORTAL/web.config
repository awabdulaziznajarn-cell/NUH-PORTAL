<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- hostingModel=inprocess : التطبيق يعمل داخل عملية IIS (أسرع، والمخطط https يصل صحيحًا للتطبيق)
           stdoutLogEnabled : للتشخيص وقت أول تشغيل فقط. ⚠️ ظلّ true بعد التشغيل،
           وهو يكتب مخرجات العملية في ملف ينمو بلا حد ولا يُنظَّف. أعِده إلى true
           مؤقتًا لو فشل الإقلاع، ثم false مرة أخرى. -->
      <aspNetCore processPath="dotnet" arguments=".\NUH-PORTAL.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- يجعل UseHttpsRedirection حتمي بدل الاعتماد على اكتشاف المنفذ -->
          <environmentVariable name="ASPNETCORE_HTTPS_PORT" value="443" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 11 ميجابايت — أعلى قليلًا من حد المرفقات (10MB) في AttachmentService -->
          <requestLimits maxAllowedContentLength="11534336" />
        </requestFiltering>
      </security>
      <!-- الضغط داخل التطبيق وحده (UseResponseCompression). الديناميكي هنا مقفول
           عمدًا حتى لا تضغط طبقتان نفس الرد. مكان واحد يضغط، لا اثنان. -->
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
<!--ProjectGuid: 2796E93A-CE4D-4AF4-8B28-AAAF17AB893B-->