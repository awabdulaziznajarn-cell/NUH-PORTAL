<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- hostingModel=inprocess : التطبيق يعمل داخل عملية IIS (أسرع، والمخطط https يصل صحيحًا للتطبيق)
           stdoutLogEnabled : خلّيه true عند أول تشغيل فقط لتشخيص أي فشل إقلاع، ثم أعده إلى false -->
      <aspNetCore processPath="dotnet"
                  arguments=".\NUH-PORTAL.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- يجعل UseHttpsRedirection حتمي بدل الاعتماد على اكتشاف المنفذ -->
          <environmentVariable name="ASPNETCORE_HTTPS_PORT" value="443" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 11 ميجابايت — أعلى قليلًا من حد المرفقات (10MB) في AttachmentService -->
          <requestLimits maxAllowedContentLength="11534336" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

    </system.webServer>
  </location>
</configuration>
